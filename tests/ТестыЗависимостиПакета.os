&Тест
Процедура ТестДолжен_СохранитьВерсиюСредыПриЧтенииМанифеста() Экспорт

	// Подготовка
	Зависимости = Новый ЗависимостиПакета();

	// Действие
	Зависимости.ЗаполнитьИзМанифеста(ПомощникТестирования.ФайлМанифеста);
	ВерсияСреды = Зависимости.ВерсияСреды();
	Зависимости.ЗаполнитьИзМанифеста("./tests/fixtures/packagedef-no-engine");
	ПустаяВерсия = Зависимости.ВерсияСреды();

	// Проверка
	Ожидаем.Что(ВерсияСреды).Равно("1.9.3");
	Ожидаем.Что(ПустаяВерсия).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьРезультатПоискаВерсииПакетаПриКопировании() Экспорт

	// Подготовка
	Зависимости = Новый ЗависимостиПакета()
		.Добавить("incompatible", "1.0.0", "", Ложь, "")
		.Добавить("autumn", "3.3.0", "", Ложь, "3.3.0");

	// Действие
	Копия = Новый ЗависимостиПакета()
		.ЗаполнитьИзТаблицы(Зависимости.СкопироватьВТаблицу())
		.СкопироватьВТаблицу();

	// Проверка
	Ожидаем.Что(Копия[0].МинимальнаяВерсия).Равно("1.0.0");
	Ожидаем.Что(Копия[0].НайденнаяВерсияПакета).Равно("");
	Ожидаем.Что(Копия[1].НайденнаяВерсияПакета).Равно("3.3.0");

КонецПроцедуры

