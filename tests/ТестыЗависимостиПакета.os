&Тест
Процедура ТестДолжен_РаспознатьТочныеПометкиТранзитивныхЗависимостей() Экспорт

	// Подготовка
	ПутьКМанифесту = "./tests/fixtures/packagedef-indirect-syntax";
	Зависимости = Новый ЗависимостиПакета();

	// Действие
	Таблица = Зависимости.ЗаполнитьИзМанифеста(ПутьКМанифесту).СкопироватьВТаблицу();
	Копия = Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(Таблица).СкопироватьВТаблицу();

	// Проверка
	Ожидаем.Что(Копия.Найти("exact", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("spaced", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("russian", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("russian_dev", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("russian_case", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("case", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("dev_exact", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit", "ИмяПакета").Неявная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit_russian", "ИмяПакета").Неявная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit_dev", "ИмяПакета").Неявная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit_case", "ИмяПакета").Неявная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit_reason", "ИмяПакета").Неявная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit_russian_reason", "ИмяПакета").Неявная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("transitive_reason", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("transitive_russian_reason", "ИмяПакета").Транзитивная).ЭтоИстина();
	Ожидаем.Что(Копия.Найти("implicit", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("legacy", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("legacy", "ИмяПакета").Неявная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("implicit_suffix", "ИмяПакета").Неявная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("implicit_without_space", "ИмяПакета").Неявная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("transitive_suffix", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("empty_reason", "ИмяПакета").Неявная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("mentioned", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("word", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("without_space", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("russian_suffix", "ИмяПакета").Транзитивная).ЭтоЛожь();
	Ожидаем.Что(Копия.Найти("separate", "ИмяПакета").Транзитивная).ЭтоЛожь();

КонецПроцедуры

