&Тест
Процедура ТестДолжен_СохранитьПометкуИзМассиваСтруктур() Экспорт

	// Подготовка
	Массив = Новый Массив();
	Массив.Добавить(Новый Структура(
		"ИмяПакета, ДляРазработки, МинимальнаяВерсия, МаксимальнаяВерсия, Транзитивная, Неявная",
		"array", Ложь, "1.0.0", "", Истина, Истина
	));

	// Действие
	ЗависимостиИзМассива = Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(Массив).СкопироватьВТаблицу();
	ЗависимостиИзФиксированногоМассива = Новый ЗависимостиПакета()
		.ЗаполнитьИзТаблицы(Новый ФиксированныйМассив(Массив))
		.СкопироватьВТаблицу();

	// Проверка
	Ожидаем.Что(ЗависимостиИзМассива[0].Транзитивная).ЭтоИстина();
	Ожидаем.Что(ЗависимостиИзМассива[0].Неявная).ЭтоИстина();
	Ожидаем.Что(ЗависимостиИзФиксированногоМассива[0].Транзитивная).ЭтоИстина();
	Ожидаем.Что(ЗависимостиИзФиксированногоМассива[0].Неявная).ЭтоИстина();

КонецПроцедуры

