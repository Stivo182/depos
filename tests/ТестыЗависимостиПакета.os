	Ожидаем.Что(Результат[3].МаксимальнаяВерсия).Равно("");
	Ожидаем.Что(Результат[3].ДляРазработки).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьЗависимостиПоИмениПакета() Экспорт

	// Подготовка
	ТестовыеСлучаи = Новый Соответствие();
	ТестовыеСлучаи.Вставить("autumn", "autumn");
	ТестовыеСлучаи.Вставить("annotations,autumn, asserts", "annotations,autumn,asserts");
	ТестовыеСлучаи.Вставить("annotations autumn  asserts ", "annotations,autumn,asserts");
	ТестовыеСлучаи.Вставить("autumnnn", "");
	ТестовыеСлучаи.Вставить("autu?n", "autumn");
	ТестовыеСлучаи.Вставить("autu?", "");
	ТестовыеСлучаи.Вставить("a?s", "");
	ТестовыеСлучаи.Вставить("autu*", "autumn");
	ТестовыеСлучаи.Вставить("a*s", "annotations,asserts");
	ТестовыеСлучаи.Вставить("/(ass.*|d)/", "asserts,delegate");
	ТестовыеСлучаи.Вставить("a*s, delegate", "annotations,asserts,delegate");

	ТаблицаЗависимостей = Новый ИнформацияОПакете(ПомощникТестирования.ФайлМанифеста).Зависимости();
	
	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл

		Шаблон = ТестовыйСлучай.Ключ;
		ИменаПакетов = СтрРазделить(ТестовыйСлучай.Значение, ",", Ложь);

		Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(ТаблицаЗависимостей);

		// Действие
		Результат = Зависимости.ОставитьПоИмени(Шаблон).СкопироватьВТаблицу();

		// Утверждение
		Ожидаем.Что(Результат, Шаблон).ИмеетДлину(ИменаПакетов.Количество());

		Для Каждого СтрокаРезультата Из Результат Цикл		
			Ожидаем.Что(ИменаПакетов, Шаблон).Содержит(СтрокаРезультата.ИмяПакета);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьОшибкуПриЧтенииОшибочногоМанифеста() Экспорт
		
	// Подготовка
	Зависимости = Новый ЗависимостиПакета();
	
	ПутьКФайлу = "./tests/fixtures/packagedef-syntax-error";
	
	// Действие
	Ошибка = ПолучитьОшибкуЗаполненияЗависимостей(Зависимости, ПутьКФайлу);

	// Проверка
	ПроверитьОшибкуМанифеста(Ошибка, "manifest.parse_failed", ПутьКФайлу);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЗависимостиПриОшибкеВМанифесте() Экспорт

	// Подготовка
	Зависимости = Новый ЗависимостиПакета().Добавить("исходная-зависимость", "1.0.0");
	ПутьКФайлу = "./tests/fixtures/opm-metadata-valid-then-invalid-dependency.xml";

	// Действие
	Ошибка = ПолучитьОшибкуЗаполненияЗависимостей(Зависимости, ПутьКФайлу);
	Результат = Зависимости.СкопироватьВТаблицу();

	// Проверка
	ПроверитьОшибкуМанифеста(Ошибка, "dependency.version_invalid", ПутьКФайлу, "bad-version");
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(Результат[0].ИмяПакета).Равно("исходная-зависимость");
	Ожидаем.Что(Результат[0].МинимальнаяВерсия).Равно("1.0.0");

КонецПроцедуры

Функция ПолучитьОшибкуЗаполненияЗависимостей(Зависимости, ПутьКФайлу)

	Попытка
		Зависимости.ЗаполнитьИзМанифеста(ПутьКФайлу);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьОшибкуМанифеста(Ошибка, КодОшибки, ПутьКФайлу, ИмяПакета = Неопределено)

	Ожидаем.Что(Ошибка).Заполнено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодОшибки);

	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, КодОшибки);
	ДанныеОшибки = КадрОшибки.Данные();
	Ожидаем.Что(ДанныеОшибки.ПутьКФайлу).Равно(ПутьКФайлу);

	Если ИмяПакета <> Неопределено Тогда
		Ожидаем.Что(ДанныеОшибки.ИмяПакета).Равно(ИмяПакета);
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьЗависимостиПоИмениПакета() Экспорт

	// Подготовка
	ТестовыеСлучаи = Новый Соответствие();
	ТестовыеСлучаи.Вставить("autumn", "delegate,annotations,asserts,packageinfo,1testrunner,semver");
	ТестовыеСлучаи.Вставить("annotations, autumn, asserts", "delegate,packageinfo,1testrunner,semver");
	ТестовыеСлучаи.Вставить("a*s", "delegate,packageinfo,autumn,1testrunner,semver");
	ТестовыеСлучаи.Вставить("/(ass.*|d)/", "annotations,packageinfo,autumn,1testrunner,semver");

	ТаблицаЗависимостей = Новый ИнформацияОПакете(ПомощникТестирования.ФайлМанифеста).Зависимости();

	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл

		Шаблон = ТестовыйСлучай.Ключ;
		ИменаПакетов = СтрРазделить(ТестовыйСлучай.Значение, ",", Ложь);

		Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(ТаблицаЗависимостей);

		// Действие
		Результат = Зависимости.УдалитьПоИмени(Шаблон).СкопироватьВТаблицу();

		// Утверждение
		Ожидаем.Что(Результат, Шаблон).ИмеетДлину(ИменаПакетов.Количество());

		Для Каждого СтрокаРезультата Из Результат Цикл
			Ожидаем.Что(ИменаПакетов, Шаблон).Содержит(СтрокаРезультата.ИмяПакета);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры
