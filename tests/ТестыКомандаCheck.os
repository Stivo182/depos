// BSLLS:LineLength-off
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать "helpers"
#Использовать logos

Перем _Поделка; // Поделка
Перем _ПотокВывода; // ПотокВПамяти
Перем _ТекущийКаталог; // Строка
Перем _Лог; // Лог
Перем _СообщенияОтладочногоЛога; // Массив

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт
	_ТекущийКаталог = ТекущийКаталог();
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_Лог = Неопределено;
	_СообщенияОтладочногоЛога = Новый Массив();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	Если _Лог <> Неопределено Тогда
		_Лог.УдалитьСпособВывода(ЭтотОбъект);
		Логирование.ЗакрытьЛог(_Лог);
		_Лог = Неопределено;
	КонецЕсли;

	ПомощникТестирования.УдалитьВременныеФайлы();
	УстановитьТекущийКаталог(_ТекущийКаталог);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьВерсиюOneScriptИзМанифеста() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();
	Приложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	Параметры = Новый Массив;
	Параметры.Добавить("check");
	Параметры.Добавить("--manifest");
	Параметры.Добавить("./tests/fixtures/packagedef-no-deps");
	Параметры.Добавить("-e");
	Параметры.Добавить("auto");

	// Действие
	Приложение.Запустить(Параметры);

	// Проверка
	Вывод = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	Ожидаем.Что(Вывод).Содержит(
		"Проверка зависимостей: ./tests/fixtures/packagedef-no-deps | OneScript: 1.9.3");
	Ожидаем.Что(Вывод).Не_().Содержит("OneScript: 1.9.3 (packagedef)");

КонецПроцедуры

