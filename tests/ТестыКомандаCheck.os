&Тест
Процедура ТестДолжен_ПолучитьОшибкуНеНайденФайлМанифестаВТекущемКаталоге() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйПользовательскийВывод = "manifest.not_found: В каталоге";

	УстановитьТекущийКаталог("./tests");

	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");
	ПодключитьСборОтладочногоЛога();

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("check");

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	ТекстДиагностики = СтрСоединить(_СообщенияОтладочногоЛога, Символы.ПС);

	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйПользовательскийВывод);
	Ожидаем.Что(ТекстВывода)
		.Содержит("Убедитесь, что указан каталог, содержащий packagedef или opm-metadata.xml.");
	Ожидаем.Что(ТекстДиагностики).Содержит("Место:");

КонецПроцедуры

Процедура ПодключитьСборОтладочногоЛога()
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos.КомандаCheck");
	_Лог.ДобавитьСпособВывода(ЭтотОбъект, УровниЛога.Отладка);
КонецПроцедуры

// Сохраняет отладочное сообщение временного appender'а.
//
// Параметры:
//   Сообщение - Строка - Форматированное сообщение.
//   УровеньСообщения - Число - Уровень сообщения logos.
Процедура Вывести(Сообщение, УровеньСообщения) Экспорт
	Если УровеньСообщения = УровниЛога.Отладка Тогда
		_СообщенияОтладочногоЛога.Добавить(Сообщение);
	КонецЕсли;
КонецПроцедуры

// Завершает работу временного appender'а.
Процедура Закрыть() Экспорт
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиИзмененияЗависимостейВJson() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	УстановитьТекущийКаталог("./tests/fixtures");

	ФайлВывода = ПомощникТестирования.СоздатьВременныйФайл("txt");

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("check");
	ПараметрыКоманды.Добавить("--format");
	ПараметрыКоманды.Добавить("json");
	ПараметрыКоманды.Добавить("--output");
	ПараметрыКоманды.Добавить(ФайлВывода);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Утверждение
	Ожидаем.Что(ФС.ФайлСуществует(ФайлВывода)).ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ФайлВывода, "UTF-8");
	СтрокаJson = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Десериализатор = Новый ДесериализаторJson();
	ПроверяемыйОбъект = Десериализатор.Десериализовать(СтрокаJson);

	Ожидаем.Что(ПроверяемыйОбъект).ИмеетТип("Массив");
	Ожидаем.Что(ПроверяемыйОбъект).ИмеетДлину(7);

	Ожидаем.Что(ПроверяемыйОбъект[0].packageName, "[0].packageName").Равно("annotations");
	Ожидаем.Что(ПроверяемыйОбъект[0].isDev, "[0].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[0].currentMinVersion, "[0].currentMinVersion").Равно("1.3.0");
	Ожидаем.Что(ПроверяемыйОбъект[0].targetMinVersion, "[0].targetMinVersion").Равно("1.3.1");
	Ожидаем.Что(ПроверяемыйОбъект[0].maxVersion, "[0].maxVersion").Равно("");

	Ожидаем.Что(ПроверяемыйОбъект[1].packageName, "[1].packageName").Равно("asserts");
	Ожидаем.Что(ПроверяемыйОбъект[1].isDev, "[1].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[1].currentMinVersion, "[1].currentMinVersion").Равно("");
	Ожидаем.Что(ПроверяемыйОбъект[1].targetMinVersion, "[1].targetMinVersion").Равно("1.5.0");
	Ожидаем.Что(ПроверяемыйОбъект[1].maxVersion, "[1].maxVersion").Равно("");

	Ожидаем.Что(ПроверяемыйОбъект[2].packageName, "[2].packageName").Равно("autumn");
	Ожидаем.Что(ПроверяемыйОбъект[2].isDev, "[2].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[2].currentMinVersion, "[2].currentMinVersion").Равно("3.2.0");
	Ожидаем.Что(ПроверяемыйОбъект[2].targetMinVersion, "[2].targetMinVersion").Равно("3.2.0");
	Ожидаем.Что(ПроверяемыйОбъект[2].maxVersion, "[2].maxVersion").Равно("4.4.1");

	Ожидаем.Что(ПроверяемыйОбъект[3].packageName, "[3].packageName").Равно("delegate");
	Ожидаем.Что(ПроверяемыйОбъект[3].isDev, "[3].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[3].currentMinVersion, "[3].currentMinVersion").Равно("1.0.0");
	Ожидаем.Что(ПроверяемыйОбъект[3].targetMinVersion, "[3].targetMinVersion").Равно("1.0.0");
	Ожидаем.Что(ПроверяемыйОбъект[3].maxVersion, "[3].maxVersion").Равно("");

	Ожидаем.Что(ПроверяемыйОбъект[4].packageName, "[4].packageName").Равно("packageinfo");
	Ожидаем.Что(ПроверяемыйОбъект[4].isDev, "[4].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[4].currentMinVersion, "[4].currentMinVersion").Равно("0.7");
	Ожидаем.Что(ПроверяемыйОбъект[4].targetMinVersion, "[4].targetMinVersion").Равно("1.0.0");
	Ожидаем.Что(ПроверяемыйОбъект[4].maxVersion, "[4].maxVersion").Равно("");

	Ожидаем.Что(ПроверяемыйОбъект[5].packageName, "[5].packageName").Равно("semver");
	Ожидаем.Что(ПроверяемыйОбъект[5].isDev, "[5].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[5].currentMinVersion, "[5].currentMinVersion").Равно("1.0.0");
	Ожидаем.Что(ПроверяемыйОбъект[5].targetMinVersion, "[5].targetMinVersion").Равно("1.0.0");
	Ожидаем.Что(ПроверяемыйОбъект[5].maxVersion, "[5].maxVersion").Равно("1.1.0");

	Ожидаем.Что(ПроверяемыйОбъект[6].packageName, "[6].packageName").Равно("1testrunner");
	Ожидаем.Что(ПроверяемыйОбъект[6].isDev, "[6].isDev").Равно(Истина);
	Ожидаем.Что(ПроверяемыйОбъект[6].currentMinVersion, "[6].currentMinVersion").Равно("1.8.0");
	Ожидаем.Что(ПроверяемыйОбъект[6].targetMinVersion, "[6].targetMinVersion").Равно("1.9.2");
	Ожидаем.Что(ПроверяемыйОбъект[6].maxVersion, "[6].maxVersion").Равно("");

