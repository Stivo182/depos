&ПараметризованныйТест
&ИсточникЗначение("bogus")
&ИсточникЗначение("Последняя")
&ИсточникЗначение("LATEST")
&ИсточникЗначение(" latest ")
Процедура ТестДолжен_СообщитьОНекорректномТипеЦелевойВерсии(НекорректныйТипВерсии) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("check");
	ПараметрыКоманды.Добавить("--target");
	ПараметрыКоманды.Добавить(НекорректныйТипВерсии);
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить("./tests/nonexistent");

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	Ожидаем.Что(ТекстВывода).Содержит("target.invalid");
	Ожидаем.Что(ТекстВывода).Содержит(НекорректныйТипВерсии);
	Ожидаем.Что(ТекстВывода).Содержит("latest, minor, patch");
	Ожидаем.Что(ТекстВывода).Не_().Содержит("manifest.not_found");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://registry.cli/", "")
&ИсточникЗначение("https://registry.cli/private", "private")
Процедура ТестДолжен_ПрименитьНастройкиРеестраИзКоманднойСтроки(АдресРеестра, ОжидаемыйПул) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = ПараметрыКомандыСНастройкамиРеестра("check", АдресРеестра);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	ПроверитьНастройкиРеестра(
		_Поделка.НайтиЖелудь("НастройкиРеестраПакетов"),
		АдресРеестра,
		ОжидаемыйПул
	);

КонецПроцедуры

Функция ПараметрыКомандыСНастройкамиРеестра(ИмяКоманды, АдресРеестра)

	Параметры = Новый Массив();
	Параметры.Добавить(ИмяКоманды);
	Параметры.Добавить("--manifest");
	Параметры.Добавить("./tests/fixtures/packagedef-no-deps");
	Параметры.Добавить("--registry");
	Параметры.Добавить(АдресРеестра);
	Параметры.Добавить("--registry-proxy");
	Параметры.Добавить("http://proxy.cli:8080/");

	Возврат Параметры;

КонецФункции

Процедура ПроверитьНастройкиРеестра(Настройки, АдресРеестра, ОжидаемыйПул)

	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно(АдресРеестра);
	Ожидаем.Что(Настройки.Серверы()[0].Пул).Равно(ОжидаемыйПул);
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.cli:8080/");

КонецПроцедуры
