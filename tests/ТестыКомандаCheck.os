&Тест
Процедура ТестДолжен_НеСчитатьЗависимостиАктуальнымиБезПодтвержденияСовместимости() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();
	Приложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");
	Параметры = Новый Массив;
	Параметры.Добавить("check");
	Параметры.Добавить("--manifest");
	Параметры.Добавить("./tests/fixtures/packagedef-incompatible");
	Параметры.Добавить("--engine");
	Параметры.Добавить("2.1.0");

	// Действие
	Приложение.Запустить(Параметры);
	Вывод = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);

	// Проверка
	Ожидаем.Что(Вывод).Содержит("incompatible");
	Ожидаем.Что(Вывод).Содержит("1.0.0 → нет подходящей версии");
	Ожидаем.Что(Вывод).Содержит("Нет доступных обновлений; совместимость некоторых зависимостей не подтверждена.");
	Ожидаем.Что(Вывод).Не_().Содержит("Все зависимости актуальны!");

КонецПроцедуры

