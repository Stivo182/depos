// BSLLS:MagicNumber-off

#Использовать url
#Использовать "helpers"
#Использовать moskito
#Использовать logos

#Область ОписаниеПеременных

Перем _Настройки; // МокОбъект
Перем _Клиент; // КлиентРеестраПакетов
Перем _Транспорт; // ФейкТранспортРеестраПакетов
Перем _ОсновнойРеестр; // Строка
Перем _Прокси; // Строка, Неопределено
Перем _Лог; // Лог
Перем _Предупреждения; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ИнициализироватьНабор() Экспорт

	_ОсновнойРеестр = "https://hub.oscript.io";

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьТест() Экспорт

	_Транспорт = Новый ФейкТранспортРеестраПакетов;
	УстановитьНастройки(_ОсновнойРеестр);
	_Предупреждения = Новый Массив;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");
	_Лог.ДобавитьСпособВывода(ЭтотОбъект, УровниЛога.Предупреждение);

КонецПроцедуры

&ПослеКаждого
Процедура ОчиститьТест() Экспорт

	_Лог.УдалитьСпособВывода(ЭтотОбъект);
	Логирование.ЗакрытьЛог(_Лог);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СобратьКлиентЧерезКонтейнер() Экспорт

	// Подготовка
	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	// Действие
	Клиент = ПомощникТестирования.ПолучитьОригинальныйЖелудь(Поделка, "КлиентРеестраПакетов");

	// Проверка
	Ожидаем.Что(ТипЗнч(Клиент)).Равно(Тип("КлиентРеестраПакетов"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредупредитьОНенайденномПакете() Экспорт

	// Подготовка
	СтраницаНенайденногоПакета = "<html><h1></h1><a href=""/download//-.ospx"">-</a></html>";
	НастроитьОтвет(_ОсновнойРеестр, 200, СтраницаНенайденногоПакета, "missing");

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("missing");

	// Проверка
	Ожидаем.Что(ВерсииПакета).ИмеетДлину(0);
	Ожидаем.Что(_Предупреждения).ИмеетДлину(1);
	Ожидаем.Что(_Предупреждения[0]).Содержит("Пакет 'missing' не найден");
	Ожидаем.Что(_Предупреждения[0]).Содержит("https://hub.oscript.io");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьВерсииБезСетевогоЗапроса() Экспорт

	// Подготовка
	НастроитьОтвет(_ОсновнойРеестр, 200, СтраницаСВерсиями("4.3.11", "4.0.0"));

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("autumn");

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("4.3.11");
	Ожидаем.Что(ВерсииПакета).Содержит("4.0.0");
	ПроверитьВызов(_ОсновнойРеестр);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьВерсииOpenHubПоТомуЖеАдресуРеестра() Экспорт

	// Подготовка
	НастроитьОтветыOpenHub(_ОсновнойРеестр);

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("autumn");

	// Проверка
	Ожидаем.Что(ВерсииПакета.Количество()).Равно(1);
	Ожидаем.Что(ВерсииПакета[0]).Равно("1.0.0");
	Ожидаем.Что(_Транспорт.Адреса()[0].ВСтроку())
		.Равно("https://hub.oscript.io/api/v1/openapi.json");
	Ожидаем.Что(_Транспорт.Адреса()[1].ВСтроку())
		.Равно("https://hub.oscript.io/api/v1/pools?page=1&pageSize=100");
	Ожидаем.Что(_Транспорт.Адреса()[2].ВСтроку())
		.Равно("https://hub.oscript.io/api/v1/pools/public/packages/autumn/versions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьВерсииИзПулаУказанногоВАдресеOpenHub() Экспорт

	// Подготовка
	УстановитьСерверы(СерверыНастроек("https://hub.example.com/private", "private"));
	_Транспорт.НастроитьОтвет(
		АдресDiscovery("https://hub.example.com/private"), 404, ""
	);
	_Транспорт.НастроитьОтвет(
		АдресDiscovery("https://hub.example.com"), 200, "{""info"":{""title"":""OpenHub API v1""}}"
	);
	_Транспорт.НастроитьОтвет(
		АдресВерсий("https://hub.example.com", "private"),
		200,
		"{""versions"":[{""version"":""2.0.0"",""yanked"":false}]}"
	);

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("autumn");

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("2.0.0");
	Ожидаем.Что(_Транспорт.Адреса()[0].ВСтроку())
		.Равно("https://hub.example.com/private/api/v1/openapi.json");
	Ожидаем.Что(_Транспорт.Адреса()[1].ВСтроку()).Равно("https://hub.example.com/api/v1/openapi.json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьДанныеПользователяДляПулаИзАдресаOpenHub() Экспорт

	// Подготовка
	АдресРеестра = "https://user:secret@hub.example.com/private";
	КорневойАдрес = "https://user:secret@hub.example.com";
