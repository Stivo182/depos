Процедура ТестДолжен_НеПередаватьТехническуюПричинуТранспортнойОшибки() Экспорт

	// Подготовка
	УстановитьНастройки(
		"https://primary.example",
		"http://user:p%40ss%3Aword@proxy.example:8080"
	);
	ТекстИсключения = "{Модуль ЗапросHTTP.os / Ошибка в строке: 321 / пароль p@ss:word}";
	НастроитьИсключение("https://primary.example", ТекстИсключения);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий();

	// Проверка
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("ЗапросHTTP.os");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("p@ss:word");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сохраняет предупреждение временного способа вывода лога.
//
// Параметры:
//   Сообщение         - Строка - Форматированное сообщение.
//   УровеньСообщения  - Число - Уровень сообщения logos.
Процедура Вывести(Сообщение, УровеньСообщения) Экспорт

	Если УровеньСообщения = УровниЛога.Предупреждение Тогда
		_Предупреждения.Добавить(Сообщение);
	КонецЕсли;

КонецПроцедуры

// Завершает работу временного способа вывода лога.
Процедура Закрыть() Экспорт
КонецПроцедуры

Процедура УстановитьНастройки(ОсновнойРеестр, Прокси = Неопределено)

	НастройкиПрокси = ?(Прокси = Неопределено, Неопределено, Новый URL(Прокси));
	СоздатьКлиент(СерверыНастроек(ОсновнойРеестр), НастройкиПрокси);

КонецПроцедуры

Процедура УстановитьСерверы(Серверы)

	СоздатьКлиент(Серверы);

КонецПроцедуры

Процедура СоздатьКлиент(Серверы, Прокси = Неопределено)

	_Прокси = Прокси;
	Реестр = ?(Серверы.Количество() = 0, Неопределено, Серверы[0].Реестр);

	_Настройки = Мок.Получить(Тип("НастройкиРеестраПакетов"));
	_Настройки.Когда().Реестр().ТогдаВозвращает(Реестр);
	_Настройки.Когда().Прокси().ТогдаВозвращает(_Прокси);
	_Настройки.Когда().Серверы().ТогдаВозвращает(Серверы);

	Старый = Новый АдаптерСтарогоХаба(_Транспорт);
	OpenHub = Новый АдаптерOpenHub(_Транспорт);
	Определитель = Новый ОпределительАдаптераРеестра(_Транспорт, Старый, OpenHub);
	_Клиент = Новый КлиентРеестраПакетов(_Настройки, Определитель);

КонецПроцедуры

Функция СерверыНастроек(Адрес, Пул = "", Заголовки = Неопределено)

	Результат = Новый Массив;
	Если ЗначениеЗаполнено(Адрес) Тогда
		Результат.Добавить(НастройкаСервера(Адрес, Пул, Заголовки));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция НастройкаСервера(Адрес, Пул = "", Заголовки = Неопределено)

	Если Заголовки = Неопределено Тогда
		Заголовки = Новый Соответствие;
	КонецЕсли;

	Возврат Новый Структура("Реестр,Пул,Заголовки", Новый URL(Адрес), Пул, Заголовки);

КонецФункции

Процедура НастроитьОтвет(Хост, КодСостояния, Тело, ИмяПакета = "autumn")

	НастроитьDiscoveryСтарогоХаба(Хост);
	_Транспорт.НастроитьОтвет(АдресПакета(Хост, ИмяПакета), КодСостояния, Тело);

КонецПроцедуры

Процедура НастроитьИсключение(Хост, ОписаниеОшибки)

	НастроитьDiscoveryСтарогоХаба(Хост);
	_Транспорт.НастроитьИсключение(АдресПакета(Хост), ОписаниеОшибки);

КонецПроцедуры

Процедура ПроверитьВызов(Хост)

	АдресОжидается = АдресПакета(Хост).ВСтроку();
	Вызван = Ложь;

	Для Каждого Адрес Из _Транспорт.Адреса() Цикл
		Если Адрес.ВСтроку() = АдресОжидается Тогда
			Вызван = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Вызван).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьПроксиВызова(ОжидаемыйПрокси)

	Для Каждого Прокси Из _Транспорт.Прокси() Цикл
		Ожидаем.Что(Прокси.ВСтроку()).Равно(ОжидаемыйПрокси);
	КонецЦикла;

КонецПроцедуры

Процедура НастроитьDiscoveryСтарогоХаба(Хост)

	_Транспорт.НастроитьОтвет(АдресDiscovery(Хост), 404, "");

КонецПроцедуры

Процедура НастроитьОтветыOpenHub(Хост)

	Пулы = "{""items"":[{""name"":""public"",""visibility"":""public"",""default"":true}],"
		+ """page"":1,""pageSize"":100,""total"":1}";
	ОтветСВерсиями = "{""versions"":[{""version"":""1.0.0"",""yanked"":false}]}";
	_Транспорт.НастроитьОтвет(
		АдресDiscovery(Хост), 200, "{""info"":{""title"":""OpenHub API v1""}}"
	);
	_Транспорт.НастроитьОтвет(АдресПулов(Хост), 200, Пулы);
	_Транспорт.НастроитьОтвет(АдресВерсий(Хост), 200, ОтветСВерсиями);

КонецПроцедуры

Функция АдресПакета(Хост, ИмяПакета = "autumn")

	Адрес = Новый URL(Хост);
	Адрес.ДобавитьСегментПути("package");
	Адрес.ДобавитьСегментПути(ИмяПакета);

	Возврат Адрес;

КонецФункции

Функция АдресDiscovery(Хост)

	Адрес = Новый URL(Хост);
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("openapi.json");

	Возврат Адрес;

КонецФункции

Функция АдресПулов(Хост)

	Адрес = Новый URL(Хост);
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	ПараметрыЗапроса = Новый ПараметрыЗапросаURL;
	ПараметрыЗапроса.Добавить("page", "1");
	ПараметрыЗапроса.Добавить("pageSize", "100");
	Адрес.УстановитьПараметрыЗапроса(ПараметрыЗапроса);

	Возврат Адрес;

КонецФункции

Функция АдресВерсий(Хост, ИмяПула = "public")

	Адрес = Новый URL(Хост);
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	Адрес.ДобавитьСегментПути(ИмяПула);
	Адрес.ДобавитьСегментПути("packages");
	Адрес.ДобавитьСегментПути("autumn");
	Адрес.ДобавитьСегментПути("versions");

	Возврат Адрес;

КонецФункции

Функция СтраницаСВерсиями(Версия1, Версия2 = "")

	Ссылки = СтрШаблон("<a href=""/download/autumn/autumn-%1.ospx"">%1</a>", Версия1);
	Если ЗначениеЗаполнено(Версия2) Тогда
		Ссылки = Ссылки + СтрШаблон("<a href=""/download/autumn/autumn-%1.ospx"">%1</a>", Версия2);
	КонецЕсли;

	Возврат "<html>" + Ссылки + "</html>";

КонецФункции

Функция ПолучитьОшибкуПолученияВерсий()

	Попытка
		_Клиент.ПолучитьВерсии("autumn");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
