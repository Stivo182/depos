&Тест
Процедура ТестДолжен_ПолучитьВерсииИзПриватногоПулаСТокеном() Экспорт

	// Подготовка
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer secret-token");
	УстановитьСерверы(СерверыНастроек("https://hub.example.com", "private", Заголовки));
	_Транспорт.НастроитьОтвет(
		АдресDiscovery("https://hub.example.com"), 200, "{""info"":{""title"":""OpenHub API v1""}}"
	);
	_Транспорт.НастроитьОтвет(
		АдресВерсий("https://hub.example.com", "private"),
		200,
		"{""versions"":[{""version"":""2.0.0"",""yanked"":false}]}"
	);

	// Действие
