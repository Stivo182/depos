	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("2.0.0");
	Ожидаем.Что(_Транспорт.Адреса()).ИмеетДлину(2);
	Для Каждого ЗаголовкиЗапроса Из _Транспорт.Заголовки() Цикл
		Ожидаем.Что(ЗаголовкиЗапроса.Получить("Authorization")).Равно("Bearer secret-token");
	КонецЦикла;

