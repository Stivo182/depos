// BSLLS:MagicNumber-off

#Использовать url
#Использовать "helpers"
#Использовать moskito

#Область ОписаниеПеременных

Перем _Настройки; // МокОбъект
Перем _Клиент; // КлиентРеестраПакетов
Перем _Транспорт; // ФейкТранспортРеестраПакетов
Перем _ОсновнойРеестр; // Строка
Перем _Прокси; // Строка, Неопределено

#КонецОбласти

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ИнициализироватьНабор() Экспорт

	_ОсновнойРеестр = "https://hub.oscript.io";

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьТест() Экспорт

	_Транспорт = Новый ФейкТранспортРеестраПакетов;
	УстановитьНастройки(_ОсновнойРеестр);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПолучитьВерсииБезСетевогоЗапроса() Экспорт

	// Подготовка
	НастроитьОтвет(_ОсновнойРеестр, 200, СтраницаСВерсиями("4.3.11", "4.0.0"));

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("autumn");

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("4.3.11");
	Ожидаем.Что(ВерсииПакета).Содержит("4.0.0");
	ПроверитьВызов(_ОсновнойРеестр);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПроксиТранспорту() Экспорт

	// Подготовка
	УстановитьНастройки(_ОсновнойРеестр, "http://proxy.example:8080");
	НастроитьОтвет(_ОсновнойРеестр, 200, СтраницаСВерсиями("1.0.0"));

	// Действие
	_Клиент.ПолучитьВерсии("autumn");

	// Проверка
	ПроверитьВызов(_ОсновнойРеестр);
	ПроверитьПроксиВызова("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьБазовыйПутьРеестраВАдресеПакета() Экспорт

	// Подготовка
	ОсновнойРеестр = "https://registry.example/api";
	УстановитьНастройки(ОсновнойРеестр);
	НастроитьОтвет(ОсновнойРеестр, 200, СтраницаСВерсиями("1.0.0"));

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("autumn");

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("1.0.0");
	ПроверитьВызов(ОсновнойРеестр);
	Ожидаем.Что(_Транспорт.Адреса()[0].ВСтроку()).Равно("https://registry.example/api/package/autumn");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНезаданныхХостахРеестра() Экспорт

	// Подготовка
	УстановитьНастройки("");

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий();

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.hosts_not_configured");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьПричинуНедоступностиРеестра() Экспорт

	// Подготовка
	УстановитьНастройки("https://primary.example");
	НастроитьИсключение("https://primary.example", "соединение разорвано");

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий();

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("primary.example");
	Ожидаем.Что(ПредставлениеОшибки).Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("соединение разорвано");
	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, "registry.unavailable");
	Ожидаем.Что(КадрОшибки.Данные()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПередаватьТехническуюПричинуТранспортнойОшибки() Экспорт

	// Подготовка
	УстановитьНастройки(
		"https://primary.example",
		"http://user:p%40ss%3Aword@proxy.example:8080"
	);
	ТекстИсключения = "{Модуль ЗапросHTTP.os / Ошибка в строке: 321 / пароль p@ss:word}";
	НастроитьИсключение("https://primary.example", ТекстИсключения);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий();

	// Проверка
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("ЗапросHTTP.os");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("p@ss:word");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьНастройки(ОсновнойРеестр, Прокси = Неопределено)

	Реестр = ?(ЗначениеЗаполнено(ОсновнойРеестр), Новый URL(ОсновнойРеестр), Неопределено);

	Если Прокси = Неопределено Тогда
		_Прокси = Неопределено;
	Иначе
		_Прокси = Новый URL(Прокси);
	КонецЕсли;

	_Настройки = Мок.Получить(Тип("НастройкиРеестраПакетов"));
	_Настройки.Когда().Реестр().ТогдаВозвращает(Реестр);
	_Настройки.Когда().Прокси().ТогдаВозвращает(_Прокси);

	_Клиент = Новый КлиентРеестраПакетов(_Настройки, Новый ПарсерСтраницыПакета(), _Транспорт);

КонецПроцедуры

Процедура НастроитьОтвет(Хост, КодСостояния, Тело)

	_Транспорт.НастроитьОтвет(АдресПакета(Хост), КодСостояния, Тело);

КонецПроцедуры

Процедура НастроитьИсключение(Хост, ОписаниеОшибки)

	_Транспорт.НастроитьИсключение(АдресПакета(Хост), ОписаниеОшибки);

КонецПроцедуры

Процедура ПроверитьВызов(Хост)

	АдресОжидается = АдресПакета(Хост).ВСтроку();
	Вызван = Ложь;

	Для Каждого Адрес Из _Транспорт.Адреса() Цикл
		Если Адрес.ВСтроку() = АдресОжидается Тогда
			Вызван = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Вызван).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьПроксиВызова(ОжидаемыйПрокси)

	Прокси = _Транспорт.Прокси()[0];
	Ожидаем.Что(Прокси.ВСтроку()).Равно(ОжидаемыйПрокси);

КонецПроцедуры

Функция АдресПакета(Хост)

	Адрес = Новый URL(Хост);
	Адрес.ДобавитьСегментПути("package");
	Адрес.ДобавитьСегментПути("autumn");

	Возврат Адрес;

КонецФункции

Функция СтраницаСВерсиями(Версия1, Версия2 = "")

	Ссылки = СтрШаблон("<a href=""/download/autumn/autumn-%1.ospx"">%1</a>", Версия1);
	Если ЗначениеЗаполнено(Версия2) Тогда
		Ссылки = Ссылки + СтрШаблон("<a href=""/download/autumn/autumn-%1.ospx"">%1</a>", Версия2);
	КонецЕсли;

	Возврат "<html>" + Ссылки + "</html>";

КонецФункции

Функция ПолучитьОшибкуПолученияВерсий()

	Попытка
		_Клиент.ПолучитьВерсии("autumn");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
