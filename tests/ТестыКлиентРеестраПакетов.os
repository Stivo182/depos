	_Транспорт.НастроитьОтвет(АдресDiscovery(АдресРеестра), 404, "");
	_Транспорт.НастроитьОтвет(
		АдресDiscovery(КорневойАдрес), 200, "{""info"":{""title"":""OpenHub API v1""}}"
	);
	_Транспорт.НастроитьОтвет(
		АдресВерсий(КорневойАдрес, "private"),
		200,
		"{""versions"":[{""version"":""2.0.0"",""yanked"":false}]}"
	);

	// Действие
	ВерсииПакета = _Клиент.ПолучитьВерсии("autumn");

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("2.0.0");
	Ожидаем.Что(_Транспорт.Адреса()[1].ВСтроку())
		.Равно("https://user:secret@hub.example.com/api/v1/openapi.json");
	Ожидаем.Что(_Транспорт.Адреса()[2].ВСтроку())
		.Равно("https://user:secret@hub.example.com/api/v1/pools/private/packages/autumn/versions");

