Процедура ТестДолжен_ПрочитатьИмяПакетаИзOpmMetadata(ИмяКаталога, ОжидаемоеИмяПакета) Экспорт

	// Подготовка
	ПутьКФайлу = ОбъединитьПути(
		"./tests/fixtures/lib_sets/lib4",
		ИмяКаталога,
		"opm-metadata.xml"
	);

	// Действие
	ИмяПакета = Новый ПарсерOpmMetadata().ПрочитатьИмяПакета(ПутьКФайлу);

	// Проверка
	Ожидаем.Что(ИмяПакета).Равно(ОжидаемоеИмяПакета);

КонецПроцедуры

