	Ожидаем.Что(Результат[0].ИмяПакета).Равно("errors");
	Ожидаем.Что(Результат[0].МинимальнаяВерсия).Равно("0.1.0");
	Ожидаем.Что(Результат[0].МаксимальнаяВерсия).Равно("");
	Ожидаем.Что(Результат[0].ДляРазработки).ЭтоЛожь();

