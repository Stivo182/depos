	Ожидаем.Что(Результат[0].ИмяПакета).Равно("shared");
	Ожидаем.Что(Результат[0].МинимальнаяВерсия).Равно("2.0.0");
	Ожидаем.Что(Результат[0].МаксимальнаяВерсия).Равно("");
	Ожидаем.Что(Результат[0].ДляРазработки).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуЧтенияИмени(ПутьКФайлу)

	Попытка
		ИмяПакета = Новый ПарсерOpmMetadata().ПрочитатьИмяПакета(ПутьКФайлу);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуРазбора(ПутьКФайлу)

	Попытка
		Результат = Новый ПарсерOpmMetadata().РазобратьЗависимости(ПутьКФайлу);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьОшибкуМанифеста(Ошибка, КодОшибки, ПутьКФайлу, ИмяПакета = Неопределено)

	Ожидаем.Что(Ошибка).Заполнено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодОшибки);

	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, КодОшибки);
	ДанныеОшибки = КадрОшибки.Данные();
	Ожидаем.Что(ДанныеОшибки.ПутьКФайлу).Равно(ПутьКФайлу);

	Если ИмяПакета <> Неопределено Тогда
		Ожидаем.Что(ДанныеОшибки.ИмяПакета).Равно(ИмяПакета);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
