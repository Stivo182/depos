#Область ОписаниеПеременных

Перем _КоличествоВызовов; // Число
Перем _КоличествоМетаданныхВКэше; // Число

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_КоличествоВызовов = 0;
	_КоличествоМетаданныхВКэше = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает признак исключения зависимостей для разработки.
Функция ИсключатьДляРазработки(Исключить = Истина) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет фильтр исключаемых пакетов.
Функция ИсключитьПоИмени(Фильтр) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Регистрирует анализ транзитивных зависимостей.
//
// Параметры:
//   Зависимости - ЗависимостиПакета - Прямые зависимости проекта.
//   УстановленныеПакеты - Соответствие - Имена и каталоги пакетов.
//   КэшМетаданных - Соответствие, Неопределено - Метаданные пакетов.
//
// Возвращаемое значение:
//   Массив - Пустой список конфликтов.
Функция Проверить(Зависимости, УстановленныеПакеты, КэшМетаданных = Неопределено) Экспорт

	Если КэшМетаданных = Неопределено Тогда
		КэшМетаданных = Новый Соответствие();
	КонецЕсли;

	ПоврежденныеПакеты = Новый ТаблицаЗначений();
	ПоврежденныеПакеты.Колонки.Добавить("ИмяПакета");
	РезультатСканирования = Новый РезультатСканированияУстановленныхПакетов(
		УстановленныеПакеты,
		ПоврежденныеПакеты,
		КэшМетаданных
	);

	Возврат Проанализировать(Зависимости, РезультатСканирования).Конфликты;

КонецФункции

// Регистрирует анализ и возвращает все связанные результаты.
//
// Параметры:
//   Зависимости - ЗависимостиПакета - Прямые зависимости проекта.
//   РезультатСканирования - РезультатСканированияУстановленныхПакетов - Найденные пакеты.
//
// Возвращаемое значение:
//   РезультатТранзитивногоАнализа - Пустые конфликты и требования.
Функция Проанализировать(Зависимости, РезультатСканирования) Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;
	_КоличествоМетаданныхВКэше = РезультатСканирования.МетаданныеПакетов.Количество();

	Возврат Новый РезультатТранзитивногоАнализа(Новый Массив(), Новый Массив());

КонецФункции

// Возвращает пустые требования версий для тестового анализа.
//
// Возвращаемое значение:
//   Массив из ТребованиеЗависимости - Пустой список требований.
Функция ПолучитьТребования() Экспорт
	Возврат Новый АнализаторТранзитивныхЗависимостей().ПолучитьТребования();
КонецФункции

// Возвращает количество запусков анализа.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

// Возвращает количество метаданных в переданном кэше.
Функция КоличествоМетаданныхВКэше() Экспорт
	Возврат _КоличествоМетаданныхВКэше;
КонецФункции

#КонецОбласти
