#Область ОписаниеПеременных

Перем _КоличествоВызовов; // Число
Перем _КоличествоМетаданныхВКэше; // Число

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_КоличествоВызовов = 0;
	_КоличествоМетаданныхВКэше = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает признак исключения зависимостей для разработки.
Функция ИсключатьДляРазработки(Исключить = Истина) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет фильтр исключаемых пакетов.
Функция ИсключитьПоИмени(Фильтр) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Регистрирует анализ транзитивных зависимостей.
//
// Возвращаемое значение:
//   Массив - Пустой список конфликтов.
Функция Проверить(Зависимости, УстановленныеПакеты, КэшМетаданных = Неопределено) Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;

	Если КэшМетаданных <> Неопределено Тогда
		_КоличествоМетаданныхВКэше = КэшМетаданных.Количество();
	КонецЕсли;

	Возврат Новый Массив();

КонецФункции

// Возвращает пустые требования версий для тестового анализа.
//
// Возвращаемое значение:
//   Массив из ТребованиеЗависимости - Пустой список требований.
Функция ПолучитьТребования() Экспорт
	Возврат Новый АнализаторТранзитивныхЗависимостей().ПолучитьТребования();
КонецФункции

// Возвращает количество запусков анализа.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

// Возвращает количество метаданных в переданном кэше.
Функция КоличествоМетаданныхВКэше() Экспорт
	Возврат _КоличествоМетаданныхВКэше;
КонецФункции

#КонецОбласти
