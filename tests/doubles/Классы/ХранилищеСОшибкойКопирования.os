#Область ОписаниеПеременных

Перем _ИсходноеХранилище; // ФайловоеХранилищеМанифеста

#КонецОбласти

#Область ОбработчикиСобытий

// Создает хранилище с отказом операции копирования.
//
// Параметры:
//   ИсходноеХранилище - ФайловоеХранилищеМанифеста - Хранилище для остальных файловых операций.
Процедура ПриСозданииОбъекта(ИсходноеХранилище)

	_ИсходноеХранилище = ИсходноеХранилище;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает содержимое через исходное файловое хранилище.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к файлу.
//
// Возвращаемое значение:
//   Строка - Содержимое файла.
Функция Прочитать(ПутьКФайлу) Экспорт

	Возврат _ИсходноеХранилище.Прочитать(ПутьКФайлу);

КонецФункции

// Записывает содержимое через исходное файловое хранилище.
//
// Параметры:
//   ПутьКФайлу      - Строка - Путь к файлу.
//   СодержимоеФайла - Строка - Новое содержимое файла.
Процедура Записать(ПутьКФайлу, СодержимоеФайла) Экспорт

	_ИсходноеХранилище.Записать(ПутьКФайлу, СодержимоеФайла);

КонецПроцедуры

// Имитирует отказ копирования файла.
//
// Параметры:
//   Источник - Строка - Путь к исходному файлу.
//   Приемник  - Строка - Путь к создаваемой копии.
Процедура Скопировать(Источник, Приемник) Экспорт

	ВызватьИсключение СтрШаблон("Не удалось скопировать '%1' в '%2'", Источник, Приемник);

КонецПроцедуры

#КонецОбласти
