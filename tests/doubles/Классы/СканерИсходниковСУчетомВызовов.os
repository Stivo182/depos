#Область ОписаниеПеременных

Перем _КоличествоВызовов; // Число

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_КоличествоВызовов = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрирует поиск используемых пакетов.
//
// Параметры:
//   Каталоги - Массив - Каталоги исходников.
//
// Возвращаемое значение:
//   Массив - Пустой список пакетов.
Функция НайтиПакеты(Каталоги) Экспорт
	_КоличествоВызовов = _КоличествоВызовов + 1;
	Возврат Новый Массив();
КонецФункции

// Возвращает количество поисков пакетов.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

#КонецОбласти
