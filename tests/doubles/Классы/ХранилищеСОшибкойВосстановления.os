#Использовать errors

#Область ОписаниеПеременных

Перем _ИсходноеХранилище; // ФайловоеХранилищеМанифеста
Перем _КоличествоКопирований; // Число

#КонецОбласти

#Область ОбработчикиСобытий

// Создает хранилище с частичной записью и отказом восстановления.
//
// Параметры:
//   ИсходноеХранилище - ФайловоеХранилищеМанифеста - Хранилище для чтения и первого копирования.
Процедура ПриСозданииОбъекта(ИсходноеХранилище)

	_ИсходноеХранилище = ИсходноеХранилище;
	_КоличествоКопирований = 0;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает содержимое через исходное файловое хранилище.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к файлу.
//
// Возвращаемое значение:
//   Строка - Содержимое файла.
Функция Прочитать(ПутьКФайлу) Экспорт

	Возврат _ИсходноеХранилище.Прочитать(ПутьКФайлу);

КонецФункции

// Частично перезаписывает файл и имитирует последующий отказ записи.
//
// Параметры:
//   ПутьКФайлу      - Строка - Путь к файлу.
//   СодержимоеФайла - Строка - Новое содержимое файла.
Процедура Записать(ПутьКФайлу, СодержимоеФайла) Экспорт

	Запись = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8");
	Запись.Записать(Лев(СодержимоеФайла, 10));
	Запись.Закрыть();

	ВызватьИсключение ФабрикаОшибок.Создать(
		"manifest.write_failed",
		СтрШаблон("Возникла ошибка при записи файла манифеста '%1'", ПутьКФайлу)
	);

КонецПроцедуры

// Создает резервную копию и имитирует отказ последующего восстановления.
//
// Параметры:
//   Источник - Строка - Путь к исходному файлу.
//   Приемник  - Строка - Путь к создаваемой копии.
Процедура Скопировать(Источник, Приемник) Экспорт

	_КоличествоКопирований = _КоличествоКопирований + 1;
	Если _КоличествоКопирований = 1 Тогда
		_ИсходноеХранилище.Скопировать(Источник, Приемник);
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Имитирован отказ восстановления манифеста";

КонецПроцедуры

#КонецОбласти
