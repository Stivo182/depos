#Область ОписаниеПеременных

Перем _КоличествоВызовов; // Число

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_КоличествоВызовов = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрирует поиск и возвращает все связанные результаты.
//
// Возвращаемое значение:
//   РезультатСканированияУстановленныхПакетов - Пустой результат поиска.
Функция Просканировать() Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;
	Пакеты = Новый Соответствие();
	ПоврежденныеПакеты = Новый ТаблицаЗначений();
	ПоврежденныеПакеты.Колонки.Добавить("ИмяПакета");
	ПоврежденныеПакеты.Колонки.Добавить("Каталог");
	ПоврежденныеПакеты.Колонки.Добавить("Причина");
	МетаданныеПакетов = Новый Соответствие();
	МетаданныеПакетов.Вставить("opm-metadata.xml", Истина);
	Возврат Новый РезультатСканированияУстановленныхПакетов(
		Пакеты,
		ПоврежденныеПакеты,
		МетаданныеПакетов
	);

КонецФункции

// Сохраняет каталог библиотек.
Функция УстановитьКаталогБиблиотек(КаталогБиблиотек) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет конфигурационный файл.
Функция УстановитьКонфигурационныйФайл(ПутьКФайлу) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет контекстный каталог.
Функция УстановитьКонтекстныйКаталог(Каталог) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет фильтр исключаемых пакетов.
Функция ИсключитьПоИмени(Фильтр) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает количество поисков пакетов.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

#КонецОбласти
