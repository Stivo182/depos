#Область ОписаниеПеременных

Перем _КоличествоВызовов; // Число

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_КоличествоВызовов = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сохраняет каталог библиотек.
Функция УстановитьКаталогБиблиотек(КаталогБиблиотек) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет конфигурационный файл.
Функция УстановитьКонфигурационныйФайл(ПутьКФайлу) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Сохраняет фильтр исключаемых пакетов.
Функция ИсключитьПоИмени(Фильтр) Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Регистрирует поиск установленных пакетов.
//
// Возвращаемое значение:
//   Соответствие - Пустой список пакетов.
Функция НайтиВсеПакеты() Экспорт
	_КоличествоВызовов = _КоличествоВызовов + 1;
	Возврат Новый Соответствие();
КонецФункции

// Возвращает пустой список поврежденных пакетов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Пустой список поврежденных пакетов.
Функция ПоврежденныеПакеты() Экспорт
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("ИмяПакета");
	Результат.Колонки.Добавить("Каталог");
	Результат.Колонки.Добавить("Причина");
	Возврат Результат;
КонецФункции

// Возвращает количество поисков пакетов.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

#КонецОбласти
