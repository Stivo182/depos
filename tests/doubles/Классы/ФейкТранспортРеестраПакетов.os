#Область ОписаниеПеременных

Перем _Ответы; // Соответствие
Перем _Исключения; // Соответствие
Перем _Адреса; // Массив
Перем _Прокси; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_Ответы = Новый Соответствие;
	_Исключения = Новый Соответствие;
	_Адреса = Новый Массив;
	_Прокси = Новый Массив;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Программирует HTTP-ответ для адреса.
//
// Параметры:
//   Адрес        - URL - Адрес запроса.
//   КодСостояния - Число - Код состояния HTTP.
//   Тело         - Строка - Тело HTTP-ответа.
Процедура НастроитьОтвет(Адрес, КодСостояния, Тело) Экспорт

	_Ответы.Вставить(Адрес.ВСтроку(), Новый Структура("КодСостояния,Тело", КодСостояния, Тело));

КонецПроцедуры

// Программирует исключение транспорта для адреса.
//
// Параметры:
//   Адрес           - URL - Адрес запроса.
//   ОписаниеОшибки  - Строка - Текст исключения.
Процедура НастроитьИсключение(Адрес, ОписаниеОшибки) Экспорт

	_Исключения.Вставить(Адрес.ВСтроку(), ОписаниеОшибки);

КонецПроцедуры

// Выполняет запрограммированный GET-запрос без обращения к сети.
//
// Параметры:
//   Адрес  - URL - Адрес ресурса.
//   Прокси - URL, Неопределено - Адрес proxy.
//
// Возвращаемое значение:
//   Структура - Код и тело запрограммированного HTTP-ответа.
Функция Получить(Адрес, Прокси) Экспорт

	_Адреса.Добавить(Адрес.Скопировать());

	Если Прокси = Неопределено Тогда
		_Прокси.Добавить(Неопределено);
	Иначе
		_Прокси.Добавить(Прокси.Скопировать());
	КонецЕсли;

	Ключ = Адрес.ВСтроку();

	ОписаниеОшибки = _Исключения.Получить(Ключ);
	Если ОписаниеОшибки <> Неопределено Тогда
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;

	Ответ = _Ответы.Получить(Ключ);
	Если Ответ <> Неопределено Тогда
		Возврат Ответ;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Не запрограммирован ответ транспорта для адреса %1", Ключ);

КонецФункции

// Возвращает независимые копии переданных адресов.
//
// Возвращаемое значение:
//   Массив из URL - Адреса запросов в порядке вызовов.
Функция Адреса() Экспорт

	Результат = Новый Массив;
	Для Каждого Адрес Из _Адреса Цикл
		Результат.Добавить(Адрес.Скопировать());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает независимые копии переданных proxy.
//
// Возвращаемое значение:
//   Массив из URL, Неопределено - Proxy в порядке вызовов.
Функция Прокси() Экспорт

	Результат = Новый Массив;
	Для Каждого АдресПрокси Из _Прокси Цикл
		Если АдресПрокси = Неопределено Тогда
			Результат.Добавить(Неопределено);
		Иначе
			Результат.Добавить(АдресПрокси.Скопировать());
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
