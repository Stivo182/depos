#Область ОписаниеПеременных

Перем _Ответы; // Соответствие
Перем _Исключения; // Соответствие
Перем _Адреса; // Массив
Перем _Прокси; // Массив
Перем _Заголовки; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_Ответы = Новый Соответствие;
	_Исключения = Новый Соответствие;
	_Адреса = Новый Массив;
	_Прокси = Новый Массив;
	_Заголовки = Новый Массив;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Программирует HTTP-ответ для адреса.
//
// Параметры:
//   Адрес        - URL - Адрес запроса.
//   КодСостояния - Число - Код состояния HTTP.
//   Тело         - Строка - Тело HTTP-ответа.
Процедура НастроитьОтвет(Адрес, КодСостояния, Тело) Экспорт

	_Ответы.Вставить(Адрес.ВСтроку(), Новый Структура("КодСостояния,Тело", КодСостояния, Тело));

КонецПроцедуры

// Программирует исключение транспорта для адреса.
//
// Параметры:
//   Адрес           - URL - Адрес запроса.
//   ОписаниеОшибки  - Строка - Текст исключения.
Процедура НастроитьИсключение(Адрес, ОписаниеОшибки) Экспорт

	_Исключения.Вставить(Адрес.ВСтроку(), ОписаниеОшибки);

КонецПроцедуры

// Выполняет запрограммированный GET-запрос без обращения к сети.
//
// Параметры:
//   Адрес     - URL - Адрес ресурса.
//   Прокси    - URL, Структура, Неопределено - Настройки proxy.
//   Заголовки - Соответствие, Неопределено - Заголовки запроса.
//
// Возвращаемое значение:
//   Структура:
//     * КодСостояния - Число - Код состояния HTTP.
//     * Тело         - Строка - Тело ответа.
Функция Получить(Адрес, Прокси, Заголовки = Неопределено) Экспорт

	_Адреса.Добавить(Адрес.Скопировать());
	_Прокси.Добавить(КопияПрокси(Прокси));
	_Заголовки.Добавить(КопияЗаголовков(Заголовки));

	Ключ = Адрес.ВСтроку();

	ОписаниеОшибки = _Исключения.Получить(Ключ);
	Если ОписаниеОшибки <> Неопределено Тогда
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;

	Ответ = _Ответы.Получить(Ключ);
	Если Ответ <> Неопределено Тогда
		Возврат Ответ;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Не запрограммирован ответ транспорта для адреса %1", Ключ);

КонецФункции

// Возвращает копии заголовков запросов.
//
// Возвращаемое значение:
//   Массив из Соответствие - Заголовки в порядке вызовов.
Функция Заголовки() Экспорт

	Результат = Новый Массив;
	Для Каждого ЗаголовкиЗапроса Из _Заголовки Цикл
		Результат.Добавить(КопияЗаголовков(ЗаголовкиЗапроса));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает независимые копии переданных адресов.
//
// Возвращаемое значение:
//   Массив из URL - Адреса запросов в порядке вызовов.
Функция Адреса() Экспорт

	Результат = Новый Массив;
	Для Каждого Адрес Из _Адреса Цикл
		Результат.Добавить(Адрес.Скопировать());
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает независимые копии переданных proxy.
//
// Возвращаемое значение:
//   Массив из URL, Структура, Неопределено - Proxy в порядке вызовов.
Функция Прокси() Экспорт

	Результат = Новый Массив;
	Для Каждого НастройкиПрокси Из _Прокси Цикл
		Результат.Добавить(КопияПрокси(НастройкиПрокси));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КопияЗаголовков(Заголовки)

	Результат = Новый Соответствие;
	Если Заголовки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Заголовок Из Заголовки Цикл
		Результат.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КопияПрокси(Прокси)

	Если Прокси = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Прокси) = Тип("URL") Тогда
		Возврат Прокси.Скопировать();
	КонецЕсли;

	Результат = Новый Структура;
	Для Каждого Параметр Из Прокси Цикл
		Результат.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
