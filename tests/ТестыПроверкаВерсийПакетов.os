#Использовать "helpers"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПроверитьЧетырехкомпонентнуюВерсиюПакета() Экспорт

	// Подготовка
	НекорректныеВерсии = СтрРазделить("01.2.3.4,1.02.3.4,1.2.03.4,1.2.3.04,1.2.3.4-beta,1.2.3.4+build", ",");

	// Действие и Проверка
	Ожидаем.Что(ПроверкаВерсийПакетов.ЭтоКорректная("1.2.3.4")).ЭтоИстина();
	Для Каждого Версия Из НекорректныеВерсии Цикл
		Ожидаем.Что(ПроверкаВерсийПакетов.ЭтоКорректная(Версия), Версия).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьSemVerСТочкамиВПререлизе() Экспорт

	// Подготовка
	ВерсияСтрокой = "1.2.3-alpha.1";

	// Действие
	Версия = Новый ВерсияПакета(ВерсияСтрокой);

	// Проверка
	Ожидаем.Что(Версия.Ошибка()).ЭтоЛожь();
	Ожидаем.Что(Версия.ВСтроку()).Равно(ВерсияСтрокой);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьДвухкомпонентнуюВерсиюНулевойВетки() Экспорт

	// Подготовка
	ВерсияСтрокой = "0.7";

	// Действие
	Версия = Новый ВерсияПакета(ВерсияСтрокой);

	// Проверка
	Ожидаем.Что(Версия.Ошибка()).ЭтоЛожь();
	Ожидаем.Что(Версия.ВСтроку()).Равно(ВерсияСтрокой);
	Ожидаем.Что(Версия.Основная()).Равно(0);
	Ожидаем.Что(Версия.Второстепенная()).Равно(7);
	Ожидаем.Что(Версия.Патч()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьКомпонентыВерсииМетодами() Экспорт

	// Подготовка
	Версия = Новый ВерсияПакета("1.2.3.4");

	// Действие и Проверка
	Ожидаем.Что(Версия.Основная()).Равно(1);
	Ожидаем.Что(Версия.Второстепенная()).Равно(2);
	Ожидаем.Что(Версия.Патч()).Равно(3);
	Ожидаем.Что(Версия.ДополнительныйПатч()).Равно(4);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1.2.3", "1.2.3.0", 0)
&ИсточникЗначение("1.2.3", "1.2.3.1", -1)
&ИсточникЗначение("1.2.3.1", "1.2.3", 1)
&ИсточникЗначение("1.2.3.4", "1.2.3.5", -1)
&ИсточникЗначение("1.2.3-alpha.1", "1.2.3", -1)
&ИсточникЗначение("1.2.3-alpha.1", "1.2.3.0", -1)
&ИсточникЗначение("1.2.3.1", "1.2.3-alpha.1", 1)
&ИсточникЗначение("1.2.3-alpha.1", "1.2.3-alpha.2", -1)
&ИсточникЗначение("1.2.3+build.1", "1.2.3+build.2", 0)
Процедура ТестДолжен_СравнитьПоддерживаемыеФорматыВерсий(Первая, Вторая, ОжидаемыйРезультат) Экспорт

	// Подготовка
	ДругаяВерсия = Новый ВерсияПакета(Вторая);

	// Действие
	Результат = Новый ВерсияПакета(Первая).Сравнить(ДругаяВерсия);

	// Проверка
	Ожидаем.Что(Результат, Первая + " и " + Вторая).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1.2.3", "1.2.4", -1)
&ИсточникЗначение("1.2.3.5", "1.2.3.4", 1)
&ИсточникЗначение("1.2.3-alpha.1", "1.2.3-alpha.2", -1)
Процедура ТестДолжен_СравнитьВерсиюСоСтрокой(Первая, Вторая, ОжидаемыйРезультат) Экспорт

	// Подготовка
	Версия = Новый ВерсияПакета(Первая);

	// Действие
	Результат = Версия.Сравнить(Вторая);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКонтрактРегулярногоВыраженияSemVer() Экспорт

	// Действие
	РегулярноеВыражение = ПроверкаВерсийПакетов.РегулярноеВыражениеСтрогойВерсии();

	// Проверка
	Ожидаем.Что(РегулярноеВыражение.Совпадает("1.2.3-alpha.1+build.5")).ЭтоИстина();
	Ожидаем.Что(РегулярноеВыражение.Совпадает("1.2.3.4")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьОдноРегулярноеВыражениеСтрогойВерсии() Экспорт

	// Подготовка
	ПервоеВыражение = ПроверкаВерсийПакетов.РегулярноеВыражениеСтрогойВерсии();

	// Действие
	ВтороеВыражение = ПроверкаВерсийПакетов.РегулярноеВыражениеСтрогойВерсии();

	// Проверка
	Ожидаем.Что(ВтороеВыражение).Равно(ПервоеВыражение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СтрогоПроверитьВерсиюПакета() Экспорт

	// Подготовка
	НекорректныеВерсии = СтрРазделить("1,1.0,01.0.0,v1.0.0", ",");

	// Действие и Проверка
	Ожидаем.Что(ПроверкаВерсийПакетов.ЭтоКорректная("1.0.0-beta.1+build.5")).ЭтоИстина();
	Для Каждого Версия Из НекорректныеВерсии Цикл
		Ожидаем.Что(ПроверкаВерсийПакетов.ЭтоКорректная(Версия)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
