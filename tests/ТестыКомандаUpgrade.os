// BSLLS:LineLength-off
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать "helpers"
#Использовать logos

Перем _Поделка; // Поделка
Перем _ПотокВывода; // ПотокВПамяти
Перем _ТекущийКаталог; // Строка
Перем _Лог; // Лог
Перем _СообщенияОтладочногоЛога; // Массив

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт
	_ТекущийКаталог = ТекущийКаталог();
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_Лог = Неопределено;
	_СообщенияОтладочногоЛога = Новый Массив();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	Если _Лог <> Неопределено Тогда
		_Лог.УдалитьСпособВывода(ЭтотОбъект);
		Логирование.ЗакрытьЛог(_Лог);
		_Лог = Неопределено;
	КонецЕсли;

	ПомощникТестирования.УдалитьВременныеФайлы();
	УстановитьТекущийКаталог(_ТекущийКаталог);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьОбновлениеМанифеста() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйВывод =
	"✓ annotations       1.3.0 → 1.3.1
	|✓ packageinfo       0.7   → 1.0.0
	|✓ 1testrunner  dev  1.8.0 → 1.9.2";

	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);

	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйВывод);
	ПомощникТестирования.ОжидаемЧтоФайлыИдентичны(ФайлМанифеста, ПомощникТестирования.ФайлОбновленногоМанифеста);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ТестДолжен_СохранитьНаличиеBOMМанифестаПриОбновлении(СодержитBOM) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	ЗаписатьФайлМанифеста(ФайлМанифеста, СодержитBOM);

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ОжидаемоеКоличествоBOM = ?(СодержитBOM, 1, 0);
	Ожидаем.Что(ПомощникТестирования.КоличествоBOMВНачале(ФайлМанифеста)).Равно(ОжидаемоеКоличествоBOM);
	ПомощникТестирования.ОжидаемЧтоФайлыИдентичны(
		ФайлМанифеста,
		ПомощникТестирования.ФайлОбновленногоМанифеста
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("LF")
&ИсточникЗначение("CRLF")
Процедура ТестДолжен_СохранитьТипПереносаСтрокМанифестаПриОбновлении(ТипПереноса) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	ОжидаемыйФайл = ПомощникТестирования.СоздатьВременнуюКопиюФайла(
		ПомощникТестирования.ФайлОбновленногоМанифеста
	);
	ЗаписатьФайлМанифестаСТипомПереноса(ФайлМанифеста, ТипПереноса);
	ЗаписатьФайлМанифестаСТипомПереноса(ОжидаемыйФайл, ТипПереноса);

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ПомощникТестирования.ОжидаемЧтоФайлыПобайтовоИдентичны(ФайлМанифеста, ОжидаемыйФайл);

КонецПроцедуры

