&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ТестДолжен_ПроверитьФормированиеРезервнойКопии(СодержитBOM) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйВывод =
	"✓ annotations       1.3.0 → 1.3.1
	|✓ packageinfo       0.7   → 1.0.0
	|✓ 1testrunner  dev  1.8.0 → 1.9.2
	|
	|Создана резервная копия файла манифеста:";

	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	ЗаписатьФайлМанифеста(ФайлМанифеста, СодержитBOM);
	ИсходныйФайл = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ФайлМанифеста);

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--backup");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);

	// Проверка

	// Проверяем вывод
	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйВывод);

	// Проверяем содержимое резервной копии
	ФайлРезервнойКопии = ИзвлечьПутьКФайлуРезервнойКопииИзТекста(ТекстВывода);
	ПомощникТестирования.ОжидаемЧтоФайлыПобайтовоИдентичны(ФайлРезервнойКопии, ИсходныйФайл);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ТестДолжен_ПолучитьОшибкуНеНайденыЗависимости(СодержитBOM) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйВывод = "Не найдены зависимости для обновления";

	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла("./tests/fixtures/packagedef-no-deps");
	ЗаписатьФайлМанифеста(ФайлМанифеста, СодержитBOM);
	ИсходныйФайл = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ФайлМанифеста);

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);

	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйВывод);
	ПомощникТестирования.ОжидаемЧтоФайлыПобайтовоИдентичны(ФайлМанифеста, ИсходныйФайл);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьОшибкуНеНайденФайлМанифестаВТекущемКаталоге() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйПользовательскийВывод = "manifest.not_found: В каталоге";

	УстановитьТекущийКаталог("./tests");

	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");
	ПодключитьСборОтладочногоЛога();

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	ТекстДиагностики = СтрСоединить(_СообщенияОтладочногоЛога, Символы.ПС);

	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйПользовательскийВывод);
	Ожидаем.Что(ТекстВывода)
		.Содержит("Убедитесь, что указан каталог, содержащий packagedef или opm-metadata.xml.");
	Ожидаем.Что(ТекстДиагностики).Содержит("Место:");

КонецПроцедуры

Процедура ПодключитьСборОтладочногоЛога()
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos.КомандаUpgrade");
	_Лог.ДобавитьСпособВывода(ЭтотОбъект, УровниЛога.Отладка);
КонецПроцедуры

// Сохраняет отладочное сообщение временного appender'а.
//
// Параметры:
//   Сообщение - Строка - Форматированное сообщение.
//   УровеньСообщения - Число - Уровень сообщения logos.
Процедура Вывести(Сообщение, УровеньСообщения) Экспорт
	Если УровеньСообщения = УровниЛога.Отладка Тогда
		_СообщенияОтладочногоЛога.Добавить(Сообщение);
	КонецЕсли;
КонецПроцедуры

// Завершает работу временного appender'а.
Процедура Закрыть() Экспорт
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиИзмененияЗависимостейВJson() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	ФайлВывода = ПомощникТестирования.СоздатьВременныйФайл("json");

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);
	ПараметрыКоманды.Добавить("--output");
	ПараметрыКоманды.Добавить(ФайлВывода);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	Ожидаем.Что(ФС.ФайлСуществует(ФайлВывода)).ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ФайлВывода, "UTF-8");
	СтрокаJson = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Десериализатор = Новый ДесериализаторJson();
	ПроверяемыйОбъект = Десериализатор.Десериализовать(СтрокаJson);

	Ожидаем.Что(ПроверяемыйОбъект).ИмеетТип("Массив");
	Ожидаем.Что(ПроверяемыйОбъект).ИмеетДлину(3);

	Ожидаем.Что(ПроверяемыйОбъект[0].packageName, "[0].packageName").Равно("annotations");
	Ожидаем.Что(ПроверяемыйОбъект[0].isDev, "[0].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[0].minVersionBefore, "[0].minVersionBefore").Равно("1.3.0");
	Ожидаем.Что(ПроверяемыйОбъект[0].minVersionAfter, "[0].minVersionAfter").Равно("1.3.1");
	Ожидаем.Что(ПроверяемыйОбъект[0].maxVersion, "[0].maxVersion").Равно("");

	Ожидаем.Что(ПроверяемыйОбъект[1].packageName, "[1].packageName").Равно("packageinfo");
	Ожидаем.Что(ПроверяемыйОбъект[1].isDev, "[1].isDev").Равно(Ложь);
	Ожидаем.Что(ПроверяемыйОбъект[1].minVersionBefore, "[1].minVersionBefore").Равно("0.7");
	Ожидаем.Что(ПроверяемыйОбъект[1].minVersionAfter, "[1].minVersionAfter").Равно("1.0.0");
	Ожидаем.Что(ПроверяемыйОбъект[1].maxVersion, "[1].maxVersion").Равно("");

	Ожидаем.Что(ПроверяемыйОбъект[2].packageName, "[2].packageName").Равно("1testrunner");
	Ожидаем.Что(ПроверяемыйОбъект[2].isDev, "[2].isDev").Равно(Истина);
	Ожидаем.Что(ПроверяемыйОбъект[2].minVersionBefore, "[2].minVersionBefore").Равно("1.8.0");
	Ожидаем.Что(ПроверяемыйОбъект[2].minVersionAfter, "[2].minVersionAfter").Равно("1.9.2");
	Ожидаем.Что(ПроверяемыйОбъект[2].maxVersion, "[2].maxVersion").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьЗапретНаИзменениеOmpMetadata() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйВывод = "Не поддерживается обновление файла манифеста";
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифестаOpmMetadata);

	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("upgrade");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФайлМанифеста);

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);

	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйВывод);

КонецПроцедуры

Функция ИзвлечьПутьКФайлуРезервнойКопииИзТекста(Текст)
	
	РегулярноеВыражение = Новый РегулярноеВыражение("Создана резервная копия файла манифеста: (.*)\n");
	Совпадения = РегулярноеВыражение.НайтиСовпадения(Текст);

	Если Совпадения.Количество() > 0 Тогда
		Возврат Совпадения[0].Группы[1].Значение;
	Иначе
		ВызватьИсключение "Резервная копия файл не найдена в тексте вывода";
	КонецЕсли;

КонецФункции

Процедура ЗаписатьФайлМанифеста(ПутьКФайлу, СодержитBOM)

	Содержимое = ПомощникТестирования.СодержимоеФайла(ПутьКФайлу);
	ПомощникТестирования.ЗаписатьФайлUTF8(ПутьКФайлу, Содержимое, СодержитBOM);

КонецПроцедуры

Процедура ЗаписатьФайлМанифестаСТипомПереноса(ПутьКФайлу, ТипПереноса)

	Содержимое = ПомощникТестирования.СодержимоеФайла(ПутьКФайлу);
	Содержимое = СтрЗаменить(Содержимое, Символ(13), "");

	Если ТипПереноса = "CRLF" Тогда
		Содержимое = СтрЗаменить(Содержимое, Символ(10), Символ(13) + Символ(10));
	КонецЕсли;

	ПомощникТестирования.ЗаписатьФайлUTF8(ПутьКФайлу, Содержимое, Ложь);

КонецПроцедуры
