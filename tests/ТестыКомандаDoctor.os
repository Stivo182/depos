&ПараметризованныйТест
&ИсточникЗначение("", Ложь, Истина)
&ИсточникЗначение("usage", Ложь, Ложь)
Процедура ТестДолжен_ПодтвердитьКосвеннуюЗависимостьПередПодавлениемПредупреждения(
	Проверки,
	ОжидаетсяПредупреждение,
	ОжидаетсяРекомендация
) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("doctor");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить("./tests/fixtures/ПроектСРекомендациямиВерсий/packagedef-indirect");

	Если ЗначениеЗаполнено(Проверки) Тогда
		ПараметрыКоманды.Добавить("--checks");
		ПараметрыКоманды.Добавить(Проверки);
	КонецЕсли;

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	ЕстьПредупреждение = СтрНайти(ТекстВывода, "⚠  candidate") > 0;
	ЕстьРекомендация = СтрНайти(ТекстВывода, "ℹ candidate") > 0;

	Ожидаем.Что(ЕстьПредупреждение).Равно(ОжидаетсяПредупреждение);
	Ожидаем.Что(ЕстьРекомендация).Равно(ОжидаетсяРекомендация);

КонецПроцедуры

