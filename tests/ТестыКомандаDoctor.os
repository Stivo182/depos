// BSLLS:LineLength-off
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать "helpers"
#Использовать 1commands
#Использовать logos

Перем _Поделка; // Поделка
Перем _ПотокВывода; // ПотокВПамяти
Перем _ТекущийКаталог; // Строка
Перем _ПеременныеСредыКонфигурация; // Строка
Перем _Лог; // Лог
Перем _СообщенияОтладочногоЛога; // Массив

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт

	_ТекущийКаталог = ТекущийКаталог();
	_ПеременныеСредыКонфигурация = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_Лог = Неопределено;
	_СообщенияОтладочногоЛога = Новый Массив();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	Если _Лог <> Неопределено Тогда
		_Лог.УдалитьСпособВывода(ЭтотОбъект);
		Логирование.ЗакрытьЛог(_Лог);
		_Лог = Неопределено;
	КонецЕсли;

	ПомощникТестирования.УдалитьВременныеФайлы();
	УстановитьТекущийКаталог(_ТекущийКаталог);
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ПеременныеСредыКонфигурация);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиДиагностикуОшибкиНенайденногоМанифеста() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	ОжидаемыйПользовательскийВывод = "manifest.not_found: В каталоге";

	УстановитьТекущийКаталог("./tests");

	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");
	ПодключитьСборОтладочногоЛога();

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("doctor");

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	ТекстДиагностики = СтрСоединить(_СообщенияОтладочногоЛога, Символы.ПС);

	Ожидаем.Что(ТекстВывода).Содержит(ОжидаемыйПользовательскийВывод);
	Ожидаем.Что(ТекстВывода)
		.Содержит("Убедитесь, что указан каталог, содержащий packagedef или opm-metadata.xml.");
	Ожидаем.Что(ТекстДиагностики).Содержит("Место:");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СканироватьВсеФайлыВСтандартномКаталогеТестов() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");
	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("doctor");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить(ФС.ПолныйПуть("./packagedef"));
	ПараметрыКоманды.Добавить("--checks");
	ПараметрыКоманды.Добавить("usage");

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	Ожидаем.Что(ТекстВывода).Содержит("✕  test1 (dev)");

КонецПроцедуры

Процедура ПодключитьСборОтладочногоЛога()
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos.КомандаDoctor");
	_Лог.ДобавитьСпособВывода(ЭтотОбъект, УровниЛога.Отладка);
КонецПроцедуры

// Сохраняет отладочное сообщение временного appender'а.
//
// Параметры:
//   Сообщение - Строка - Форматированное сообщение.
//   УровеньСообщения - Число - Уровень сообщения logos.
Процедура Вывести(Сообщение, УровеньСообщения) Экспорт
	Если УровеньСообщения = УровниЛога.Отладка Тогда
		_СообщенияОтладочногоЛога.Добавить(Сообщение);
	КонецЕсли;
КонецПроцедуры

// Завершает работу временного appender'а.
Процедура Закрыть() Экспорт
КонецПроцедуры

