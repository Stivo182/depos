	Ожидаем.Что(ТекстВывода).Содержит("Не обнаружено прямого использования");
	Ожидаем.Что(ТекстВывода).Содержит("Конфликты транзитивных зависимостей");
	Ожидаем.Что(ТекстВывода).Содержит("✕  missing_shared");
	Ожидаем.Что(ТекстВывода).Содержит("✕  shared");
	Ожидаем.Что(ТекстВывода).Содержит("✕  7 проблем");

