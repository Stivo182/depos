Процедура ТестДолжен_УчитыватьIgnoreDevВРекомендациях(ИгнорироватьDev, ОжидаетсяРекомендация) Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("doctor");
	ПараметрыКоманды.Добавить("--manifest");
	ПараметрыКоманды.Добавить("./tests/fixtures/ПроектСРекомендациямиВерсий/packagedef-dev");
	ПараметрыКоманды.Добавить("--checks");
	ПараметрыКоманды.Добавить("transitive");

	Если ИгнорироватьDev Тогда
		ПараметрыКоманды.Добавить("--ignore-dev");
	КонецЕсли;

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);
	ЕстьРекомендация = СтрНайти(ТекстВывода, "Рекомендации по версиям зависимостей") > 0;
	Ожидаем.Что(ЕстьРекомендация).Равно(ОжидаетсяРекомендация);

	Если ОжидаетсяРекомендация Тогда
		Ожидаем.Что(ТекстВывода).Содержит(".РазработкаЗависитОт(""dev_candidate"", ""4.0.0"")");
		Ожидаем.Что(ТекстВывода).Содержит(".РазработкаЗависитОт(""dev_candidate"")");
	КонецЕсли;

КонецПроцедуры

