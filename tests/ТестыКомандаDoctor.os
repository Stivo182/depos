&Тест
Процедура ТестДолжен_ПолучитьРезультатаАнализаМанифестаПоИмениПакета() Экспорт

	// Подготовка
	_ПотокВывода = ПомощникТестирования.ПерехватитьПотокВывода();
	УстановитьТекущийКаталог("./tests/fixtures");
	ПомощникТестирования.УстановитьИзолированныеКаталогиБиблиотек(
		ФС.ПолныйПуть(ОбъединитьПути(_ТекущийКаталог, "tests/fixtures/oscript_modules")),
		"./nonexistent"
	);

	_Поделка = ПомощникТестирования.ОтладочнаяПоделка();
	КонсольноеПриложение = _Поделка.НайтиЖелудь("КонсольноеПриложение");

	ПараметрыКоманды = Новый Массив();
	ПараметрыКоманды.Добавить("doctor");
	ПараметрыКоманды.Добавить("--package");
	ПараметрыКоманды.Добавить("mypackage");

	// Действие
	КонсольноеПриложение.Запустить(ПараметрыКоманды);

	// Проверка
	ТекстВывода = ПомощникТестирования.ПолучитьТекстИзПотокаВывода(_ПотокВывода);

	Ожидаем.Что(ТекстВывода).Содержит("Не обнаружено прямого использования");
	Ожидаем.Что(ТекстВывода).Содержит("Несоответствие установленных версий");
	Ожидаем.Что(ТекстВывода).Не_().Содержит("   1testrunner (dev)");

