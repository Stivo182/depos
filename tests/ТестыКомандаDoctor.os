	Ожидаем.Что(ТекстВывода).Содержит("рекомендация: убрать явную версию");
	Ожидаем.Что(ТекстВывода).Содержит(".ЗависитОт(""candidate"", ""5.4.0.3"")");
	Ожидаем.Что(ТекстВывода).Содержит(".ЗависитОт(""candidate"")");

