&Тест
Процедура ТестДолжен_СохранитьОшибкуНесовпаденияВерсииПриПроверке() Экспорт

	// Подготовка
	ОбновляторЗависимостей = _Поделка.НайтиЖелудь("ОбновляторЗависимостей");
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	ОжидаемаяВерсия = "4.0.0"" + ""-injected";
	Зависимости = Новый ЗависимостиПакета().Добавить("autumn", ОжидаемаяВерсия);

	// Действие и Проверка
	Ожидаем.Что(ОбновляторЗависимостей)
		.Метод("Обновить", ПараметрыОбновления(ФайлМанифеста, Зависимости))
		.ВыбрасываетИсключение("Проверка зависимостей закончилась неудачей");
	ПомощникТестирования.ОжидаемЧтоФайлыИдентичны(ФайлМанифеста, ПомощникТестирования.ФайлМанифеста);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьОшибкуСозданияРезервнойКопии() Экспорт

	// Подготовка
	ОбновляторЗависимостей = _Поделка.НайтиЖелудь("ОбновляторЗависимостей");
	ИсходноеХранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ХранилищеСОшибкойКопирования = Новый ХранилищеСОшибкойКопирования(ИсходноеХранилище);
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(
		ОбновляторЗависимостей,
		"_ХранилищеМанифеста",
		ХранилищеСОшибкойКопирования
	);
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	Зависимости = Новый ЗависимостиПакета().Добавить("autumn", "4.0.0");

	// Действие и Проверка
	Ожидаем.Что(ОбновляторЗависимостей)
		.Метод("Обновить", ПараметрыОбновления(ФайлМанифеста, Зависимости))
		.ВыбрасываетИсключение("Ошибка создания резервной копии файла манифеста");

КонецПроцедуры

&Тест
&Параметры(Истина)
&Параметры(Ложь)
Процедура ТестДолжен_ВосстановитьМанифестПослеЧастичнойЗаписи(СодержитBOM) Экспорт

	// Подготовка
	ОбновляторЗависимостей = _Поделка.НайтиЖелудь("ОбновляторЗависимостей");
	ИсходноеХранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ХранилищеСЧастичнойЗаписью = Новый ХранилищеСЧастичнойЗаписью(ИсходноеХранилище);
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(
		ОбновляторЗависимостей,
		"_ХранилищеМанифеста",
		ХранилищеСЧастичнойЗаписью
	);
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	СодержимоеМанифеста = ПомощникТестирования.СодержимоеФайла(ФайлМанифеста);
	ПомощникТестирования.ЗаписатьФайлUTF8(ФайлМанифеста, СодержимоеМанифеста, СодержитBOM);
	ИсходныйФайл = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ФайлМанифеста);
	Зависимости = Новый ЗависимостиПакета().Добавить("autumn", "4.0.0");

	// Действие и Проверка
	Ожидаем.Что(ОбновляторЗависимостей)
		.Метод("Обновить", ПараметрыОбновления(ФайлМанифеста, Зависимости))
		.ВыбрасываетИсключение("Возникла ошибка при записи файла манифеста");
	ПомощникТестирования.ОжидаемЧтоФайлыПобайтовоИдентичны(ФайлМанифеста, ИсходныйФайл);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеВосстановленияМанифеста() Экспорт

	// Подготовка
	ОбновляторЗависимостей = _Поделка.НайтиЖелудь("ОбновляторЗависимостей");
	ИсходноеХранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ХранилищеСОшибкой = Новый ХранилищеСОшибкойВосстановления(ИсходноеХранилище);
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(ОбновляторЗависимостей, "_ХранилищеМанифеста", ХранилищеСОшибкой);
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	Зависимости = Новый ЗависимостиПакета().Добавить("autumn", "4.0.0");
	Ошибка = Неопределено;

	// Действие
	Попытка
		ОбновляторЗависимостей.Обновить(ФайлМанифеста, Зависимости);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("manifest.restore_failed");
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, "manifest.write_failed")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьСохранениеРезервнойКопии() Экспорт

	// Подготовка
	ОбновляторЗависимостей = _Поделка.НайтиЖелудь("ОбновляторЗависимостей");
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(ПомощникТестирования.ФайлМанифеста);
	Зависимости = Новый ЗависимостиПакета().Добавить("autumn", "4.3.11");

	// Действие
	ОбновляторЗависимостей
		.СохранятьКопию()
		.Обновить(ФайлМанифеста, Зависимости);

	// Проверка
	Файл = Новый Файл(ФайлМанифеста);
	Маска = Файл.Имя + "_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + "*";
	НайденныеФайлы = НайтиФайлы(Файл.Путь, Маска);
	Ожидаем.Что(НайденныеФайлы).Заполнено();
	ПомощникТестирования.ОжидаемЧтоФайлыИдентичны(
		НайденныеФайлы[0].ПолноеИмя,
		ПомощникТестирования.ФайлМанифеста
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбновленныеЗависимости()

	ИсходныеЗависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(ПомощникТестирования.ФайлМанифеста);

	Зависимости = _Поделка.НайтиЖелудь("ОпределительВерсийЗависимостей")
		.ТолькоУстаревшие()
		.НайтиВерсии(ИсходныеЗависимости, ТипыВерсий.Последняя);

	Возврат Зависимости;

КонецФункции

Функция ПараметрыОбновления(ФайлМанифеста, Зависимости)

	Параметры = Новый Массив();
	Параметры.Добавить(ФайлМанифеста);
	Параметры.Добавить(Зависимости);
	Возврат Параметры;

КонецФункции

#КонецОбласти
