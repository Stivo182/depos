&Тест
Процедура ТестДолжен_НеРекомендоватьПриНесовместимыхТранзитивныхТребованиях() Экспорт

	// Подготовка
	ЗаглушитьТекущиеКаталогиБиблиотек();

	КаталогПроекта = "./tests/fixtures/ПроектСРекомендациямиВерсий";
	Анализатор = _Поделка.НайтиЖелудь("АнализаторЗависимостей").РабочийКаталог(КаталогПроекта);
	Зависимости = Новый ЗависимостиПакета()
		.Добавить("incompatible_a", "1.0.0")
		.Добавить("incompatible_b", "1.0.0")
		.Добавить("candidate", "5.4.0.3");
	ВыборПроверок = Новый ВыборПроверокЗависимостей("transitive");

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости, ВыборПроверок);

	// Проверка
	ЕстьКонфликты = Результат.КонфликтыТранзитивныхЗависимостей.Количество() > 0;
	Ожидаем.Что(ЕстьКонфликты).ЭтоИстина();
	Ожидаем.Что(Результат.РекомендацииПоВерсиямЗависимостей).ИмеетДлину(0);

КонецПроцедуры

