&Тест
Процедура ТестДолжен_УчитыватьКонтекстПрямыхDevЗависимостей() Экспорт

	// Подготовка
	ЗаглушитьТекущиеКаталогиБиблиотек();

	КаталогПроекта = "./tests/fixtures/ПроектСРекомендациямиВерсий";
	Анализатор = _Поделка.НайтиЖелудь("АнализаторЗависимостей").РабочийКаталог(КаталогПроекта);
	ProdКандидат = Новый ЗависимостиПакета()
		.ДобавитьДляРазработки("dev_root", "1.0.0")
		.Добавить("dev_candidate", "4.0.0");
	DevКандидат = Новый ЗависимостиПакета()
		.ДобавитьДляРазработки("dev_root", "1.0.0")
		.ДобавитьДляРазработки("dev_candidate", "4.0.0");
	ВыборПроверок = Новый ВыборПроверокЗависимостей("transitive");

	// Действие
	РезультатProd = Анализатор.ПроверитьЗависимости(ProdКандидат, ВыборПроверок);
	РезультатDev = Анализатор.ПроверитьЗависимости(DevКандидат, ВыборПроверок);
	РезультатБезDev = Анализатор
		.ИсключатьДляРазработки()
		.ПроверитьЗависимости(DevКандидат, ВыборПроверок);
	Анализатор.ИсключатьДляРазработки(Ложь);

	// Проверка
	Ожидаем.Что(РезультатProd.РекомендацииПоВерсиямЗависимостей).ИмеетДлину(0);
	Ожидаем.Что(РезультатDev.РекомендацииПоВерсиямЗависимостей).ИмеетДлину(1);
	Ожидаем.Что(РезультатБезDev.РекомендацииПоВерсиямЗависимостей).ИмеетДлину(0);

КонецПроцедуры

