		.РабочийКаталог(КаталогПроекта);
	Зависимости = Новый ЗависимостиПакета()
		.ЗаполнитьИзМанифеста(ОбъединитьПути(КаталогПроекта, "packagedef"));
	ВыборПроверок = Новый ВыборПроверокЗависимостей("transitive");

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости, ВыборПроверок);

	// Проверка
	Ожидаем.Что(Результат.ПоврежденныеУстановленныеПакеты).ИмеетДлину(1);
	ПроверитьПоврежденныйПакет(Результат, "broken-root", "Не удалось разобрать XML");
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьПоврежденныеУстановленныеПакеты() Экспорт

	// Подготовка
	ЗаглушитьТекущиеКаталогиБиблиотек();
	КаталогПроекта = "./tests/fixtures/ПроектСПоврежденнымиПакетами";
	Анализатор = _Поделка.НайтиЖелудь("АнализаторЗависимостей")
		.РабочийКаталог(КаталогПроекта);
	Зависимости = Новый ЗависимостиПакета()
		.ЗаполнитьИзМанифеста(ОбъединитьПути(КаталогПроекта, "packagedef"));

	// Действие
	ВыборПроверок = Новый ВыборПроверокЗависимостей("installed");
	Результат = Анализатор.ПроверитьЗависимости(Зависимости, ВыборПроверок);

	// Проверка
	Ожидаем.Что(Результат.ПоврежденныеУстановленныеПакеты).ИмеетДлину(3);
	Ожидаем.Что(Результат.НеустановленныеПакеты).ИмеетДлину(0);
	Ожидаем.Что(Результат.КонфликтыВерсийУстановленныхПакетов).ИмеетДлину(0);
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(3);

	ПроверитьПоврежденныйПакет(Результат, "missing-metadata", "Отсутствует файл");
	ПроверитьПоврежденныйПакет(Результат, "invalid-version", "Не удалось разобрать XML");
	ПроверитьПоврежденныйПакет(Результат, "invalid-xml", "Не удалось разобрать XML");
	Ожидаем.Что(
		Результат.ПоврежденныеУстановленныеПакеты.Найти("empty-version", "ИмяПакета") = Неопределено
	).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьПоврежденныйПакет(Результат, ИмяПакета, ЧастьПричины)

	Пакет = Результат.ПоврежденныеУстановленныеПакеты.Найти(ИмяПакета, "ИмяПакета");

	Ожидаем.Что(Пакет).Заполнено();
	Ожидаем.Что(Пакет.Каталог).Содержит(ИмяПакета);
	Ожидаем.Что(Пакет.Причина).Содержит(ЧастьПричины);

КонецПроцедуры

Процедура ПроверитьТранзитивныйКонфликт(
	Конфликт,
	ИмяПакета,
	ТипКонфликта,
	ИсточникТребования,
	ТребуемаяВерсия,
	УстановленнаяВерсия,
	ЦепочкаЗависимостей
)

	Ожидаем.Что(Конфликт.ИмяПакета).Равно(ИмяПакета);
	Ожидаем.Что(Конфликт.ДляРазработки).ЭтоЛожь();
	Ожидаем.Что(Конфликт.ТипКонфликта).Равно(ТипКонфликта);
	Ожидаем.Что(Конфликт.ИсточникТребования).Равно(ИсточникТребования);
	Ожидаем.Что(Конфликт.ТребуемаяВерсия).Равно(ТребуемаяВерсия);
	Ожидаем.Что(Конфликт.УстановленнаяВерсия).Равно(УстановленнаяВерсия);
	Ожидаем.Что(Конфликт.ЦепочкаЗависимостей).Равно(ЦепочкаЗависимостей);

КонецПроцедуры

Функция ПолучитьЗависимостиПоУмолчанию()
	Возврат Новый ЗависимостиПакета().ЗаполнитьИзМанифеста("./tests/fixtures/packagedef");
КонецФункции

Процедура ЗаглушитьТекущиеКаталогиБиблиотек()

	ПомощникТестирования.УстановитьИзолированныеКаталогиБиблиотек(
		"./nonexistent",
		"./nonexistent"
	);

КонецПроцедуры
