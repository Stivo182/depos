#Использовать url
#Использовать "helpers"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОПоврежденномJSONВерсийOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, "{");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОтсутствииМассиваВерсийOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, "{}");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	Ожидаем.Что(ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка))
		.Содержит("ответ не содержит корректных доступных версий");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНеверномТипеЭлементаВерсийOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, "{""versions"":[1]}");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтфильтроватьНестрогиеSemverВерсииOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Ответ = "{""versions"":["
		+ "{""version"":""1"",""yanked"":false},"
		+ "{""version"":""1.0"",""yanked"":false},"
		+ "{""version"":""01.0.0"",""yanked"":false},"
		+ "{""version"":""v1.0.0"",""yanked"":false},"
		+ "{""version"":""1.0.0"",""yanked"":false}]}";
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, Ответ);
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета.Количество()).Равно(1);
	Ожидаем.Что(ВерсииПакета[0]).Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНеверныхТипахПолейВерсииOpenHub() Экспорт

	// Подготовка
	Ответы = Новый Массив;
	Ответы.Добавить("{""versions"":[{""version"":100,""yanked"":false}]}");
	Ответы.Добавить("{""versions"":[{""version"":""1.0.0"",""yanked"":""true""}]}");

	// Действие и Проверка
	Для Каждого Ответ Из Ответы Цикл
		Реестр = Новый URL("https://openhub.example");
		Транспорт = Новый ФейкТранспортРеестраПакетов;
		Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, Ответ);
		Адаптер = Новый АдаптерOpenHub(Транспорт);

		Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПроксиВЗапросВерсийOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Прокси = Новый URL("http://proxy.example:8080");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, КорректныеВерсии());
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Адаптер.ПолучитьВерсии("autumn", Реестр, Прокси);

	// Проверка
	Ожидаем.Что(Транспорт.Прокси()[0].ВСтроку()).Равно("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеТранспортаOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://user:registry-secret@openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьИсключение(АдресВерсий(Реестр, "default"), "технические подробности");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Содержит("openhub.example");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("registry-secret");

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ИспользоватьПулDefaultЕслиПулНеУказан() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, КорректныеВерсии());
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("1.0.0");
	Ожидаем.Что(Транспорт.Адреса()).ИмеетДлину(1);
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку())
		.Равно("https://openhub.example/api/v1/pools/default/packages/autumn/versions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЗапросВАдресеВерсийЯвногоПула() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example/private?tenant=alpha");
	КорневойРеестр = Новый URL("https://openhub.example/?tenant=alpha");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(КорневойРеестр, "private"), 200, КорректныеВерсии());
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	ДоступныеВерсии = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено, "private");

	// Проверка
	Ожидаем.Что(ДоступныеВерсии).Содержит("1.0.0");
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку())
		.Равно("https://openhub.example/api/v1/pools/private/packages/autumn/versions?tenant=alpha");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивПриПустомVersions() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "private"), 200, "{""versions"":[]}");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	ДоступныеВерсии = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено, "private");

	// Проверка
	Ожидаем.Что(ДоступныеВерсии).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивДляНенайденногоПакетаOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 404, "Пакет не найден");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

