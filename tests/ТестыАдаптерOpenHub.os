&Тест
Процедура ТестДолжен_ОтфильтроватьНекорректныеВерсииOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Ответ = "{""versions"":["
		+ "{""version"":""1"",""yanked"":false},"
		+ "{""version"":""1.0"",""yanked"":false},"
		+ "{""version"":""01.0.0"",""yanked"":false},"
		+ "{""version"":""v1.0.0"",""yanked"":false},"
		+ "{""version"":""1.2.3.4"",""yanked"":false},"
		+ "{""version"":""1.0.0"",""yanked"":false}]}";
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, Ответ);
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета.Количество()).Равно(2);
	Ожидаем.Что(ВерсииПакета).Содержит("1.0.0");
	Ожидаем.Что(ВерсииПакета).Содержит("1.2.3.4");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНеверныхТипахПолейВерсииOpenHub() Экспорт

	// Подготовка
	Ответы = Новый Массив;
	Ответы.Добавить("{""versions"":[{""version"":100,""yanked"":false}]}");
	Ответы.Добавить("{""versions"":[{""version"":""1.0.0"",""yanked"":""true""}]}");

	// Действие и Проверка
	Для Каждого Ответ Из Ответы Цикл
		Реестр = Новый URL("https://openhub.example");
		Транспорт = Новый ФейкТранспортРеестраПакетов;
		Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, Ответ);
		Адаптер = СоздатьАдаптер(Транспорт);

		Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.registry.unavailable");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПроксиВЗапросВерсийOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Прокси = Новый URL("http://proxy.example:8080");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 200, КорректныеВерсии());
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Адаптер.ПолучитьВерсии("autumn", Реестр, Прокси);

	// Проверка
	Ожидаем.Что(Транспорт.Прокси()[0].ВСтроку()).Равно("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеТранспортаOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://user:registry-secret@openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	ТекстИсключения = "{Модуль ЗапросHTTP.os / Ошибка в строке: 1 / Внешнее исключение "
		+ "(System.Net.WebException): The operation has timed out.}";
	Транспорт.НастроитьИсключение(АдресВерсий(Реестр, "default"), ТекстИсключения);
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.registry.unavailable");
	Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, "http.operation.timed_out")).ЭтоИстина();
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("Истекло время ожидания HTTP-операции");
	Ожидаем.Что(ПредставлениеОшибки).Содержит("openhub.example");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("registry-secret");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("ЗапросHTTP.os");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("The operation has timed out.");
	Ожидаем.Что(ПредставлениеОшибки).Содержит("DEPOS_REGISTRY_TIMEOUT");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("DNS");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("прокси");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("TLS");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДатьСпециальныеПодсказкиДляОшибокТранспортаOpenHub() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура(
		"ТекстИсключения,КодОшибки,Подсказка",
		"{Модуль ЗапросHTTP.os / Ошибка в строке: 1 / Внешнее исключение "
			+ "(System.Net.WebException): en = 'Name or service not known'}",
		"network.name_resolution.failed",
		"DNS"
	));
	Ошибки.Добавить(Новый Структура(
		"ТекстИсключения,КодОшибки,Подсказка",
		"{Модуль ЗапросHTTP.os / Ошибка в строке: 1 / Внешнее исключение "
			+ "(System.Net.WebException): en = 'Connection refused'}",
		"network.connection.refused",
		"адрес, порт"
	));
	Ошибки.Добавить(Новый Структура(
		"ТекстИсключения,КодОшибки,Подсказка",
		"{Модуль ЗапросHTTP.os / Ошибка в строке: 1 / Внешнее исключение "
			+ "(System.Net.WebException): The request failed with status code '407'}",
		"proxy.authentication.required",
		"аутентификацию прокси"
	));
	Ошибки.Добавить(Новый Структура(
		"ТекстИсключения,КодОшибки,Подсказка",
		"{Модуль ЗапросHTTP.os / Ошибка в строке: 1 / Внешнее исключение "
			+ "(System.Net.WebException): The SSL connection could not be established, see inner exception.}",
		"network.tls.handshake.failed",
		"TLS-соединение"
	));

	// Действие и Проверка
	Для Каждого ДанныеОшибки Из Ошибки Цикл
		Реестр = Новый URL("https://openhub.example");

		Транспорт = Новый ФейкТранспортРеестраПакетов;
		Транспорт.НастроитьИсключение(АдресВерсий(Реестр, "default"), ДанныеОшибки.ТекстИсключения);
		Адаптер = СоздатьАдаптер(Транспорт);

		Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);
		ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);

		Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, ДанныеОшибки.КодОшибки)).ЭтоИстина();
		Ожидаем.Что(ПредставлениеОшибки).Содержит(ДанныеОшибки.Подсказка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереопределятьСтруктурированнуюОшибкуРеестраOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	ИсходнаяОшибка = Новый ПостроительОшибки("registry.authorization_required", "Требуется авторизация")
		.Построить();
	Транспорт.НастроитьИсключение(АдресВерсий(Реестр, "default"), ИсходнаяОшибка);
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.authorization_required");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПоказыватьНеизвестнуюТехническуюОшибкуТранспортаOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьИсключение(
		АдресВерсий(Реестр, "default"),
		"{Модуль ЗапросHTTP.os / пароль proxy-secret}"
	);
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("Транспортная ошибка");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("ЗапросHTTP.os");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("proxy-secret");
	Ожидаем.Что(ПредставлениеОшибки).Содержит("Проверьте доступность реестра и настройки сети.");

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_РазрешитьВерсиюСУчетомДвижкаИИсходногоАдреса() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example/private?tenant=alpha");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Адрес = Новый URL("https://openhub.example/private/api/v1/pools/private/packages/autumn/resolve?tenant=alpha");
	Адрес.ПараметрыЗапроса().Установить("spec", ">=1.2.3 <2.0.0-0");
	Адрес.ПараметрыЗапроса().Установить("engine", "2.1.0");
	Транспорт.НастроитьОтвет(Адрес, 200,
		"{""version"":""1.3.0"",""engine_version"":""2.0.0"",""yanked"":false}");
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Версия = Адаптер.РазрешитьВерсию("autumn", ">=1.2.3 <2.0.0-0", "2.1.0",
		Реестр, Неопределено, "private");

	// Проверка
	Ожидаем.Что(Версия).Равно("1.3.0");
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку()).Равно(Адрес.ВСтроку());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОтветРезолваБезТребованияКДвижку() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Адрес = Новый URL("https://openhub.example/api/v1/pools/default/packages/autumn/resolve");
	Адрес.ПараметрыЗапроса().Установить("spec", ">=0.0.0-0");
	Адрес.ПараметрыЗапроса().Установить("engine", "2.1.0");
	Транспорт.НастроитьОтвет(Адрес, 200, "{""version"":""1.0.0"",""yanked"":false}");
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Попытка
		Адаптер.РазрешитьВерсию("autumn", ">=0.0.0-0", "2.1.0", Реестр, Неопределено);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.registry.unavailable");

КонецПроцедуры

