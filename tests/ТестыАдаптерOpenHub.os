&Тест
Процедура ТестДолжен_СохранитьБазовыйПутьВАдресеВерсийЯвногоПула() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example/private?tenant=alpha");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "private"), 200, КорректныеВерсии());
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	ДоступныеВерсии = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено, "private");

	// Проверка
	Ожидаем.Что(ДоступныеВерсии).Содержит("1.0.0");
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку())
		.Равно("https://openhub.example/private/api/v1/pools/private/packages/autumn/versions?tenant=alpha");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивПриПустомVersions() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "private"), 200, "{""versions"":[]}");
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	ДоступныеВерсии = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено, "private");

	// Проверка
	Ожидаем.Что(ДоступныеВерсии).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивДляНенайденногоПакетаOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 404, "Пакет не найден");
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОHTTPОшибкеOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "default"), 503, "Сервис недоступен");
	Адаптер = СоздатьАдаптер(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.registry.unavailable");
	Ожидаем.Что(ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка)).Содержит("HTTP 503");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьАдаптер(Транспорт)

	ДубКлассификатора = Новый ДубКлассификатораОшибок;

	Возврат Новый АдаптерOpenHub(Транспорт, ДубКлассификатора.КлассификаторНативныхОшибок());

КонецФункции

Функция КорректныеВерсии()

	Возврат "{""versions"":[{""version"":""1.0.0"",""yanked"":false}]}";

КонецФункции

Функция АдресВерсий(Реестр, ИмяПула)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментыПути(СтрРазделить("api/v1/pools", "/", Ложь));
	Адрес.ДобавитьСегментПути(ИмяПула);
	Адрес.ДобавитьСегментПути("packages");
	Адрес.ДобавитьСегментПути("autumn");
	Адрес.ДобавитьСегментПути("versions");

	Возврат Адрес;

КонецФункции

Функция ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр)

	Попытка
		Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
