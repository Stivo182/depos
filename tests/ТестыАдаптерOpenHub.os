&Тест
Процедура ТестДолжен_СообщитьОбОшибкеТранспортаOpenHub() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Транспорт.НастроитьИсключение(АдресПулов(Реестр, 1), "пароль secret");
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("secret");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НастроитьКорректныеОтветы(Транспорт, Реестр)

	НастроитьКорректныйОтветПулов(Транспорт, Реестр);
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "public"), 200, КорректныеВерсии());
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "public", "winter"), 200, КорректныеВерсии());

КонецПроцедуры

Процедура НастроитьКорректныйОтветПулов(Транспорт, Реестр)

	Пулы = "{""items"":[{""name"":""public"",""visibility"":""public"",""default"":true}],"
		+ """page"":1,""pageSize"":100,""total"":1}";
	Транспорт.НастроитьОтвет(АдресПулов(Реестр, 1), 200, Пулы);

КонецПроцедуры

Функция КорректныеВерсии()

	Возврат "{""versions"":[{""version"":""1.0.0"",""yanked"":false}]}";

КонецФункции

Функция АдресПулов(Реестр, НомерСтраницы)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	ПараметрыЗапроса = Новый ПараметрыЗапросаURL;
	ПараметрыЗапроса.Добавить("page", Формат(НомерСтраницы, "ЧГ="));
	ПараметрыЗапроса.Добавить("pageSize", "100");
	Адрес.УстановитьПараметрыЗапроса(ПараметрыЗапроса);

	Возврат Адрес;

КонецФункции

Функция АдресВерсий(Реестр, ИмяПула, ИмяПакета = "autumn")

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	Адрес.ДобавитьСегментПути(ИмяПула);
	Адрес.ДобавитьСегментПути("packages");
	Адрес.ДобавитьСегментПути(ИмяПакета);
	Адрес.ДобавитьСегментПути("versions");

	Возврат Адрес;

КонецФункции

Функция ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр)

	Попытка
		Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуПолученияВерсийИзПула(Адаптер, Реестр, Пул)

	Попытка
		Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено, Пул);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьОшибкуСтруктурыJSON(Ошибка)

	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	Ожидаем.Что(ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка))
		.Содержит("некорректная структура JSON OpenHub");

КонецПроцедуры

#КонецОбласти
