	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.registry.resolve_rejected");
	Ожидаем.Что(Ошибка.Описание).Содержит("invalid_spec");

