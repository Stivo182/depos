#Область Тесты

&Тест
Процедура ТестДолжен_ПолучитьДоступныеВерсииИзОсновногоПубличногоПула() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Пулы = "{""items"":[{""name"":""private"",""visibility"":""private"",""default"":false},"
		+ "{""name"":""public"",""visibility"":""public"",""default"":true}],"
		+ """page"":1,""pageSize"":100,""total"":2}";
	ОтветСВерсиями = "{""versions"":["
		+ "{""version"":""1.0.0"",""yanked"":false},"
		+ "{""version"":""1.1.0"",""yanked"":true},"
		+ "{""version"":""broken"",""yanked"":false}]}";
	Транспорт.НастроитьОтвет(АдресПулов(Реестр, 1), 200, Пулы);
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "public"), 200, ОтветСВерсиями);
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета.Количество()).Равно(1);
	Ожидаем.Что(ВерсииПакета[0]).Равно("1.0.0");
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку())
		.Равно("https://openhub.example/api/v1/pools?page=1&pageSize=100");
	Ожидаем.Что(Транспорт.Адреса()[1].ВСтроку())
		.Равно("https://openhub.example/api/v1/pools/public/packages/autumn/versions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакэшироватьОсновнойПубличныйПул() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьКорректныеОтветы(Транспорт, Реестр);
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);
	Адаптер.ПолучитьВерсии("winter", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(Транспорт.Адреса().Количество()).Равно(3);
	Ожидаем.Что(Транспорт.Адреса()[2].ВСтроку())
		.Равно("https://openhub.example/api/v1/pools/public/packages/winter/versions");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОсновнойПулНаСледующейСтранице() Экспорт

	// Подготовка
	Реестр = Новый URL("https://openhub.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	ПервыеПулы = "{""items"":[{""name"":""private"",""visibility"":""private"",""default"":true}],"
		+ """page"":1,""pageSize"":100,""total"":101}";
	ВторыеПулы = "{""items"":[{""name"":""public"",""visibility"":""public"",""default"":true}],"
		+ """page"":2,""pageSize"":100,""total"":101}";
	Транспорт.НастроитьОтвет(АдресПулов(Реестр, 1), 200, ПервыеПулы);
	Транспорт.НастроитьОтвет(АдресПулов(Реестр, 2), 200, ВторыеПулы);
	Транспорт.НастроитьОтвет(АдресВерсий(Реестр, "public"), 200, КорректныеВерсии());
	Адаптер = Новый АдаптерOpenHub(Транспорт);

	// Действие
	Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(Транспорт.Адреса()[1].ВСтроку())
		.Равно("https://openhub.example/api/v1/pools?page=2&pageSize=100");

КонецПроцедуры

