#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ВзятьВерсиюСредыИзPackagedef() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();

	// Действие
	Результат = Определитель.Определить(РежимыВерсииДвижка.Автоматический(),
		ПомощникТестирования.ФайлМанифеста);

	// Проверка
	Ожидаем.Что(Результат).Равно("1.9.3");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьВерсиюСредыИзOpmMetadata() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();

	// Действие
	Результат = Определитель.Определить(РежимыВерсииДвижка.Автоматический(),
		ПомощникТестирования.ФайлМанифестаOpmMetadata);

	// Проверка
	Ожидаем.Что(Результат).Равно("1.9.3");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВзятьТекущуюВерсиюЕслиМанифестБезТребования() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();
	ОжидаемаяВерсия = Новый СистемнаяИнформация().Версия;

	// Действие
	Результат = Определитель.Определить(РежимыВерсииДвижка.Автоматический(),
		"./tests/fixtures/packagedef-no-engine");

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемаяВерсия);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьТекущуюВерсиюOneScript() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();
	ОжидаемаяВерсия = Новый СистемнаяИнформация().Версия;

	// Действие
	Результат = Определитель.Определить(РежимыВерсииДвижка.Текущий(),
		ПомощникТестирования.ФайлМанифеста);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемаяВерсия);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьRcВерсиюДвижка() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();

	// Действие
	Результат = Определитель.Определить("2.2.1-rc.1", ПомощникТестирования.ФайлМанифеста);

	// Проверка
	Ожидаем.Что(Результат).Равно("2.2.1-rc.1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректнуюВерсиюДвижка() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();
	Ошибка = Неопределено;

	// Действие
	Попытка
		Определитель.Определить("2.x", ПомощникТестирования.ФайлМанифеста);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Заполнено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.engine.version_invalid");
	Ожидаем.Что(Ошибка.Описание).Содержит("2.x");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректноеТребованиеИзМанифеста() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВерсииДвижка();
	Ошибка = Неопределено;

	// Действие
	Попытка
		Определитель.Определить(РежимыВерсииДвижка.Автоматический(),
			"./tests/fixtures/packagedef-invalid-engine");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Заполнено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("depos.engine.version_invalid");
	Ожидаем.Что(Ошибка.Описание).Содержит("2.x");

КонецПроцедуры

#КонецОбласти
