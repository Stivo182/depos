Перем ФайлМанифеста Экспорт; // Строка
Перем ФайлОбновленногоМанифеста Экспорт; // Строка
Перем ФайлМанифестаOpmMetadata Экспорт; // Строка

Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов

// Проверяет непосредственную причину структурированной ошибки.
//
// Параметры:
//   Ошибка - ИнформацияОбОшибке - Проверяемая ошибка.
//   КодПричины - Строка - Ожидаемый код непосредственной причины.
Процедура ПроверитьПричинуОшибки(Ошибка, КодПричины) Экспорт

	Ожидаем.Что(Ошибка.Причина).Заполнено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка.Причина)).Равно(КодПричины);

КонецПроцедуры

Функция СоздатьВременныйФайл(Расширение = Неопределено) Экспорт
	Возврат _МенеджерВременныхФайлов.СоздатьФайл(Расширение);
КонецФункции

Функция СоздатьВременнуюКопиюФайла(Путь) Экспорт
	ВременныйФайл = _МенеджерВременныхФайлов.СоздатьФайл(Новый Файл(Путь).Расширение);
	КопироватьФайл(Путь, ВременныйФайл);
	Возврат ВременныйФайл;
КонецФункции

Процедура УдалитьВременныеФайлы() Экспорт
	_МенеджерВременныхФайлов.Удалить();
КонецПроцедуры

Процедура ОжидаемЧтоФайлыИдентичны(ФайлПроверяемый, ФайлОжидаемый, Сообщение = "") Экспорт
	Ожидаем.Что(СодержимоеФайла(ФайлПроверяемый), Сообщение).Равно(СодержимоеФайла(ФайлОжидаемый));
КонецПроцедуры

// Проверяет побайтовую идентичность двух файлов.
//
// Параметры:
//   ФайлПроверяемый - Строка - Путь к проверяемому файлу.
//   ФайлОжидаемый   - Строка - Путь к ожидаемому файлу.
//   Сообщение       - Строка - Дополнительное сообщение проверки.
Процедура ОжидаемЧтоФайлыПобайтовоИдентичны(ФайлПроверяемый, ФайлОжидаемый, Сообщение = "") Экспорт

	ПроверяемыеДанные = Новый ДвоичныеДанные(ФайлПроверяемый);
	ОжидаемыеДанные = Новый ДвоичныеДанные(ФайлОжидаемый);

	Ожидаем.Что(ПолучитьBase64СтрокуИзДвоичныхДанных(ПроверяемыеДанные), Сообщение)
		.Равно(ПолучитьBase64СтрокуИзДвоичныхДанных(ОжидаемыеДанные));

КонецПроцедуры

// Возвращает количество последовательных UTF-8 BOM в начале файла.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к проверяемому файлу.
//
// Возвращаемое значение:
//   Число - Количество последовательных сигнатур EF BB BF в начале файла.
Функция КоличествоBOMВНачале(ПутьКФайлу) Экспорт

	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);
	КоличествоBOM = 0;
	Смещение = 0;

	Пока Буфер.Размер >= Смещение + 3
		И Буфер.Получить(Смещение) = 239
		И Буфер.Получить(Смещение + 1) = 187
		И Буфер.Получить(Смещение + 2) = 191 Цикл

		КоличествоBOM = КоличествоBOM + 1;
		Смещение = Смещение + 3;

	КонецЦикла;

	Возврат КоличествоBOM;

КонецФункции

// Записывает текстовый файл в UTF-8 с заданным наличием BOM.
//
// Параметры:
//   ПутьКФайлу    - Строка - Путь к записываемому файлу.
//   Содержимое    - Строка - Содержимое файла.
//   СодержитBOM   - Булево - Признак добавления UTF-8 BOM.
Процедура ЗаписатьФайлUTF8(ПутьКФайлу, Содержимое, СодержитBOM) Экспорт

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Содержимое, КодировкаТекста.UTF8, СодержитBOM);
	ДвоичныеДанные.Записать(ПутьКФайлу);

КонецПроцедуры

Функция СодержимоеФайла(Файл) Экспорт
	ЧтениеТекста = Новый ЧтениеТекста(Файл);
	Содержимое = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	Возврат Содержимое;
КонецФункции

Функция ПерехватитьПотокВывода() Экспорт

	ПотокВывода = Новый ПотокВПамяти();

	Если Консоль.КодировкаВыходногоПотока <> КодировкаТекста.UTF8 Тогда
		Консоль.КодировкаВыходногоПотока = КодировкаТекста.UTF8;
		НаборСимволов.Обновить();
	КонецЕсли;

	Консоль.УстановитьПотокВывода(ПотокВывода);

	Возврат ПотокВывода;

КонецФункции

Процедура ВернутьПотокВывода() Экспорт
	Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());
КонецПроцедуры

// Изолирует поиск библиотек от конфигурации процесса, запускающего тесты.
//
// Оба параметра задаются всегда, чтобы lib.system и lib.additional из OneUnit
// или глобальной установки OneScript не участвовали в поиске тестовых пакетов.
//
// Параметры:
//   ОсновнойКаталог       - Строка - Значение параметра lib.system.
//   ДополнительныйКаталог - Строка - Значение параметра lib.additional.
Процедура УстановитьИзолированныеКаталогиБиблиотек(ОсновнойКаталог, ДополнительныйКаталог) Экспорт

	Параметры = Новый Массив();
	Параметры.Добавить("lib.system=" + ОсновнойКаталог);
	Параметры.Добавить("lib.additional=" + ДополнительныйКаталог);

	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", СтрСоединить(Параметры, ";"));

КонецПроцедуры

Функция ПолучитьТекстИзПотокаВывода(ПотокВывода) Экспорт

	Консоль.УстановитьПотокВывода(Консоль.ОткрытьСтандартныйПотокВывода());

	ПотокВывода.Перейти(0, ПозицияВПотоке.Начало);
	ЧтениеТекста = Новый ЧтениеТекста(ПотокВывода, Консоль.КодировкаВыходногоПотока);

	ТекстВывода = ЧтениеТекста.Прочитать();
	ТекстВывода = СтрЗаменить(ТекстВывода, Символы.ВК, "");
	ТекстВывода = СтрЗаменить(ТекстВывода, Символ(26), "→");

	ПотокВывода.Закрыть();

	ВернутьПотокВывода();

	Возврат ТекстВывода;
	
КонецФункции

Функция ПолучитьОригинальныйЖелудь(Поделка, Имя) Экспорт

	Желудь = Поделка.НайтиЖелудь(Имя);
	Если ТипЗнч(Желудь) = Тип(Имя) Тогда
		Возврат Желудь;
	КонецЕсли;

	Рефлектор = Новый Рефлектор();

	ИнициализированныеЖелудиОдиночки = Рефлектор.ПолучитьСвойство(Поделка, "ИнициализированныеЖелудиОдиночки");
	ИнициализированныеЖелудиОдиночки.Удалить(Имя);

	ФабрикаЖелудей = Рефлектор.ПолучитьСвойство(Поделка, "ФабрикаЖелудей");

	ОпределенияЖелудейПоИмени = Рефлектор.ПолучитьСвойство(ФабрикаЖелудей, "ОпределенияЖелудейПоИмени");
	ОпределенияЖелудейПоИмени.Удалить(Имя);
	
	ФабрикаЖелудей.ДобавитьЖителяЛеса(Тип(Имя), "", "Желудь");

	Возврат Поделка.НайтиЖелудь(Имя);

КонецФункции

Функция ОтладочнаяПоделка() Экспорт

	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	НастройкиПриложения = Поделка.НайтиЖелудь("НастройкиПриложения");
	НастройкиПриложения.РежимОтладки = Истина;

	Возврат Поделка;

КонецФункции

_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
ФайлМанифеста = "./tests/fixtures/packagedef";
ФайлОбновленногоМанифеста = "./tests/fixtures/packagedef-verified-latest";
ФайлМанифестаOpmMetadata = "./tests/fixtures/oscript_modules/mypackage/opm-metadata.xml";
