#Использовать asserts

#Область ПрограммныйИнтерфейс

// Выбирает диагностические элементы по пакету и необязательным признакам.
//
// Параметры:
//   Элементы - Массив - Диагностические элементы или требования.
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево, Неопределено - Контекст зависимости.
//   ТипКонфликта - Строка, Неопределено - Вид конфликта.
//
// Возвращаемое значение:
//   Массив
Функция НайтиПакеты(Элементы, ИмяПакета, ДляРазработки = Неопределено, ТипКонфликта = Неопределено) Экспорт

	Результат = Новый Массив();
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.ИмяПакета = ИмяПакета
			И (ДляРазработки = Неопределено Или Элемент.ДляРазработки = ДляРазработки)
			И (ТипКонфликта = Неопределено Или Элемент.ТипКонфликта = ТипКонфликта) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Представляет структурированные цепочки для сравнения с ожидаемыми маршрутами.
//
// Параметры:
//   Элемент - ДиагностическийЭлементЗависимости - Проверяемая диагностика.
//
// Возвращаемое значение:
//   Массив из Строка
Функция Цепочки(Элемент) Экспорт

	Результат = Новый Массив();
	Для Каждого Требование Из Элемент.Требования Цикл
		Ожидаем.Что(ТипЗнч(Требование.ЦепочкаЗависимостей)).Равно(Тип("Массив"));
		Результат.Добавить(СтрСоединить(Требование.ЦепочкаЗависимостей, " -> "));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает источники структурированных требований для проверки состава.
//
// Параметры:
//   Элемент - ДиагностическийЭлементЗависимости - Проверяемая диагностика.
//   Корневые - Булево - Возвращать корневые прямые зависимости.
//
// Возвращаемое значение:
//   Массив из Строка
Функция Источники(Элемент, Корневые = Ложь) Экспорт

	Результат = Новый Массив();
	Для Каждого Требование Из Элемент.Требования Цикл
		Источник = ?(Корневые, Требование.КорневаяПрямаяЗависимость, Требование.ИсточникТребования);
		Если Результат.Найти(Источник) = Неопределено Тогда
			Результат.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Упорядочивает диагностические элементы для адресных проверок в тестах.
//
// Параметры:
//   Элементы - Массив - Диагностические элементы.
//   ПоКонфликту - Булево - Сначала сравнивать вид конфликта.
//
// Возвращаемое значение:
//   Массив из ДиагностическийЭлементЗависимости
Функция Упорядочить(Элементы, ПоКонфликту = Ложь) Экспорт

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("ИмяПакета");
	Таблица.Колонки.Добавить("ТипКонфликта");
	Таблица.Колонки.Добавить("Источник");
	Таблица.Колонки.Добавить("Элемент");
	Для Каждого Элемент Из Элементы Цикл
		Строка = Таблица.Добавить();
		Строка.ИмяПакета = Элемент.ИмяПакета;
		Строка.ТипКонфликта = Элемент.ТипКонфликта;
		Строка.Источник = ?(Элемент.Требования.Количество() = 0, "", Элемент.Требования[0].ИсточникТребования);
		Строка.Элемент = Элемент;
	КонецЦикла;
	Таблица.Сортировать(?(ПоКонфликту, "ТипКонфликта, ИмяПакета, Источник", "ИмяПакета"));

	Возврат Таблица.ВыгрузитьКолонку("Элемент");

КонецФункции

#КонецОбласти
