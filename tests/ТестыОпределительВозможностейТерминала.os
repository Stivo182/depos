#Использовать "helpers"

&Тест
Процедура ТестДолжен_ИспользоватьAsciiПрофильДляНеUnicodeКодировки() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВозможностейТерминала();

	// Действие
	Профиль = Определитель.ОпределитьДляКодировки(КодировкаТекста.ANSI);
	Текст = Определитель.ПрименитьПрофиль("× пакет 1.0 → >=2.0", Профиль);

	// Проверка
	Ожидаем.Что(Профиль.ЭтоЮникод).Равно(Ложь);
	Ожидаем.Что(Текст).Равно("[x] пакет 1.0 -> >=2.0");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("UTF8", "✕ ", "⚠ ", "ℹ", "↑", "→", "├─")
&ИсточникЗначение("CP866", "[x]", "[!]", "[i]", "^", "->", "├─")
&ИсточникЗначение("ASCII", "[x]", "[!]", "[i]", "^", "->", "|-")
Процедура ТестДолжен_ВыбратьНезависимыеНаборыСимволов(
	Режим, Ошибка, Предупреждение, Рекомендация, СтрелкаВверх, Стрелка, Ветка
) Экспорт

	// Подготовка
	Профиль = Новый ОпределительВозможностейТерминала().ОпределитьДляКодировки(КодировкаДляРежима(Режим));

	// Проверка
	Ожидаем.Что(Профиль.Режим).Равно(Режим);
	Ожидаем.Что(Профиль.Ошибка).Равно(Ошибка);
	Ожидаем.Что(Профиль.Предупреждение).Равно(Предупреждение);
	Ожидаем.Что(Профиль.Рекомендация).Равно(Рекомендация);
	Ожидаем.Что(Профиль.СтрелкаВверх).Равно(СтрелкаВверх);
	Ожидаем.Что(Профиль.Стрелка).Равно(Стрелка);
	Ожидаем.Что(Профиль.Ветка).Равно(Ветка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДобавлятьПостоянныеПризнакиВПрофиль() Экспорт

	// Подготовка
	Определитель = Новый ОпределительВозможностейТерминала();

	// Действие
	Профиль = Определитель.ОпределитьДляКодировки(КодировкаТекста.UTF8);

	// Проверка
	Ожидаем.Что(Профиль.Свойство("Цвет")).Равно(Ложь);
	Ожидаем.Что(Профиль.Свойство("Интерактивный")).Равно(Ложь);

КонецПроцедуры

Функция КодировкаДляРежима(Режим)

	Если Режим = "UTF8" Тогда
		Возврат КодировкаТекста.UTF8;
	ИначеЕсли Режим = "CP866" Тогда
		Возврат КодировкаТекста.OEM;
	КонецЕсли;

	Возврат КодировкаТекста.ANSI;

КонецФункции
