&Тест
Процедура ТестДолжен_ПолучитьРежимОтладкиИзПеременнойСреды() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("DEPOS_DEBUG", "true");
	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	// Действие
	НастройкиПриложения = Поделка.НайтиЖелудь("НастройкиПриложения");

	// Проверка
	Ожидаем.Что(НастройкиПриложения.РежимОтладкиВключен()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьРеестрыПоУмолчаниюИзПеременныхСреды() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("DEPOS_REGISTRY_PRIMARY", "https://primary.example");
