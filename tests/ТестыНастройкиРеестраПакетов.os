&Тест
Процедура ТестДолжен_ВернутьНезависимыеОбъектыАдресов() Экспорт

	// Подготовка
	Настройки = НастройкиРеестраБезOpm();
	Настройки.Применить("https://registry.example/base", "http://proxy.example:8080");
	Реестр = Настройки.Реестр();
	Прокси = Настройки.Прокси();

	// Действие
	Реестр.УстановитьПуть("/измененный-путь");
	Прокси.УстановитьПорт(8081);

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.example/base");
	Ожидаем.Что(Настройки.Серверы()[0].Пул).Равно("base");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьIPv6АдресаРеестраИПрокси() Экспорт

	// Подготовка
	Настройки = НастройкиРеестраБезOpm();

	// Действие
	Настройки.Применить("https://[2001:db8::1]:8443/base", "http://[2001:db8::2]:8080");

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://[2001:db8::1]:8443/base");
	Ожидаем.Что(Настройки.Серверы()[0].Пул).Равно("base");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://[2001:db8::2]:8080");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ftp://registry.example")
&ИсточникЗначение("http://")
&ИсточникЗначение("https://registry example")
&ИсточникЗначение("https://registry.example:70000")
&ИсточникЗначение("registry.example:70000")
Процедура ТестДолжен_ОтклонитьНекорректныйАдресРеестра(АдресРеестра) Экспорт

	// Подготовка
	Настройки = НастройкиРеестраБезOpm();

	// Действие
	Ошибка = ПолучитьОшибкуПрименения(Настройки, АдресРеестра);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.settings_invalid");
	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, "registry.settings_invalid");
	Ожидаем.Что(КадрОшибки.Данные()).Равно(Неопределено);

КонецПроцедуры

