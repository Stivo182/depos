&Тест
Процедура ТестДолжен_ВыбратьСерверOpmПоИмениИзЯвногоРеестра() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", "primary");
	СерверыOpm = Новый Массив;
	СерверыOpm.Добавить(СерверOpm("primary", "https://primary.example"));
	СерверыOpm.Добавить(СерверOpm("backup", "https://backup.example", "private", "Bearer token"));
	Провайдер = Новый ФейкПровайдерНастроекOpm(СерверыOpm);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Настройки.Применить("backup");
	Сервер = Настройки.Серверы()[0];

	// Проверка
	Ожидаем.Что(Провайдер.УчитыватьЗеркало()).ЭтоЛожь();
	Ожидаем.Что(Сервер.Реестр.ВСтроку()).Равно("https://backup.example");
	Ожидаем.Что(Сервер.Пул).Равно("private");
	Ожидаем.Что(Сервер.Заголовки.Получить("Authorization")).Равно("Bearer token");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОтсутствииИменованногоРеестра() Экспорт

	// Подготовка
	СерверыOpm = Новый Массив;
	СерверыOpm.Добавить(СерверOpm("primary", "https://primary.example"));
	Провайдер = Новый ФейкПровайдерНастроекOpm(СерверыOpm);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Ошибка = ПолучитьОшибкуПрименения(Настройки, "missing");

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.settings_invalid");
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("missing");
	Ожидаем.Что(ПредставлениеОшибки).Содержит("opm.cfg");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьЯвныйРеестрНезависимоОтOpmHubMirror() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", "unknown");
	Провайдер = Новый ФейкПровайдерНастроекOpm(Новый Массив);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Настройки.Применить("https://registry.cli/private");

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.cli/private");
	Ожидаем.Что(Настройки.Серверы()[0].Пул).Равно("private");
	Ожидаем.Что(Провайдер.УчитыватьЗеркало()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьРеестрыИзНастроекПриложения() Экспорт

	// Подготовка
	НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	НастройкиПриложения.ОсновнойРеестрПоУмолчанию = "ftp://primary.example";
	НастройкиПриложения.РезервныйРеестрПоУмолчанию = "";
	Провайдер = Новый ФейкПровайдерНастроекOpm(Новый Массив);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложения, Провайдер);

	// Действие
	Ошибка = ПолучитьОшибкуПрименения(Настройки, Неопределено);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.settings_invalid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьСерверИзПеременнойOpmHubMirror() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", "backup");
