&Тест
Процедура ТестДолжен_ДобавитьТолькоТокенИзДругогоПула() Экспорт

	// Подготовка
	ТочныйСервер = СерверOpm("private", "https://hub.example.com", "private");
	ТочныйСервер.Заголовки.Вставить("X-Organization", "private-team");
	ЗапаснойСервер = СерверOpm("another", "https://hub.example.com", "another", "Bearer token");
	ЗапаснойСервер.Заголовки.Вставить("X-Organization", "another-team");
	ЗапаснойСервер.Заголовки.Вставить("X-Another-Pool", "value");
	СерверыOpm = Новый Массив;
	СерверыOpm.Добавить(ТочныйСервер);
	СерверыOpm.Добавить(ЗапаснойСервер);
	Провайдер = Новый ФейкПровайдерНастроекOpm(СерверыOpm);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Настройки.Применить("https://hub.example.com/private");
	Заголовки = Настройки.Серверы()[0].Заголовки;

	// Проверка
	Ожидаем.Что(Заголовки.Получить("Authorization")).Равно("Bearer token");
	Ожидаем.Что(Заголовки.Получить("X-Organization")).Равно("private-team");
	Ожидаем.Что(Заголовки.Получить("X-Another-Pool")).Равно(Неопределено);

КонецПроцедуры

