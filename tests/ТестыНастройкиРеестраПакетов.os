#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкиРеестраБезOpm(НастройкиПриложения = Неопределено)

	Если НастройкиПриложения = Неопределено Тогда
		НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	КонецЕсли;

	Провайдер = Новый ФейкПровайдерНастроекOpm(Новый Массив);

	Возврат Новый НастройкиРеестраПакетов(НастройкиПриложения, Провайдер);

КонецФункции

Функция НастройкиПриложенияПоУмолчанию()

	Настройки = Новый НастройкиПриложения();
	Настройки.ОсновнойРеестрПоУмолчанию = "https://hub.oscript.io";
	Настройки.РезервныйРеестрПоУмолчанию = "http://hub.oscript.ru";

	Возврат Настройки;

КонецФункции

Функция СерверOpm(Имя, Адрес, Пул = "", Авторизация = "")

	Заголовки = Новый Соответствие;
	Если ЗначениеЗаполнено(Авторизация) Тогда
		Заголовки.Вставить("Authorization", Авторизация);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Адрес", Новый URL(Адрес));
	Результат.Вставить("Пул", Пул);
	Результат.Вставить("Заголовки", Заголовки);

	Возврат Результат;

КонецФункции

Функция ПолучитьОшибкуПрименения(
	Настройки,
	ОсновнойРеестр = Неопределено,
	Прокси = Неопределено
)

	Попытка
		Настройки.Применить(ОсновнойРеестр, Прокси);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ИменаПеременныхСреды()

	Имена = Новый Массив();
	Имена.Добавить("OPM_HUB_MIRROR");
	Имена.Добавить("DEPOS_DEBUG");
	Имена.Добавить("DEPOS_REGISTRY_PRIMARY");
	Имена.Добавить("DEPOS_REGISTRY_FALLBACK");

	Возврат Имена;

КонецФункции

Процедура ОчиститьПеременныеСреды()

	Для Каждого ИмяПеременной Из ИменаПеременныхСреды() Цикл
		УстановитьПеременнуюСреды(ИмяПеременной, "");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
