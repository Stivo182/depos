// BSLLS:MagicNumber-off

#Использовать url
#Использовать "helpers"

#Область ОписаниеПеременных

Перем _ИсходныеПеременныеСреды; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Импорты = "../oscript_modules/url,../oscript_modules/ip")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ИнициализироватьНабор() Экспорт

	_ИсходныеПеременныеСреды = Новый Соответствие();
	Для Каждого ИмяПеременной Из ИменаПеременныхСреды() Цикл
		_ИсходныеПеременныеСреды.Вставить(ИмяПеременной, ПолучитьПеременнуюСреды(ИмяПеременной));
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьТест() Экспорт

	ОчиститьПеременныеСреды();

КонецПроцедуры

&ПослеКаждого
Процедура ОчиститьТест() Экспорт

	Для Каждого Переменная Из _ИсходныеПеременныеСреды Цикл
		УстановитьПеременнуюСреды(Переменная.Ключ, Переменная.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьНастроенныйПулПоУмолчанию() Экспорт

	// Подготовка
	НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	НастройкиПриложения.ПулПоУмолчанию = "community";
	Настройки = НастройкиРеестраБезOpm(НастройкиПриложения);

	// Действие
	Пул = Настройки.ПулПоУмолчанию();

	// Проверка
	Ожидаем.Что(Пул).Равно("community");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьСерверыИзНастроекOpm() Экспорт

	// Подготовка
	СерверыOpm = Новый Массив;
	СерверыOpm.Добавить(СерверOpm("private", "https://hub.example.com", "private", "Bearer token"));
	Провайдер = Новый ФейкПровайдерНастроекOpm(СерверыOpm);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Настройки.Применить();
	Серверы = Настройки.Серверы();

	// Проверка
	Ожидаем.Что(Серверы).ИмеетДлину(1);
	Ожидаем.Что(Серверы[0].Реестр.ВСтроку()).Равно("https://hub.example.com");
	Ожидаем.Что(Серверы[0].Пул).Равно("private");
	Ожидаем.Что(Серверы[0].Заголовки.Получить("Authorization")).Равно("Bearer token");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьПроксиИзНастроекOpm() Экспорт

	// Подготовка
	СерверыOpm = Новый Массив;
	СерверыOpm.Добавить(СерверOpm("private", "https://hub.example.com"));
	ПроксиOpm = Новый Структура;
	ПроксиOpm.Вставить("ИспользоватьСистемный", Ложь);
	ПроксиOpm.Вставить("Сервер", "proxy.example.com");
	ПроксиOpm.Вставить("Порт", 8080);
	ПроксиOpm.Вставить("Пользователь", "user");
	ПроксиOpm.Вставить("Пароль", "password");
	ПроксиOpm.Вставить("ИспользоватьАутентификациюОС", Ложь);
	Провайдер = Новый ФейкПровайдерНастроекOpm(СерверыOpm, ПроксиOpm);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Настройки.Применить();
	Прокси = Настройки.Прокси();

	// Проверка
	Ожидаем.Что(Прокси.Сервер).Равно("proxy.example.com");
	Ожидаем.Что(Прокси.Порт).Равно(8080);
	Ожидаем.Что(Прокси.Пользователь).Равно("user");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьПулИзЯвногоАдресаХаба() Экспорт

	// Подготовка
	Провайдер = Новый ФейкПровайдерНастроекOpm(Новый Массив);
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию(), Провайдер);

	// Действие
	Настройки.Применить("https://hub.example.com/private");
	Сервер = Настройки.Серверы()[0];

	// Проверка
	Ожидаем.Что(Сервер.Реестр.ВСтроку()).Равно("https://hub.example.com/private");
	Ожидаем.Что(Сервер.Пул).Равно("private");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьТокенТочногоПула() Экспорт

