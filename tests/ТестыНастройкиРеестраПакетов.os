// BSLLS:MagicNumber-off

#Использовать url
#Использовать "helpers"

#Область ОписаниеПеременных

Перем _ИсходныеПеременныеСреды; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Импорты = "../oscript_modules/url,../oscript_modules/ip")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ИнициализироватьНабор() Экспорт

	_ИсходныеПеременныеСреды = Новый Соответствие();
	Для Каждого ИмяПеременной Из ИменаПеременныхСреды() Цикл
		_ИсходныеПеременныеСреды.Вставить(ИмяПеременной, ПолучитьПеременнуюСреды(ИмяПеременной));
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьТест() Экспорт

	ОчиститьПеременныеСреды();

КонецПроцедуры

&ПослеКаждого
Процедура ОчиститьТест() Экспорт

	Для Каждого Переменная Из _ИсходныеПеременныеСреды Цикл
		УстановитьПеременнуюСреды(Переменная.Ключ, Переменная.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_РазрешитьОсновнойРеестрПоПриоритетуИсточников() Экспорт

	// Подготовка
	НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложения);

	// Действие и Проверка
	Настройки.Применить();
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://hub.oscript.io");

	НастройкиПриложения.ОсновнойРеестр = "https://config.example/";
	Настройки.Применить();
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://config.example/");

	Настройки.Применить("http://cli.example///");
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("http://cli.example///");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьНастройкиРеестраИзПеременныхСреды() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("DEPOS_REGISTRY_URL", "https://registry.env");
	УстановитьПеременнуюСреды("DEPOS_REGISTRY_PROXY", "http://proxy.env:8081");
	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	// Действие
	Настройки = Поделка.НайтиЖелудь("НастройкиРеестраПакетов");
	Настройки.Применить();

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.env");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.env:8081");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьРежимОтладкиИзПеременнойСреды() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды("DEPOS_DEBUG", "true");
	Поделка = Новый Поделка();
	Поделка.ЗапуститьПриложение();

	// Действие
	НастройкиПриложения = Поделка.НайтиЖелудь("НастройкиПриложения");

	// Проверка
	Ожидаем.Что(НастройкиПриложения.РежимОтладкиВключен()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПроверятьДеталькиДоПримененияНастроекКоманднойСтроки() Экспорт

	// Подготовка
	НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	НастройкиПриложения.ОсновнойРеестр = "ftp://registry.config";
	НастройкиПриложения.ПроксиРеестра = "https://proxy.config";
	Ошибка = Неопределено;

	// Действие
	Попытка
		Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложения);
		Настройки.Применить("https://registry.cli", "http://proxy.cli:8080");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Равно(Неопределено);
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.cli");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.cli:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьПроксиПоПриоритетуИсточников() Экспорт

	// Подготовка
	НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложения);

	// Действие и Проверка
	Настройки.Применить();
	Ожидаем.Что(Настройки.Прокси()).Равно(Неопределено);

	НастройкиПриложения.ПроксиРеестра = "http://proxy.config:8080/";
	Настройки.Применить();
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.config:8080/");

	Настройки.Применить(Неопределено, "http://user:pass@proxy.cli:8082/");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://user:pass@proxy.cli:8082/");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьПроцентноКодированныйПарольПрокси() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Настройки.Применить(Неопределено, "http://user:p%40ss%3Aword@proxy.example:8080");

	// Проверка
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://user:p%40ss%3Aword@proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКодированныйСлешВПутиРеестра() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Настройки.Применить("https://registry.example/base%2Ftenant/", Неопределено);

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.example/base%2Ftenant/");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИсходноеНаписаниеURL() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());
	АдресРеестра = "HTTPS://Registry.Example:443/a/../%7Euser";

	// Действие
	Настройки.Применить(АдресРеестра);

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно(АдресРеестра);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыеОбъектыАдресов() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());
	Настройки.Применить("https://registry.example/base", "http://proxy.example:8080");
	Реестр = Настройки.Реестр();
	Прокси = Настройки.Прокси();

	// Действие
	Реестр.УстановитьПуть("/измененный-путь");
	Прокси.УстановитьПорт(8081);

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.example/base");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьIPv6АдресаРеестраИПрокси() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Настройки.Применить("https://[2001:db8::1]:8443/base", "http://[2001:db8::2]:8080");

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://[2001:db8::1]:8443/base");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://[2001:db8::2]:8080");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ftp://registry.example")
&ИсточникЗначение("registry.example")
&ИсточникЗначение("http://")
&ИсточникЗначение("https://registry example")
&ИсточникЗначение("https://registry.example:70000")
Процедура ТестДолжен_ОтклонитьНекорректныйАдресРеестра(АдресРеестра) Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Ошибка = ПолучитьОшибкуПрименения(Настройки, АдресРеестра);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.settings_invalid");
	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, "registry.settings_invalid");
	Ожидаем.Что(КадрОшибки.Данные()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://proxy.example:8080")
&ИсточникЗначение("proxy.example:8080")
&ИсточникЗначение("http://proxy example:8080")
&ИсточникЗначение("http://proxy.example:70000")
&ИсточникЗначение("http://user:pass@word@proxy.example:8080")
&ИсточникЗначение("http://user:%ZZ@proxy.example:8080")
Процедура ТестДолжен_ОтклонитьНекорректныйАдресПрокси(АдресПрокси) Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Ошибка = ПолучитьОшибкуПрименения(
		Настройки,
		Неопределено,
		АдресПрокси
	);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.settings_invalid");
	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, "registry.settings_invalid");
	Ожидаем.Что(КадрОшибки.Данные()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://registry.example:0")
&ИсточникЗначение("https://registry.example?token=value")
&ИсточникЗначение("https://registry.example#fragment")
Процедура ТестДолжен_ПринятьURLРеестраСоСхемноДопустимымиКомпонентами(АдресРеестра) Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Настройки.Применить(АдресРеестра);

	// Проверка
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно(АдресРеестра);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("http://proxy.example:8080/path")
&ИсточникЗначение("http://proxy.example:8080?token=value")
Процедура ТестДолжен_ПринятьURLПроксиСоСхемноДопустимымиКомпонентами(АдресПрокси) Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Настройки.Применить(Неопределено, АдресПрокси);

	// Проверка
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно(АдресПрокси);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПередатьПарольПроксиВДиагностикуОшибки() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());

	// Действие
	Ошибка = ПолучитьОшибкуПрименения(
		Настройки,
		Неопределено,
		"ftp://user:secret@proxy.example:8080"
	);

	// Проверка
	Диагностика = ДиагностикаОшибок.ДиагностическоеПредставление(Ошибка);
	Ожидаем.Что(Диагностика).Не_().Содержит("secret");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьПроксиБезПредварительногоДекодированияПароля() Экспорт

	// Подготовка
	Настройки = Новый НастройкиРеестраПакетов(НастройкиПриложенияПоУмолчанию());
	АдресПрокси = "http://user:%FF@proxy.example:8080";

	// Действие
	Настройки.Применить(Неопределено, АдресПрокси);

	// Проверка
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно(АдресПрокси);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкиПриложенияПоУмолчанию()

	Настройки = Новый НастройкиПриложения();
	Настройки.ОсновнойРеестр = "https://hub.oscript.io";
	Настройки.ПроксиРеестра = "";

	Возврат Настройки;

КонецФункции

Функция ПолучитьОшибкуПрименения(
	Настройки,
	ОсновнойРеестр = Неопределено,
	Прокси = Неопределено
)

	Попытка
		Настройки.Применить(ОсновнойРеестр, Прокси);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ИменаПеременныхСреды()

	Имена = Новый Массив();
	Имена.Добавить("DEPOS_REGISTRY_URL");
	Имена.Добавить("DEPOS_REGISTRY_PROXY");
	Имена.Добавить("DEPOS_DEBUG");

	Возврат Имена;

КонецФункции

Процедура ОчиститьПеременныеСреды()

	Для Каждого ИмяПеременной Из ИменаПеременныхСреды() Цикл
		УстановитьПеременнуюСреды(ИмяПеременной, "");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
