&Тест
Процедура ТестДолжен_НеПроверятьДеталькиДоПримененияНастроекКоманднойСтроки() Экспорт

	// Подготовка
	НастройкиПриложения = НастройкиПриложенияПоУмолчанию();
	Ошибка = Неопределено;

	// Действие
	Попытка
		Настройки = НастройкиРеестраБезOpm(НастройкиПриложения);
		Настройки.Применить("https://registry.cli", "http://proxy.cli:8080");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Равно(Неопределено);
	Ожидаем.Что(Настройки.Реестр().ВСтроку()).Равно("https://registry.cli");
	Ожидаем.Что(Настройки.Прокси().ВСтроку()).Равно("http://proxy.cli:8080");

КонецПроцедуры

