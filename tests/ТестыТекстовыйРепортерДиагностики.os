&Тест
Процедура ТестДолжен_ВывестиУдалениеСтруктурнойРекомендацииОднойСтрокой() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьРекомендацию(
		"asserts",
		Истина,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки()
	);
	ИсходноеОбъявление = ".РазработкаЗависитОт(""asserts"", ""1.5.0"")";
	Элемент.КраткоеОписание = ИсходноеОбъявление + " → удалить";
	Элемент.ПодробнаяПричина = "Строка 4" + Символы.ПС + "Строка 5";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	ЦветнойТекст = Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина);
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(ЦветнойТекст);

	// Проверка
	СтрокаУдаления = "- " + ИсходноеОбъявление;
	Ожидаем.Что(Текст).Содержит(СтрокаУдаления);
	Ожидаем.Что(Текст).Не_().Содержит("+ удалить");
	Ожидаем.Что(ЦветнойТекст).Содержит("(" + СтрокаУдаления + "|#color=Красный)");
	Ожидаем.Что(ЦветнойТекст).Не_().Содержит("(+ удалить|#color=Зеленый)");
	Ожидаем.Что(Текст).Содержит(
		"       Причина: Строка 4" + Символы.ПС
			+ "                Строка 5"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьОбъявленияИУдаляемуюСтрокуДляПовтора() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПредупреждение(
		ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
		"duplicate",
		Ложь
	);
	Элемент.КраткоеОписание = "Строка 6: .ЗависитОт(""duplicate"", ""1.0.0"") → удалить повторное объявление";
	Элемент.ПодробнаяПричина = "Строка 4: .ЗависитОт(""duplicate"", ""1.0.0"")" + Символы.ПС
		+ "Строка 5: .ЗависитОт(""duplicate"", ""1.0.0"")" + Символы.ПС
		+ "Строка 6: .ЗависитОт(""duplicate"", ""1.0.0"")";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	ЦветнойТекст = Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина);
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(ЦветнойТекст);

	// Проверка
	СтрокаУдаления = "- .ЗависитОт(""duplicate"", ""1.0.0"")";
	Ожидаем.Что(Текст).Содержит(СтрокаУдаления + "  (строка 5)");
	Ожидаем.Что(Текст).Содержит(СтрокаУдаления + "  (строка 6)");
	Ожидаем.Что(ЦветнойТекст).Содержит(
		"(" + СтрокаУдаления + "|#color=Красный)  ((строка 5)|#color=ТемноСерый)"
	);
	Ожидаем.Что(Текст).Содержит("Оставить: Строка 4: .ЗависитОт(""duplicate"", ""1.0.0"")");
	Ожидаем.Что(Текст).Не_().Содержит("Строка 5: .ЗависитОт(""duplicate"", ""1.0.0"")");
	Ожидаем.Что(Текст).Не_().Содержит("Строка 6: .ЗависитОт(""duplicate"", ""1.0.0"")");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиИсправлениеИФайлыСтруктурнойДиагностики() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.ЗависимостьДляРазработкиВПроизводственномКоде(),
		"asserts",
		Истина
	);
	Элемент.КраткоеОписание = "Строка 7: .РазработкаЗависитОт(""asserts"", ""1.5.0"") → "
		+ ".ЗависитОт(""asserts"", ""1.5.0"")";
	Элемент.Файлы.Добавить("src/first.os");
	Элемент.Файлы.Добавить("src/last.os");
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Репортер = Новый ТекстовыйРепортерДиагностики();
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Репортер.Сформировать(Отчет, Истина)
	);

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("- .РазработкаЗависитОт(""asserts"", ""1.5.0"")");
	Ожидаем.Что(КраткийТекст).Содержит("+ .ЗависитОт(""asserts"", ""1.5.0"")");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("(строка 7)");
	Ожидаем.Что(ПодробныйТекст).Содержит(
		"- .РазработкаЗависитОт(""asserts"", ""1.5.0"")  (строка 7)"
	);
	Ожидаем.Что(ПодробныйТекст).Содержит("├─ src/first.os");
	Ожидаем.Что(ПодробныйТекст).Содержит("└─ src/last.os");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиЦепочкиТребованийСРекомендованнойВерсией() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьРекомендацию("entity", Ложь);
	Элемент.КраткоеОписание = ".ЗависитОт(""entity"", ""5.4.0"")  (строка 14)";
	Элемент.ТекущаяМинимальнаяВерсия = "5.4.0";
	ПервоеТребование = Новый ТребованиеЗависимости();
	ПервоеТребование.ИсточникТребования = "first";
	ПервоеТребование.ТребуемаяВерсия = ">=5.4.0";
	ПервоеТребование.ЦепочкаЗависимостей.Добавить("root");
	ПервоеТребование.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(ПервоеТребование);
	ТребованиеБезВерсии = Новый ТребованиеЗависимости();
	ТребованиеБезВерсии.ЦепочкаЗависимостей.Добавить("without-version");
	ТребованиеБезВерсии.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(ТребованиеБезВерсии);
	ПоследнееТребование = Новый ТребованиеЗависимости();
	ПоследнееТребование.ИсточникТребования = "last";
	ПоследнееТребование.ТребуемаяВерсия = ">=5.4.0";
	ПоследнееТребование.ЦепочкаЗависимостей.Добавить("last");
	ПоследнееТребование.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(ПоследнееТребование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина)
	);

	// Проверка
	Ожидаем.Что(Текст).Содержит("      ├─ root -> entity (>=5.4.0)");
	Ожидаем.Что(Текст).Содержит("      └─ last -> entity (>=5.4.0)");
	Ожидаем.Что(Текст).Не_().Содержит("without-version -> entity");

КонецПроцедуры

