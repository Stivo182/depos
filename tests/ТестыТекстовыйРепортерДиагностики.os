&Тест
Процедура ТестДолжен_ПредложитьДобавитьVerboseКТекущейКоманде() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "missing", Ложь);
	Элемент.ТребуемаяВерсия = ">=1.0.0";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "other/packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("Для подробностей запустите команду с --verbose");
	Ожидаем.Что(КраткийТекст).Содержит("Требуется: >=1.0.0");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("Не установлена → >=1.0.0");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("depos doctor --verbose");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("Для подробностей запустите команду с --verbose");
	Ожидаем.Что(Прав(ПодробныйТекст, 1)).Не_().Равно("─");

КонецПроцедуры

