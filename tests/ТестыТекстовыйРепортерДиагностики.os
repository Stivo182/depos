&Тест
Процедура ТестДолжен_ВывестиОднуПричинуПоврежденнойТранзитивнойЗависимости() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"broken-package",
		Ложь
	);
	Элемент.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьПовреждена();
	Элемент.КраткоеОписание = "Требуемый пакет поврежден";
	Элемент.ПодробнаяПричина = "Отсутствует файл opm-metadata.xml";
	Элемент.ТребуемаяВерсия = ">=1.0.0";
	Элемент.Каталог = "C:/packages/broken-package";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("Требуемый пакет поврежден");
	Ожидаем.Что(КраткийТекст).Содержит("Требуется: >=1.0.0");
	Ожидаем.Что(КраткийТекст).Содержит("Каталог:   C:/packages/broken-package");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("Версия: Не установлена");
	Ожидаем.Что(ПодробныйТекст).Содержит("Причина:   Отсутствует файл opm-metadata.xml");
	Ожидаем.Что(ПодробныйТекст).Содержит("Требуется: >=1.0.0");
	Ожидаем.Что(ПодробныйТекст).Содержит("Каталог:   C:/packages/broken-package");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("Требуемый пакет поврежден");
	Ожидаем.Что(КоличествоВхождений(
		ПодробныйТекст,
		"Отсутствует файл opm-metadata.xml"
	)).Равно(1);

КонецПроцедуры

Функция КоличествоВхождений(Текст, Подстрока)

	Результат = 0;
	Позиция = СтрНайти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Результат = Результат + 1;
		Текст = Сред(Текст, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Текст, Подстрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&Тест
Процедура ТестДолжен_ВывестиИсточникТранзитивногоКонфликтаБезОграниченияВерсии() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"missing-package",
		Ложь
	);
	Элемент.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьНеУстановлена();
	Элемент.КраткоеОписание = "Требуемый пакет не установлен";
	Требование = Новый ТребованиеЗависимости();
	Требование.ИсточникТребования = "source";
	Требование.ЦепочкаЗависимостей.Добавить("source");
	Требование.ЦепочкаЗависимостей.Добавить("missing-package");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("└─ source -> missing-package");
	Ожидаем.Что(ПодробныйТекст).Содержит("Требования:");
	Ожидаем.Что(ПодробныйТекст).Содержит("└─ source -> missing-package");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("missing-package ()");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("missing-package ()");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиПричиныТранзитивныхКонфликтовВКомпактномОтчете() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();

	Первый = Результаты.ДобавитьОшибку(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Первый.КраткоеОписание = "Требования зависимостей несовместимы";
	Первый.ТипКонфликта = ТипыКонфликтовЗависимостей.НесовместимыеТребования();
	Первый.УстановленнаяВерсия = "1.5.0";

	ТребованиеПервогоИсточника = Новый ТребованиеЗависимости();
	ТребованиеПервогоИсточника.ИсточникТребования = "first";
	ТребованиеПервогоИсточника.ТребуемаяВерсия = ">=2.0.0";
	Первый.Требования.Добавить(ТребованиеПервогоИсточника);

	ТребованиеВторогоИсточника = Новый ТребованиеЗависимости();
	ТребованиеВторогоИсточника.ИсточникТребования = "second";
	ТребованиеВторогоИсточника.ТребуемаяВерсия = "<=1.0.0";
	Первый.Требования.Добавить(ТребованиеВторогоИсточника);

	Второй = Результаты.ДобавитьОшибку(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Второй.КраткоеОписание = "Установленная версия нарушает требование";
	Второй.ТипКонфликта = ТипыКонфликтовЗависимостей.УстановленнаяВерсияНеСоответствуетТребованию();
	Второй.УстановленнаяВерсия = "1.5.0";
	Второй.Требования.Добавить(ТребованиеПервогоИсточника.Копия());

	Единственный = Результаты.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "unique", Ложь);
	Единственный.КраткоеОписание = "Требуемый пакет не установлен";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("✕  2 ошибки");
	Ожидаем.Что(КраткийТекст).Содержит("✕  shared" + Символы.ПС);
	Ожидаем.Что(КраткийТекст).Не_().Содержит("✕  shared,");
	Ожидаем.Что(КраткийТекст).Содержит("Установлена: 1.5.0");
	Ожидаем.Что(КраткийТекст).Содержит("├─ first: >=2.0.0");
	Ожидаем.Что(КраткийТекст).Содержит("└─ second: <=1.0.0");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("Требования зависимостей несовместимы");
	Ожидаем.Что(КраткийТекст).Содержит(
		"✕  unique" + Символы.ПС + "       Требуемый пакет не установлен");
	Ожидаем.Что(ПодробныйТекст).Содержит(
		"Причина:     требования зависимостей несовместимы"
			+ Символы.ПС
			+ "       Установлена: 1.5.0"
	);
	Ожидаем.Что(ПодробныйТекст).Содержит("├─ first: >=2.0.0");
	Ожидаем.Что(ПодробныйТекст).Содержит("└─ second: <=1.0.0");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("Конфликты:");

КонецПроцедуры

