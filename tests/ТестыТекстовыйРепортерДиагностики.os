Процедура ТестДолжен_СемантическиВыделитьПоляДиагностикиВИнтерактивномТерминале() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НесоответствиеВерсий(), "entity", Истина);
	Элемент.УстановленнаяВерсия = "1.0.0";
	Элемент.ТребуемаяВерсия = ">=2.0.0";
	Элемент.Каталог = "C:/packages/entity";
	Требование = Новый ТребованиеЗависимости();
	Требование.ИсточникТребования = "source";
	Требование.ТребуемаяВерсия = ">=2.0.0";
	Требование.ЦепочкаЗависимостей.Добавить("root");
	Требование.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Профиль = Новый Структура(
		"Ошибка,Успех,Рекомендация,Стрелка,Ветка,ПоследняяВетка,Вертикаль,Горизонталь",
		"×", "✓", "ℹ", "→", "├─", "└─", "│  ", "─"
	);

	// Действие
