	Элемент.ТребуемаяВерсия = ">=2.1.0";
	Требование = Новый ТребованиеЗависимости();
	Требование.ТребуемаяВерсия = ">=2.1.0";
	Требование.ЦепочкаЗависимостей.Добавить("winow");
	Требование.ЦепочкаЗависимостей.Добавить("autumn-validate");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет)
	);

	// Проверка
	Ожидаем.Что(Текст).Содержит("Требования:" + Символы.ПС);
	Ожидаем.Что(Текст).Содержит("└─ winow -> autumn-validate (>=2.1.0)");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьКонтекстыИПоказатьОбъявлениеВПодробномОтчете() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Предупреждение = Результаты.ДобавитьПредупреждение(
		ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(),
		"shared",
		Ложь
	);
	Предупреждение.КраткоеОписание = "Объявлено: .ЗависитОт(""shared"", ""1.0.0"")  (строка 4)";
	Результаты.ДобавитьРекомендацию(
		"shared",
		Истина,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки()
	);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ЦветнойПодробныйТекст = Репортер.Сформировать(Отчет, Истина);
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		ЦветнойПодробныйТекст
	);

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("shared (prod)");
	Ожидаем.Что(КраткийТекст).Содержит("shared (dev)");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("Объявлено:");
	Ожидаем.Что(ПодробныйТекст).Содержит(
		"Объявлено: .ЗависитОт(""shared"", ""1.0.0"")  (строка 4)"
	);
	Ожидаем.Что(ЦветнойПодробныйТекст).Содержит(
		"Объявлено: (.ЗависитОт(""shared"", ""1.0.0"")|#color=Серый)  "
			+ "((строка 4)|#color=ТемноСерый)"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1, "1 ошибка")
&ИсточникЗначение(2, "2 ошибки")
&ИсточникЗначение(5, "5 ошибок")
&ИсточникЗначение(11, "11 ошибок")
&ИсточникЗначение(21, "21 ошибка")
Процедура ТестДолжен_СклонитьКоличествоОшибок(Количество, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Для Индекс = 1 По Количество Цикл
		Результаты.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "package" + Индекс, Ложь);
	КонецЦикла;
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет)
	);

	// Проверка
	Ожидаем.Что(Текст).Содержит(ОжидаемаяСтрока);

КонецПроцедуры
