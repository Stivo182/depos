КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиЦепочкиДляРекомендацииТранзитивнойПометки() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьРекомендацию(
		"candidate",
		Ложь,
		ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки()
	);
	Элемент.КраткоеОписание = ".ЗависитОт(""candidate"") → "
		+ ".ЗависитОт(""candidate"") // Транзитивная";
	Требование = Новый ТребованиеЗависимости();
	Требование.ЦепочкаЗависимостей.Добавить("source");
	Требование.ЦепочкаЗависимостей.Добавить("candidate");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Тексты = Новый Массив();
	Тексты.Добавить(КраткийТекст);
	Тексты.Добавить(ПодробныйТекст);
	Для Каждого Текст Из Тексты Цикл
		Ожидаем.Что(Текст).Содержит("Цепочки:" + Символы.ПС);
		Ожидаем.Что(Текст).Содержит("└─ source -> candidate");
	КонецЦикла;

КонецПроцедуры

