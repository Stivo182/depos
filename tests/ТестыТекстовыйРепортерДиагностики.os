&Тест
Процедура ТестДолжен_РазделятьТолькоНесоответствияВерсийВПодробномРежиме() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "installed-one", Ложь);
	Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "installed-two", Ложь);
	Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "unused-one", Ложь);
	Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "unused-two", Ложь);
	ПервоеНесоответствие = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
		"mismatch-one",
		Ложь
	);
	ПервоеНесоответствие.УстановленнаяВерсия = "1.0.0";
	ПервоеНесоответствие.ТребуемаяВерсия = ">=2.0.0";
	ВтороеНесоответствие = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
		"mismatch-two",
		Ложь
	);
	ВтороеНесоответствие.УстановленнаяВерсия = "1.0.0";
	ВтороеНесоответствие.ТребуемаяВерсия = ">=2.0.0";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	ПолныйТекст = Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина);
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(ПолныйТекст);

	// Проверка
	Ожидаем.Что(Текст).Содержит("installed-one" + Символы.ПС + "  ✕  installed-two");
	Ожидаем.Что(Текст).Содержит("unused-one" + Символы.ПС + "  ⚠  unused-two");
	Ожидаем.Что(Текст).Содержит(">=2.0.0" + Символы.ПС + Символы.ПС + "  ✕  mismatch-two");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиПолныеДеталиТребованийТолькоВПодробномРежиме() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
		"shared",
		Ложь
	);
	Элемент.КраткоеОписание = "Установленная версия нарушает требование";
	Требование = Новый ТребованиеЗависимости();
	Требование.ИсточникТребования = "source";
	Требование.ТребуемаяВерсия = ">=2.0.0";
	Требование.ЦепочкаЗависимостей.Добавить("root");
	Требование.ЦепочкаЗависимостей.Добавить("shared");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КомпактныйТекст = Репортер.Сформировать(Отчет, Ложь);
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Репортер.Сформировать(Отчет, Истина)
	);

	// Проверка
	Ожидаем.Что(КомпактныйТекст).Не_().Содержит("root -> shared");
	Ожидаем.Что(КомпактныйТекст).Содержит("      source");
	Ожидаем.Что(КомпактныйТекст).Не_().Содержит("источники:");
	Ожидаем.Что(ПодробныйТекст).Содержит("Требования:");
	Ожидаем.Что(ПодробныйТекст).Содержит("root -> shared (>=2.0.0)");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("source: >=2.0.0");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("НесовместимыеТребования");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиИсправлениеРекомендацииВПодробномРежиме() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьРекомендацию("entity", Ложь);
	Элемент.ТекущаяМинимальнаяВерсия = "5.4.0";
	Элемент.ТранзитивнаяМинимальнаяВерсия = "5.5.0";
	Требование = Новый ТребованиеЗависимости();
	Требование.ТребуемаяВерсия = ">=5.5.0";
	Требование.ЦепочкаЗависимостей.Добавить("source");
	Требование.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	ПолныйТекст = Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина);
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(ПолныйТекст);
	КомпактныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет)
	);

	// Проверка
	Ожидаем.Что(ПолныйТекст).Содержит(
		"Рекомендация: (не указывать|#color=Зеленый)"
	);
	Ожидаем.Что(Текст).Содержит("Рекомендация: не указывать");
	Ожидаем.Что(Текст).Содержит("Объявлено:    >=5.4.0");
	Ожидаем.Что(Текст).Содержит("Транзитивно:  >=5.5.0");
	Ожидаем.Что(Текст).Не_().Содержит(">=5.4.0 → не указывать");
	Ожидаем.Что(КомпактныйТекст).Содержит("Прямые ограничения версий уже обеспечены транзитивными зависимостями");
	Ожидаем.Что(КомпактныйТекст).Содержит("source -> entity (>=5.5.0)");
	Ожидаем.Что(КомпактныйТекст).Содержит(">=5.4.0 → не указывать");
	Ожидаем.Что(Текст).Не_().Содержит(".ЗависитОт(");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиЦепочкиТребованийСРекомендованнойВерсией() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьРекомендацию("entity", Ложь);
	Элемент.ТекущаяМинимальнаяВерсия = "5.4.0";
	ПервоеТребование = Новый ТребованиеЗависимости();
	ПервоеТребование.ИсточникТребования = "first";
	ПервоеТребование.ТребуемаяВерсия = ">=5.4.0";
	ПервоеТребование.ЦепочкаЗависимостей.Добавить("root");
	ПервоеТребование.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(ПервоеТребование);
	ТребованиеБезВерсии = Новый ТребованиеЗависимости();
	ТребованиеБезВерсии.ЦепочкаЗависимостей.Добавить("without-version");
	ТребованиеБезВерсии.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(ТребованиеБезВерсии);
	ПоследнееТребование = Новый ТребованиеЗависимости();
	ПоследнееТребование.ИсточникТребования = "last";
	ПоследнееТребование.ТребуемаяВерсия = ">=5.4.0";
	ПоследнееТребование.ЦепочкаЗависимостей.Добавить("last");
	ПоследнееТребование.ЦепочкаЗависимостей.Добавить("entity");
	Элемент.Требования.Добавить(ПоследнееТребование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина)
	);

	// Проверка
	Ожидаем.Что(Текст).Содержит("      ├─ root -> entity (>=5.4.0)");
	Ожидаем.Что(Текст).Содержит("      └─ last -> entity (>=5.4.0)");
	Ожидаем.Что(Текст).Не_().Содержит("without-version -> entity");

КонецПроцедуры

