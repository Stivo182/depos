#Использовать "helpers"

&Тест
Процедура ТестДолжен_ВывестиОшибкиПередПредупреждениямиИРекомендациями() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Результаты.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(),
		"error-package",
		Ложь
	);
	Предупреждение = Результаты.ДобавитьПредупреждение(
		ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
		"warning-package",
		Ложь
	);
	Предупреждение.КраткоеОписание = ".ЗависитОт(""warning-package"") → удалить";
	Рекомендация = Результаты.ДобавитьРекомендацию(
		"recommendation-package",
		Ложь,
		ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки()
	);
	Рекомендация.КраткоеОписание = ".ЗависитОт(""recommendation-package"") → "
		+ ".РазработкаЗависитОт(""recommendation-package"")";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет)
	);

	// Проверка
	ПозицияОшибки = СтрНайти(Текст, "01  Отсутствуют в манифесте");
	ПозицияПредупреждения = СтрНайти(Текст, "02  Повторные объявления зависимостей");
	ПозицияРекомендации = СтрНайти(Текст, "03  Производственные зависимости только для разработки");
	Ожидаем.Что(ПозицияОшибки > 0).ЭтоИстина();
	Ожидаем.Что(ПозицияОшибки < ПозицияПредупреждения).ЭтоИстина();
	Ожидаем.Что(ПозицияПредупреждения < ПозицияРекомендации).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьВерсииOneScriptКраткоИПолями() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка(), "candidate", Ложь);
	Элемент.УстановленнаяВерсия = "5.0.2";
	Элемент.ВерсияСредыПроверяемогоПакета = "2.0.0";
	Элемент.ВерсияСредыЗависимости = "2.2.0";
	Элемент.Каталог = "C:/packages/candidate";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("OneScript: >=2.0.0 → >=2.2.0");
	Ожидаем.Что(КраткийТекст).Содержит("Каталог:   C:/packages/candidate");
	Ожидаем.Что(ПодробныйТекст).Содержит("Версия пакета:     5.0.2");
	Ожидаем.Что(ПодробныйТекст).Содержит("Заявлено проектом: OneScript >=2.0.0");
	Ожидаем.Что(ПодробныйТекст).Содержит("Требуется пакетом: OneScript >=2.2.0");
	Ожидаем.Что(ПодробныйТекст).Содержит("Каталог:           C:/packages/candidate");

КонецПроцедуры

