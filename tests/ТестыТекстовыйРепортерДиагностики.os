	Ожидаем.Что(Текст).Содержит("Требуется:    (>=2.0.0|#color=Зеленый)");
	Ожидаем.Что(Текст).Содержит("Каталог:      (C:/packages/entity|#color=Серый)");
	Ожидаем.Что(Текст).Содержит("(root -> entity|#color=Серый)");

