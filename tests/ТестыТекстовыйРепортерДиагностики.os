&Тест
Процедура ТестДолжен_ВывестиПричинуНесоответствияУстановленнойВерсииВПодробномОтчете() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"autumn-validate",
		Ложь
	);
	Элемент.ТипКонфликта = ТипыКонфликтовЗависимостей.УстановленнаяВерсияНеСоответствуетТребованию();
	Элемент.КраткоеОписание = "Установленная версия нарушает требование";
	Элемент.УстановленнаяВерсия = "1.1.0";
	Элемент.ТребуемаяВерсия = ">=2.1.0";
	Требование = Новый ТребованиеЗависимости();
	Требование.ИсточникТребования = "winow";
	Требование.ТребуемаяВерсия = ">=2.1.0";
	Требование.ЦепочкаЗависимостей.Добавить("winow");
	Требование.ЦепочкаЗависимостей.Добавить("autumn-validate");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет, Истина)
	);
	КомпактныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет)
	);

	// Проверка
	Ожидаем.Что(Текст).Содержит("Установленная версия нарушает требование");
	Ожидаем.Что(Текст).Содержит("Требования:");
	Ожидаем.Что(Текст).Содержит("└─ winow -> autumn-validate (>=2.1.0)");
	Ожидаем.Что(КомпактныйТекст).Содержит("└─ winow -> autumn-validate (>=2.1.0)");

КонецПроцедуры

