&ИсточникЗначение(2, "2 проблемы")
&ИсточникЗначение(5, "5 проблем")
&ИсточникЗначение(11, "11 проблем")
&ИсточникЗначение(21, "21 проблема")
Процедура ТестДолжен_СклонитьКоличествоПроблем(Количество, ОжидаемаяСтрока) Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Для Индекс = 1 По Количество Цикл
		Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "package" + Индекс, Ложь);
	КонецЦикла;
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(
		Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет)
	);

	// Проверка
	Ожидаем.Что(Текст).Содержит(ОжидаемаяСтрока);

КонецПроцедуры
