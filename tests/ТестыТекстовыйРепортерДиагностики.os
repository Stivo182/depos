#Использовать "helpers"

&Тест
Процедура ТестДолжен_СформироватьКомпактныйUnicodeОтчетСРазметкойЦвета() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НесоответствиеВерсий(), "autumn", Ложь);
	Элемент.УстановленнаяВерсия = "3.3.0";
	Элемент.ТребуемаяВерсия = ">=4.3.0";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "C:/project/packagedef");

	// Действие
	Текст = Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет);

	// Проверка
	Ожидаем.Что(Текст).Содержит("(✕ |#color=Красный) (1|#color=Красный) (проблема|#color=Красный)");
	Ожидаем.Что(Текст).Содержит("(✕ |#color=Красный) (autumn|#color=Белый)");
	Ожидаем.Что(Текст).Содержит("(3.3.0|#color=Красный) → (>=4.3.0|#color=Зеленый)");
	Разделитель = СтрЗаменить("                                                            ", " ", "─");
	Ожидаем.Что(Текст).Содержит(
		Разделитель + Символы.ПС + "01  Несоответствие установленных версий" + Символы.ПС + Символы.ПС
	);
	Ожидаем.Что(Текст).Содержит("#color=");

КонецПроцедуры

