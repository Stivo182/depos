&Тест
Процедура ТестДолжен_ВывестиОтсутствующуюТранзитивнуюЗависимостьВКомпактномОтчете() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"autumn-validate",
		Ложь
	);
	Элемент.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьНеУстановлена();
	Элемент.КраткоеОписание = "Требуемый пакет не установлен";
	Элемент.ТребуемаяВерсия = ">=2.1.0";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Действие
	Текст = Новый ТекстовыйРепортерДиагностики().Сформировать(Отчет);
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Текст);

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит(
		"✕  autumn-validate" + Символы.ПС + "       Требуемый пакет не установлен");
	Ожидаем.Что(Текст).Содержит("(Не установлена|#color=Красный) → (>=2.1.0|#color=Зеленый)");
	Ожидаем.Что(Текст).Не_().Содержит("(|#color=Красный)");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиИсточникТранзитивногоКонфликтаБезОграниченияВерсии() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"missing-package",
		Ложь
	);
	Элемент.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьНеУстановлена();
	Элемент.КраткоеОписание = "Требуемый пакет не установлен";
	Требование = Новый ТребованиеЗависимости();
	Требование.ИсточникТребования = "source";
	Требование.ЦепочкаЗависимостей.Добавить("source");
	Требование.ЦепочкаЗависимостей.Добавить("missing-package");
	Элемент.Требования.Добавить(Требование);
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит("└─ source -> missing-package");
	Ожидаем.Что(ПодробныйТекст).Содержит("Требования:");
	Ожидаем.Что(ПодробныйТекст).Содержит("└─ source -> missing-package");
	Ожидаем.Что(КраткийТекст).Не_().Содержит("missing-package ()");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("missing-package ()");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВывестиПричиныТранзитивныхКонфликтовВКомпактномОтчете() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Первый = Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Первый.КраткоеОписание = "Требования зависимостей несовместимы";
	Второй = Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Второй.КраткоеОписание = "Установленная версия нарушает требование";
	Единственный = Результаты.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "unique", Ложь);
	Единственный.КраткоеОписание = "Требуемый пакет не установлен";
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Репортер = Новый ТекстовыйРепортерДиагностики();

	// Действие
	КраткийТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет));
	ПодробныйТекст = ПомощникКонсольногоВывода.УдалитьРазметкуЦвета(Репортер.Сформировать(Отчет, Истина));

	// Проверка
	Ожидаем.Что(КраткийТекст).Содержит(
		"✕  shared" + Символы.ПС + "       Требования зависимостей несовместимы");
	Ожидаем.Что(КраткийТекст).Содержит("       Установленная версия нарушает требование");
	Ожидаем.Что(КраткийТекст).Содержит(
		"✕  unique" + Символы.ПС + "       Требуемый пакет не установлен");
	Ожидаем.Что(ПодробныйТекст).Не_().Содержит("shared (Требования зависимостей несовместимы)");
	Ожидаем.Что(ПодробныйТекст).Содержит("       Требования зависимостей несовместимы");

КонецПроцедуры

