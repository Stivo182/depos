#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьВсеТипыПроверокЗависимостей() Экспорт

	// Подготовка

	// Действие
	ТипыПроверок = ТипыПроверокЗависимостей.Все();

	// Проверка
	Ожидаем.Что(ТипыПроверок).ИмеетДлину(3);
	Ожидаем.Что(ТипыПроверок[0]).Равно(ТипыПроверокЗависимостей.Использование);
	Ожидаем.Что(ТипыПроверок[1]).Равно(ТипыПроверокЗависимостей.УстановленныеПакеты);
	Ожидаем.Что(ТипыПроверок[2]).Равно(ТипыПроверокЗависимостей.ТранзитивныеЗависимости);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Неопределено, Истина, Истина, Истина)
&ИсточникЗначение("", Истина, Истина, Истина)
&ИсточникЗначение("usage", Истина, Ложь, Ложь)
&ИсточникЗначение("installed", Ложь, Истина, Ложь)
&ИсточникЗначение("transitive", Ложь, Ложь, Истина)
&ИсточникЗначение("usage,installed", Истина, Истина, Ложь)
&ИсточникЗначение("installed, transitive", Ложь, Истина, Истина)
&ИсточникЗначение("transitive,usage", Истина, Ложь, Истина)
&ИсточникЗначение("usage,installed,transitive", Истина, Истина, Истина)
Процедура ТестДолжен_ВыбратьЗаданныеПроверки(
	ЗначениеОпции,
	ОжидаетсяИспользование,
	ОжидаютсяУстановленные,
	ОжидаютсяТранзитивные
) Экспорт

	// Подготовка

	// Действие
	Выбор = Новый ВыборПроверокЗависимостей(ЗначениеОпции);

	// Проверка
	Ожидаем.Что(Выбор.ПроверятьИспользование()).Равно(ОжидаетсяИспользование);
	Ожидаем.Что(Выбор.ПроверятьУстановленныеПакеты()).Равно(ОжидаютсяУстановленные);
	Ожидаем.Что(Выбор.ПроверятьТранзитивныеЗависимости()).Равно(ОжидаютсяТранзитивные);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНеизвестнойПроверке() Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Попытка
		Выбор = Новый ВыборПроверокЗависимостей("usage,unknown");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Заполнено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("checks.invalid");

	КадрОшибки = ДиагностикаОшибок.НайтиПервую(Ошибка, "checks.invalid");
	Ожидаем.Что(КадрОшибки.Данные().ЗначениеОпции).Равно("usage,unknown");

КонецПроцедуры

#КонецОбласти
