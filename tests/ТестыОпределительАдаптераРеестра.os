#Область Тесты

&Тест
Процедура ТестДолжен_ВыбратьOpenHubПоОписаниюAPI() Экспорт

	// Подготовка
	Контекст = ПодготовитьКонтекст();
	НастроитьDiscovery(Контекст, 200, "{""info"":{""title"":""OpenHub API v1""}}");

	// Действие
	Адаптер = Контекст.Определитель.Получить("autumn", Контекст.Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ТипЗнч(Адаптер)).Равно(Тип("АдаптерOpenHub"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьСтарыйХаб() Экспорт

	// Подготовка
	Сценарии = Новый Массив;
	Сценарии.Добавить(Новый Структура("КодСостояния,Тело", 404, ""));
	Сценарии.Добавить(Новый Структура("КодСостояния,Тело", 200, "<html></html>"));
	Сценарии.Добавить(Новый Структура("КодСостояния,Тело", 200, "{}"));
	Сценарии.Добавить(Новый Структура("КодСостояния,Тело", 200, "{""info"":[]}"));
	Сценарии.Добавить(Новый Структура("КодСостояния,Тело", 200, "{""info"":"));
	Сценарии.Добавить(Новый Структура(
		"КодСостояния,Тело", 200, "{""info"":{""title"":""Another API""}}"));

	Для Каждого Сценарий Из Сценарии Цикл
		Контекст = ПодготовитьКонтекст();
		НастроитьDiscovery(Контекст, Сценарий.КодСостояния, Сценарий.Тело);

		// Действие
		Адаптер = Контекст.Определитель.Получить("autumn", Контекст.Реестр, Неопределено);

		// Проверка
		Ожидаем.Что(ТипЗнч(Адаптер)).Равно(Тип("АдаптерСтарогоХаба"));
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакэшироватьВыбранныйАдаптер() Экспорт

	// Подготовка
	Контекст = ПодготовитьКонтекст();
	НастроитьDiscovery(Контекст, 404, "");

	// Действие
	Контекст.Определитель.Получить("autumn", Контекст.Реестр, Неопределено);
	Контекст.Определитель.Получить("winter", Контекст.Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(Контекст.Транспорт.Адреса()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИспользоватьКэшАдаптераДляЗапросовСЗаголовками() Экспорт

	// Подготовка
	Контекст = ПодготовитьКонтекст();
	ЗаголовкиПервогоЗапроса = Новый Соответствие;
	ЗаголовкиПервогоЗапроса.Вставить("Authorization", "Bearer first");
	ЗаголовкиВторогоЗапроса = Новый Соответствие;
	ЗаголовкиВторогоЗапроса.Вставить("Authorization", "Bearer second");
	НастроитьDiscovery(Контекст, 404, "");

	// Действие
	ПервыйАдаптер = Контекст.Определитель.Получить(
		"autumn", Контекст.Реестр, Неопределено, ЗаголовкиПервогоЗапроса);
	НастроитьDiscovery(Контекст, 200, "{""info"":{""title"":""OpenHub API v1""}}");
	ВторойАдаптер = Контекст.Определитель.Получить(
		"autumn", Контекст.Реестр, Неопределено, ЗаголовкиВторогоЗапроса);

	// Проверка
	Ожидаем.Что(ТипЗнч(ПервыйАдаптер)).Равно(Тип("АдаптерСтарогоХаба"));
	Ожидаем.Что(ТипЗнч(ВторойАдаптер)).Равно(Тип("АдаптерOpenHub"));
	Ожидаем.Что(Контекст.Транспорт.Адреса()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПроксиВDiscovery() Экспорт

	// Подготовка
	Контекст = ПодготовитьКонтекст();
	Прокси = Новый URL("http://proxy.example:8080");
	НастроитьDiscovery(Контекст, 404, "");

	// Действие
	Контекст.Определитель.Получить("autumn", Контекст.Реестр, Прокси);

	// Проверка
	Ожидаем.Что(Контекст.Транспорт.Прокси()[0].ВСтроку()).Равно("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбHTTPОшибкеDiscovery() Экспорт

	// Подготовка
	Контекст = ПодготовитьКонтекст();
	НастроитьDiscovery(Контекст, 503, "");

	// Действие
	Ошибка = ПолучитьОшибку(Контекст.Определитель, Контекст.Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеТранспортаDiscovery() Экспорт

	// Подготовка
	Контекст = ПодготовитьКонтекст();
	Контекст.Реестр = Новый URL("https://user:registry-secret@hub.oscript.io");
	Контекст.Транспорт.НастроитьИсключение(АдресDiscovery(Контекст.Реестр), "технические подробности");

	// Действие
	Ошибка = ПолучитьОшибку(Контекст.Определитель, Контекст.Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	Представление = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(Представление).Содержит("ошибка транспорта");
	Ожидаем.Что(Представление).Содержит("hub.oscript.io");
	Ожидаем.Что(Представление).Не_().Содержит("registry-secret");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьКонтекст()

	Реестр = Новый URL("https://hub.oscript.io");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	Старый = Новый АдаптерСтарогоХаба(Транспорт);
	OpenHub = Новый АдаптерOpenHub(Транспорт);
	Определитель = Новый ОпределительАдаптераРеестра(Транспорт, Старый, OpenHub);

	Возврат Новый Структура("Реестр,Транспорт,Определитель", Реестр, Транспорт, Определитель);

КонецФункции

Процедура НастроитьDiscovery(Контекст, КодСостояния, Тело)

	Контекст.Транспорт.НастроитьОтвет(АдресDiscovery(Контекст.Реестр), КодСостояния, Тело);

КонецПроцедуры

Функция АдресDiscovery(Реестр)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("openapi.json");

	Возврат Адрес;

КонецФункции

Функция ПолучитьОшибку(Определитель, Реестр, Прокси)

	Попытка
		Определитель.Получить("autumn", Реестр, Прокси);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
