#Использовать "helpers"

&Тест
Процедура ТестДолжен_ВернутьВсеТипыДиагностикиФункциями() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()).Равно("ОтсутствуетВМанифесте");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую()).Равно("НеИспользуетсяНапрямую");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.НеУстановлен()).Равно("НеУстановлен");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.Поврежден()).Равно("Поврежден");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.НесоответствиеВерсий()).Равно("НесоответствиеВерсий");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка())
		.Равно("НесовместимостьВерсийДвижка");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт()).Равно("ТранзитивныйКонфликт");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.РекомендацияВерсии()).Равно("РекомендацияВерсии");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ПовторноеОбъявление()).Равно("ПовторноеОбъявление");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ЗависимостьДляРазработкиВПроизводственномКоде())
		.Равно("ЗависимостьДляРазработкиВПроизводственномКоде");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки())
		.Равно("РекомендацияУдаленияЗависимостиДляРазработки");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки())
		.Равно("ПроизводственнаяЗависимостьТолькоДляРазработки");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки())
		.Равно("РекомендацияУдаленияПометки");
	Ожидаем.Что(ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки())
		.Равно("РекомендацияТранзитивнойПометки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьСтруктурныеДиагностики() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ЭтоСтруктурнаяДиагностика(
		ТипыДиагностикиЗависимостей.ПовторноеОбъявление()
	)).ЭтоИстина();
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ЭтоСтруктурнаяДиагностика(
		ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки()
	)).ЭтоИстина();
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ЭтоСтруктурнаяДиагностика(
		ТипыДиагностикиЗависимостей.РекомендацияВерсии()
	)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьДиагностикиИзмененияОбъявления() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ИзменяетОбъявлениеЗависимости(
		ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки()
	)).ЭтоИстина();
	Ожидаем.Что(ТипыДиагностикиЗависимостей.ИзменяетОбъявлениеЗависимости(
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки()
	)).ЭтоЛожь();

КонецПроцедуры
