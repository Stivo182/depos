#Использовать "helpers"
#Использовать "../src/core"
#Использовать "../src/internal"

#Область ОписаниеПеременных

Перем _ТекущийКаталог; // Строка

#КонецОбласти

#Область ОбработчикиСобытий

&ПередВсеми
Процедура Инициализация() Экспорт
	_ТекущийКаталог = ТекущийКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	УстановитьТекущийКаталог(_ТекущийКаталог);
	ПомощникТестирования.УдалитьВременныеФайлы();
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_НормализоватьРегистрИмениУстановленногоПакета() Экспорт

	// Подготовка
	Сканер = Новый СканерУстановленныхПакетов(Новый ОпределительКаталоговБиблиотек())
		.УстановитьКаталогБиблиотек("./tests/fixtures/lib_sets/mixed-case");

	// Действие
	Результат = Сканер.НайтиВсеПакеты();

	// Проверка
	Ожидаем.Что(Строка(Результат["mixedcasepackage"])).Содержит("MixedCasePackage");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиУстановленныйПакетБезУчетаРегистраИмени() Экспорт

	// Подготовка
	Сканер = Новый СканерУстановленныхПакетов(Новый ОпределительКаталоговБиблиотек());
	ЛокаторМанифеста = Новый ЛокаторМанифеста(Сканер);
	УстановитьТекущийКаталог("./tests/fixtures");

	// Действие
	ПутьКФайлу = ЛокаторМанифеста.НайтиПоИмениПакета("AuTuMn");

	// Проверка
	Ожидаем.Что(Новый Файл(ПутьКФайлу).Имя).Равно("opm-metadata.xml");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновитьЗависимостьБезУчетаРегистраИмени() Экспорт

	// Подготовка
	Обновлятор = Новый ОбновляторЗависимостей(Новый ФайловоеХранилищеМанифеста());
	ФайлМанифеста = ПомощникТестирования.СоздатьВременнуюКопиюФайла(
		"./tests/fixtures/packagedef-mixed-case"
	);
	Зависимости = Новый ЗависимостиПакета().Добавить("AUTUMN", "2.0.0");

	// Действие
	Обновлятор.Обновить(ФайлМанифеста, Зависимости);

	// Проверка
	Ожидаем.Что(ПомощникТестирования.СодержимоеФайла(ФайлМанифеста))
		.Содержит(".ЗависитОт(""AuTuMn"", ""2.0.0"")");

КонецПроцедуры

#КонецОбласти
