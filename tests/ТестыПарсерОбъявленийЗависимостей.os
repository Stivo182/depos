
#Использовать "helpers"
#Использовать "../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьРазобранныеОбъявленияДляОбновления() Экспорт

	// Подготовка
	Текст = "Описание.ЗависитОт(""fs"", ""1.0.0"", ""2.0.0"")" + Символы.ПС
		+ "  .РазработкаЗависитОт(""dev"")";
	Парсер = Новый ПарсерОбъявленийЗависимостей();

	// Действие
	Объявления = Парсер.НайтиДляОбновления(Текст);

	// Проверка
	Ожидаем.Что(Объявления).ИмеетДлину(2);
	Ожидаем.Что(ТипЗнч(Объявления[0])).Равно(Тип("Структура"));
	Ожидаем.Что(Объявления[0].ИмяПакета).Равно("fs");
	Ожидаем.Что(Объявления[0].ДляРазработки).ЭтоЛожь();
	Ожидаем.Что(Объявления[0].МинимальнаяВерсия).Равно("1.0.0");
	Ожидаем.Что(Объявления[0].МаксимальнаяВерсия).Равно("2.0.0");
	Ожидаем.Что(Объявления[0].ДлинаВерсии).Равно(5);
	Ожидаем.Что(Сред(Текст, Объявления[0].ИндексВерсии + 1, 5)).Равно("1.0.0");
	Ожидаем.Что(Объявления[1].ИмяПакета).Равно("dev");
	Ожидаем.Что(Объявления[1].ДляРазработки).ЭтоИстина();
	Ожидаем.Что(Объявления[1].МинимальнаяВерсия).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиЗависимостьВЦепочкеНаОднойСтроке() Экспорт

	// Подготовка
	Текст = "Описание.Имя(""https://demo"").ЗависитОт(""fs"", ""1.0.0"");" + Символы.ПС
		+ "// Описание.ЗависитОт(""ghost"", ""9.0.0"");";

	// Действие
	Объявления = Новый ПарсерОбъявленийЗависимостей().НайтиДляОбновления(Текст);

	// Проверка
	Ожидаем.Что(Объявления).ИмеетДлину(1);
	Ожидаем.Что(Объявления[0].ИмяПакета).Равно("fs");
	Ожидаем.Что(Объявления[0].МинимальнаяВерсия).Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗависимостьВКомментарииПослеВызова() Экспорт

	// Подготовка
	Текст = "Описание.Имя(""https://example.test"").ЗависитОт(""fs"", ""1.0.0"")"
		+ " // .ЗависитОт(""ghost"", ""9.0.0"")" + Символы.ПС
		+ ".РазработкаЗависитОт(""dev"", ""2.0.0"")";

	// Действие
	Объявления = Новый ПарсерОбъявленийЗависимостей().НайтиДляОбновления(Текст);

	// Проверка
	Ожидаем.Что(Объявления).ИмеетДлину(2);
	Ожидаем.Что(Объявления[0].ИмяПакета).Равно("fs");
	Ожидаем.Что(Объявления[1].ИмяПакета).Равно("dev");
	Ожидаем.Что(Сред(Текст, Объявления[1].ИндексВерсии + 1, 5)).Равно("2.0.0");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗависимостьВСтрокеСУдвоеннымиКавычками() Экспорт

	// Подготовка
	Текст = "Описание.Имя(""пример """"цитата"""" .ЗависитОт(""""ghost"""")"")"
		+ ".ЗависитОт(""fs"", ""1.0.0"")";

	// Действие
	Объявления = Новый ПарсерОбъявленийЗависимостей().НайтиДляОбновления(Текст);

	// Проверка
	Ожидаем.Что(Объявления).ИмеетДлину(1);
	Ожидаем.Что(Объявления[0].ИмяПакета).Равно("fs");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеНаходитьВызовДругогоОбъекта() Экспорт

	// Подготовка
	Текст = "Другой.ЗависитОт(""fs"", ""1.0.0"");" + Символы.ПС
		+ "Описание.Имя(""pkg"").ЗависитОт(""real"", ""2.0.0"");";

	// Действие
	Объявления = Новый ПарсерОбъявленийЗависимостей().НайтиДляОбновления(Текст);

	// Проверка
	Ожидаем.Что(Объявления).ИмеетДлину(1);
	Ожидаем.Что(Объявления[0].ИмяПакета).Равно("real");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеНаходитьПродолжениеЦепочкиДругогоОбъекта() Экспорт

	// Подготовка
	ПереводСтроки = Символ(13) + Символ(10);
	Текст = "Другой" + ПереводСтроки
		+ "  .ЗависитОт(""fs"", ""1.0.0"");" + ПереводСтроки
		+ "Описание" + ПереводСтроки
		+ "  .ЗависитОт(""real"", ""2.0.0"");";

	// Действие
	Объявления = Новый ПарсерОбъявленийЗависимостей().НайтиДляОбновления(Текст);

	// Проверка
	Ожидаем.Что(Объявления).ИмеетДлину(1);
	Ожидаем.Что(Объявления[0].ИмяПакета).Равно("real");

КонецПроцедуры

#КонецОбласти
