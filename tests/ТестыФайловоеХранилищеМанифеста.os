#Использовать "helpers"

Перем _Поделка; // Поделка

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ПомощникТестирования.УдалитьВременныеФайлы();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеЧтенияМанифеста() Экспорт

	// Подготовка
	Хранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл();
	УдалитьФайлы(ПутьКФайлу);

	Параметры = Новый Массив();
	Параметры.Добавить(ПутьКФайлу);

	// Действие и Проверка
	Ожидаем.Что(Хранилище)
		.Метод("Прочитать", Параметры)
		.ВыбрасываетИсключение(СтрШаблон("Возникла ошибка при чтении файла манифеста '%1'", ПутьКФайлу));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОшибкеЗаписиМанифеста() Экспорт

	// Подготовка
	Хранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ПутьККаталогу = ПомощникТестирования.СоздатьВременныйФайл();
	УдалитьФайлы(ПутьККаталогу);
	ПутьКФайлу = ОбъединитьПути(ПутьККаталогу, "packagedef");

	Параметры = Новый Массив();
	Параметры.Добавить(ПутьКФайлу);
	Параметры.Добавить("");

	// Действие и Проверка
	Ожидаем.Что(Хранилище)
		.Метод("Записать", Параметры)
		.ВыбрасываетИсключение(СтрШаблон("Возникла ошибка при записи файла манифеста '%1'", ПутьКФайлу));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ТестДолжен_СохранитьНаличиеBOMПриЗаписи(СодержитBOM) Экспорт

	// Подготовка
	Хранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл();
	ПомощникТестирования.ЗаписатьФайлUTF8(ПутьКФайлу, "Исходное содержимое", СодержитBOM);

	// Действие
	Хранилище.Записать(ПутьКФайлу, "Обновленное содержимое");

	// Проверка
	ОжидаемоеКоличествоBOM = ?(СодержитBOM, 1, 0);
	Ожидаем.Что(ПомощникТестирования.КоличествоBOMВНачале(ПутьКФайлу)).Равно(ОжидаемоеКоличествоBOM);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина, "LF")
&ИсточникЗначение(Истина, "CRLF")
&ИсточникЗначение(Ложь, "LF")
&ИсточникЗначение(Ложь, "CRLF")
Процедура ТестДолжен_СохранитьBOMИПереносыСтрокПриЧтении(СодержитBOM, ТипПереноса) Экспорт

	// Подготовка
	Хранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл();
	ПереносСтроки = ?(ТипПереноса = "CRLF", Символ(13), "") + Символ(10);
	ОжидаемоеСодержимое = "Первая строка" + ПереносСтроки + "Вторая строка";
	ПомощникТестирования.ЗаписатьФайлUTF8(ПутьКФайлу, ОжидаемоеСодержимое, СодержитBOM);

	// Действие
	ФактическоеСодержимое = Хранилище.Прочитать(ПутьКФайлу);

	// Проверка
	Ожидаем.Что(ФактическоеСодержимое).Равно(ОжидаемоеСодержимое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОтсутствующийФайлПриЗаписи() Экспорт

	// Подготовка
	Хранилище = _Поделка.НайтиЖелудь("ФайловоеХранилищеМанифеста");
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл();
	ОжидаемыйФайл = ПомощникТестирования.СоздатьВременныйФайл();
	ПомощникТестирования.ЗаписатьФайлUTF8(ОжидаемыйФайл, "Содержимое", Ложь);
	УдалитьФайлы(ПутьКФайлу);

	// Действие
	Хранилище.Записать(ПутьКФайлу, "Содержимое");

	// Проверка
	ПомощникТестирования.ОжидаемЧтоФайлыПобайтовоИдентичны(ПутьКФайлу, ОжидаемыйФайл);

КонецПроцедуры

#КонецОбласти
