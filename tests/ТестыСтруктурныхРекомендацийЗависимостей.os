&Тест
Процедура ТестДолжен_НеВыбиратьОбъявлениеПриРазныхОграниченияхПовтора() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef-conflicting-duplicate"
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(
		Зависимости,
		Новый ВыборПроверокЗависимостей("usage")
	);
	Повтор = Результат.Элементы(ТипыДиагностикиЗависимостей.ПовторноеОбъявление())[0];

	// Проверка
	Ожидаем.Что(Повтор.Уровень).Равно(УровниДиагностикиЗависимостей.Ошибка());
	Ожидаем.Что(Повтор.КраткоеОписание).Равно("");
	Ожидаем.Что(Повтор.ПодробнаяПричина).Содержит("Строка 3: .ЗависитОт(""duplicate"", ""1.0.0"")");
	Ожидаем.Что(Повтор.ПодробнаяПричина).Содержит("Строка 4: .ЗависитОт(""duplicate"", ""2.0.0"")");

