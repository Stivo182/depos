&Тест
Процедура ТестДолжен_НеФормироватьСтруктурныеРекомендацииБезЛитеральныхОбъявлений() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета()
		.Добавить("redundant", "2.0.0")
		.ДобавитьДляРазработки("redundant", "1.0.0")
		.ДобавитьДляРазработки("dev_in_prod", "1.0.0")
		.Добавить("move_to_dev", "1.0.0")
		.Добавить("transitive_candidate", "1.0.0");

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости);

	// Проверка
	Ожидаем.Что(Результат.Элементы(ТипыДиагностикиЗависимостей.ЗависимостьДляРазработкиВПроизводственномКоде()))
		.ИмеетДлину(0);
	Ожидаем.Что(Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки()))
		.ИмеетДлину(0);
	Ожидаем.Что(Результат.Элементы(ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки()))
		.ИмеетДлину(0);
	Ожидаем.Что(Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки()))
		.ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьСтруктурныеРекомендацииПриПолнойПроверке() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = ЗависимостиПоУмолчанию();

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости);

	// Проверка
	ПроверитьЕдинственнуюДиагностику(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки(),
		"redundant"
	);
	ПроверитьЕдинственнуюДиагностику(
		Результат, ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки(), "move_to_dev"
	);
	РекомендацияПереноса = Результат.Элементы(
		ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки()
	)[0];
	Ожидаем.Что(РекомендацияПереноса.ПодробнаяПричина).Не_().Заполнено();
	Ожидаем.Что(РекомендацияПереноса.Файлы).ИмеетДлину(1);
	Ожидаем.Что(СтрЗаменить(РекомендацияПереноса.Файлы[0], "\", "/"))
		.Содержит("/tests/Использования.os");
	ПроверитьЕдинственнуюДиагностику(
		Результат, ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки(), "transitive_candidate"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат, ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки(), "implicit_dev"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("packagedef-covered-range", 1)
&ИсточникЗначение("packagedef-uncovered-range", 0)
&ИсточникЗначение("packagedef-unversioned-dev", 1)
&ИсточникЗначение("packagedef-uncovered-dev", 0)
Процедура ТестДолжен_УдалятьОбъявлениеДляРазработкиТолькоПриПокрывающемПроизводственномОграничении(
	ИмяМанифеста,
	КоличествоРекомендаций
) Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		ОбъединитьПути("./tests/fixtures/ПроектСоСтруктурнымиРекомендациями", ИмяМанифеста)
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(
		Зависимости,
		Новый ВыборПроверокЗависимостей("usage")
	);

	// Проверка
	Рекомендации = Результат.Элементы(
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки()
	);
	Ожидаем.Что(Рекомендации).ИмеетДлину(КоличествоРекомендаций);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьНепокрытуюЗависимостьДляРазработкиНеоднозначнымПовтором() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef-uncovered-dev"
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(
		Зависимости,
		Новый ВыборПроверокЗависимостей("usage")
	);
	Повторы = ПроверкаДиагностики.НайтиПакеты(
		Результат.Элементы(ТипыДиагностикиЗависимостей.ПовторноеОбъявление()),
		"redundant"
	);

	// Проверка
	Ожидаем.Что(Повторы).ИмеетДлину(1);
	Ожидаем.Что(Повторы[0].Уровень).Равно(УровниДиагностикиЗависимостей.Ошибка());
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки(),
		"redundant"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(),
		"redundant"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодавитьПометкуВПроизводственномКонтекстеПриМежконтекстномПовторе() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef-uncovered-prod-marked"
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости);

	// Проверка
	ПроверитьЕдинственнуюДиагностику(
		Результат,
		ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
		"redundant"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.ПометкаТранзитивностиНеПодтверждена(),
		"redundant"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияВерсии(),
		"redundant"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиМежконтекстныйПовторСВычисляемымОбъявлением() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef-dynamic-context"
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(
		Зависимости,
		Новый ВыборПроверокЗависимостей("usage")
	);
	Повторы = ПроверкаДиагностики.НайтиПакеты(
		Результат.Элементы(ТипыДиагностикиЗависимостей.ПовторноеОбъявление()),
		"redundant"
	);

	// Проверка
	Ожидаем.Что(Повторы).ИмеетДлину(1);
	Ожидаем.Что(Повторы[0].Уровень).Равно(УровниДиагностикиЗависимостей.Ошибка());
	Ожидаем.Что(Повторы[0].КраткоеОписание).Равно("");
	Ожидаем.Что(Повторы[0].ПодробнаяПричина).Содержит("вычисляемое объявление");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьОдноИсправлениеДляИзбыточнойЗависимостиДляРазработки() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef-covered-marked"
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(
		Зависимости,
		Новый ВыборПроверокЗависимостей("usage")
	);

	// Проверка
	ПроверитьЕдинственнуюДиагностику(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки(),
		"implicit_dev"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки(),
		"implicit_dev"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АнализаторПоУмолчанию()

	Возврат _Поделка.НайтиЖелудь("АнализаторЗависимостей")
		.РабочийКаталог("./tests/fixtures/ПроектСоСтруктурнымиРекомендациями")
		.КаталогиИсходников("src")
		.КаталогиДляРазработки("tests")
		.ИсключатьДляРазработки(Ложь);

КонецФункции

Функция ЗависимостиПоУмолчанию()

	Возврат Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef"
	);

КонецФункции

Процедура ПроверитьЕдинственнуюДиагностику(Результат, Тип, ИмяПакета)

	Элементы = ПроверкаДиагностики.НайтиПакеты(Результат.Элементы(Тип), ИмяПакета);
	Ожидаем.Что(Элементы).ИмеетДлину(1);

КонецПроцедуры

Процедура ПроверитьОтсутствиеДиагностики(Результат, Тип, ИмяПакета)

	Элементы = ПроверкаДиагностики.НайтиПакеты(Результат.Элементы(Тип), ИмяПакета);
	Ожидаем.Что(Элементы).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти
