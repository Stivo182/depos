Перем _Поделка; // Поделка

#КонецОбласти

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ЗаменитьОбщиеСообщенияПредметнымиДиагностиками() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = ЗависимостиПоУмолчанию();

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости, Новый ВыборПроверокЗависимостей("usage"));
	Повтор = Результат.Элементы(ТипыДиагностикиЗависимостей.ПовторноеОбъявление())[0];

	// Проверка
	ПроверитьЕдинственнуюДиагностику(Результат, ТипыДиагностикиЗависимостей.ПовторноеОбъявление(), "duplicate");
	Ожидаем.Что(Повтор.Уровень).Равно(УровниДиагностикиЗависимостей.Предупреждение());
	Ожидаем.Что(Повтор.КраткоеОписание).Содержит("Строка 4: .ЗависитОт(""duplicate"", ""1.0.0"")");
	Ожидаем.Что(Повтор.КраткоеОписание).Содержит("→ удалить повторное объявление");
	ПроверитьЕдинственнуюДиагностику(
		Результат,
		ТипыДиагностикиЗависимостей.ЗависимостьДляРазработкиВПроизводственномКоде(),
		"dev_in_prod"
	);
	ПроверитьЕдинственнуюДиагностику(
		Результат, ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки(), "stale"
	);
	РекомендацияПометки = Результат.Элементы(
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки()
	)[0];
	Ожидаем.Что(РекомендацияПометки.КраткоеОписание).Равно(
		"Строка 10: .ЗависитОт(""stale"", ""1.0.0"") // Транзитивная - требуется напрямую"
			+ " → .ЗависитОт(""stale"", ""1.0.0"")"
	);
	Ожидаем.Что(РекомендацияПометки.ПодробнаяПричина).Не_().Заполнено();
	Ожидаем.Что(РекомендацияПометки.Файлы).ИмеетДлину(1);
	Ожидаем.Что(СтрЗаменить(РекомендацияПометки.Файлы[0], "\", "/"))
		.Содержит("/src/Использования.os");
	ПроверитьОтсутствиеДиагностики(
		Результат, ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(), "dev_in_prod"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат, ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "dev_in_prod"
	);
	Ожидаем.Что(
		Результат.Элементы(ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки())
	).ИмеетДлину(0);
	Ожидаем.Что(
		Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки())
	).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереноситьЗависимостьПриНеполномПроизводственномГрафе() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию();
	Зависимости = Новый ЗависимостиПакета().ЗаполнитьИзМанифеста(
		"./tests/fixtures/ПроектСоСтруктурнымиРекомендациями/packagedef-incomplete-graph"
	);

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(
		Зависимости,
		Новый ВыборПроверокЗависимостей("usage,transitive")
	);

	// Проверка
	ПроверитьОтсутствиеДиагностики(
		Результат, ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки(), "move_to_dev"
	);
	ПроверитьЕдинственнуюДиагностику(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки(),
		"transitive_candidate"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(),
		"transitive_candidate"
	);
	ПроверитьОтсутствиеДиагностики(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияВерсии(),
		"transitive_candidate"
	);

КонецПроцедуры

