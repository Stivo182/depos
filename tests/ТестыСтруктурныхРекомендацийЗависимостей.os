Процедура ТестДолжен_ОставитьТолькоПроизводственныеСтруктурныеДиагностикиПриИсключенииДляРазработки() Экспорт

	// Подготовка
	Анализатор = АнализаторПоУмолчанию().ИсключатьДляРазработки();
	Зависимости = ЗависимостиПоУмолчанию();

	// Действие
	Результат = Анализатор.ПроверитьЗависимости(Зависимости);

	// Проверка
	ПроверитьЕдинственнуюДиагностику(
		Результат, ТипыДиагностикиЗависимостей.ПовторноеОбъявление(), "duplicate"
	);
	ПроверитьЕдинственнуюДиагностику(
		Результат, ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки(), "stale"
	);
	Ожидаем.Что(
		Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки())
	).ИмеетДлину(0);
	Ожидаем.Что(
		Результат.Элементы(
			ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки()
		)
	).ИмеетДлину(0);

