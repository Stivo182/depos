#Использовать "helpers"

&Тест
Процедура ТестДолжен_НумероватьТолькоНепустыеСекцииОтчета() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);
	Результаты.ДобавитьРекомендацию("entity", Ложь);
	Построитель = Новый ПостроительОтчетаДиагностики();

	// Действие
	Отчет = Построитель.Построить(Результаты, "C:/project/packagedef");

	// Проверка
	Ожидаем.Что(Отчет.Секции).ИмеетДлину(2);
	Ожидаем.Что(Отчет.Секции[0].Номер).Равно("01");
	Ожидаем.Что(Отчет.Секции[0].Тип).Равно(ТипыДиагностикиЗависимостей.НеУстановлен());
	Ожидаем.Что(Отчет.Секции[0].РазделятьЭлементы).ЭтоЛожь();
	Ожидаем.Что(Отчет.Секции[1].Номер).Равно("02");
	Ожидаем.Что(Отчет.Секции[1].Описание).Равно("Прямые ограничения версий уже обеспечены транзитивными зависимостями");
	Ожидаем.Что(Отчет.Секции[1].РазделятьЭлементы).ЭтоИстина();
	Ожидаем.Что(Отчет.КоличествоПроблем).Равно(1);
	Ожидаем.Что(Отчет.КоличествоРекомендаций).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СтабильноСортироватьЭлементыИФайлы() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "zeta", Ложь);
	Элемент = Результаты.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "alpha", Ложь);
	Элемент.Файлы.Добавить("z.os");
	Элемент.Файлы.Добавить("a.os");

	// Действие
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Проверка
	Ожидаем.Что(Отчет.Секции[0].Элементы[0].ИмяПакета).Равно("alpha");
	Ожидаем.Что(Отчет.Секции[0].Элементы[0].Файлы[0]).Равно("a.os");
	Ожидаем.Что(Элемент.Файлы[0]).Равно("z.os");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьНезависимыйСнимокДиагностики() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Элемент = Результаты.ДобавитьРекомендацию("candidate", Ложь);
	Элемент.ТекущаяМинимальнаяВерсия = "1.0.0";
	Элемент.Файлы.Добавить("source.os");
	Требование = Новый ТребованиеЗависимости();
	Требование.ИсточникТребования = "root";
	Требование.ЦепочкаЗависимостей.Добавить("root");
	Требование.ЦепочкаЗависимостей.Добавить("candidate");
	Элемент.Требования.Добавить(Требование);

	// Действие
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");
	Элемент.ИмяПакета = "changed";
	Элемент.ТекущаяМинимальнаяВерсия = "2.0.0";
	Элемент.Файлы.Очистить();
	Требование.ИсточникТребования = "changed";
	Требование.ЦепочкаЗависимостей.Очистить();
	Результаты.ОчиститьРекомендации();

	// Проверка
	КопияЭлемента = Отчет.Секции[0].Элементы[0];
	Ожидаем.Что(Отчет.КоличествоРекомендаций).Равно(1);
	Ожидаем.Что(КопияЭлемента.ИмяПакета).Равно("candidate");
	Ожидаем.Что(КопияЭлемента.ТекущаяМинимальнаяВерсия).Равно("1.0.0");
	Ожидаем.Что(КопияЭлемента.Файлы[0]).Равно("source.os");
	Ожидаем.Что(КопияЭлемента.Требования[0].ИсточникТребования).Равно("root");
	Ожидаем.Что(КопияЭлемента.Требования[0].ЦепочкаЗависимостей).ИмеетДлину(2);
	Ожидаем.Что(КопияЭлемента.Требования[0].ЦепочкаЗависимостей[1]).Равно("candidate");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СортироватьИмяПакетаПередКонтекстом() Экспорт

	// Подготовка
	Результаты = Новый РезультатыАнализаЗависимостей();
	Результаты.ДобавитьРекомендацию("alpha0", Ложь);
	Результаты.ДобавитьРекомендацию("alpha", Истина);
	Результаты.ДобавитьРекомендацию("alpha", Ложь);

	// Действие
	Отчет = Новый ПостроительОтчетаДиагностики().Построить(Результаты, "packagedef");

	// Проверка
	Элементы = Отчет.Секции[0].Элементы;
	Ожидаем.Что(Элементы[0].ИмяПакета).Равно("alpha");
	Ожидаем.Что(Элементы[0].ДляРазработки).ЭтоЛожь();
	Ожидаем.Что(Элементы[1].ИмяПакета).Равно("alpha");
	Ожидаем.Что(Элементы[1].ДляРазработки).ЭтоИстина();
	Ожидаем.Что(Элементы[2].ИмяПакета).Равно("alpha0");

КонецПроцедуры
