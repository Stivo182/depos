// BSLLS:MagicNumber-off

#Использовать url
#Использовать "helpers"

#Область ОписаниеПеременных

Перем _ИсходноеИмяЗеркала; // Строка
Перем _ИсходныйКаталог; // Строка

#КонецОбласти

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Импорты = "../oscript_modules/url")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьТест() Экспорт

	_ИсходноеИмяЗеркала = ПолучитьПеременнуюСреды("OPM_HUB_MIRROR");
	_ИсходныйКаталог = ТекущийКаталог();
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", "");

КонецПроцедуры

&ПослеКаждого
Процедура ОчиститьТест() Экспорт

	УстановитьТекущийКаталог(_ИсходныйКаталог);
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", _ИсходноеИмяЗеркала);

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПрочитатьСерверыИзТекущегоКаталога() Экспорт

	// Подготовка
	ИспользоватьНастройки("private");
	Провайдер = Новый ПровайдерНастроекOpm;

	// Действие
	Серверы = Провайдер.ПолучитьНастройки().Серверы;

	// Проверка
	Ожидаем.Что(Серверы).ИмеетДлину(2);
	Ожидаем.Что(Серверы[0].Имя).Равно("private");
	Ожидаем.Что(Серверы[0].Адрес.ВСтроку()).Равно("https://hub.example.com:443");
	Ожидаем.Что(Серверы[0].Свойство("Порт")).ЭтоЛожь();
	Ожидаем.Что(Серверы[0].Свойство("ПутьНаСервере")).ЭтоЛожь();
	Ожидаем.Что(Серверы[0].Пул).Равно("private");
	Ожидаем.Что(Серверы[0].Заголовки.Получить("Authorization")).Равно("Bearer secret-token");
	Ожидаем.Что(Серверы[0].Заголовки.Получить("X-Organization")).Равно("team");
	Ожидаем.Что(Серверы[1].Имя).Равно("backup");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбратьСерверПоИмениЗеркалаOpm() Экспорт

	// Подготовка
	ИспользоватьНастройки("private");
	Провайдер = Новый ПровайдерНастроекOpm;
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", "backup");

	// Действие
	Серверы = Провайдер.ПолучитьНастройки().Серверы;

	// Проверка
	Ожидаем.Что(Серверы).ИмеетДлину(1);
	Ожидаем.Что(Серверы[0].Имя).Равно("backup");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУчитыватьЗеркалоПоЯвномуУказанию() Экспорт

	// Подготовка
	ИспользоватьНастройки("private");
	Провайдер = Новый ПровайдерНастроекOpm;
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", "backup");

	// Действие
	Серверы = Провайдер.ПолучитьНастройки(Ложь).Серверы;

	// Проверка
	Ожидаем.Что(Серверы).ИмеетДлину(2);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("localhost", "http://localhost")
&ИсточникЗначение("loopback-ipv4", "http://127.0.0.42")
&ИсточникЗначение("localhost-subdomain", "http://packages.localhost")
&ИсточникЗначение("loopback-ipv6", "http://[::1]")
&ИсточникЗначение("explicit-port", "http://packages.example.com:8080")
&ИсточникЗначение("separate-port-80", "http://packages-http.example.com:80")
&ИсточникЗначение("separate-port-8080", "http://packages-alt.example.com:8080")
&ИсточникЗначение("remote", "https://packages.example.com")
Процедура ТестДолжен_ОпределитьСхемуСервераЕслиОнаНеУказана(ИмяСервера, ОжидаемыйАдрес) Экспорт

	// Подготовка
	ИспользоватьНастройки("without-schemes");
	Провайдер = Новый ПровайдерНастроекOpm;
	УстановитьПеременнуюСреды("OPM_HUB_MIRROR", ИмяСервера);

	// Действие
	Серверы = Провайдер.ПолучитьНастройки().Серверы;

	// Проверка
	Ожидаем.Что(Серверы).ИмеетДлину(1);
	Ожидаем.Что(Серверы[0].Адрес.ВСтроку()).Равно(ОжидаемыйАдрес);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьНастройкиПроксиOpm() Экспорт

	// Подготовка
	ИспользоватьНастройки("private");
	Провайдер = Новый ПровайдерНастроекOpm;

	// Действие
	Настройки = Провайдер.ПолучитьНастройки();

	// Проверка
	Ожидаем.Что(Настройки.Прокси.ИспользоватьСистемный).ЭтоЛожь();
	Ожидаем.Что(Настройки.Прокси.Сервер).Равно("proxy.example.com");
	Ожидаем.Что(Настройки.Прокси.Порт).Равно(8080);
	Ожидаем.Что(Настройки.Прокси.Пользователь).Равно("user");
	Ожидаем.Что(Настройки.Прокси.Пароль).Равно("password");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьСтандартныйПортПроксиOpm() Экспорт

	// Подготовка
	ИспользоватьНастройки("proxy-without-port");
	Провайдер = Новый ПровайдерНастроекOpm;

	// Действие
	Настройки = Провайдер.ПолучитьНастройки();

	// Проверка
	Ожидаем.Что(Настройки.Прокси.Порт).Равно(80);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЧитатьМенееПриоритетныйФайлПослеНекорректного() Экспорт

	// Подготовка
	ИспользоватьНастройки("invalid-root");
	Провайдер = Новый ПровайдерНастроекOpm;
	ПутьМенееПриоритетногоФайла = ОбъединитьПути(СтартовыйСценарий().Каталог, "opm.cfg");
	Ожидаем.Что(Новый Файл(ПутьМенееПриоритетногоФайла).Существует()).ЭтоЛожь();
	Запись = Новый ЗаписьТекста(ПутьМенееПриоритетногоФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(
		"{""СервераПакетов"":[{""Имя"":""lower"",""Сервер"":""https://lower.example""}]}"
	);
	Запись.Закрыть();
	Ошибка = Неопределено;
	Настройки = Неопределено;

	// Действие
	Попытка
		Настройки = Провайдер.ПолучитьНастройки();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	УдалитьФайлы(ПутьМенееПриоритетногоФайла);

	// Проверка
	Ожидаем.Что(Ошибка).Равно(Неопределено);
	Ожидаем.Что(Настройки.Серверы).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьПутиНастроекИзСистемнойИнформации() Экспорт

	// Подготовка
	Провайдер = Новый ПровайдерНастроекOpm;
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПутьПрофиля = СистемнаяИнформация.ПолучитьПутьПапки(СпециальнаяПапка.ПрофильПользователя);

	// Действие
	Пути = Провайдер.ПутиФайловНастроек();

	// Проверка
	Если ЭтоWindows(СистемнаяИнформация) Тогда
		ПутьОбщихДанных = СистемнаяИнформация.ПолучитьПутьПапки(
			СпециальнаяПапка.ОбщийКаталогДанныхПриложения
		);
		Ожидаем.Что(Пути[1]).Равно(ОбъединитьПути(ПутьПрофиля, "opm.cfg"));
		Ожидаем.Что(Пути[2]).Равно(ОбъединитьПути(ПутьОбщихДанных, "opm.cfg"));
	Иначе
		Ожидаем.Что(Пути[1]).Равно(ОбъединитьПути(ПутьПрофиля, ".opm.cfg"));
		Ожидаем.Что(Пути[2]).Равно(ОбъединитьПути("/etc", "opm.cfg"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИспользоватьНастройки(ИмяКаталога)

	КаталогФикстур = ОбъединитьПути(_ИсходныйКаталог, "tests", "fixtures", "opm");
	КаталогНастроек = ОбъединитьПути(КаталогФикстур, ИмяКаталога);
	УстановитьТекущийКаталог(КаталогНастроек);

КонецПроцедуры

Функция ЭтоWindows(СистемнаяИнформация)

	Платформа = СистемнаяИнформация.ТипПлатформы;

	Возврат Платформа = ТипПлатформы.Windows_x86 Или Платформа = ТипПлатформы.Windows_x86_64;

КонецФункции

#КонецОбласти
