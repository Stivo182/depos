#Использовать url
#Использовать "helpers"

#Область Тесты

&Тест
Процедура ТестДолжен_ДекодироватьКомпонентыАвторизацииПроксиРаздельно() Экспорт

	// Подготовка
	Адрес = Новый URL("http://user%40name:pass%3Aword@proxy.example:8080");

	// Действие
	Авторизация = АдресаСерверовПакетов.ДанныеАвторизацииПрокси(Адрес);

	// Проверка
	Ожидаем.Что(Авторизация.Пользователь).Равно("user@name");
	Ожидаем.Что(Авторизация.Пароль).Равно("pass:word");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьОтсутствующийИПустойПарольПрокси() Экспорт

	// Подготовка
	АдресБезПароля = Новый URL("http://user@proxy.example:8080");
	АдресСПустымПаролем = Новый URL("http://user:@proxy.example:8080");

	// Действие
	БезПароля = АдресаСерверовПакетов.ДанныеАвторизацииПрокси(АдресБезПароля);
	СПустымПаролем = АдресаСерверовПакетов.ДанныеАвторизацииПрокси(АдресСПустымПаролем);

	// Проверка
	Ожидаем.Что(БезПароля.Пароль).Равно(Неопределено);
	Ожидаем.Что(СПустымПаролем.Пароль).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустуюАвторизациюДляПроксиБезДанныхПользователя() Экспорт

	// Подготовка
	Адрес = Новый URL("http://proxy.example:8080");

	// Действие
	Авторизация = АдресаСерверовПакетов.ДанныеАвторизацииПрокси(Адрес);

	// Проверка
	Ожидаем.Что(Авторизация.Пользователь).Равно(Неопределено);
	Ожидаем.Что(Авторизация.Пароль).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНекорректнойКодировкеАвторизацииПрокси() Экспорт

	// Подготовка
	Адрес = Новый URL("http://user:%FF@proxy.example:8080");

	// Действие
	Попытка
		АдресаСерверовПакетов.ДанныеАвторизацииПрокси(Адрес);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("encoding.invalid");

КонецПроцедуры

#КонецОбласти
