#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НастроитьОтветТранспорта(Транспорт, Реестр, КодСостояния, Тело)

	Транспорт.НастроитьОтвет(АдресПакета(Реестр), КодСостояния, Тело);

КонецПроцедуры

Процедура НастроитьИсключениеТранспорта(Транспорт, Реестр, ОписаниеОшибки)

	Транспорт.НастроитьИсключение(АдресПакета(Реестр), ОписаниеОшибки);

КонецПроцедуры

Функция АдресПакета(Реестр)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("package");
	Адрес.ДобавитьСегментПути("autumn");

	Возврат Адрес;

КонецФункции

Функция СтраницаСВерсией(Версия)

	Ссылка = СтрШаблон("<a href=""/download/autumn/autumn-%1.ospx"">%1</a>", Версия);
	Возврат "<html>" + Ссылка + "</html>";

КонецФункции

Функция ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр)

	Попытка
		Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
