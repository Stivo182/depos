	// Подготовка
	Реестр = Новый URL("https://registry.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	СтраницаНенайденногоПакета = "<html><h1></h1><a href=""/download//-.ospx"">-</a></html>";
	НастроитьОтветТранспорта(Транспорт, Реестр, 200, СтраницаНенайденногоПакета);
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьПакетНенайденнымИзЗаПустогоЗаголовкаВREADME() Экспорт

	// Подготовка
	Реестр = Новый URL("https://registry.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	СтраницаПакета = "<html><h1>autumn</h1>" + СтраницаСВерсией("1.0.0") + "<h1></h1></html>";
