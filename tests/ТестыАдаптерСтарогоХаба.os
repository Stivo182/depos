#Область Тесты

&Тест
Процедура ТестДолжен_ПолучитьВерсииИзHTMLСтарогоХаба() Экспорт

	// Подготовка
	Реестр = Новый URL("https://hub.oscript.io");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьОтветТранспорта(Транспорт, Реестр, 200, СтраницаСВерсией("4.3.11"));
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета).Содержит("4.3.11");
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку()).Равно("https://hub.oscript.io/package/autumn");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("0.0.0")
&ИсточникЗначение("1.2.3")
&ИсточникЗначение("1.2.3-alpha")
&ИсточникЗначение("1.2.3-alpha.1")
&ИсточникЗначение("1.2.3+build.5")
&ИсточникЗначение("1.2.3-alpha.1+build.5")
Процедура ТестДолжен_ИзвлечьСтрогуюВерсиюSemVerИзHTML(Версия) Экспорт

	// Подготовка
	Реестр = Новый URL("https://hub.oscript.io");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьОтветТранспорта(Транспорт, Реестр, 200, СтраницаСВерсией(Версия));
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	ВерсииПакета = Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(ВерсииПакета).ИмеетДлину(1);
	Ожидаем.Что(ВерсииПакета[0]).Равно(Версия);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("1")
&ИсточникЗначение("1.2")
&ИсточникЗначение("01.2.3")
&ИсточникЗначение("1.2.3-01")
&ИсточникЗначение("v1.2.3")
Процедура ТестДолжен_ПропуститьНестрогуюВерсиюSemVerИзHTML(Версия) Экспорт

	// Подготовка
	Реестр = Новый URL("https://hub.oscript.io");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьОтветТранспорта(Транспорт, Реестр, 200, СтраницаСВерсией(Версия));
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	Ожидаем.Что(ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка))
		.Содержит("ответ не содержит корректных версий");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПроксиТранспорту() Экспорт

	// Подготовка
	Реестр = Новый URL("https://hub.oscript.io");
	Прокси = Новый URL("http://proxy.example:8080");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьОтветТранспорта(Транспорт, Реестр, 200, СтраницаСВерсией("1.0.0"));
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	Адаптер.ПолучитьВерсии("autumn", Реестр, Прокси);

	// Проверка
	Ожидаем.Что(Транспорт.Прокси()[0].ВСтроку()).Равно("http://proxy.example:8080");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьБазовыйПутьРеестраВАдресеПакета() Экспорт

	// Подготовка
	Реестр = Новый URL("https://registry.example/api");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьОтветТранспорта(Транспорт, Реестр, 200, СтраницаСВерсией("1.0.0"));
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	Адаптер.ПолучитьВерсии("autumn", Реестр, Неопределено);

	// Проверка
	Ожидаем.Что(Транспорт.Адреса()[0].ВСтроку()).Равно("https://registry.example/api/package/autumn");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОТранспортнойОшибкеБезТехническихДеталей() Экспорт

	// Подготовка
	Реестр = Новый URL("https://registry.example");
	Транспорт = Новый ФейкТранспортРеестраПакетов;
	НастроитьИсключениеТранспорта(Транспорт, Реестр, "пароль secret");
	Адаптер = Новый АдаптерСтарогоХаба(Транспорт);

	// Действие
	Ошибка = ПолучитьОшибкуПолученияВерсий(Адаптер, Реестр);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("registry.unavailable");
	ПредставлениеОшибки = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Ожидаем.Что(ПредставлениеОшибки).Содержит("ошибка транспорта");
	Ожидаем.Что(ПредставлениеОшибки).Не_().Содержит("secret");

КонецПроцедуры

&Тест
