#Использовать autumn
#Использовать asserts
#Использовать fs
#Использовать "helpers"
#Использовать "../src/core"
#Использовать "../src/internal"

Перем _ТекущийКаталог; // Строка
Перем _ПеременныеСредыКонфигурация; // Строка
Перем _Поделка; // Поделка

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт

	_ТекущийКаталог = ТекущийКаталог();
	_ПеременныеСредыКонфигурация = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	УстановитьТекущийКаталог(_ТекущийКаталог);
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ПеременныеСредыКонфигурация);
КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиПакеты() Экспорт

	// Подготовка
	Сканер = _Поделка.НайтиЖелудь("СканерУстановленныхПакетов");
	УстановитьТекущийКаталог("./tests");

	КаталогБиблиотек1 = "../tests/fixtures/lib_sets/lib1";
	КаталогБиблиотек2 = "../tests/fixtures/lib_sets/lib2";

	ТестовыеСлучаи = Новый ТаблицаЗначений();
	ТестовыеСлучаи.Колонки.Добавить("ПеременнаяСреды_ОсновноеКаталог");
	ТестовыеСлучаи.Колонки.Добавить("ПеременнаяСреды_ДополнительныйКаталог");
	ТестовыеСлучаи.Колонки.Добавить("КаталогБиблиотек");
	ТестовыеСлучаи.Колонки.Добавить("Пакеты");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		КаталогБиблиотек1, 
		"", 
		"",
		"lib1/fs;lib1/package1;lib3/package3");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		"", 
		КаталогБиблиотек2, 
		"",
		"oscript_modules/autumn;lib2/fs;lib2/package2");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		КаталогБиблиотек1, 
		КаталогБиблиотек2, 
		"",
		"lib1/package1;lib2/fs;lib2/package2");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		"", 
		"", 
		"",
		"oscript_modules/autumn;oscript_modules/fs;lib3/package3");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		"", 
		"", 
		КаталогБиблиотек2,
		"oscript_modules/autumn;lib2/fs;lib2/package2");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		КаталогБиблиотек1, 
		"", 
		КаталогБиблиотек2,
		"lib1/package1;lib2/fs;lib2/package2;lib3/package3");

	ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
		"", 
		КаталогБиблиотек1, 
		КаталогБиблиотек2,
		"oscript_modules/autumn;lib1/package1;lib2/fs;lib2/package2");

	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл
		
		ОписаниеТеста = СтрШаблон(
			"ПеременнаяСреды_ОсновноеКаталог=%1
			|ПеременнаяСреды_ДополнительныйКаталог=%2
			|КаталогБиблиотек=%3",
			ТестовыйСлучай.ПеременнаяСреды_ОсновноеКаталог,
			ТестовыйСлучай.ПеременнаяСреды_ДополнительныйКаталог,
			ТестовыйСлучай.КаталогБиблиотек
		);

		УстановитьКаталогиБиблиотекВПеременнуюСреды(
			ТестовыйСлучай.ПеременнаяСреды_ОсновноеКаталог, 
			ТестовыйСлучай.ПеременнаяСреды_ДополнительныйКаталог);

		Сканер.УстановитьКаталогБиблиотек(ТестовыйСлучай.КаталогБиблиотек);

		// Действие
		Результат = Сканер.НайтиВсеПакеты();

		// Утверждение
		Для Каждого Пакет Из ТестовыйСлучай.Пакеты Цикл

			ИмяКаталога = Пакет.ИмяКаталога;
			ИмяПакета = Пакет.ИмяПакета;
			Сообщение = СтрШаблон("%1
				|ИмяКаталога=%2
				|ИмяПакета=%3",
				ОписаниеТеста,
				ИмяКаталога,
				ИмяПакета
			);

			Ожидаем.Что(Строка(Результат[ИмяПакета]), Сообщение).Содержит(ИмяКаталога);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьКаталогиБезКорректныхМетаданныхПакета() Экспорт

	// Подготовка
	Сканер = _Поделка.НайтиЖелудь("СканерУстановленныхПакетов");
	УстановитьТекущийКаталог("./tests");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "");
	Сканер.УстановитьКаталогБиблиотек("./fixtures/lib_sets/lib4");

	// Действие
	Результат = Сканер.НайтиВсеПакеты();

	// Проверка
	Ожидаем.Что(Строка(Результат["metadata-directory"])).Содержит("metadata-directory");
	Ожидаем.Что(Строка(Результат["simple-metadata-directory"])).Содержит("simple-metadata-directory");
	Ожидаем.Что(Строка(Результат["cdata-name-directory"])).Содержит("cdata-name-directory");
	Ожидаем.Что(Строка(Результат["empty-version-package"])).Содержит("empty-version-package");
	Ожидаем.Что(Строка(Результат["missing-version-package"])).Содержит("missing-version-package");
	Ожидаем.Что(Результат["ordinary-subdirectory"] = Неопределено).ЭтоИстина();
	Ожидаем.Что(Результат["broken-package"] = Неопределено).ЭтоИстина();
	Ожидаем.Что(Результат["empty-name-package"] = Неопределено).ЭтоИстина();
	Ожидаем.Что(Результат["missing-name-package"] = Неопределено).ЭтоИстина();
	Ожидаем.Что(Результат["structured-name-package"] = Неопределено).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПричиныПоврежденияПакетов() Экспорт

	// Подготовка
	Сканер = _Поделка.НайтиЖелудь("СканерУстановленныхПакетов");
	УстановитьТекущийКаталог("./tests");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "");
	Сканер.УстановитьКаталогБиблиотек("./fixtures/lib_sets/lib4");

	// Действие
	Сканер.НайтиВсеПакеты();
	ПоврежденныеПакеты = Сканер.ПоврежденныеПакеты();

	// Проверка
	ПроверитьПоврежденныйПакет(ПоврежденныеПакеты, "ordinary-subdirectory", "Отсутствует файл");
	ПроверитьПоврежденныйПакет(ПоврежденныеПакеты, "broken-package", "Не удалось разобрать XML");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключитьКаталогиПакетовДоЧтенияМетаданных() Экспорт

	// Подготовка
	Сканер = _Поделка.НайтиЖелудь("СканерУстановленныхПакетов");
	УстановитьТекущийКаталог("./tests");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "");
	Сканер
		.УстановитьКаталогБиблиотек("./fixtures/lib_sets/lib4")
		.ИсключитьПоИмени("broken-package,metadata-directory");

	// Действие
	Результат = Сканер.НайтиВсеПакеты();
	ПоврежденныеПакеты = Сканер.ПоврежденныеПакеты();

	// Проверка
	Ожидаем.Что(Результат["metadata-directory"] = Неопределено).ЭтоИстина();
	Ожидаем.Что(ПоврежденныеПакеты.Найти("broken-package", "ИмяПакета") = Неопределено).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("valid", "corrupt-missing")
&ИсточникЗначение("corrupt-missing", "valid")
&ИсточникЗначение("valid-without-version", "corrupt-missing")
&ИсточникЗначение("corrupt-missing", "valid-without-version")
Процедура ТестДолжен_ПредпочестьКорректныйДубликатПоврежденному(
	СистемныйКандидат,
	ДополнительныйКандидат
) Экспорт

	// Подготовка
	Сканер = _Поделка.НайтиЖелудь("СканерУстановленныхПакетов")
		.УстановитьКаталогБиблиотек("")
		.ИсключитьПоИмени("");
	УстановитьТекущийКаталог("./tests");
	КаталогФикстур = "./fixtures/lib_sets/duplicates";
	ПомощникТестирования.УстановитьИзолированныеКаталогиБиблиотек(
		ОбъединитьПути(КаталогФикстур, СистемныйКандидат),
		ОбъединитьПути(КаталогФикстур, ДополнительныйКандидат)
	);

	// Действие
	Результат = Сканер.НайтиВсеПакеты();
	ПоврежденныеПакеты = Сканер.ПоврежденныеПакеты();

	// Проверка
	Ожидаем.Что(Строка(Результат["duplicate-package"])).Содержит("valid");
	Ожидаем.Что(ПоврежденныеПакеты.Найти("duplicate-package", "ИмяПакета") = Неопределено).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьПоврежденныйПакет(ПоврежденныеПакеты, ИмяПакета, ЧастьПричины)

	Пакет = ПоврежденныеПакеты.Найти(ИмяПакета, "ИмяПакета");

	Ожидаем.Что(Пакет).Заполнено();
	Ожидаем.Что(Пакет.Каталог).Содержит(ИмяПакета);
	Ожидаем.Что(Пакет.Причина).Содержит(ЧастьПричины);

КонецПроцедуры

Процедура ДобавитьТестовыйСлучай(ТестовыеСлучаи, 
	ПеременнаяСреды_ОсновноеКаталог, ПеременнаяСреды_ДополнительныйКаталог, КаталогБиблиотек, Пакеты)

	ТестовыйСлучай = ТестовыеСлучаи.Добавить();
	ТестовыйСлучай.ПеременнаяСреды_ОсновноеКаталог = ПеременнаяСреды_ОсновноеКаталог;
	ТестовыйСлучай.ПеременнаяСреды_ДополнительныйКаталог = ПеременнаяСреды_ДополнительныйКаталог;
	ТестовыйСлучай.КаталогБиблиотек = КаталогБиблиотек;
	ТестовыйСлучай.Пакеты = Новый Массив();

	Для Каждого Строка Из СтрРазделить(Пакеты, ";") Цикл
		Части = СтрРазделить(Строка, "/");
		ТестовыйСлучай.Пакеты.Добавить(Новый Структура("ИмяКаталога, ИмяПакета", Части[0], Части[1]));
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьКаталогиБиблиотекВПеременнуюСреды(ОсновнойКаталог = "", ДополнительныйКаталог = "")

	Если Не ЗначениеЗаполнено(ОсновнойКаталог) Тогда
		ОсновнойКаталог = "../oscript_modules";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДополнительныйКаталог) Тогда
		ДополнительныйКаталог = "./fixtures/lib_sets/lib3";
	КонецЕсли;

	ПомощникТестирования.УстановитьИзолированныеКаталогиБиблиотек(
		ОсновнойКаталог,
		ДополнительныйКаталог
	);

КонецПроцедуры
