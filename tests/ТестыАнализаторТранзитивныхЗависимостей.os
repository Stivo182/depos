&Тест
Процедура ТестДолжен_НайтиНесовместимыеТребованияРазныхВеток() Экспорт

	// Подготовка
	Анализатор = Новый АнализаторТранзитивныхЗависимостей();
	Зависимости = Новый ЗависимостиПакета()
		.Добавить("root_a", "1.0.0")
		.Добавить("root_b", "1.0.0");

	// Действие
	Конфликты = Анализатор.Проверить(Зависимости, УстановленныеПакетыДляПроекта());

	// Проверка
	Ожидаем.Что(Конфликты).ИмеетДлину(3);
	
	ВидыКонфликтов = Новый Массив();
	Для Каждого Конфликт Из Конфликты Цикл
		ВидыКонфликтов.Добавить(Конфликт.ТипКонфликта);
	КонецЦикла;

	Ожидаем.Что(ВидыКонфликтов).Содержит(ТипыКонфликтовЗависимостей.НесовместимыеТребования());
	Ожидаем.Что(ВидыКонфликтов)
		.Содержит(ТипыКонфликтовЗависимостей.УстановленнаяВерсияНеСоответствуетТребованию());

	НесовместимыйКонфликт = НайтиКонфликтПоТипу(
		Конфликты,
		ТипыКонфликтовЗависимостей.НесовместимыеТребования());
	Ожидаем.Что(НесовместимыйКонфликт.ИмяПакета).Равно("shared");
	Ожидаем.Что(НесовместимыйКонфликт.КраткоеОписание).Равно("Требования зависимостей несовместимы");
	Ожидаем.Что(НесовместимыйКонфликт.Требования).ИмеетДлину(2);
	Ожидаем.Что(НесовместимыйКонфликт.Требования[0].ИсточникТребования).Равно("root_a");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[1].ИсточникТребования).Равно("root_b");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[0].ТребуемаяВерсия).Равно(">=2.0.0");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[1].ТребуемаяВерсия).Равно("<=1.0.0");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[0].МинимальнаяВерсия).Равно("2.0.0");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[1].МаксимальнаяВерсия).Равно("1.0.0");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[0].КорневаяПрямаяЗависимость).Равно("root_a");
	Ожидаем.Что(НесовместимыйКонфликт.Требования[1].КорневаяПрямаяЗависимость).Равно("root_b");
	Ожидаем.Что(ПроверкаДиагностики.Цепочки(НесовместимыйКонфликт)).Содержит("root_a -> shared");
	Ожидаем.Что(ПроверкаДиагностики.Цепочки(НесовместимыйКонфликт)).Содержит("root_b -> shared");

КонецПроцедуры

