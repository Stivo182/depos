&Тест
Процедура ТестДолжен_СохранитьТребованияИзРазныхПрямыхВеток() Экспорт

	// Подготовка
	Анализатор = Новый АнализаторТранзитивныхЗависимостей();
	Зависимости = Новый ЗависимостиПакета()
		.Добавить("root_repeat_a", "1.0.0")
		.Добавить("root_repeat_b", "1.0.0");

	// Действие
	Анализатор.Проверить(Зависимости, УстановленныеПакетыДляПроекта());
	Требования = Анализатор.ПолучитьТребования();

	// Проверка
	ТребованияЛиста = ПроверкаДиагностики.НайтиПакеты(Требования, "missing_repeat_leaf");
	Ожидаем.Что(ТребованияЛиста).ИмеетДлину(2);
	Ожидаем.Что(ТребованияЛиста[0].КорневаяПрямаяЗависимость).Равно("root_repeat_a");
	Ожидаем.Что(ТребованияЛиста[1].КорневаяПрямаяЗависимость).Равно("root_repeat_b");

