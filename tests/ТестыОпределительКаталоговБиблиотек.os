// BSLLS:LatinAndCyrillicSymbolInWord-off
// BSLLS:LineLength-off

#Использовать "helpers"

Перем _Поделка; // Поделка
Перем _ТекущийКаталог; // Строка
Перем _ПеременныеСредыКонфигурация; // Строка

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт

	_ТекущийКаталог = ТекущийКаталог();
	_ПеременныеСредыКонфигурация = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	УстановитьТекущийКаталог(_ТекущийКаталог);
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ПеременныеСредыКонфигурация);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКаталогиИзПеременнойСредыВПорядкеПриоритета() Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests");
	Конфигурация = "lib.system=../tests/fixtures/lib_sets/lib1;"
		+ "lib.additional=../tests/fixtures/lib_sets/lib2";
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);

	// Действие
	Результат = _Поделка.НайтиЖелудь("ОпределительКаталоговБиблиотек").ПолучитьКаталогиБиблиотек();

	// Утверждение
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(ФС.ПутиРавны(Результат[0], ПолучитьПутьКФикстуре("lib_sets/lib2"))).ЭтоИстина();
	Ожидаем.Что(ФС.ПутиРавны(Результат[1], ПолучитьПутьКФикстуре("lib_sets/lib1"))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьКаждыйКаталогИзLibAdditionalВЯвномКонфигурационномФайле() Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "");

	// Действие
	Результат = _Поделка.НайтиЖелудь("ОпределительКаталоговБиблиотек")
		.УстановитьКонфигурационныйФайл("./fixtures/oscriptcfg-multiple-libs/oscript.cfg")
		.ПолучитьКаталогиБиблиотек();

	// Утверждение
	Ожидаем.Что(Результат).ИмеетДлину(3);
	Ожидаем.Что(ФС.ПутиРавны(Результат[0], ПолучитьПутьКФикстуре("lib_sets/lib2"))).ЭтоИстина();
	Ожидаем.Что(ФС.ПутиРавны(Результат[1], ПолучитьПутьКФикстуре("lib_sets/lib3"))).ЭтоИстина();
	Ожидаем.Что(ФС.ПутиРавны(Результат[2], ПолучитьПутьКФикстуре("oscript_modules"))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьЯвныйКонфигурационныйФайлСПовышеннымПриоритетом() Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests");
	Конфигурация = "lib.system=../tests/fixtures/lib_sets/lib1;"
		+ "lib.additional=../tests/fixtures/lib_sets/lib2";
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);

	// Действие
	Результат = _Поделка.НайтиЖелудь("ОпределительКаталоговБиблиотек")
		.УстановитьКонфигурационныйФайл("./fixtures/oscriptcfg/oscript.cfg")
		.ПолучитьКаталогиБиблиотек();

	// Утверждение
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(ФС.ПутиРавны(Результат[0], ПолучитьПутьКФикстуре("lib_sets/lib2"))).ЭтоИстина();
	Ожидаем.Что(ФС.ПутиРавны(Результат[1], ПолучитьПутьКФикстуре("oscript_modules"))).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьДублиКаталоговСПомощьюСравненияПутей() Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests");
	Конфигурация = "lib.system=../tests/fixtures/lib_sets/lib1;"
		+ "lib.additional=../tests/fixtures/lib_sets/./lib1";
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);

	// Действие
	Результат = _Поделка.НайтиЖелудь("ОпределительКаталоговБиблиотек").ПолучитьКаталогиБиблиотек();

	// Утверждение
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(ФС.ПутиРавны(Результат[0], ПолучитьПутьКФикстуре("lib_sets/lib1"))).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("CFG", "")
&ИсточникЗначение(
	"OSCRIPT_CONFIG",
	"lib.additional=.\\lib1;lib.additional=./lib2;lib.additional=.\\lib3;lib.system=./lib2"
)
Процедура ТестДолжен_НакопитьПовторяющиесяLibAdditional(ИсточникКонфигурации, Конфигурация) Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests/fixtures/lib_sets");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);
	Определитель = ПомощникТестирования.ПолучитьОригинальныйЖелудь(
		_Поделка,
		"ОпределительКаталоговБиблиотек"
	);
	Если ИсточникКонфигурации = "CFG" Тогда
		Определитель.УстановитьКонфигурационныйФайл("../oscriptcfg-repeated-libs/oscript.cfg");
	КонецЕсли;

	// Действие
	Результат = Определитель.ПолучитьКаталогиБиблиотек();

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(3);
	Ожидаем.Что(ФС.ПутиРавны(Результат[0], ПолучитьПутьКФикстуре("lib_sets/lib1"))).ЭтоИстина();
	Ожидаем.Что(ФС.ПутиРавны(Результат[1], ПолучитьПутьКФикстуре("lib_sets/lib2"))).ЭтоИстина();
	Ожидаем.Что(ФС.ПутиРавны(Результат[2], ПолучитьПутьКФикстуре("lib_sets/lib3"))).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("CFG", "")
&ИсточникЗначение("OSCRIPT_CONFIG", "lib.system=./lib1;lib.system=./lib2")
Процедура ТестДолжен_ИспользоватьПоследнийПовторяющийсяLibSystem(ИсточникКонфигурации, Конфигурация) Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests/fixtures/lib_sets");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);
	Определитель = ПомощникТестирования.ПолучитьОригинальныйЖелудь(
		_Поделка,
		"ОпределительКаталоговБиблиотек"
	);
	Если ИсточникКонфигурации = "CFG" Тогда
		Определитель.УстановитьКонфигурационныйФайл("../oscriptcfg-repeated-system/oscript.cfg");
	КонецЕсли;

	// Действие
	Результат = Определитель.ПолучитьКаталогиБиблиотек();

	// Проверка
	Ожидаем.Что(РезультатСодержитПуть(Результат, ПолучитьПутьКФикстуре("lib_sets/lib1"))).ЭтоЛожь();
	Ожидаем.Что(РезультатСодержитПуть(Результат, ПолучитьПутьКФикстуре("lib_sets/lib2"))).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("CFG", "lib.additional=./lib1;lib.system=./lib2")
&ИсточникЗначение("OSCRIPT_CONFIG", "lib.additional=;lib.system=")
Процедура ТестДолжен_ПерекрытьНижнийИсточникПустымиЗначениями(ИсточникКонфигурации, Конфигурация) Экспорт

	// Подготовка
	УстановитьТекущийКаталог("./tests/fixtures/lib_sets");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", Конфигурация);
	Определитель = ПомощникТестирования.ПолучитьОригинальныйЖелудь(
		_Поделка,
		"ОпределительКаталоговБиблиотек"
	);
	Если ИсточникКонфигурации = "CFG" Тогда
		Определитель.УстановитьКонфигурационныйФайл("../oscriptcfg-empty-libs/oscript.cfg");
	КонецЕсли;

	// Действие
	Результат = Определитель.ПолучитьКаталогиБиблиотек();

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьАбсолютныеПутиWindowsИUnix() Экспорт

	// Подготовка
	УстановитьПеременнуюСреды(
		"OSCRIPT_CONFIG",
		"lib.additional=C:\libs\one;lib.additional=/opt/libs/two;lib.system=C:\libs\one"
	);
	Определитель = ПомощникТестирования.ПолучитьОригинальныйЖелудь(
		_Поделка,
		"ОпределительКаталоговБиблиотек"
	);

	// Действие
	Результат = Определитель.ПолучитьКаталогиБиблиотек();

	// Проверка
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0]).Равно("C:\libs\one");
	Ожидаем.Что(Результат[1]).Равно("/opt/libs/two");

КонецПроцедуры

Функция ПолучитьПутьКФикстуре(ОтносительныйПуть)
	Возврат ФС.НормализоватьПуть(ОбъединитьПути(_ТекущийКаталог, "tests/fixtures/" + ОтносительныйПуть));
КонецФункции

Функция РезультатСодержитПуть(Результат, ИскомыйПуть)

	Для Каждого Путь Из Результат Цикл
		Если ФС.ПутиРавны(Путь, ИскомыйПуть) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции
