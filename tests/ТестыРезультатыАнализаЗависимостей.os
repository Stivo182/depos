#Использовать "helpers"

&Тест
Процедура ТестДолжен_НеУчитыватьРекомендациюКакПроблемуВЕдинойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	// Действие
	Рекомендация = Результат.ДобавитьРекомендацию("entity", Ложь);

	// Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(1);
	Ожидаем.Что(Рекомендация.ЭтоПроблема).ЭтоЛожь();
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(0);
	Ожидаем.Что(Результат.ЕстьПроблемы()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПроблемуИзЕдинойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	// Действие
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);

	// Проверка
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(1);
	Ожидаем.Что(Результат.ЕстьПроблемы()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПроблемыВсехТиповИзЕдинойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(), "missing_manifest", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "unused", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "not_installed", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НесоответствиеВерсий(), "direct_conflict", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.Поврежден(), "broken", Ложь);

	// Проверка
	Ожидаем.Что(Результат.ЕстьПроблемы()).ЭтоИстина();
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(6);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключатьПроблемыВсехТиповПоИмени() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(), "shared", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "shared", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "shared", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НесоответствиеВерсий(), "shared", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.Поврежден(), "shared", Ложь);

	// Действие
	Результат.ИсключитьПоИмени("shared");

	// Проверка
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьРекомендацииПроблемами() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие и Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(1);
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(0);
	Ожидаем.Что(Результат.ЕстьПроблемы()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключатьРекомендацииПоИмени() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие
	Результат.ИсключитьПоИмени("entity");

	// Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(0);
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ФильтроватьЕдинуюКоллекциюПоТипуБезИзмененияСостава() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие
	Проблемы = Результат.Элементы(ТипыДиагностикиЗависимостей.НеУстановлен());
	Рекомендации = Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияВерсии());
	Результат.Элементы().Очистить();

	// Проверка
	Ожидаем.Что(Проблемы).ИмеетДлину(1);
	Ожидаем.Что(Проблемы[0].ИмяПакета).Равно("fs");
	Ожидаем.Что(Рекомендации).ИмеетДлину(1);
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалятьРекомендацииИзЕдинственнойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьПроблему(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие
	Результат.ОчиститьРекомендации();

	// Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(1);
	Ожидаем.Что(Результат.КоличествоПроблем()).Равно(1);
	Ожидаем.Что(Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияВерсии())).ИмеетДлину(0);

КонецПроцедуры
