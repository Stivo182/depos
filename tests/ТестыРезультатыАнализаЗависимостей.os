#Использовать "helpers"

&Тест
Процедура ТестДолжен_НеУчитыватьРекомендациюКакОшибкуВЕдинойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	// Действие
	Рекомендация = Результат.ДобавитьРекомендацию("entity", Ложь);

	// Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(1);
	Ожидаем.Что(Рекомендация.Уровень).Равно(УровниДиагностикиЗависимостей.Рекомендация());
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(0);
	Ожидаем.Что(Результат.ЕстьОшибки()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьПредупреждениеОтдельноОтОшибок() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	// Действие
	Предупреждение = Результат.ДобавитьПредупреждение(
		ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь
	);

	// Проверка
	Ожидаем.Что(Предупреждение.Уровень).Равно(УровниДиагностикиЗависимостей.Предупреждение());
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(0);
	Ожидаем.Что(Результат.КоличествоПредупреждений()).Равно(1);
	Ожидаем.Что(Результат.ЕстьОшибки()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьОшибкуИзЕдинойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	// Действие
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);

	// Проверка
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(1);
	Ожидаем.Что(Результат.ЕстьОшибки()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьОшибкиВсехТиповИзЕдинойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(), "missing_manifest", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "unused", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "not_installed", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НесоответствиеВерсий(), "direct_conflict", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.Поврежден(), "broken", Ложь);

	// Проверка
	Ожидаем.Что(Результат.ЕстьОшибки()).ЭтоИстина();
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(6);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключатьОшибкиВсехТиповПоИмени() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();

	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(), "shared", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "shared", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "shared", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НесоответствиеВерсий(), "shared", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(), "shared", Ложь);
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.Поврежден(), "shared", Ложь);

	// Действие
	Результат.ИсключитьПоИмени("shared");

	// Проверка
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьРекомендацииОшибками() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие и Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(1);
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(0);
	Ожидаем.Что(Результат.ЕстьОшибки()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИсключатьРекомендацииПоИмени() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие
	Результат.ИсключитьПоИмени("entity");

	// Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(0);
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ФильтроватьЕдинуюКоллекциюПоТипуБезИзмененияСостава() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие
	Ошибки = Результат.Элементы(ТипыДиагностикиЗависимостей.НеУстановлен());
	Рекомендации = Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияВерсии());
	Результат.Элементы().Очистить();

	// Проверка
	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(Ошибки[0].ИмяПакета).Равно("fs");
	Ожидаем.Что(Рекомендации).ИмеетДлину(1);
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалятьРекомендацииИзЕдинственнойКоллекции() Экспорт

	// Подготовка
	Результат = Новый РезультатыАнализаЗависимостей();
	Результат.ДобавитьОшибку(ТипыДиагностикиЗависимостей.НеУстановлен(), "fs", Ложь);
	Результат.ДобавитьПредупреждение(ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(), "unused", Ложь);
	Результат.ДобавитьРекомендацию("entity", Ложь);

	// Действие
	Результат.ОчиститьРекомендации();

	// Проверка
	Ожидаем.Что(Результат.Элементы()).ИмеетДлину(2);
	Ожидаем.Что(Результат.КоличествоОшибок()).Равно(1);
	Ожидаем.Что(Результат.КоличествоПредупреждений()).Равно(1);
	Ожидаем.Что(Результат.Элементы(ТипыДиагностикиЗависимостей.РекомендацияВерсии())).ИмеетДлину(0);

КонецПроцедуры
