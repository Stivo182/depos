// BSLLS:LineLength-off
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать "helpers"

Перем _Поделка; // Поделка
Перем _ТекущийКаталог; // Строка
Перем _ПеременныеСредыКонфигурация; // Строка

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура Инициализация() Экспорт

	_Поделка = Новый Поделка();
	_Поделка.ЗапуститьПриложение();
	
	_ТекущийКаталог = ТекущийКаталог();
	_ПеременныеСредыКонфигурация = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	УстановитьТекущийКаталог(_ТекущийКаталог);
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ПеременныеСредыКонфигурация);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьМанифестВТекущемКаталоге() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");

	УстановитьТекущийКаталог("./tests/fixtures");

	// Действие
	ПутьКФайлу = ЛокаторМанифеста.НайтиВКаталоге();

	// Утверждение
	Файл = Новый Файл(ПутьКФайлу);

	Ожидаем.Что(Файл.Существует()).ЭтоИстина();
	Ожидаем.Что(Файл.Имя).Равно("packagedef");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьМанифестВУказанномКаталоге() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");

	// Действие
	ПутьКФайлу = ЛокаторМанифеста.НайтиВКаталоге("./tests/fixtures");

	// Утверждение
	Файл = Новый Файл(ПутьКФайлу);

	Ожидаем.Что(Файл.Существует()).ЭтоИстина();
	Ожидаем.Что(Файл.Имя).Равно("packagedef");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОпределитьМанифестПоИмениПакетаВКонтекстеБиблиотек() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");
	УстановитьТекущийКаталог("./tests/fixtures");
	КаталогБиблиотек = ФС.ПолныйПуть("lib_sets/lib1");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "lib.system=" + КаталогБиблиотек);

	// Действие
	ПутьКФайлу = ЛокаторМанифеста.НайтиПоИмениПакета("package1");

	// Проверка
	Ожидаем.Что(ПутьКФайлу)
		.Равно(ФС.ПолныйПуть("lib_sets/lib1/package1/opm-metadata.xml"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИскатьПакетВКаталогеБиблиотекКаталогаЗапуска() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");
	УстановитьТекущийКаталог("./tests/fixtures");
	КаталогБиблиотек = ФС.ПолныйПуть("lib_sets/lib1");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "lib.system=" + КаталогБиблиотек);

	// Действие
	ПутьКФайлу = ЛокаторМанифеста.НайтиПоИмениПакета("mypackage");

	// Проверка
	Ожидаем.Что(ПутьКФайлу)
		.Равно(ФС.ПолныйПуть("oscript_modules/mypackage/opm-metadata.xml"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьКонфигурациюКаталогаЗапускаПриПоискеПакета() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");
	УстановитьТекущийКаталог("./tests/fixtures/oscriptcfg");
	КаталогБиблиотек = ФС.ПолныйПуть("../lib_sets/lib1");
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "lib.system=" + КаталогБиблиотек);

	// Действие
	ПутьКФайлу = ЛокаторМанифеста.НайтиПоИмениПакета("mypackage");

	// Проверка
	Ожидаем.Что(ПутьКФайлу)
		.Равно(ФС.ПолныйПуть("../oscript_modules/mypackage/opm-metadata.xml"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОНеустановленномПакете() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");
	
	УстановитьТекущийКаталог("./tests/fixtures");

	Параметры = Новый Массив();
	Параметры.Добавить("package");

	// Действие и Проверка
	Ожидаем.Что(ЛокаторМанифеста)
		.Метод("НайтиПоИмениПакета", Параметры)
		.ВыбрасываетИсключение("Пакет 'package' не установлен");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбОтсутствииМанифестаВТекущемКаталоге() Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");

	УстановитьТекущийКаталог("./tests");
	Каталог = ТекущийКаталог();

	// Действие и Проверка
	Ожидаем.Что(ЛокаторМанифеста)
		.Метод("НайтиВКаталоге")
		.ВыбрасываетИсключение(СтрШаблон("В каталоге '%1' не найден файл манифеста", Каталог));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("./tests", "В каталоге '%1' не найден файл манифеста")
&ИсточникЗначение("./testsss", "Каталог '%1' не найден")
&ИсточникЗначение("packagedef", "Вместо каталога указан файл '%1'")
Процедура ТестДолжен_СообщитьОбОшибкеДляПереданногоКаталога(
	Каталог,
	ШаблонСообщения
) Экспорт

	// Подготовка
	ЛокаторМанифеста = _Поделка.НайтиЖелудь("ЛокаторМанифеста");

	Параметры = Новый Массив();
	Параметры.Добавить(Каталог);

	// Действие и Проверка
	Ожидаем.Что(ЛокаторМанифеста)
		.Метод("НайтиВКаталоге", Параметры)
		.ВыбрасываетИсключение(СтрШаблон(ШаблонСообщения, Каталог));

КонецПроцедуры
