#Использовать "helpers"

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ПомощникТестирования.УдалитьВременныеФайлы();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗаменятьКаталогИНеОставлятьВременныеФайлы() Экспорт

	// Подготовка
	ПутьККаталогу = ПомощникТестирования.СоздатьВременныйФайл();
	УдалитьФайлы(ПутьККаталогу);
	СоздатьКаталог(ПутьККаталогу);
	Экспортер = Новый ЭкспортерОтчетаДиагностики();
	Параметры = Новый Массив();
	Параметры.Добавить("содержимое");
	Параметры.Добавить(ПутьККаталогу);

	// Действие и Проверка
	Ожидаем.Что(Экспортер)
		.Метод("Записать", Параметры)
		.ВыбрасываетИсключение("является каталогом");

	Каталог = Новый Файл(ПутьККаталогу);
	Артефакты = НайтиФайлы(Каталог.Путь, Каталог.Имя + ".tmp-*", Ложь);
	Ожидаем.Что(Каталог.ЭтоКаталог()).Равно(Истина);
	Ожидаем.Что(Артефакты).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменитьСуществующийФайлЦеликом() Экспорт

	// Подготовка
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл("txt");
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать("старое содержимое");
	Запись.Закрыть();

	// Действие
	Экспортер = Новый ЭкспортерОтчетаДиагностики();
	Экспортер.Записать("новое содержимое", ПутьКФайлу);
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ФактическоеСодержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	// Проверка
	Ожидаем.Что(ФактическоеСодержимое).Равно("новое содержимое");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьUnicodeТекстВUtf8Файл() Экспорт

	// Подготовка
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл("txt");
	Содержимое = "✓ Отчёт ✕";

	// Действие
	Экспортер = Новый ЭкспортерОтчетаДиагностики();
	Экспортер.Записать(Содержимое, ПутьКФайлу);
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ФактическоеСодержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	// Проверка
	Ожидаем.Что(ФактическоеСодержимое).Равно(Содержимое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗаписыватьРазметкуЦветаВТекстовыйФайл() Экспорт

	// Подготовка
	ПутьКФайлу = ПомощникТестирования.СоздатьВременныйФайл("txt");
	Содержимое = "(Ошибка|#color=Красный)";

	// Действие
	Экспортер = Новый ЭкспортерОтчетаДиагностики();
	Экспортер.Записать(Содержимое, ПутьКФайлу);
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ФактическоеСодержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	// Проверка
	Ожидаем.Что(ФактическоеСодержимое).Равно("Ошибка");

КонецПроцедуры
