#Область ОбработчикиСобытий

// Проверяет наличие локальных зависимостей перед сборкой пакета.
//
// Параметры:
//   РабочийКаталог - Строка - Каталог с исходниками пакета.
Процедура ПередСборкой(Знач РабочийКаталог) Экспорт

    КаталогЗависимостей = Новый Файл(ОбъединитьПути(ТекущийКаталог(), "oscript_modules"));
    Если Не КаталогЗависимостей.Существует() Тогда
        ВызватьИсключение "Каталог oscript_modules не существует. Установите зависимости перед сборкой.";
    КонецЕсли;

    Если Не КаталогЗависимостей.ЭтоКаталог() Тогда
        ВызватьИсключение "Путь oscript_modules не является каталогом.";
    КонецЕсли;

    УстановленныеЗависимости = НайтиФайлы(КаталогЗависимостей.ПолноеИмя, "*", Ложь);
    Если УстановленныеЗависимости.Количество() = 0 Тогда
        ВызватьИсключение "Каталог oscript_modules пуст. Установите зависимости перед сборкой.";
    КонецЕсли;

КонецПроцедуры

