// BSLLS:ExportVariables-off

#Область ОписаниеПеременных

&Сериализуемое("manifestPath")
&Тип("Строка")
Перем ПутьКМанифесту Экспорт; // Строка

&Сериализуемое("problemCount")
&Тип("Число")
Перем КоличествоПроблем Экспорт; // Число

&Сериализуемое("recommendationCount")
&Тип("Число")
Перем КоличествоРекомендаций Экспорт; // Число

&Сериализуемое("sections")
&Тип("Массив") &ДляКаждого &Тип("СекцияОтчетаДиагностики")
Перем Секции Экспорт; // Массив из СекцияОтчетаДиагностики

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	ПутьКМанифесту = "";
	КоличествоПроблем = 0;
	КоличествоРекомендаций = 0;
	Секции = Новый Массив();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет, содержит ли отчет хотя бы одну проблему.
//
// Возвращаемое значение:
//   Булево
Функция ЕстьПроблемы() Экспорт

	Возврат КоличествоПроблем > 0;

КонецФункции

#КонецОбласти
