// BSLLS:ExportVariables-off

#Область ОписаниеПеременных

&Сериализуемое("manifestPath")
&Тип("Строка")
Перем ПутьКМанифесту Экспорт; // Строка

&Сериализуемое("problemCount")
&Тип("Число")
Перем КоличествоОшибок Экспорт; // Число

&Сериализуемое("warningCount")
&Тип("Число")
Перем КоличествоПредупреждений Экспорт; // Число

&Сериализуемое("recommendationCount")
&Тип("Число")
Перем КоличествоРекомендаций Экспорт; // Число

&Сериализуемое("sections")
&Тип("Массив") &ДляКаждого &Тип("СекцияОтчетаДиагностики")
Перем Секции Экспорт; // Массив из СекцияОтчетаДиагностики

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	ПутьКМанифесту = "";
	КоличествоОшибок = 0;
	КоличествоПредупреждений = 0;
	КоличествоРекомендаций = 0;
	Секции = Новый Массив();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет, содержит ли отчет хотя бы одну ошибку.
//
// Возвращаемое значение:
//   Булево
Функция ЕстьОшибки() Экспорт

	Возврат КоличествоОшибок > 0;

КонецФункции

#КонецОбласти
