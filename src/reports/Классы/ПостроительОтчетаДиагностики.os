#Использовать "../../analysis"

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Строит упорядоченное представление результата анализа зависимостей.
//
// Параметры:
//   РезультатыАнализа - РезультатыАнализаЗависимостей - Результат анализа.
//   ПутьКМанифесту - Строка - Путь анализируемого манифеста.
//
// Возвращаемое значение:
//   ОтчетДиагностики
Функция Построить(РезультатыАнализа, ПутьКМанифесту) Экспорт

	Отчет = Новый ОтчетДиагностики();
	Отчет.ПутьКМанифесту = ПутьКМанифесту;
	Отчет.КоличествоОшибок = РезультатыАнализа.КоличествоОшибок();
	Отчет.КоличествоПредупреждений = РезультатыАнализа.КоличествоПредупреждений();
	Отчет.КоличествоРекомендаций = РезультатыАнализа.КоличествоРекомендаций();

	НомерСекции = 0;
	Для Каждого ОписаниеСекции Из ОписанияСекций() Цикл
		Элементы = ПодготовитьЭлементыТипаДляОтчета(РезультатыАнализа.Элементы(), ОписаниеСекции.Тип);
		Если Элементы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		НомерСекции = НомерСекции + 1;
		Секция = Новый СекцияОтчетаДиагностики(
			ФорматироватьНомерСекции(НомерСекции),
			ОписаниеСекции.Тип,
			ОписаниеСекции.Заголовок,
			ОписаниеСекции.Описание,
			Элементы
		);
		Отчет.Секции.Добавить(Секция);
	КонецЦикла;

	Возврат Отчет;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписанияСекций()

	Результат = Новый Массив();

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
		"Повторные объявления зависимостей",
		"Один пакет несколько раз объявлен в одном контексте"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ЗависимостьДляРазработкиВПроизводственномКоде(),
		"Зависимости для разработки в производственном коде",
		"Пакеты доступны при разработке, но не гарантированы потребителю проекта"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(),
		"Отсутствуют в манифесте",
		"Используемые пакеты не объявлены в зависимостях проекта"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки(),
		"Избыточные зависимости для разработки",
		"Производственные ограничения версий уже покрывают ограничения для разработки"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки(),
		"Производственные зависимости только для разработки",
		"Пакеты используются только во вспомогательном коде и не нужны производственному графу"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки(),
		"Неактуальные пометки зависимостей",
		"Прямое использование делает подавляющую пометку ненужной"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки(),
		"Транзитивные зависимости без пометки",
		"Пакеты не используются напрямую, но подтверждены графом зависимостей"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(),
		"Не обнаружено прямого использования",
		"Прямое использование объявленных пакетов не найдено в проверяемом коде"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ПометкаТранзитивностиНеПодтверждена(),
		"Пометки без транзитивной цепочки",
		"Не найдена подходящая цепочка от другой прямой зависимости"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.НеУстановлен(),
		"Не установлены",
		"Объявленные пакеты не найдены в доступных каталогах библиотек"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.Поврежден(),
		"Повреждены установленные пакеты",
		"Каталоги пакетов найдены, но их метаданные отсутствуют или не читаются"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
		"Несоответствие установленных версий",
		"Установленные версии не удовлетворяют ограничениям манифеста"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка(),
		"Несовместимость версий OneScript",
		"Зависимости требуют более новую версию OneScript, чем объявляет проект"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"Конфликты транзитивных зависимостей",
		"Граф зависимостей содержит несовместимые требования или недоступные пакеты"
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияВерсии(),
		"Рекомендации по версиям",
		"Прямые ограничения версий уже обеспечены транзитивными зависимостями"
	);

	Возврат Результат;

КонецФункции

Процедура ДобавитьОписаниеСекции(
	Секции,
	Тип,
	Заголовок,
	Описание = ""
)

	Секции.Добавить(Новый Структура(
		"Тип, Заголовок, Описание",
		Тип,
		Заголовок,
		Описание
	));

КонецПроцедуры

Функция ПодготовитьЭлементыТипаДляОтчета(ВсеЭлементы, Тип)

	Результат = Новый Массив();
	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("ИмяПакета");
	ТаблицаСортировки.Колонки.Добавить("ДляРазработки");
	ТаблицаСортировки.Колонки.Добавить("ТипКонфликта");
	ТаблицаСортировки.Колонки.Добавить("Источники");
	ТаблицаСортировки.Колонки.Добавить("Элемент");

	Для Каждого Элемент Из ВсеЭлементы Цикл
		Если Элемент.Тип = Тип Тогда
			КопияЭлемента = Элемент.Копия();
			ОтсортироватьТребования(КопияЭлемента.Требования);

			СтрокаТаблицы = ТаблицаСортировки.Добавить();
			СтрокаТаблицы.ИмяПакета = НРег(КопияЭлемента.ИмяПакета);
			СтрокаТаблицы.ДляРазработки = КопияЭлемента.ДляРазработки;
			СтрокаТаблицы.ТипКонфликта = КопияЭлемента.ТипКонфликта;
			СтрокаТаблицы.Источники = КлючТребований(КопияЭлемента.Требования);
			СтрокаТаблицы.Элемент = КопияЭлемента;
		КонецЕсли;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("ИмяПакета, ДляРазработки, ТипКонфликта, Источники");

	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		ОтсортироватьФайлы(СтрокаТаблицы.Элемент.Файлы);
		Результат.Добавить(СтрокаТаблицы.Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОтсортироватьТребования(Требования)

	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("Ключ");
	ТаблицаСортировки.Колонки.Добавить("Требование");

	Для Каждого Требование Из Требования Цикл
		СтрокаТаблицы = ТаблицаСортировки.Добавить();
		СтрокаТаблицы.Ключ = КлючТребования(Требование);
		СтрокаТаблицы.Требование = Требование;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("Ключ");
	Требования.Очистить();

	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Требования.Добавить(СтрокаТаблицы.Требование);
	КонецЦикла;

КонецПроцедуры

Функция КлючТребований(Требования)

	Ключи = Новый Массив();
	Для Каждого Требование Из Требования Цикл
		Ключи.Добавить(КлючТребования(Требование));
	КонецЦикла;

	Возврат СтрСоединить(Ключи, Символы.ПС);

КонецФункции

Функция КлючТребования(Требование)

	Возврат НРег(Требование.КорневаяПрямаяЗависимость) + Символы.Таб
		+ НРег(Требование.ИсточникТребования) + Символы.Таб
		+ Требование.ТребуемаяВерсия + Символы.Таб
		+ ?(Требование.ДляРазработки, "1", "0") + Символы.Таб
		+ СтрСоединить(Требование.ЦепочкаЗависимостей, Символы.Таб);

КонецФункции

Процедура ОтсортироватьФайлы(Файлы)

	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("Путь");

	Для Каждого Путь Из Файлы Цикл
		СтрокаТаблицы = ТаблицаСортировки.Добавить();
		СтрокаТаблицы.Путь = Путь;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("Путь");

	Файлы.Очистить();
	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Файлы.Добавить(СтрокаТаблицы.Путь);
	КонецЦикла;

КонецПроцедуры

Функция ФорматироватьНомерСекции(Номер)

	Возврат ?(Номер < 10, "0", "") + Номер;

КонецФункции

#КонецОбласти
