#Использовать "../../analysis"

#Область ОписаниеПеременных

Перем _ШиринаОтступа; // Число
Перем _ОтступЭлемента; // Строка
Перем _ОтступДеталей; // Строка
Перем _ОтступВложенныхДеталей; // Строка
Перем _РабочийКаталог; // Строка
Перем _ПакетыСРазнымиКонтекстами; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()

	_ШиринаОтступа = 1;
	_ОтступЭлемента = ЛевыйОтступ(2);
	_ОтступДеталей = ЛевыйОтступ(7);
	_ОтступВложенныхДеталей = ЛевыйОтступ(9);
	_РабочийКаталог = "";
	_ПакетыСРазнымиКонтекстами = Новый Соответствие();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует текстовый отчет диагностики с разметкой цветового вывода.
//
// Параметры:
//   Отчет - ОтчетДиагностики - Подготовленный отчет.
//   Подробно - Булево - Выводить все доступные детали.
//   Профиль - Структура, Неопределено - Профиль символов. По умолчанию используется Unicode.
//
// Возвращаемое значение:
//   Строка
Функция Сформировать(Отчет, Подробно = Ложь, Профиль = Неопределено) Экспорт

	Строки = Новый Массив();
	Строки.Добавить("");
	Профиль = ПолучитьПрофиль(Профиль);
	_РабочийКаталог = Новый Файл(Отчет.ПутьКМанифесту).Путь;
	_ПакетыСРазнымиКонтекстами = ПакетыСРазнымиКонтекстами(Отчет);

	ДобавитьСводку(Строки, Отчет, Профиль);
	ДобавитьСекции(Строки, Отчет, Подробно, Профиль);
	ДобавитьЗавершениеОтчета(Строки, Отчет, Подробно);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПрофиль(Профиль)

	Если Профиль = Неопределено Тогда
		Возврат Новый ОпределительВозможностейТерминала().ОпределитьДляКодировки(КодировкаТекста.UTF8);
	КонецЕсли;

	Возврат Профиль;

КонецФункции

Процедура ДобавитьСводку(Строки, Отчет, Профиль)

	Части = Новый Массив();
	КоличествоОшибок = КоличествоПозицийУровняВСводке(
		Отчет,
		УровниДиагностикиЗависимостей.Ошибка()
	);
	КоличествоПредупреждений = КоличествоПозицийУровняВСводке(
		Отчет,
		УровниДиагностикиЗависимостей.Предупреждение()
	);
	КоличествоРекомендаций = КоличествоПозицийУровняВСводке(
		Отчет,
		УровниДиагностикиЗависимостей.Рекомендация()
	);

	Если КоличествоОшибок > 0 Тогда
		ДобавитьЧастьСводки(Части, Профиль.Ошибка, КоличествоОшибок, "ошибка", "ошибки", "ошибок", "Красный");
	КонецЕсли;

	Если КоличествоПредупреждений > 0 Тогда
		ДобавитьЧастьСводки(
			Части,
			Профиль.Предупреждение,
			КоличествоПредупреждений,
			"предупреждение",
			"предупреждения",
			"предупреждений",
			"Желтый"
		);
	КонецЕсли;

	Если КоличествоРекомендаций > 0 Тогда
		ДобавитьЧастьСводки(
			Части,
			Профиль.Рекомендация,
			КоличествоРекомендаций,
			"рекомендация",
			"рекомендации",
			"рекомендаций",
			"Синий"
		);
	КонецЕсли;

	Если Не Отчет.ЕстьОшибки() Тогда
		Строки.Добавить(ОформитьЦветом(Профиль.Успех, "Зеленый") + " Ошибок не найдено.");
	КонецЕсли;

	Если Части.Количество() > 0 Тогда
		Если Не Отчет.ЕстьОшибки() Тогда
			Строки.Добавить("");
		КонецЕсли;
		Строки.Добавить(СтрСоединить(Части, "     "));
	КонецЕсли;

КонецПроцедуры

Функция КоличествоПозицийУровняВСводке(Отчет, Уровень)

	Количество = 0;
	Для Каждого Секция Из Отчет.Секции Цикл
		КлючиГрупп = Новый Соответствие();
		Для Каждого Элемент Из Секция.Элементы Цикл
			Если Элемент.Уровень <> Уровень Тогда
				Продолжить;
			КонецЕсли;

			ЭтоТранзитивныйКонфликт = Секция.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт();
			Если Не ЭтоТранзитивныйКонфликт Тогда
				Количество = Количество + 1;
				Продолжить;
			КонецЕсли;

			КлючГруппы = КлючГруппыКонфликтов(Элемент);
			Если КлючиГрупп[КлючГруппы] = Неопределено Тогда
				КлючиГрупп.Вставить(КлючГруппы, Истина);
				Количество = Количество + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Количество;

КонецФункции

Процедура ДобавитьЧастьСводки(Части, Маркер, Количество, Форма1, Форма2, Форма5, Цвет)

	Части.Добавить(СтрШаблон(
		"%1 %2 %3",
		ОформитьЦветом(Маркер, Цвет),
		ОформитьЦветом(Количество, Цвет),
		ОформитьЦветом(ФормаСлова(Количество, Форма1, Форма2, Форма5), Цвет)
	));

КонецПроцедуры

Процедура ДобавитьСекции(Строки, Отчет, Подробно, Профиль)

	Секции = СекцииДляВывода(Отчет.Секции);
	НомерСекции = 0;
	Для Каждого Секция Из Секции Цикл
		НомерСекции = НомерСекции + 1;
		Строки.Добавить("");
		Строки.Добавить(РазделительСекции(Профиль));
		Строки.Добавить(СтрШаблон("%1  %2", ФорматироватьНомерСекции(НомерСекции), Секция.Заголовок));
		
		Если ЗначениеЗаполнено(Секция.Описание) Тогда
			Строки.Добавить(ЛевыйОтступ(4) + ОформитьЦветом(Секция.Описание, "ТемноСерый"));
		КонецЕсли;

		Строки.Добавить("");
		ДобавитьЭлементыСекции(Строки, Секция, Подробно, Профиль);
	КонецЦикла;

	Если Секции.Количество() > 0 И Не Подробно Тогда
		Строки.Добавить("");
		Строки.Добавить(РазделительСекции(Профиль));
	КонецЕсли;

КонецПроцедуры

Функция СекцииДляВывода(Секции)

	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("Приоритет");
	ТаблицаСортировки.Колонки.Добавить("Порядок");
	ТаблицаСортировки.Колонки.Добавить("Секция");

	Порядок = 0;
	Для Каждого Секция Из Секции Цикл
		СтрокаТаблицы = ТаблицаСортировки.Добавить();
		СтрокаТаблицы.Приоритет = ПриоритетСекции(Секция);
		СтрокаТаблицы.Порядок = Порядок;
		СтрокаТаблицы.Секция = Секция;
		Порядок = Порядок + 1;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("Приоритет, Порядок");

	Результат = Новый Массив();
	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Результат.Добавить(СтрокаТаблицы.Секция);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПриоритетСекции(Секция)

	Результат = 4;
	Для Каждого Элемент Из Секция.Элементы Цикл
		Результат = Мин(Результат, ПриоритетУровня(Элемент.Уровень));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПриоритетУровня(Уровень)

	Если Уровень = УровниДиагностикиЗависимостей.Ошибка() Тогда
		Возврат 1;
	ИначеЕсли Уровень = УровниДиагностикиЗависимостей.Предупреждение() Тогда
		Возврат 2;
	ИначеЕсли Уровень = УровниДиагностикиЗависимостей.Рекомендация() Тогда
		Возврат 3;
	КонецЕсли;

	Возврат 4;

КонецФункции

Функция ФорматироватьНомерСекции(Номер)

	Возврат ?(Номер < 10, "0", "") + Номер;

КонецФункции

Процедура ДобавитьЭлементыСекции(Строки, Секция, Подробно, Профиль)

	Элементы = ЭлементыДляВывода(Секция.Элементы);
	Если Секция.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт() Тогда
		ДобавитьГруппыТранзитивныхКонфликтов(Строки, Элементы, Подробно, Профиль);
		Возврат;
	КонецЕсли;

	КоличествоЭлементов = Элементы.Количество();
	РазделятьЭлементы = Секция.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()
		Или Секция.Тип = ТипыДиагностикиЗависимостей.НесоответствиеВерсий()
		Или Секция.Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии();

	Для Индекс = 0 По КоличествоЭлементов - 1 Цикл
		ДобавитьЭлемент(Строки, Элементы[Индекс], Подробно, Профиль);
		Если РазделятьЭлементы И Индекс < КоличествоЭлементов - 1 Тогда
			Строки.Добавить("");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭлементыДляВывода(Элементы)

	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("Приоритет");
	ТаблицаСортировки.Колонки.Добавить("Порядок");
	ТаблицаСортировки.Колонки.Добавить("Элемент");

	Порядок = 0;
	Для Каждого Элемент Из Элементы Цикл
		СтрокаТаблицы = ТаблицаСортировки.Добавить();
		СтрокаТаблицы.Приоритет = ПриоритетУровня(Элемент.Уровень);
		СтрокаТаблицы.Порядок = Порядок;
		СтрокаТаблицы.Элемент = Элемент;
		Порядок = Порядок + 1;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("Приоритет, Порядок");

	Результат = Новый Массив();
	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Результат.Добавить(СтрокаТаблицы.Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьГруппыТранзитивныхКонфликтов(Строки, Элементы, Подробно, Профиль)

	Индекс = 0;
	Пока Индекс < Элементы.Количество() Цикл
		ПервыйЭлемент = Элементы[Индекс];
		КлючГруппы = КлючГруппыКонфликтов(ПервыйЭлемент);
		Группа = Новый Массив();

		Пока Индекс < Элементы.Количество()
			И КлючГруппыКонфликтов(Элементы[Индекс]) = КлючГруппы Цикл
			Группа.Добавить(Элементы[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;

		Если Группа.Количество() = 1 Тогда
			ДобавитьЭлемент(Строки, ПервыйЭлемент, Подробно, Профиль);
		ИначеЕсли Подробно Тогда
			ДобавитьГруппуТранзитивныхКонфликтов(Строки, Группа, Профиль);
		Иначе
			ДобавитьКраткуюГруппуТранзитивныхКонфликтов(Строки, Группа, Профиль);
		КонецЕсли;

		Если Индекс < Элементы.Количество() Тогда
			Строки.Добавить("");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КлючГруппыКонфликтов(Элемент)

	Возврат НРег(Элемент.ИмяПакета) + "|" + ?(Элемент.ДляРазработки, "1", "0");

КонецФункции

Процедура ДобавитьКраткуюГруппуТранзитивныхКонфликтов(Строки, Элементы, Профиль)

	ДобавитьЗаголовокЭлемента(Строки, Элементы[0], Профиль);

	Для Каждого Элемент Из Элементы Цикл
		Если ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
			ДобавитьПоле(Строки, "Установлена:", ОформитьЦветом(Элемент.УстановленнаяВерсия, "Красный"));
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Требования = УникальныеВерсионныеТребованияГруппы(Элементы);
	ДобавитьТребованияГруппы(Строки, Требования, Профиль);

КонецПроцедуры

Функция УникальныеВерсионныеТребованияГруппы(Элементы)

	Результат = Новый Массив();
	Ключи = Новый Соответствие();
	Для Каждого Элемент Из Элементы Цикл
		Для Каждого Требование Из Элемент.Требования Цикл
			Если Не ЗначениеЗаполнено(Требование.ТребуемаяВерсия) Тогда
				Продолжить;
			КонецЕсли;

			Источник = ?(ЗначениеЗаполнено(Требование.ИсточникТребования),
				Требование.ИсточникТребования,
				Требование.КорневаяПрямаяЗависимость
			);
			Ключ = НРег(Источник) + "|" + НРег(Требование.ТребуемаяВерсия);
			Если Ключи[Ключ] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Ключи.Вставить(Ключ, Истина);
			ДанныеТребования = Новый Структура();
			ДанныеТребования.Вставить("Источник", Источник);
			ДанныеТребования.Вставить("Версия", Требование.ТребуемаяВерсия);
			Результат.Добавить(ДанныеТребования);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьТребованияГруппы(Строки, Требования, Профиль)

	Если Требования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить(_ОтступДеталей + "Требования:");
	ПоследнийИндекс = Требования.Количество() - 1;
	Для Индекс = 0 По ПоследнийИндекс Цикл
		Ветка = ?(Индекс = ПоследнийИндекс, Профиль.ПоследняяВетка, Профиль.Ветка);
		Требование = Требования[Индекс];
		Строки.Добавить(_ОтступВложенныхДеталей + Ветка + " "
			+ ОформитьЦветом(Требование.Источник, "Серый") + ": "
			+ ОформитьЦветом(Требование.Версия, "Бирюза"));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьГруппуТранзитивныхКонфликтов(Строки, Элементы, Профиль)

	ДобавитьЗаголовокЭлемента(Строки, Элементы[0], Профиль);

	Поля = Новый Массив();
	ДобавитьПолеВГруппу(Поля, "Причина:", ПричинаГруппыТранзитивныхКонфликтов(Элементы));

	Для Каждого Элемент Из Элементы Цикл
		Если ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
			ДобавитьПолеВГруппу(
				Поля,
				"Установлена:",
				ОформитьЦветом(Элемент.УстановленнаяВерсия, "Красный")
			);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ДобавитьГруппуПолей(Строки, Поля);

	Требования = УникальныеВерсионныеТребованияГруппы(Элементы);
	ДобавитьТребованияГруппы(Строки, Требования, Профиль);

КонецПроцедуры

Функция ПричинаГруппыТранзитивныхКонфликтов(Элементы)

	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.ТипКонфликта = ТипыКонфликтовЗависимостей.НесовместимыеТребования() Тогда
			Возврат "требования зависимостей несовместимы";
		КонецЕсли;
	КонецЦикла;

	Возврат "установленная версия не удовлетворяет требованиям";

КонецФункции

Процедура ДобавитьЗавершениеОтчета(Строки, Отчет, Подробно)

	Если НЕ Подробно И (Отчет.ЕстьОшибки()
		Или Отчет.КоличествоПредупреждений > 0
		Или Отчет.КоличествоРекомендаций > 0) Тогда
		Строки.Добавить("Для подробностей запустите команду с " + ОформитьЦветом("--verbose", "Желтый"));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЭлемент(Строки, Элемент, Подробно, Профиль)

	ДобавитьЗаголовокЭлемента(Строки, Элемент, Профиль);

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте() Тогда
		ДобавитьПредложениеОбъявления(Строки, Элемент);
	КонецЕсли;

	ДобавитьОписаниеЭлемента(Строки, Элемент, Подробно);
	ДобавитьПодробнуюПричинуЭлемента(Строки, Элемент, Подробно);

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии() Тогда
		ДобавитьРекомендациюВерсии(Строки, Элемент, Подробно, Профиль);
		Возврат;
	КонецЕсли;

	ДобавитьВерсииЭлемента(Строки, Элемент, Подробно, Профиль);
	ДобавитьФайлыИКаталог(Строки, Элемент, Подробно, Профиль);
	ДобавитьТребованияЭлемента(Строки, Элемент, Подробно, Профиль);

КонецПроцедуры

Процедура ДобавитьОписаниеЭлемента(Строки, Элемент, Подробно)

	Если ЭтоСтруктурнаяДиагностика(Элемент) Тогда
		ДобавитьСтруктурнуюДиагностику(Строки, Элемент, Подробно);
		Возврат;
	КонецЕсли;

	ЭтоТранзитивныйКонфликт = Элемент.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт();
	СкрытьКраткоеОписание = Подробно И ЭтоТранзитивныйКонфликт;
	ПоказыватьКраткоеОписание = Подробно
		Или ЭтоТранзитивныйКонфликт
		Или Элемент.Тип = ТипыДиагностикиЗависимостей.ПометкаТранзитивностиНеПодтверждена();
	ЭтоРекомендацияВерсии = Элемент.Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии();
	ЕстьКраткоеОписание = ЗначениеЗаполнено(Элемент.КраткоеОписание);

	Если ПоказыватьКраткоеОписание
		И НЕ ЭтоРекомендацияВерсии
		И ЕстьКраткоеОписание
		И НЕ СкрытьКраткоеОписание Тогда
		Строки.Добавить(_ОтступДеталей + ОформитьКраткоеОписание(Элемент.КраткоеОписание));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПодробнуюПричинуЭлемента(Строки, Элемент, Подробно)

	ЭтоТранзитивныйКонфликт = Элемент.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт();
	ПоказыватьПодробнуюПричину = Подробно
		И ЗначениеЗаполнено(Элемент.ПодробнаяПричина)
		И НЕ ЭтоТранзитивныйКонфликт;
	Если НЕ ПоказыватьПодробнуюПричину Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоСтруктурнаяДиагностика(Элемент) Тогда
		ДобавитьПодробнуюПричинуСтруктурнойДиагностики(Строки, Элемент);
	ИначеЕсли Элемент.Тип = ТипыДиагностикиЗависимостей.Поврежден() Тогда
		ДобавитьПоле(Строки, "Причина:", Элемент.ПодробнаяПричина);
	Иначе
		Строки.Добавить(_ОтступДеталей + Элемент.ПодробнаяПричина);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПодробнуюПричинуСтруктурнойДиагностики(Строки, Элемент)

	ЭтоПовторноеОбъявление = Элемент.Тип = ТипыДиагностикиЗависимостей.ПовторноеОбъявление();
	ЕстьУдаляемоеОбъявление = ЭтоПовторноеОбъявление И ЗначениеЗаполнено(Элемент.КраткоеОписание);

	Если ЕстьУдаляемоеОбъявление Тогда
		Подпись = "Оставить:";
		Значение = ОбъявлениеДляСохранения(Элемент.ПодробнаяПричина);
	Иначе
		Подпись = ?(ЭтоПовторноеОбъявление, "Объявления:", "Причина:");
		Значение = Элемент.ПодробнаяПричина;
	КонецЕсли;

	ДобавитьПоле(Строки, Подпись, Значение);

КонецПроцедуры

Процедура ДобавитьТребованияЭлемента(Строки, Элемент, Подробно, Профиль)

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки() Тогда
		ДобавитьТребования(Строки, Элемент.Требования, Профиль, "Цепочки:");
		Возврат;
	КонецЕсли;

	Если Подробно Или Элемент.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт() Тогда
		ДобавитьТребования(Строки, Элемент.Требования, Профиль, "Требования:");
	Иначе
		ДобавитьКраткиеИсточники(Строки, Элемент.Требования);
	КонецЕсли;

КонецПроцедуры

Функция ОбъявлениеДляСохранения(ОписаниеОбъявлений)

	Объявления = СтрРазделить(ОписаниеОбъявлений, Символы.ПС, Ложь);
	Возврат ?(Объявления.Количество() = 0, "", Объявления[0]);

КонецФункции

Процедура ДобавитьЗаголовокЭлемента(Строки, Элемент, Профиль, Дополнение = "")

	ПоказыватьПроизводственныйКонтекст = Не Элемент.ДляРазработки
		И _ПакетыСРазнымиКонтекстами[НРег(Элемент.ИмяПакета)] <> Неопределено;

	Если Элемент.ДляРазработки Тогда
		Контекст = "(dev)";
	ИначеЕсли ПоказыватьПроизводственныйКонтекст Тогда
		Контекст = "(prod)";
	Иначе
		Контекст = "";
	КонецЕсли;

	КонтекстРазработки = ?(ЗначениеЗаполнено(Контекст), " " + ОформитьЦветом(Контекст, "Желтый"), "");
	Строки.Добавить(СтрШаблон(
		"%1%2 %3%4%5",
		_ОтступЭлемента, МаркерУровняДиагностики(Элемент, Профиль),
		ОформитьЦветом(Элемент.ИмяПакета, "Белый"),
		КонтекстРазработки,
		Дополнение
	));

КонецПроцедуры

Процедура ДобавитьФайлыИКаталог(Строки, Элемент, Подробно, Профиль)

	ПоказыватьФайлы = Элемент.Файлы.Количество() > 0;

	Если ПоказыватьФайлы Тогда
		ДобавитьФайлы(Строки, Элемент.Файлы, Подробно, Профиль);
	КонецЕсли;

	Если Не Подробно Тогда
		Поля = Новый Массив();
		Если Элемент.Тип = ТипыДиагностикиЗависимостей.Поврежден()
			И ЗначениеЗаполнено(Элемент.ПодробнаяПричина) Тогда
			ДобавитьПолеВГруппу(Поля, "Причина:", Элемент.ПодробнаяПричина);
		КонецЕсли;

		ДобавитьКаталогВГруппу(Поля, Элемент);

		ШиринаПодписи = 0;
		ПодписьВерсии = ПодписьВерсииКраткогоОтчета(Элемент);
		Если ЗначениеЗаполнено(ПодписьВерсии) Тогда
			ШиринаПодписи = ШиринаПодписиСКаталогом(Элемент, ПодписьВерсии);
		КонецЕсли;

		ДобавитьГруппуПолей(Строки, Поля, ШиринаПодписи);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьВерсииЭлемента(Строки, Элемент, Подробно, Профиль)

	Если Подробно Тогда
		ДобавитьПодробныеВерсииЭлемента(Строки, Элемент);
		Возврат;
	КонецЕсли;

	ДобавитьКраткиеВерсииЭлемента(Строки, Элемент, Профиль);

КонецПроцедуры

Процедура ДобавитьПодробныеВерсииЭлемента(Строки, Элемент)

	Поля = Новый Массив();
	ДобавитьПричинуТранзитивногоКонфликтаВГруппу(Поля, Элемент);
	ДобавитьПодробныеПоляВерсий(Поля, Элемент);
	ДобавитьКаталогВГруппу(Поля, Элемент);
	ДобавитьГруппуПолей(Строки, Поля);

КонецПроцедуры

Процедура ДобавитьПричинуТранзитивногоКонфликтаВГруппу(Поля, Элемент)

	Если Элемент.Тип <> ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт() Тогда
		Возврат;
	КонецЕсли;

	Причина = ?(
		ЗначениеЗаполнено(Элемент.ПодробнаяПричина),
		Элемент.ПодробнаяПричина,
		Элемент.КраткоеОписание
	);
	Если ЗначениеЗаполнено(Причина) Тогда
		ДобавитьПолеВГруппу(Поля, "Причина:", Причина);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПодробныеПоляВерсий(Поля, Элемент)

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка() Тогда
		ДобавитьПолеВГруппу(Поля, "Версия пакета:", Элемент.УстановленнаяВерсия);
		ДобавитьПолеВГруппу(Поля, "Заявлено проектом:",
			"OneScript " + ОформитьЦветом(">=" + Элемент.ВерсияСредыПроверяемогоПакета, "Красный"));
		ДобавитьПолеВГруппу(Поля, "Требуется пакетом:",
			"OneScript " + ОформитьЦветом(">=" + Элемент.ВерсияСредыЗависимости, "Зеленый"));
	ИначеЕсли Элемент.Тип <> ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте() Тогда
		Если ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
			ДобавитьПолеВГруппу(Поля, "Установлена:",
				ОформитьЦветом(Элемент.УстановленнаяВерсия, "Красный"));
		КонецЕсли;

		Если ЗначениеЗаполнено(Элемент.ТребуемаяВерсия) Тогда
			ДобавитьПолеВГруппу(Поля, "Требуется:",
				ОформитьЦветом(Элемент.ТребуемаяВерсия, "Зеленый"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКраткиеВерсииЭлемента(Строки, Элемент, Профиль)

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка() Тогда
		ДобавитьВерсииДвижка(Строки, Элемент, Профиль);
		Возврат;
	КонецЕсли;

	ВыводитсяТолькоТребование = Элемент.Тип = ТипыДиагностикиЗависимостей.НеУстановлен()
		Или ЭтоНедоступнаяТранзитивнаяЗависимость(Элемент);
	Если ВыводитсяТолькоТребование Тогда
		ДобавитьТребуемуюВерсиюКраткогоОтчета(Строки, Элемент);
		Возврат;
	КонецЕсли;

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()
		Или НЕ (ЗначениеЗаполнено(Элемент.УстановленнаяВерсия)
			Или ЗначениеЗаполнено(Элемент.ТребуемаяВерсия)) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
		УстановленнаяВерсия = "Не установлена";
	ИначеЕсли НЕ ЗначениеЗаполнено(Элемент.ТребуемаяВерсия) Тогда
		ДобавитьПоле(
			Строки,
			"Установлена:",
			ОформитьЦветом(Элемент.УстановленнаяВерсия, "Красный"),
			ШиринаПодписиСКаталогом(Элемент, "Установлена:")
		);
		Возврат;
	Иначе
		УстановленнаяВерсия = Элемент.УстановленнаяВерсия;
	КонецЕсли;

	ЗначениеВерсии = СтрШаблон(
		"%1 %2 %3",
		ОформитьЦветом(УстановленнаяВерсия, "Красный"),
		Профиль.Стрелка,
		ОформитьЦветом(Элемент.ТребуемаяВерсия, "Зеленый")
	);
	ДобавитьПоле(Строки, "Версия:", ЗначениеВерсии, ШиринаПодписиСКаталогом(Элемент, "Версия:"));

КонецПроцедуры

Процедура ДобавитьТребуемуюВерсиюКраткогоОтчета(Строки, Элемент)

	Если НЕ ЗначениеЗаполнено(Элемент.ТребуемаяВерсия) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьПоле(
		Строки,
		"Требуется:",
		ОформитьЦветом(Элемент.ТребуемаяВерсия, "Зеленый"),
		ШиринаПодписиСКаталогом(Элемент, "Требуется:")
	);

КонецПроцедуры

Функция ЭтоНедоступнаяТранзитивнаяЗависимость(Элемент)

	Возврат Элемент.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт()
		И НЕ ЗначениеЗаполнено(Элемент.УстановленнаяВерсия);

КонецФункции

Функция ПодписьВерсииКраткогоОтчета(Элемент)

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка() Тогда
		Возврат "OneScript:";
	КонецЕсли;

	ЕстьУстановленнаяВерсия = ЗначениеЗаполнено(Элемент.УстановленнаяВерсия);
	ЕстьТребуемаяВерсия = ЗначениеЗаполнено(Элемент.ТребуемаяВерсия);
	ВыводитсяТолькоТребование = Элемент.Тип = ТипыДиагностикиЗависимостей.НеУстановлен()
		Или ЭтоНедоступнаяТранзитивнаяЗависимость(Элемент);

	Если ВыводитсяТолькоТребование Тогда
		Возврат ?(ЕстьТребуемаяВерсия, "Требуется:", "");
	КонецЕсли;

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()
		Или НЕ (ЕстьУстановленнаяВерсия Или ЕстьТребуемаяВерсия) Тогда
		Возврат "";
	КонецЕсли;

	Если ЕстьУстановленнаяВерсия И НЕ ЕстьТребуемаяВерсия Тогда
		Возврат "Установлена:";
	КонецЕсли;

	Возврат "Версия:";

КонецФункции

Процедура ДобавитьВерсииДвижка(Строки, Элемент, Профиль)

	ЗначениеВерсии = СтрШаблон(
		"%1 %2 %3",
		ОформитьЦветом(">=" + Элемент.ВерсияСредыПроверяемогоПакета, "Красный"),
		Профиль.Стрелка,
		ОформитьЦветом(">=" + Элемент.ВерсияСредыЗависимости, "Зеленый")
	);

	ДобавитьПоле(Строки, "OneScript:", ЗначениеВерсии, ШиринаПодписиСКаталогом(Элемент, "OneScript:"));

КонецПроцедуры

Процедура ДобавитьФайлы(Строки, Файлы, Подробно, Профиль)

	Если Подробно Тогда
		Строки.Добавить(_ОтступДеталей + "Использование:");
		КоличествоФайлов = Файлы.Количество();
		Для Индекс = 0 По КоличествоФайлов - 1 Цикл
			Ветвь = ?(Индекс = КоличествоФайлов - 1, Профиль.ПоследняяВетка, Профиль.Ветка) + " ";

			Строки.Добавить(_ОтступВложенныхДеталей
				+ Ветвь
				+ ОформитьЦветом(ПутьДляОтчета(Файлы[Индекс]), "Серый"));
		КонецЦикла;
		Возврат;
	КонецЕсли;

	КоличествоСкрытых = Файлы.Количество() - 1;
	Дополнение = ?(КоличествоСкрытых > 0,
		ОформитьЦветом(
			СтрШаблон(
				" (+%1 %2)",
				КоличествоСкрытых,
				ФормаСлова(КоличествоСкрытых, "файл", "файла", "файлов")
			),
			"ТемноСерый"
		),
		""
	);

	ДобавитьПоле(
		Строки,
		"Использование:",
		ОформитьЦветом(ПутьДляОтчета(Файлы[0]), "Серый") + Дополнение
	);

КонецПроцедуры

Процедура ДобавитьКраткиеИсточники(Строки, Требования)

	Источники = Новый Массив();
	Для Каждого Требование Из Требования Цикл
		Источник = ?(ЗначениеЗаполнено(Требование.ИсточникТребования),
			Требование.ИсточникТребования,
			Требование.КорневаяПрямаяЗависимость
		);

		Если ЗначениеЗаполнено(Источник) И Источники.Найти(Источник) = Неопределено Тогда
			Источники.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;

	Если Источники.Количество() > 0 Тогда
		Строки.Добавить(_ОтступДеталей + СтрСоединить(Источники, ", "));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьТребования(Строки, Требования, Профиль, Заголовок = "Требования:")

	Если Требования.Количество() > 0 И ЗначениеЗаполнено(Заголовок) Тогда
		Строки.Добавить(_ОтступДеталей + Заголовок);
	КонецЕсли;

	Для Индекс = 0 По Требования.ВГраница() Цикл
		Требование = Требования[Индекс];
		Последнее = Индекс = Требования.ВГраница();
		Ветка = ?(Последнее, Профиль.ПоследняяВетка, Профиль.Ветка);
	
		Если Требование.ЦепочкаЗависимостей.Количество() > 0 Тогда
			Цепочка = СтрСоединить(Требование.ЦепочкаЗависимостей, " -> ");
		Иначе
			Цепочка = ?(ЗначениеЗаполнено(Требование.ИсточникТребования),
				Требование.ИсточникТребования,
				Требование.КорневаяПрямаяЗависимость
			);
		КонецЕсли;

		СтрокаТребования = _ОтступВложенныхДеталей + Ветка + " " + ОформитьЦветом(Цепочка, "Серый");
		Если ЗначениеЗаполнено(Требование.ТребуемаяВерсия) Тогда
			СтрокаТребования = СтрокаТребования + ОформитьЦветом(" (" + Требование.ТребуемаяВерсия + ")", "Бирюза");
		КонецЕсли;

		Строки.Добавить(СтрокаТребования);
	КонецЦикла;

КонецПроцедуры

Функция ОтобратьТребованияСВерсией(Требования)

	Результат = Новый Массив();
	Для Каждого Требование Из Требования Цикл
		Если ЗначениеЗаполнено(Требование.ТребуемаяВерсия) Тогда
			Результат.Добавить(Требование);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьРекомендациюВерсии(Строки, Элемент, Подробно, Профиль)

	Если Подробно Тогда
		Поля = Новый Массив();
		Если ЗначениеЗаполнено(Элемент.КраткоеОписание) Тогда
			ДобавитьПолеВГруппу(
				Поля,
				"Объявление:",
				ОформитьОбъявлениеСНомеромСтроки(Элемент.КраткоеОписание, "Белый")
			);
		КонецЕсли;

		Если ЗначениеЗаполнено(Элемент.ТекущаяМинимальнаяВерсия) Тогда
			ДобавитьПолеВГруппу(Поля, "Ограничение:",
				ОформитьЦветом(">=" + Элемент.ТекущаяМинимальнаяВерсия, "Бирюза"));
			ДобавитьПолеВГруппу(Поля, "Рекомендация:", ОформитьЦветом("не указывать", "Зеленый"));
		КонецЕсли;

		Если ЗначениеЗаполнено(Элемент.ТранзитивнаяМинимальнаяВерсия) Тогда
			ДобавитьПолеВГруппу(Поля, "Транзитивно:",
				ОформитьЦветом(">=" + Элемент.ТранзитивнаяМинимальнаяВерсия, "Бирюза"));
		КонецЕсли;

		ДобавитьКаталогВГруппу(Поля, Элемент);
		ДобавитьГруппуПолей(Строки, Поля);
	Иначе
		Строки.Добавить(СтрШаблон(
			"%1Ограничение: %2 %3 %4",
			_ОтступДеталей,
			ОформитьЦветом(">=" + Элемент.ТекущаяМинимальнаяВерсия, "Бирюза"),
			Профиль.Стрелка,
			ОформитьЦветом("не указывать", "Бирюза")
		));
	КонецЕсли;

	ДобавитьФайлыИКаталог(Строки, Элемент, Подробно, Профиль);
	ДобавитьТребования(Строки,
		ОтобратьТребованияСВерсией(Элемент.Требования),
		Профиль,
		"Цепочки:"
	);

КонецПроцедуры

Процедура ДобавитьПредложениеОбъявления(Строки, Элемент)

	ИмяМетода = ?(Элемент.ДляРазработки, ".РазработкаЗависитОт", ".ЗависитОт");
	Аргументы = """" + СтрЗаменить(Элемент.ИмяПакета, """", """""") + """";

	Если ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
		Аргументы = Аргументы + ", """ + Элемент.УстановленнаяВерсия + """";
	КонецЕсли;

	Объявление = ИмяМетода + "(" + Аргументы + ")";
	Строки.Добавить(_ОтступДеталей + ОформитьЦветом("+ " + Объявление, "Зеленый"));

КонецПроцедуры

Функция МаркерУровняДиагностики(Элемент, Профиль)

	Если Элемент.Уровень = УровниДиагностикиЗависимостей.Рекомендация() Тогда
		Возврат ОформитьЦветом(Профиль.Рекомендация, "Синий");
	КонецЕсли;

	Если Элемент.Уровень = УровниДиагностикиЗависимостей.Предупреждение() Тогда
		Возврат ОформитьЦветом(Профиль.Предупреждение, "Желтый");
	КонецЕсли;

	Возврат ОформитьЦветом(Профиль.Ошибка, "Красный");

КонецФункции

Функция ЭтоСтруктурнаяДиагностика(Элемент)

	Возврат ТипыДиагностикиЗависимостей.ЭтоСтруктурнаяДиагностика(Элемент.Тип);

КонецФункции

Функция ОформитьКраткоеОписание(КраткоеОписание)

	ПодписьОбъявления = "Объявлено:";
	ЭтоОбъявление = Лев(КраткоеОписание, СтрДлина(ПодписьОбъявления)) = ПодписьОбъявления;
	Если Не ЭтоОбъявление Тогда
		Возврат ОформитьЦветом(КраткоеОписание, "ТемноСерый");
	КонецЕсли;

	НачалоОбъявления = СтрДлина(ПодписьОбъявления) + 2;
	Объявление = Сред(КраткоеОписание, НачалоОбъявления);
	Возврат ПодписьОбъявления + " " + ОформитьОбъявлениеСНомеромСтроки(Объявление, "Серый");

КонецФункции

Функция ОформитьОбъявлениеСНомеромСтроки(Объявление, ЦветОбъявления)

	МаркерНомераСтроки = "  (строка ";
	ПозицияНомераСтроки = СтрНайти(Объявление, МаркерНомераСтроки);
	Если ПозицияНомераСтроки = 0 Тогда
		Возврат ОформитьЦветом(Объявление, ЦветОбъявления);
	КонецЕсли;

	ТекстОбъявления = Лев(Объявление, ПозицияНомераСтроки - 1);
	Возврат ОформитьЦветом(ТекстОбъявления, ЦветОбъявления)
		+ "  "
		+ ОформитьЦветом(Сред(Объявление, ПозицияНомераСтроки + 2), "ТемноСерый");

КонецФункции

Процедура ДобавитьСтруктурнуюДиагностику(Строки, Элемент, Подробно)

	Если Не ЗначениеЗаполнено(Элемент.КраткоеОписание) Тогда
		Возврат;
	КонецЕсли;

	ЭтоПовторноеОбъявление = Элемент.Тип = ТипыДиагностикиЗависимостей.ПовторноеОбъявление();
	Если ЭтоПовторноеОбъявление И ЗначениеЗаполнено(Элемент.ПодробнаяПричина) Тогда
		ДобавитьУдаляемыеПовторныеОбъявления(Строки, Элемент.ПодробнаяПричина);
		Возврат;
	КонецЕсли;

	Разделитель = " → ";
	Позиция = СтрНайти(Элемент.КраткоеОписание, Разделитель);
	Если Позиция = 0 Тогда
		Строки.Добавить(_ОтступДеталей
			+ ОформитьЦветом("+ " + Элемент.КраткоеОписание, "Зеленый"));
		Возврат;
	КонецЕсли;

	ИсходноеОбъявление = Лев(Элемент.КраткоеОписание, Позиция - 1);
	ДобавитьУдаляемоеОбъявление(Строки, ИсходноеОбъявление, ЭтоПовторноеОбъявление Или Подробно);

	ЭтоУдаление = ЭтоПовторноеОбъявление
		Или Элемент.Тип = ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки();

	Если ЭтоУдаление Тогда
		Возврат;
	КонецЕсли;

	РекомендованноеОбъявление = Сред(Элемент.КраткоеОписание, Позиция + СтрДлина(Разделитель));
	Строки.Добавить(_ОтступДеталей
		+ ОформитьЦветом("+ " + РекомендованноеОбъявление, "Зеленый"));

КонецПроцедуры

Процедура ДобавитьУдаляемыеПовторныеОбъявления(Строки, ОписаниеОбъявлений)

	Объявления = СтрРазделить(ОписаниеОбъявлений, Символы.ПС, Ложь);
	Для Индекс = 1 По Объявления.Количество() - 1 Цикл
		ДобавитьУдаляемоеОбъявление(Строки, Объявления[Индекс], Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьУдаляемоеОбъявление(Строки, ИсходноеОбъявление, ПоказыватьНомерСтроки)

	Дополнение = "";
	ПрефиксНомераСтроки = "Строка ";
	ПозицияРазделителя = СтрНайти(ИсходноеОбъявление, ": ");
	НачинаетсяСНомераСтроки = Лев(
		ИсходноеОбъявление,
		СтрДлина(ПрефиксНомераСтроки)
	) = ПрефиксНомераСтроки;
	ЕстьНомерСтроки = НачинаетсяСНомераСтроки
		И ПозицияРазделителя > СтрДлина(ПрефиксНомераСтроки);

	Если ЕстьНомерСтроки Тогда
		НомерСтроки = Сред(
			ИсходноеОбъявление,
			СтрДлина(ПрефиксНомераСтроки) + 1,
			ПозицияРазделителя - СтрДлина(ПрефиксНомераСтроки) - 1
		);
		ИсходноеОбъявление = Сред(ИсходноеОбъявление, ПозицияРазделителя + 2);

		Если ПоказыватьНомерСтроки Тогда
			Дополнение = "  " + ОформитьЦветом("(строка " + НомерСтроки + ")", "ТемноСерый");
		КонецЕсли;
	КонецЕсли;

	Строки.Добавить(_ОтступДеталей
		+ ОформитьЦветом("- " + ИсходноеОбъявление, "Красный")
		+ Дополнение);

КонецПроцедуры

Функция ОформитьЦветом(Текст, Цвет)

	Возврат ПомощникКонсольногоВывода.ПокраситьТекст(Текст, Цвет);

КонецФункции

Процедура ДобавитьКаталогВГруппу(Поля, Элемент)

	Если ЗначениеЗаполнено(Элемент.Каталог) Тогда
		ДобавитьПолеВГруппу(Поля, "Каталог:", ОформитьЦветом(ПутьДляОтчета(Элемент.Каталог), "Серый"));
	КонецЕсли;

КонецПроцедуры

Функция ШиринаПодписиСКаталогом(Элемент, Подпись)

	ШиринаПодписи = СтрДлина(Подпись);
	Если ЗначениеЗаполнено(Элемент.Каталог)
		И СтрДлина("Каталог:") > ШиринаПодписи Тогда
		ШиринаПодписи = СтрДлина("Каталог:");
	КонецЕсли;

	Возврат ШиринаПодписи;

КонецФункции

Процедура ДобавитьПолеВГруппу(Поля, Подпись, Значение)

	Поле = Новый Структура();
	Поле.Вставить("Подпись", Подпись);
	Поле.Вставить("Значение", Значение);
	Поля.Добавить(Поле);

КонецПроцедуры

Процедура ДобавитьГруппуПолей(Строки, Поля, МинимальнаяШиринаПодписи = 0)

	ШиринаПодписи = МинимальнаяШиринаПодписи;
	Для Каждого Поле Из Поля Цикл
		ДлинаПодписи = СтрДлина(Поле.Подпись);
		Если ДлинаПодписи > ШиринаПодписи Тогда
			ШиринаПодписи = ДлинаПодписи;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Поле Из Поля Цикл
		ДобавитьПоле(Строки, Поле.Подпись, Поле.Значение, ШиринаПодписи);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоле(Строки, Подпись, Значение, ШиринаПодписи = 0)

	Если ШиринаПодписи = 0 Тогда
		ШиринаПодписи = СтрДлина(Подпись);
	КонецЕсли;

	Заполнитель = ПомощникКонсольногоВывода.ФиксированнаяСтрока(
		"",
		ШиринаПодписи - СтрДлина(Подпись)
	);
	Префикс = _ОтступДеталей + Подпись + Заполнитель + " ";
	ОтступПродолжения = ПомощникКонсольногоВывода.ФиксированнаяСтрока("", СтрДлина(Префикс));
	ВыровненноеЗначение = СтрЗаменить(Значение, Символы.ПС, Символы.ПС + ОтступПродолжения);
	Строки.Добавить(Префикс + ВыровненноеЗначение);

КонецПроцедуры

Функция ПакетыСРазнымиКонтекстами(Отчет)

	Контексты = Новый Соответствие();
	Для Каждого Секция Из Отчет.Секции Цикл
		Для Каждого Элемент Из Секция.Элементы Цикл
			Ключ = НРег(Элемент.ИмяПакета);
			Контекст = Контексты[Ключ];
			Если Контекст = Неопределено Тогда
				Контекст = Новый Структура(
					"ЕстьПроизводственныйКонтекст, ЕстьКонтекстРазработки",
					Ложь,
					Ложь
				);
				Контексты.Вставить(Ключ, Контекст);
			КонецЕсли;

			Если Элемент.ДляРазработки Тогда
				Контекст.ЕстьКонтекстРазработки = Истина;
			Иначе
				Контекст.ЕстьПроизводственныйКонтекст = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Соответствие();
	Для Каждого Элемент Из Контексты Цикл
		Если Элемент.Значение.ЕстьПроизводственныйКонтекст
			И Элемент.Значение.ЕстьКонтекстРазработки Тогда
			Результат.Вставить(Элемент.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПутьДляОтчета(Путь)

	Если Не ЗначениеЗаполнено(_РабочийКаталог) Тогда
		Возврат Путь;
	КонецЕсли;

	ПолныйКорень = ФС.ПолныйПуть(_РабочийКаталог);
	ПолныйПуть = ФС.ПолныйПуть(Путь);
	РазделительПути = ПолучитьРазделительПути();
	КореньСРазделителем = ?(Прав(ПолныйКорень, 1) = РазделительПути,
		ПолныйКорень, ПолныйКорень + РазделительПути);
	ПутьВнутриПроекта = НРег(ПолныйПуть) = НРег(ПолныйКорень)
		Или НРег(Лев(ПолныйПуть, СтрДлина(КореньСРазделителем))) = НРег(КореньСРазделителем);

	Если Не ПутьВнутриПроекта Тогда
		Возврат Путь;
	КонецЕсли;

	Возврат ФС.ОтносительныйПуть(_РабочийКаталог, Путь, "/");

КонецФункции

Функция ЛевыйОтступ(Уровень)

	Возврат ПомощникКонсольногоВывода.ФиксированнаяСтрока("", Уровень * _ШиринаОтступа);

КонецФункции

Функция РазделительСекции(Профиль)

	Возврат СтрЗаменить("                                                            ", " ", Профиль.Горизонталь);

КонецФункции

Функция ФормаСлова(Количество, Форма1, Форма2, Форма5)

	ПоследниеДвеЦифры = Количество % 100;
	Если ПоследниеДвеЦифры >= 11 И ПоследниеДвеЦифры <= 14 Тогда
		Возврат Форма5;
	КонецЕсли;

	ПоследняяЦифра = Количество % 10;
	Если ПоследняяЦифра = 1 Тогда
		Возврат Форма1;
	ИначеЕсли ПоследняяЦифра >= 2 И ПоследняяЦифра <= 4 Тогда
		Возврат Форма2;
	КонецЕсли;

	Возврат Форма5;

КонецФункции

#КонецОбласти
