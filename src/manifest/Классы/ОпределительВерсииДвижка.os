#Использовать packageinfo
#Использовать errors
#Использовать "../../common"
#Использовать "../../packages"

#Область ПрограммныйИнтерфейс

// Определяет версию OneScript для подбора зависимостей.
//
// Параметры:
//   Режим        - Строка - Версия, auto или current.
//   ПутьКФайлу   - Строка - Путь к выбранному манифесту.
//
// Возвращаемое значение:
//   Строка - Версия OneScript; пустая строка отключает проверку совместимости.
Функция Определить(Режим, ПутьКФайлу) Экспорт

	Если Не ЗначениеЗаполнено(Режим) Тогда
		Возврат "";
	КонецЕсли;

	Если НРег(Режим) = РежимыВерсииДвижка.Текущий() Тогда
		Версия = Новый СистемнаяИнформация().Версия;
	ИначеЕсли НРег(Режим) = РежимыВерсииДвижка.Автоматический() Тогда
		Расширение = НРег(Новый Файл(ПутьКФайлу).Расширение);
		Если Расширение = ".xml" Тогда
			Версия = Новый ПарсерOpmMetadata().Разобрать(ПутьКФайлу).ВерсияСреды;
		Иначе
			ИнформацияОПакете = Новый ИнформацияОПакете(ПутьКФайлу);
			ИнформацияОПакете.Свойства().Свойство("ВерсияСреды", Версия);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Версия) Тогда
			Версия = Новый СистемнаяИнформация().Версия;
		КонецЕсли;
	Иначе
		Версия = Режим;
	КонецЕсли;

	Если Не ПроверкаВерсийПакетов.ЭтоКорректная(Версия) Тогда
		Сообщение = СтрШаблон("Некорректная версия OneScript '%1'. Ожидается SemVer или A.B.C.D.", Версия);
		ВызватьИсключение Новый ПостроительОшибки(КодыОшибокDepos.ВерсияДвижкаНекорректна(), Сообщение)
			.Данные("Версия", Версия)
			.Построить();
	КонецЕсли;

	Возврат Версия;

КонецФункции

#КонецОбласти
