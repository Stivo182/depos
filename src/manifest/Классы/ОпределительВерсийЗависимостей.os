#Использовать "../../packages"


#Область ОписаниеПеременных

Перем _ТолькоУстаревшие; // Булево
Перем _ОпределительВерсийПакетов; // ОпределительВерсийПакетов

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Пластилин("ОпределительВерсийПакетов") ОпределительВерсийПакетов)
	_ОпределительВерсийПакетов = ОпределительВерсийПакетов;
	ТолькоУстаревшие(Ложь);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает зависимости с целевыми версиями.
//
// Параметры:
//   Зависимости - ЗависимостиПакета
//   ТипВерсии - Строка - Тип целевой версии (см. ТипыВерсий).
//                        Если не указан или пустой, используется значение "Последняя".
//   ВерсияДвижка - Строка - Целевая версия OneScript; пустая отключает проверку совместимости.
//
// Возвращаемое значение:
//   ЗависимостиПакета
Функция НайтиВерсии(Зависимости, ТипВерсии = Неопределено, ВерсияДвижка = "") Экспорт

	ТаблицаЗависимостей = Зависимости.СкопироватьВТаблицу();
	ЗависимостиДляПоискаВерсий = ЗависимостиБезМаксимальнойВерсии(ТаблицаЗависимостей);
	ЦелевыеВерсииПакетов = _ОпределительВерсийПакетов.НайтиВерсии(
		ЗависимостиДляПоискаВерсий,
		ТипВерсии,
		ВерсияДвижка
	);

	Результат = Новый ЗависимостиПакета();

	Для Каждого СтрокаЗависимости Из ТаблицаЗависимостей Цикл

		НайденнаяВерсияПакета = Неопределено;
		Если Не ЗначениеЗаполнено(СтрокаЗависимости.МаксимальнаяВерсия) Тогда
			НайденнаяВерсияПакета = ЦелевыеВерсииПакетов[СтрокаЗависимости.ИмяПакета];
			Версия = НайденнаяВерсияПакета;
			Если Не ЗначениеЗаполнено(Версия) Тогда
				Версия = СтрокаЗависимости.МинимальнаяВерсия;
				НайденнаяВерсияПакета = "";
			КонецЕсли;
		Иначе
			Версия = СтрокаЗависимости.МинимальнаяВерсия;
		КонецЕсли;

		ВерсияБольшеИсходной = ЗначениеЗаполнено(Версия) 
			И ЗначениеЗаполнено(СтрокаЗависимости.МинимальнаяВерсия)
			И Новый ВерсияПакета(Версия).Сравнить(СтрокаЗависимости.МинимальнаяВерсия) > 0;
		
		Если Не _ТолькоУстаревшие Или ВерсияБольшеИсходной Тогда
			Результат.Добавить(
				СтрокаЗависимости.ИмяПакета,
				Версия,
				СтрокаЗависимости.МаксимальнаяВерсия,
				СтрокаЗависимости.ДляРазработки,
				НайденнаяВерсияПакета
			);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Устанавливает фильтр по устаревшим пакетам.
//
// Параметры:
//   Включить - Булево - Если Истина, возвращаются только пакеты с устаревшими версиями
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ТолькоУстаревшие(Включить = Истина) Экспорт
	_ТолькоУстаревшие = Включить;
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗависимостиБезМаксимальнойВерсии(Зависимости)

	Результат = Зависимости.Скопировать();
	Количество = Результат.Количество();
	Для Индекс = 1 По Количество Цикл
		СтрокаЗависимости = Результат[Количество - Индекс];
		Если ЗначениеЗаполнено(СтрокаЗависимости.МаксимальнаяВерсия) Тогда
			Результат.Удалить(СтрокаЗависимости);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
