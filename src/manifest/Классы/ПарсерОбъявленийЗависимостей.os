#Использовать osparser

#Область ОписаниеПеременных

Перем _ВыражениеПометкиПослеВызова; // РегулярноеВыражение
Перем _ТекстРазобранногоМанифеста; // Строка
Перем _ВызовыЗависимостей; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_ВыражениеПометкиПослеВызова = Новый РегулярноеВыражение(
		"^[ \t]*;?[ \t]*//[ \t]+((?i:неявная|implicit|транзитивная|transitive))" +
		"(?:[ \t]+-[ \t]+[^ \t\r\n][^\r\n]*)?[ \t]*\r?$"
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит статические объявления зависимостей и позиции их минимальных версий.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура - Объявления зависимостей с исходным текстом и позициями версий.
Функция НайтиЛитеральныеОбъявления(ТекстМанифеста) Экспорт

	Результат = Новый Массив();
	Вызовы = НайтиВызовыЗависимостей(ТекстМанифеста);

	Для Каждого Вызов Из Вызовы Цикл
		Поле = Вызов.Поле;
		Если Поле.Аргументы.Количество() < 1 Или Поле.Аргументы.Количество() > 3 Тогда
			Продолжить;
		КонецЕсли;

		Имя = СтроковыйАргумент(Поле.Аргументы[0]);
		Если Имя = Неопределено Или Имя = "" Тогда
			Продолжить;
		КонецЕсли;

		Версия = ?(Поле.Аргументы.Количество() > 1, СтроковыйАргумент(Поле.Аргументы[1]), "");
		МаксимальнаяВерсия = ?(Поле.Аргументы.Количество() > 2, СтроковыйАргумент(Поле.Аргументы[2]), "");
		Если Версия = Неопределено Или МаксимальнаяВерсия = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИндексВерсии = 0;
		ДлинаВерсии = 0;
		Если Поле.Аргументы.Количество() > 1 Тогда
			ЛитералВерсии = Поле.Аргументы[1].Начало;
			ИндексВерсии = ЛитералВерсии.Позиция;
			ДлинаВерсии = ЛитералВерсии.Длина - 2;
		КонецЕсли;

		Объявление = Новый Структура();
		Объявление.Вставить("ИмяПакета", Имя);
		Объявление.Вставить("ДляРазработки", Вызов.ДляРазработки);
		Объявление.Вставить("МинимальнаяВерсия", Версия);
		Объявление.Вставить("МаксимальнаяВерсия", МаксимальнаяВерсия);
		Объявление.Вставить("БезусловноеОбъявление", Вызов.Безусловный);
		Объявление.Вставить("ЛитеральноеОбъявление", Истина);
		Объявление.Вставить(
			"ЕстьВычисляемоеОбъявлениеВСтроке",
			ЕстьВычисляемоеОбъявлениеВСтроке(Вызов, Вызовы)
		);
		Объявление.Вставить(
			"БезусловноеВычисляемоеОбъявлениеВСтроке",
			ЕстьВычисляемоеОбъявлениеВСтроке(Вызов, Вызовы, Истина)
		);
		Объявление.Вставить("ИндексВерсии", ИндексВерсии);
		Объявление.Вставить("ДлинаВерсии", ДлинаВерсии);
		Объявление.Вставить("НомерСтроки", Поле.Аргументы[0].Начало.НомерСтроки);
		Объявление.Вставить("НомерСтрокиВызова", Вызов.НомерСтроки);
		Объявление.Вставить(
			"ТекстОбъявления",
			ТекстОбъявления(Имя, Вызов.ДляРазработки, Версия, МаксимальнаяВерсия)
		);
		Объявление.Вставить("ТекстПометки", ТекстПометкиПослеВызова(ТекстМанифеста, Поле));

		Результат.Добавить(Объявление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Находит пометки после объявлений зависимостей.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура - Пометки пакетов с признаком транзитивности.
Функция НайтиПометкиЗависимостей(ТекстМанифеста) Экспорт

	Пометки = Новый Массив();
	Для Каждого Вызов Из НайтиВызовыЗависимостей(ТекстМанифеста) Цикл
		Поле = Вызов.Поле;
		Если Поле.Аргументы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Имя = СтроковыйАргумент(Поле.Аргументы[0]);
		Если Имя = Неопределено Или Имя = "" Тогда
			Продолжить;
		КонецЕсли;

		ТекстПометки = ТекстПометкиПослеВызова(ТекстМанифеста, Поле);
		Совпадения = _ВыражениеПометкиПослеВызова.НайтиСовпадения(ТекстПометки);
		Если Совпадения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ТекстПометки = НРег(Совпадения[0].Группы[1].Значение);
		Транзитивная = ТекстПометки = "транзитивная" Или ТекстПометки = "transitive";
		Пометки.Добавить(Новый Структура(
			"ИмяПакета, ДляРазработки, Транзитивная, НомерСтрокиВызова",
			Имя, Вызов.ДляРазработки, Транзитивная, Вызов.НомерСтроки
		));
	КонецЦикла;

	Возврат Пометки;

КонецФункции

// Заменяет значения минимальных версий, сохраняя остальной текст манифеста.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//   ЗаменыВерсий - Массив из Структура - Позиция, длина и новый текст версии.
//
// Возвращаемое значение:
//   Строка - Текст с замененными версиями.
Функция ЗаменитьВерсии(ТекстМанифеста, ЗаменыВерсий) Экспорт

	Если ЗаменыВерсий.Количество() = 0 Тогда
		Возврат ТекстМанифеста;
	КонецЕсли;

	Парсер = Новый ПарсерВстроенногоЯзыка();
	Парсер.Разобрать(ТекстМанифеста);

	Для Каждого ЗаменаВерсии Из ЗаменыВерсий Цикл
		Замена = Парсер.ТаблицаЗамен().Добавить();
		Замена.Источник = "depos";
		Замена.Позиция = ЗаменаВерсии.Позиция;
		Замена.Длина = ЗаменаВерсии.Длина;
		Замена.Текст = ЗаменаВерсии.Текст;
	КонецЦикла;

	Возврат Парсер.ВыполнитьЗамены();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстПометкиПослеВызова(ТекстМанифеста, Поле)

	ОстатокТекста = Сред(ТекстМанифеста, Поле.Конец.Позиция + Поле.Конец.Длина);
	КонецСтроки = СтрНайти(ОстатокТекста, Символ(10));
	Если КонецСтроки > 0 Тогда
		ОстатокТекста = Лев(ОстатокТекста, КонецСтроки - 1);
	КонецЕсли;

	Совпадения = _ВыражениеПометкиПослеВызова.НайтиСовпадения(ОстатокТекста);
	Если Совпадения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ТекстПометки = Совпадения[0].Значение;
	Возврат СокрЛП(Сред(ТекстПометки, СтрНайти(ТекстПометки, "//")));

КонецФункции

Функция ТекстОбъявления(ИмяПакета, ДляРазработки, МинимальнаяВерсия, МаксимальнаяВерсия)

	Аргументы = Новый Массив();
	Аргументы.Добавить("""" + СтрЗаменить(ИмяПакета, """", """""") + """");

	Если ЗначениеЗаполнено(МинимальнаяВерсия) Или ЗначениеЗаполнено(МаксимальнаяВерсия) Тогда
		Аргументы.Добавить("""" + МинимальнаяВерсия + """");
	КонецЕсли;

	Если ЗначениеЗаполнено(МаксимальнаяВерсия) Тогда
		Аргументы.Добавить("""" + МаксимальнаяВерсия + """");
	КонецЕсли;

	ИмяМетода = ?(ДляРазработки, "РазработкаЗависитОт", "ЗависитОт");
	Возврат "." + ИмяМетода + "(" + СтрСоединить(Аргументы, ", ") + ")";

КонецФункции

Функция НайтиВызовыЗависимостей(ТекстМанифеста)

	Если _ВызовыЗависимостей <> Неопределено И _ТекстРазобранногоМанифеста = ТекстМанифеста Тогда
		Возврат _ВызовыЗависимостей;
	КонецЕсли;

	Парсер = Новый ПарсерВстроенногоЯзыка();
	Парсер.Разобрать(ТекстМанифеста);
	Вызовы = Новый Массив();
	ОператорыМодуля = Парсер.Узлы().Модуль[0].Операторы;

	Для Каждого Оператор Из Парсер.Узлы().ОператорВызоваПроцедуры Цикл
		Идентификатор = Оператор.Идентификатор;
		Если НРег(Идентификатор.Голова.Имя) <> "описание" Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Поле Из Идентификатор.Хвост Цикл
			Если Поле.Тип <> "ВыражениеПоле" Или Поле.Аргументы = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ИмяМетода = НРег(Поле.Имя);
			Если ИмяМетода = "зависитот" Или ИмяМетода = "разработказависитот" Тогда
				Вызовы.Добавить(Новый Структура(
					"Поле, ДляРазработки, Безусловный, НомерСтроки",
					Поле,
					ИмяМетода = "разработказависитот",
					ЭтоОператорМодуля(Оператор, ОператорыМодуля),
					Оператор.Конец.НомерСтроки
				));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	_ТекстРазобранногоМанифеста = ТекстМанифеста;
	_ВызовыЗависимостей = Вызовы;

	Возврат Вызовы;

КонецФункции

Функция ЭтоОператорМодуля(ИскомыйОператор, ОператорыМодуля)

	Для Каждого Оператор Из ОператорыМодуля Цикл
		СовпадаетНачало = Оператор.Начало.Позиция = ИскомыйОператор.Начало.Позиция;
		СовпадаетКонец = Оператор.Конец.Позиция = ИскомыйОператор.Конец.Позиция;
		Если СовпадаетНачало И СовпадаетКонец Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьВычисляемоеОбъявлениеВСтроке(ИскомыйВызов, Вызовы, ТолькоБезусловное = Ложь)

	Для Каждого Вызов Из Вызовы Цикл
		ДругаяСтрока = Вызов.НомерСтроки <> ИскомыйВызов.НомерСтроки;
		НетАргументов = Вызов.Поле.Аргументы.Количество() = 0;
		НеПодходитУсловное = ТолькоБезусловное И Не Вызов.Безусловный;
		ПропуститьВызов = ДругаяСтрока Или НетАргументов Или НеПодходитУсловное;

		Если ПропуститьВызов Тогда
			Продолжить;
		КонецЕсли;

		Если СтроковыйАргумент(Вызов.Поле.Аргументы[0]) = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СтроковыйАргумент(Аргумент)

	Если Аргумент.Тип <> "ВыражениеСтроковое" Или Аргумент.Элементы.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Аргумент.Элементы[0].Значение;

КонецФункции

#КонецОбласти
