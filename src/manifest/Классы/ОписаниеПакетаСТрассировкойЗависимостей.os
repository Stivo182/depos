#Использовать packageinfo

// Декорирует ОписаниеПакета для регистрации фактически выполненных объявлений зависимостей.
// Цепочные методы намеренно возвращают этот декоратор, чтобы вызовы ЗависитОт
// и РазработкаЗависитОт не обходили трассировку.

#Область ОписаниеПеременных

Перем _ОписаниеПакета; // ОписаниеПакета
Перем _ПутьКМанифесту; // Строка
Перем _ВыполненныеОбъявления; // Массив из Структура
Перем _ВыполненныеЗависимости; // ТаблицаЗначений
Перем _УчтенныеЛитеральныеКлючи; // Соответствие
Перем _НеоднозначныеЛитеральныеКлючи; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

// Создает описание пакета с трассировкой выполненных объявлений зависимостей.
//
// Параметры:
//   ПутьКМанифесту - Строка - Путь к загружаемому packagedef.
Процедура ПриСозданииОбъекта(ПутьКМанифесту)

	_ОписаниеПакета = Новый ОписаниеПакета();
	_ПутьКМанифесту = Новый Файл(ПутьКМанифесту).ПолноеИмя;
	_ВыполненныеОбъявления = Новый Массив();
	_УчтенныеЛитеральныеКлючи = Новый Соответствие();
	_НеоднозначныеЛитеральныеКлючи = Новый Соответствие();

	_ВыполненныеЗависимости = Новый ТаблицаЗначений();
	_ВыполненныеЗависимости.Колонки.Добавить("ИмяПакета");
	_ВыполненныеЗависимости.Колонки.Добавить("МинимальнаяВерсия");
	_ВыполненныеЗависимости.Колонки.Добавить("МаксимальнаяВерсия");
	_ВыполненныеЗависимости.Колонки.Добавить("ДляРазработки");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает имя пакета.
//
// Параметры:
//   Параметр - Строка - Имя пакета.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция Имя(Параметр) Экспорт
	_ОписаниеПакета.Имя(Параметр);
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает версию пакета.
//
// Параметры:
//   Параметр - Строка - Версия пакета.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция Версия(Параметр) Экспорт
	_ОписаниеПакета.Версия(Параметр);
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает автора пакета.
//
// Параметры:
//   Параметр - Строка - Автор пакета.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция Автор(Параметр) Экспорт
	_ОписаниеПакета.Автор(Параметр);
	Возврат ЭтотОбъект;
КонецФункции

