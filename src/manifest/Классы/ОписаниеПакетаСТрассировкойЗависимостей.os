Функция Задачи(Параметр) Экспорт
	_ОписаниеПакета.Задачи(Параметр);
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает свойства пакета.
//
// Возвращаемое значение:
//   Структура - Свойства пакета.
Функция Свойства() Экспорт
	Возврат _ОписаниеПакета.Свойства();
КонецФункции

// Возвращает типы модулей пакета.
//
// Возвращаемое значение:
//   Структура:
//     * Класс - Строка - Тип класса.
//     * Модуль - Строка - Тип модуля.
Функция ТипыМодулей() Экспорт
	Возврат _ОписаниеПакета.ТипыМодулей;
КонецФункции

// Добавляет производственную зависимость.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета зависимости.
//   МинимальнаяВерсия - Строка, Неопределено - Минимальная версия зависимости.
//   МаксимальнаяВерсия - Строка, Неопределено - Максимальная версия зависимости.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ЗависитОт(ИмяПакета, МинимальнаяВерсия = Неопределено, МаксимальнаяВерсия = Неопределено) Экспорт

	_ОписаниеПакета.ЗависитОт(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия);
	ЗарегистрироватьОбъявление(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, Ложь);
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет зависимость для разработки.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета зависимости.
//   МинимальнаяВерсия - Строка, Неопределено - Минимальная версия зависимости.
//   МаксимальнаяВерсия - Строка, Неопределено - Максимальная версия зависимости.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция РазработкаЗависитОт(
	ИмяПакета,
	МинимальнаяВерсия = Неопределено,
	МаксимальнаяВерсия = Неопределено
) Экспорт

	_ОписаниеПакета.РазработкаЗависитОт(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия);
	ЗарегистрироватьОбъявление(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Возвращает зависимость по имени пакета.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета зависимости.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений, Неопределено - Зависимость или Неопределено, если пакет не найден.
Функция Зависимость(ИмяПакета) Экспорт

	Отбор = Новый Структура("ИмяПакета, ДляРазработки", НРег(ИмяПакета), Ложь);
	ПроизводственныеЗависимости = _ВыполненныеЗависимости.НайтиСтроки(Отбор);
	Если ПроизводственныеЗависимости.Количество() > 0 Тогда
		Возврат ПроизводственныеЗависимости[0];
	КонецЕсли;

	Возврат _ВыполненныеЗависимости.Найти(НРег(ИмяПакета), "ИмяПакета");

КонецФункции

// Возвращает зависимости пакета.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Копия зависимостей пакета.
Функция Зависимости() Экспорт
	Возврат _ВыполненныеЗависимости.Скопировать();
КонецФункции

// Добавляет класс пакета.
//
// Параметры:
//   Идентификатор - Строка - Идентификатор класса.
//   Файл - Строка - Путь к файлу класса.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ОпределяетКласс(Идентификатор, Файл) Экспорт
	_ОписаниеПакета.ОпределяетКласс(Идентификатор, Файл);
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает классы пакета.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Классы пакета.
Функция Классы() Экспорт
	Возврат _ОписаниеПакета.Классы();
КонецФункции

// Добавляет модуль пакета.
//
// Параметры:
//   Идентификатор - Строка - Идентификатор модуля.
//   Файл - Строка - Путь к файлу модуля.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ОпределяетМодуль(Идентификатор, Файл) Экспорт
	_ОписаниеПакета.ОпределяетМодуль(Идентификатор, Файл);
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает модули пакета.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Модули пакета.
Функция Модули() Экспорт
	Возврат _ОписаниеПакета.Модули();
КонецФункции

// Возвращает все модули пакета.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Классы и модули пакета.
Функция ВсеМодулиПакета() Экспорт
	Возврат _ОписаниеПакета.ВсеМодулиПакета();
КонецФункции

// Добавляет включаемый файл.
//
// Параметры:
//   ИсходныйПуть - Строка - Путь к включаемому файлу или каталогу.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ВключитьФайл(ИсходныйПуть) Экспорт
	_ОписаниеПакета.ВключитьФайл(ИсходныйПуть);
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает включаемые файлы.
//
// Возвращаемое значение:
//   Массив из Строка - Пути к включаемым файлам и каталогам.
Функция ВключаемыеФайлы() Экспорт
	Возврат _ОписаниеПакета.ВключаемыеФайлы();
КонецФункции

// Добавляет исполняемый файл.
//
// Параметры:
//   Путь - Строка - Путь к исполняемому файлу.
//   ИмяПриложения - Строка - Имя приложения.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ИсполняемыйФайл(Путь, ИмяПриложения = "") Экспорт
	_ОписаниеПакета.ИсполняемыйФайл(Путь, ИмяПриложения);
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает исполняемые файлы.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Исполняемые файлы пакета.
Функция ИсполняемыеФайлы() Экспорт
	Возврат _ОписаниеПакета.ИсполняемыеФайлы();
КонецФункции

// Сопоставляет литеральное объявление с выполненным и помечает его учтенным.
//
// Параметры:
//   Объявление - Структура - Разобранное литеральное объявление зависимости.
//
// Возвращаемое значение:
//   Булево - Истина, если найдено и учтено соответствующее выполненное объявление.
Функция УчестьВыполненноеОбъявление(Объявление) Экспорт

	УсловноеОбъявление = Не Объявление.БезусловноеОбъявление;
	ЕстьВычисляемоеОбъявление = Объявление.ЕстьВычисляемоеОбъявлениеВСтроке;
	НеоднозначноеОбъявление = УсловноеОбъявление И ЕстьВычисляемоеОбъявление;

	Если НеоднозначноеОбъявление Тогда
		НетБезусловногоВычисляемого = Не Объявление.БезусловноеВычисляемоеОбъявлениеВСтроке;
		НедостаточноСовпадений = КоличествоСовпадающихОбъявлений(Объявление) < 2;
		НетДоказательстваВыполнения = НетБезусловногоВычисляемого ИЛИ НедостаточноСовпадений;

		Если НетДоказательстваВыполнения Тогда
			// shortcut: стек не содержит колонку вызова, убрать фильтр после появления позиции выражения в кадре.
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Для Каждого ВыполненноеОбъявление Из _ВыполненныеОбъявления Цикл
		ОбъявлениеУжеУчтено = ВыполненноеОбъявление.Учтено;
		ОбъявленияРазличаются = Не ОбъявленияСовпадают(ВыполненноеОбъявление, Объявление);
		ПропуститьОбъявление = ОбъявлениеУжеУчтено ИЛИ ОбъявленияРазличаются;
		Если ПропуститьОбъявление Тогда
			Продолжить;
		КонецЕсли;

		ВыполненноеОбъявление.Учтено = Истина;
		Ключ = КлючОбъявления(ВыполненноеОбъявление);
		_УчтенныеЛитеральныеКлючи.Вставить(Ключ, Истина);

		Если Объявление.ЕстьВычисляемоеОбъявлениеВСтроке Тогда
			_НеоднозначныеЛитеральныеКлючи.Вставить(Ключ, Истина);
		КонецЕсли;

		Возврат Истина;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает выполненные объявления с вычисляемым именем пакета.
//
// Возвращаемое значение:
//   Массив из Структура - Объявления, не сопоставленные с литеральным исходным кодом.
Функция ВычисляемыеОбъявления() Экспорт

	Результат = Новый Массив();
	ДобавленныеОбъявления = Новый Соответствие();

	Для Каждого Объявление Из _ВыполненныеОбъявления Цикл
		Если Объявление.Учтено Тогда
			Продолжить;
		КонецЕсли;

		Ключ = КлючОбъявления(Объявление);
		ЛитеральноеОбъявлениеУчтено = _УчтенныеЛитеральныеКлючи[Ключ] <> Неопределено;
		ЛитеральноеОбъявлениеОднозначно = _НеоднозначныеЛитеральныеКлючи[Ключ] = Неопределено;

		Если ЛитеральноеОбъявлениеУчтено И ЛитеральноеОбъявлениеОднозначно Тогда
			Продолжить;
		КонецЕсли;

		Если ДобавленныеОбъявления[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(СтруктураВычисляемогоОбъявления(Объявление));
		ДобавленныеОбъявления.Вставить(Ключ, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗарегистрироватьОбъявление(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, ДляРазработки)

	Отбор = Новый Структура("ИмяПакета, ДляРазработки", НРег(ИмяПакета), ДляРазработки);

	Зависимости = _ВыполненныеЗависимости.НайтиСтроки(Отбор);
	Зависимость = ?(
		Зависимости.Количество() = 0,
		_ВыполненныеЗависимости.Добавить(),
		Зависимости[0]
	);
	Зависимость.ИмяПакета = НРег(ИмяПакета);
	Зависимость.ДляРазработки = ДляРазработки;

	Если МинимальнаяВерсия <> Неопределено Тогда
		Зависимость.МинимальнаяВерсия = НормализованнаяВерсия(МинимальнаяВерсия);
		Зависимость.МаксимальнаяВерсия = НормализованнаяВерсия(МаксимальнаяВерсия);
	КонецЕсли;

	_ВыполненныеОбъявления.Добавить(Новый Структура(
		"НомерСтроки, ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, ДляРазработки, Учтено",
		НомерСтрокиВызова(),
		ИмяПакета,
		МинимальнаяВерсия,
		МаксимальнаяВерсия,
		ДляРазработки,
		Ложь
	));

КонецПроцедуры

Функция НомерСтрокиВызова()

	Попытка
		ВызватьИсключение "Трассировка объявления зависимости";
	Исключение
		СтекВызовов = ИнформацияОбОшибке().ПолучитьСтекВызовов();
		Для Каждого Кадр Из СтекВызовов Цикл
			Если НРег(Кадр.ИмяМодуля) = НРег(_ПутьКМанифесту) Тогда
				Возврат Кадр.НомерСтроки;
			КонецЕсли;
		КонецЦикла;
	КонецПопытки;

	Возврат 0;

КонецФункции

Функция НормализованнаяВерсия(Версия)

	Возврат ?(ЗначениеЗаполнено(Версия), Версия, "");

КонецФункции

Функция КлючОбъявления(Объявление)

	Возврат СтрШаблон(
		"%1|%2|%3|%4|%5",
		Объявление.НомерСтроки,
		НРег(Объявление.ИмяПакета),
		Объявление.ДляРазработки,
		НормализованнаяВерсия(Объявление.МинимальнаяВерсия),
		НормализованнаяВерсия(Объявление.МаксимальнаяВерсия)
	);

КонецФункции

Функция СтруктураВычисляемогоОбъявления(Объявление)

	Результат = Новый Структура();
	Результат.Вставить("ИмяПакета", Объявление.ИмяПакета);
	Результат.Вставить("ДляРазработки", Объявление.ДляРазработки);
	Результат.Вставить("МинимальнаяВерсия", НормализованнаяВерсия(Объявление.МинимальнаяВерсия));
	Результат.Вставить("МаксимальнаяВерсия", НормализованнаяВерсия(Объявление.МаксимальнаяВерсия));
	Результат.Вставить("БезусловноеОбъявление", Ложь);
	Результат.Вставить("ЛитеральноеОбъявление", Ложь);
	Результат.Вставить("ЕстьВычисляемоеОбъявлениеВСтроке", Истина);
	Результат.Вставить("БезусловноеВычисляемоеОбъявлениеВСтроке", Ложь);
	Результат.Вставить("ИндексВерсии", 0);
	Результат.Вставить("ДлинаВерсии", 0);
	Результат.Вставить("НомерСтроки", Объявление.НомерСтроки);
	Результат.Вставить("НомерСтрокиВызова", Объявление.НомерСтроки);
	Результат.Вставить("ТекстОбъявления", "");
	Результат.Вставить("ТекстПометки", "");

	Возврат Результат;

КонецФункции

Функция ОбъявленияСовпадают(ВыполненноеОбъявление, ИсходноеОбъявление)

	СовпадаетСтрока = ВыполненноеОбъявление.НомерСтроки = ИсходноеОбъявление.НомерСтрокиВызова;
	СовпадаетИмя = НРег(ВыполненноеОбъявление.ИмяПакета) = НРег(ИсходноеОбъявление.ИмяПакета);
	СовпадаетКонтекст = ВыполненноеОбъявление.ДляРазработки = ИсходноеОбъявление.ДляРазработки;
	МинимальнаяВерсия = НормализованнаяВерсия(ВыполненноеОбъявление.МинимальнаяВерсия);
	МаксимальнаяВерсия = НормализованнаяВерсия(ВыполненноеОбъявление.МаксимальнаяВерсия);
	СовпадаетМинимальнаяВерсия = МинимальнаяВерсия = ИсходноеОбъявление.МинимальнаяВерсия;
	СовпадаетМаксимальнаяВерсия = МаксимальнаяВерсия = ИсходноеОбъявление.МаксимальнаяВерсия;
	Результат = СовпадаетСтрока И СовпадаетИмя И СовпадаетКонтекст;
	Результат = Результат И СовпадаетМинимальнаяВерсия;
	Результат = Результат И СовпадаетМаксимальнаяВерсия;

	Возврат Результат;

КонецФункции

Функция КоличествоСовпадающихОбъявлений(Объявление)

	Количество = 0;
	Для Каждого ВыполненноеОбъявление Из _ВыполненныеОбъявления Цикл
		Если ОбъявленияСовпадают(ВыполненноеОбъявление, Объявление) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

#КонецОбласти
