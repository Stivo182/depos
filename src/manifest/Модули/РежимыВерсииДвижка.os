#Область ПрограммныйИнтерфейс

// Возвращает режим определения версии OneScript по манифесту.
//
// Возвращаемое значение:
//   Строка - Режим auto.
Функция Автоматический() Экспорт
	Возврат "auto";
КонецФункции

// Возвращает режим использования версии запущенного OneScript.
//
// Возвращаемое значение:
//   Строка - Режим current.
Функция Текущий() Экспорт
	Возврат "current";
КонецФункции

#КонецОбласти
