#Использовать errors

#Область ПрограммныйИнтерфейс

// Создаёт ошибку недоступности реестра.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   Реестр     - Строка - Представление адреса реестра.
//   Причина    - Строка - Безопасное описание причины.
//
// Возвращаемое значение:
//   ИнформацияОбОшибке - Ошибка группы registry.unavailable.
Функция Недоступен(ИмяПакета, Реестр, Причина) Экспорт

	Сообщение = СтрШаблон(
		"Не удалось получить версии пакета '%1' из реестра %2: %3",
		ИмяПакета,
		Реестр,
		Причина
	);

	Возврат Новый ПостроительОшибки(КодыОшибокDepos.РеестрНедоступен(), Сообщение)
		.Подсказка("Проверьте подключение к интернету и доступность реестра пакетов.")
		.Построить();

КонецФункции

#КонецОбласти
