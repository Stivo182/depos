#Использовать semver

#Область ОписаниеПеременных

Перем _РегулярноеВыражениеСтрогойВерсии; // РегулярноеВыражение
Перем _РегулярноеВыражениеЧетырехкомпонентнойВерсии; // РегулярноеВыражение

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает кэшированное регулярное выражение для строгой проверки SemVer.
//
// Возвращаемое значение:
//   РегулярноеВыражение - Регулярное выражение строгого формата SemVer.
Функция РегулярноеВыражениеСтрогойВерсии() Экспорт

	Если _РегулярноеВыражениеСтрогойВерсии = Неопределено Тогда
		_РегулярноеВыражениеСтрогойВерсии = СоздатьРегулярноеВыражениеСтрогойВерсии();
	КонецЕсли;

	Возврат _РегулярноеВыражениеСтрогойВерсии;

КонецФункции

// Проверяет, что строка содержит четырёхкомпонентную числовую версию.
//
// Параметры:
//   ВерсияСтрокой - Строка - Проверяемая версия.
//
// Возвращаемое значение:
//   Булево - Истина, если строка имеет формат A.B.C.D.
Функция ЭтоЧетырехкомпонентная(ВерсияСтрокой) Экспорт

	Если ТипЗнч(ВерсияСтрокой) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если _РегулярноеВыражениеЧетырехкомпонентнойВерсии = Неопределено Тогда
		_РегулярноеВыражениеЧетырехкомпонентнойВерсии =
			СоздатьРегулярноеВыражениеЧетырехкомпонентнойВерсии();
	КонецЕсли;

	Возврат _РегулярноеВыражениеЧетырехкомпонентнойВерсии.Совпадает(ВерсияСтрокой);

КонецФункции

// Проверяет строку на соответствие поддерживаемому формату версии пакета.
//
// Параметры:
//   ВерсияСтрокой - Строка - Проверяемая версия.
//
// Возвращаемое значение:
//   Булево - Истина, если строка содержит строгую SemVer-версию или версию A.B.C.D.
Функция ЭтоКорректная(ВерсияСтрокой) Экспорт

	Если ТипЗнч(ВерсияСтрокой) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоЧетырехкомпонентная(ВерсияСтрокой) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не РегулярноеВыражениеСтрогойВерсии().Совпадает(ВерсияСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;

	Версия = Новый Версия(ВерсияСтрокой);
	Возврат Не Версия.Ошибка();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьРегулярноеВыражениеСтрогойВерсии()

	Число = "(0|[1-9][0-9]*)";
	АлфавитноЧисловойИдентификатор = "[0-9]*[A-Za-z-][0-9A-Za-z-]*";
	ИдентификаторПререлиза = "(" + Число + "|" + АлфавитноЧисловойИдентификатор + ")";
	Пререлиз = ИдентификаторПререлиза + "(\." + ИдентификаторПререлиза + ")*";
	Метаданные = "[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*";

	Возврат Новый РегулярноеВыражение(
		"^" + Число + "\." + Число + "\." + Число + "(-" + Пререлиз + ")?(\+" + Метаданные + ")?$"
	);

КонецФункции

Функция СоздатьРегулярноеВыражениеЧетырехкомпонентнойВерсии()
	Число = "(0|[1-9][0-9]*)";
	Возврат Новый РегулярноеВыражение("^" + Число + "\." + Число + "\." + Число + "\." + Число + "$");
КонецФункции

#КонецОбласти
