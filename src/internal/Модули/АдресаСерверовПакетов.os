// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать url

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает HTTP(S)-адрес сервера пакетов.
//
// Для локального хоста и адреса с явным портом по умолчанию используется http, для порта 443
// и остальных адресов используется https. Явно указанная схема не изменяется.
//
// Параметры:
//   АдресСтрокой - Строка - Адрес сервера пакетов.
//   Порт         - Число - Порт, заданный отдельно от адреса.
//   Ошибка       - ИнформацияОбОшибке, Неопределено - Выходной параметр с ошибкой разбора.
//
// Возвращаемое значение:
//   URL, Неопределено - Адрес или Неопределено при ошибке.
Функция Разобрать(АдресСтрокой, Порт = 0, Ошибка = Неопределено) Экспорт

	АдресСтрокой = СокрЛП(Строка(АдресСтрокой));
	СхемаУказана = СхемаУказанаВАдресе(АдресСтрокой);
	Адрес = РазборURL.ПопытатьсяРазобратьСоСхемойПоУмолчанию(АдресСтрокой, "https", Ошибка);
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Хост = Адрес.Хост();
		ЯвныйПорт = Порт;
		Если ЯвныйПорт <= 0 И Адрес.ТекстПорта() <> Неопределено Тогда
			ЯвныйПорт = Число(Адрес.ТекстПорта());
		КонецЕсли;

		Если Не СхемаУказана Тогда
			Если ЯвныйПорт = 443 Тогда
				Адрес.УстановитьСхему("https");
			ИначеЕсли ЯвныйПорт > 0 Или ЭтоЛокальныйХост(Хост) Тогда
				Адрес.УстановитьСхему("http");
			КонецЕсли;
		КонецЕсли;

		Если Порт > 0 Тогда
			Адрес.УстановитьПорт(Порт);
		КонецЕсли;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

	Если Не Адрес.СоответствуетСхеме()
		Или (НРег(Адрес.Схема()) <> "http" И НРег(Адрес.Схема()) <> "https") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Адрес;

КонецФункции

// Возвращает корневой адрес сервера, сохраняя данные пользователя и строку запроса.
//
// Параметры:
//   Адрес - URL - Исходный адрес сервера пакетов.
//
// Возвращаемое значение:
//   URL - Адрес без пути и фрагмента.
Функция КорневойСДаннымиПользователя(Адрес) Экспорт

	КодированныеДанныеПользователя = Адрес.КодированныеДанныеПользователя();
	КодированнаяСтрокаЗапроса = Адрес.КодированнаяСтрокаЗапроса();

	Результат = Адрес.Корневой();
	Результат.УстановитьКодированныеДанныеПользователя(КодированныеДанныеПользователя);
	Результат.УстановитьКодированнуюСтрокуЗапроса(КодированнаяСтрокаЗапроса);

	Возврат Результат;

КонецФункции

// Возвращает безопасное представление адреса для журналов и сообщений об ошибках.
//
// Параметры:
//   Адрес - URL - Исходный адрес сервера пакетов.
//
// Возвращаемое значение:
//   Строка - Адрес без данных пользователя, строки запроса и фрагмента.
Функция ПредставлениеДляДиагностики(Адрес) Экспорт

	Результат = Адрес.Скопировать();
	Результат.УстановитьКодированныеДанныеПользователя(Неопределено);
	Результат.УстановитьКодированнуюСтрокуЗапроса(Неопределено);
	Результат.УстановитьКодированныйФрагмент(Неопределено);

	Возврат Результат.ВСтроку();

КонецФункции

// Возвращает декодированные данные авторизации proxy из URL.
//
// Параметры:
//   Адрес - URL - Адрес proxy.
//
// Возвращаемое значение:
//   Структура:
//     * Пользователь - Строка, Неопределено - Имя пользователя.
//     * Пароль       - Строка, Неопределено - Пароль.
Функция ДанныеАвторизацииПрокси(Адрес) Экспорт

	КодированныеДанные = Адрес.КодированныеДанныеПользователя();
	Если КодированныеДанные = Неопределено Тогда
		Возврат Новый Структура("Пользователь,Пароль");
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(КодированныеДанные, ":");
	Если ПозицияРазделителя = 0 Тогда
		ИмяПользователя = КодированныеДанные;
		Пароль = Неопределено;
	Иначе
		ИмяПользователя = Лев(КодированныеДанные, ПозицияРазделителя - 1);
		Пароль = Сред(КодированныеДанные, ПозицияРазделителя + 1);
	КонецЕсли;

	Пользователь = КодированиеURL.ДекодироватьUTF8(ИмяПользователя);
	Если Пароль <> Неопределено Тогда
		Пароль = КодированиеURL.ДекодироватьUTF8(Пароль);
	КонецЕсли;

	Возврат Новый Структура("Пользователь,Пароль", Пользователь, Пароль);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоЛокальныйХост(Хост)

	Хост = НРег(Хост);

	Возврат Хост = "localhost"
		Или СтрНачинаетсяС(Хост, "127.0.0.")
		Или СтрЗаканчиваетсяНа(Хост, ".localhost")
		Или Хост = "[::1]"
		Или Хост = "::1";

КонецФункции

Функция СхемаУказанаВАдресе(Адрес)

	ПозицияДвоеточия = СтрНайти(Адрес, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Префикс = Лев(Адрес, ПозицияДвоеточия - 1);

	Возврат Сред(Адрес, ПозицияДвоеточия + 1, 2) = "//"
		И СтрНайти(Префикс, "/") = 0
		И СтрНайти(Префикс, "?") = 0
		И СтрНайти(Префикс, "#") = 0;

КонецФункции

#КонецОбласти
