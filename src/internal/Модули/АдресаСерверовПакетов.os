// BSLLS:UsingHardcodeNetworkAddress-off

#Использовать url

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет схему к адресу сервера пакетов, если она не указана.
//
// Для локального хоста и адреса с явным портом используется http, для остальных адресов используется https.
//
// Параметры:
//   АдресСтрокой - Строка - Адрес сервера пакетов.
//   Порт         - Число - Порт, заданный отдельно от адреса.
//
// Возвращаемое значение:
//   Строка - Адрес со схемой или исходное значение, если адрес невозможно разобрать.
Функция ДобавитьСхему(АдресСтрокой, Порт = 0) Экспорт

	АдресСтрокой = СокрЛП(Строка(АдресСтрокой));
	Если СтрНайти(АдресСтрокой, "://") > 0 Тогда
		Возврат АдресСтрокой;
	КонецЕсли;

	Если НРег(АдресСтрокой) = "[::1]" Тогда
		Возврат "http://[::1]";
	КонецЕсли;

	Попытка
		АдресДляАнализа = Новый URL("https://" + АдресСтрокой);
	Исключение
		Возврат АдресСтрокой;
	КонецПопытки;

	ИспользоватьHTTP = Порт > 0
		Или АдресДляАнализа.ПортУказан()
		ИЛИ ЭтоЛокальныйХост(АдресДляАнализа.Хост());

	Схема = ?(ИспользоватьHTTP, "http", "https");

	Возврат Схема + "://" + АдресСтрокой;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоЛокальныйХост(Хост)

	Хост = НРег(Хост);

	Возврат Хост = "localhost"
		Или СтрНачинаетсяС(Хост, "127.0.0.")
		Или СтрЗаканчиваетсяНа(Хост, ".localhost")
		Или Хост = "[::1]"
		Или Хост = "::1";

КонецФункции

#КонецОбласти
