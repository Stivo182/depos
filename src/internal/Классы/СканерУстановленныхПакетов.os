#Использовать fs

#Область ОписаниеПеременных

Перем _ОпределительКаталоговБиблиотек; // ОпределительКаталоговБиблиотек
Перем _ПарсерOpmMetadata; // ПарсерOpmMetadata
Перем _КаталогБиблиотек; // Строка
Перем _ПоврежденныеПакеты; // ТаблицаЗначений
Перем _ВыражениеИсключенияИменПакетов; // Строка
Перем _Лог; // Лог

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Пластилин("ОпределительКаталоговБиблиотек") ОпределительКаталоговБиблиотек)

	_ОпределительКаталоговБиблиотек = ОпределительКаталоговБиблиотек;
	_ПарсерOpmMetadata = Новый ПарсерOpmMetadata();
	_КаталогБиблиотек = "";
	_ПоврежденныеПакеты = ПустаяТаблицаПоврежденныхПакетов();
	_ВыражениеИсключенияИменПакетов = "";
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит все доступные пакеты в каталогах библиотек.
//
// Если явно задан каталог библиотек, он имеет наивысший приоритет.
// Остальные каталоги определяются через ОпределительКаталоговБиблиотек.
//
// Возвращаемое значение:
//   Соответствие - Найденные пакеты:
//     * Ключ - Строка - Имя пакета (совпадает с именем каталога)
//     * Значение - Строка - Полный путь к каталогу пакета
Функция НайтиВсеПакеты() Экспорт

	НайденныеПакеты = Новый Соответствие();
	_ПоврежденныеПакеты = ПустаяТаблицаПоврежденныхПакетов();
	КаталогиБиблиотек = ПолучитьКаталогиБиблиотек();

	Для Каждого Каталог Из КаталогиБиблиотек Цикл
		НайтиПакетыВКаталоге(Каталог, НайденныеПакеты);
	КонецЦикла;

	Возврат НайденныеПакеты;

КонецФункции

// Возвращает поврежденные пакеты, обнаруженные при последнем поиске.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * ИмяПакета - Строка - Имя каталога пакета.
//     * Каталог     - Строка - Полный путь к каталогу пакета.
//     * Причина     - Строка - Причина повреждения.
Функция ПоврежденныеПакеты() Экспорт
	Возврат _ПоврежденныеПакеты.Скопировать();
КонецФункции

// Исключает каталоги пакетов из поиска до чтения их метаданных.
//
// Параметры:
//   Фильтр - Строка - Имена пакетов, маска или регулярное выражение.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ИсключитьПоИмени(Фильтр) Экспорт
	_ВыражениеИсключенияИменПакетов = Фильтр;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает путь к каталогу библиотек для поиска.
//
// Параметры:
//   КаталогБиблиотек - Строка - Путь к каталогу библиотек
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьКаталогБиблиотек(КаталогБиблиотек) Экспорт
	_КаталогБиблиотек = КаталогБиблиотек;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает конфигурационный файл oscript.cfg.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к конфигурационному файлу
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьКонфигурационныйФайл(ПутьКФайлу) Экспорт
	_ОпределительКаталоговБиблиотек.УстановитьКонфигурационныйФайл(ПутьКФайлу);
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьКаталогиБиблиотек()

	Результат = Новый Массив();

	Если ЗначениеЗаполнено(_КаталогБиблиотек) Тогда
		Результат.Добавить(_КаталогБиблиотек);
	КонецЕсли;

	Для Каждого КаталогБиблиотек Из _ОпределительКаталоговБиблиотек.ПолучитьКаталогиБиблиотек() Цикл
		Если Не РаботаСПутямиФайловойСистемы.ПутьУжеДобавлен(Результат, КаталогБиблиотек) Тогда
			Результат.Добавить(КаталогБиблиотек);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура НайтиПакетыВКаталоге(Каталог, НайденныеПакеты)

	Если Не ФС.КаталогСуществует(Каталог) Тогда
		_Лог.Отладка("Пропущен поиск пакетов в несуществующем каталоге: %1", Каталог);
		Возврат;
	КонецЕсли;

	_Лог.Отладка("Поиск пакетов в каталоге: %1", Каталог);

	Файлы = НайтиФайлы(Каталог, "*");
	ФильтрИмен = Новый ФильтрИменПакетов(_ВыражениеИсключенияИменПакетов);
	Для Каждого Файл Из Файлы Цикл

		Если Не Файл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(_ВыражениеИсключенияИменПакетов)
			И ФильтрИмен.Совпадает(Файл.Имя) Тогда
			Продолжить;
		КонецЕсли;

		ПутьКМетаданным = ОбъединитьПути(Файл.ПолноеИмя, "opm-metadata.xml");
		Если Не ФС.ФайлСуществует(ПутьКМетаданным) Тогда
			ДобавитьПоврежденныйПакет(Файл, "Отсутствует файл opm-metadata.xml", НайденныеПакеты);
			Продолжить;
		КонецЕсли;

		МетаданныеПакета = ПрочитатьМетаданныеПакета(Файл, ПутьКМетаданным, НайденныеПакеты);
		Если МетаданныеПакета = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(МетаданныеПакета.ИмяПакета) Тогда
			ДобавитьПоврежденныйПакет(Файл, "Не указано корректное имя пакета", НайденныеПакеты);
			Продолжить;
		КонецЕсли;

		ИмяПакета = Файл.Имя;
		Если НайденныеПакеты[ИмяПакета] = Неопределено Тогда
			_Лог.Отладка("Найден пакет: %1", ИмяПакета);
			НайденныеПакеты.Вставить(ИмяПакета, Файл.ПолноеИмя);
			УдалитьПоврежденныйПакет(ИмяПакета);
		КонецЕсли;

	КонецЦикла;

	_Лог.Отладка("Завершение поиска пакетов в каталоге: %1", Каталог);

КонецПроцедуры

Функция ПрочитатьМетаданныеПакета(Файл, ПутьКМетаданным, НайденныеПакеты)

	Попытка
		Возврат _ПарсерOpmMetadata.Разобрать(ПутьКМетаданным);
	Исключение
		ДобавитьПоврежденныйПакет(
			Файл,
			"Не удалось разобрать XML файла opm-metadata.xml",
			НайденныеПакеты
		);
		_Лог.Отладка(
			"Не удалось прочитать метаданные пакета '%1': %2",
			ПутьКМетаданным,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ДобавитьПоврежденныйПакет(Файл, Причина, НайденныеПакеты)

	Если НайденныеПакеты[Файл.Имя] <> Неопределено
		Или _ПоврежденныеПакеты.Найти(Файл.Имя, "ИмяПакета") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = _ПоврежденныеПакеты.Добавить();
	СтрокаТаблицы.ИмяПакета = Файл.Имя;
	СтрокаТаблицы.Каталог = Файл.ПолноеИмя;
	СтрокаТаблицы.Причина = Причина;

КонецПроцедуры

Процедура УдалитьПоврежденныйПакет(ИмяПакета)

	ПоврежденныйПакет = _ПоврежденныеПакеты.Найти(ИмяПакета, "ИмяПакета");
	Если ПоврежденныйПакет <> Неопределено Тогда
		_ПоврежденныеПакеты.Удалить(ПоврежденныйПакет);
	КонецЕсли;

КонецПроцедуры

Функция ПустаяТаблицаПоврежденныхПакетов()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("ИмяПакета", ТипСтрока);
	Результат.Колонки.Добавить("Каталог", ТипСтрока);
	Результат.Колонки.Добавить("Причина", ТипСтрока);

	Возврат Результат;

КонецФункции

#КонецОбласти
