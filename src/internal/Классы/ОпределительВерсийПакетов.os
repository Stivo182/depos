#Использовать errors

#Область ОписаниеПеременных

Перем _Пакеты; // Соответствие
Перем _ТипВерсии; // Строка, Неопределено - см. ТипыВерсий
Перем _ПустаяВерсия; // Строка - Значение пустой версии ("0.0.0")
Перем _КлиентРеестраПакетов; // КлиентРеестраПакетов

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Пластилин("КлиентРеестраПакетов") КлиентРеестраПакетов)

	_Пакеты = Новый Соответствие();
	_ПустаяВерсия = "0.0.0";
	_КлиентРеестраПакетов = КлиентРеестраПакетов;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит целевые версии для указанных пакетов на основе их минимальных версий и типа версии.
//
// Параметры:
//   Пакеты - Строка - Список имен пакетов через запятую или пробел, опционально с минимальными версиями
//                     в формате "имя@версия" (например, "autumn@4.3.3, asserts").
//          - Массив из Строка - Список имен пакетов, возможно с минимальными версиями в формате "имя@версия".
//          - ТаблицаЗначений - Таблица с данными о пакетах:
//            * ИмяПакета - Строка - Имя пакета.
//            * МинимальнаяВерсия - Строка - Минимальная версия пакета.
//   ТипВерсии - Строка - Тип целевой версии (см. ТипыВерсий).
//                        Если не указан или пустой, используется значение "Последняя".
//
// Возвращаемое значение:
//   Соответствие:
//     * Ключ - Строка - Имя пакета
//     * Значение - Строка - Целевая версия
Функция НайтиВерсии(Пакеты, ТипВерсии = Неопределено) Экспорт

	ДобавитьПакеты(Пакеты);
	УстановитьТипВерсии(ТипВерсии);

	Результат = Новый Соответствие();

	Если _Пакеты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Строка Из _Пакеты Цикл

		ИмяПакета = Строка.Ключ;
		МинимальнаяВерсия = Строка.Значение;

		ЦелеваяВерсия = ОпределитьЦелевуюВерсию(ИмяПакета, МинимальнаяВерсия);

		Если ЗначениеЗаполнено(ЦелеваяВерсия) Тогда
			Результат.Вставить(ИмяПакета, ЦелеваяВерсия);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьТипВерсии(ТипВерсии)
	_ТипВерсии = ?(ЗначениеЗаполнено(ТипВерсии), ТипВерсии, ТипыВерсий.Последняя);
КонецПроцедуры

Процедура ДобавитьПакеты(Пакеты)
		
	_Пакеты.Очистить();
	Тип = ТипЗнч(Пакеты);
	Сообщение = СтрШаблон(
		"Неподдерживаемый тип параметра Пакеты: %1. Ожидался Строка, Массив или ТаблицаЗначений.",
		Тип
	);
	ПроверкаАргументов.ПроверитьТип(
		"Пакеты",
		Пакеты,
		"Строка, Массив, ТаблицаЗначений",
		Сообщение
	);
	
	Если Тип = Тип("Строка") Тогда
		ДобавитьПакеты(СтрРазделить(Пакеты, ", ", Ложь));
	ИначеЕсли Тип = Тип("Массив") Тогда
		ДобавитьПакетыИзМассива(Пакеты);
	Иначе
		ДобавитьПакетыИзТаблицы(Пакеты);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПакетыИзТаблицы(Пакеты)

	Для Каждого Пакет Из Пакеты Цикл
		ДобавитьПакет(Пакет.ИмяПакета, Пакет.МинимальнаяВерсия);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПакетыИзМассива(Пакеты)

	Для Каждого Пакет Из Пакеты Цикл
		ДобавитьПакет(Пакет);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПакет(ИмяПакета, МинимальнаяВерсия = "")

	Части = СтрРазделить(ИмяПакета, "@");
	Если Части.Количество() = 2 Тогда
		_Пакеты.Вставить(Части[0], Части[1]);
	Иначе
		_Пакеты.Вставить(ИмяПакета, МинимальнаяВерсия);
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьЦелевуюВерсию(ИмяПакета, Знач МинимальнаяВерсия)
	
	Если Не ЗначениеЗаполнено(МинимальнаяВерсия) Тогда
		МинимальнаяВерсия = _ПустаяВерсия;
	КонецЕсли;

	МинимальнаяВерсияОбъект = Новый ВерсияПакета(МинимальнаяВерсия);
	Если МинимальнаяВерсияОбъект.Ошибка() Тогда
		Сообщение = СтрШаблон("Некорректная минимальная версия пакета '%1': %2", ИмяПакета, МинимальнаяВерсия);
		ВызватьИсключение Новый ПостроительОшибки(КодыОшибокDepos.ВерсияПакетаНекорректна(), Сообщение)
			.Данные("ИмяПакета", ИмяПакета)
			.Данные("Версия", МинимальнаяВерсия)
			.Построить();
	КонецЕсли;
		
	Попытка
		ВерсииПакета = _КлиентРеестраПакетов.ПолучитьВерсии(ИмяПакета);
	Исключение
		Причина = ИнформацияОбОшибке();
		Если ДиагностикаОшибок.СодержитГруппу(Причина, "registry") Тогда
			ВызватьИсключение;
		КонецЕсли;

		Сообщение = СтрШаблон("Не удалось получить версии пакета '%1'", ИмяПакета);
		Ошибка = Новый ПостроительОшибки(КодыОшибокDepos.ВерсииПакетаНедоступны(), Сообщение)
			.Подсказка("Проверьте доступ к реестру пакетов и повторите команду.")
			.Причина(Причина)
			.Построить();
		ВызватьИсключение Ошибка;
	КонецПопытки;

	Если ВерсииПакета.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектыВерсий = Новый Массив();
	Для Каждого ВерсияСтрокой Из ВерсииПакета Цикл
		ВерсияОбъект = Новый ВерсияПакета(ВерсияСтрокой);
		Если Не ВерсияОбъект.Ошибка() Тогда
			ОбъектыВерсий.Добавить(ВерсияОбъект);
		КонецЕсли;
	КонецЦикла;

	Если _ТипВерсии = ТипыВерсий.Последняя 
		Или Не ЗначениеЗаполнено(_ТипВерсии)
		Или МинимальнаяВерсия = _ПустаяВерсия Тогда
		Версия = НайтиМаксимальную(ОбъектыВерсий, МинимальнаяВерсияОбъект);
	ИначеЕсли _ТипВерсии = ТипыВерсий.Минорная Тогда
		Версия = МаксимальнаяМинорнаяВерсия(ОбъектыВерсий, МинимальнаяВерсияОбъект);
	ИначеЕсли _ТипВерсии = ТипыВерсий.Патч Тогда
		Версия = МаксимальнаяПатчВерсия(ОбъектыВерсий, МинимальнаяВерсияОбъект);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если Версия <> Неопределено И Не Версия.ВСтроку() = _ПустаяВерсия Тогда
		Возврат Версия.ВСтроку();
	КонецЕсли;

КонецФункции

Функция МаксимальнаяМинорнаяВерсия(МассивВерсий, МинимальнаяВерсия)

	Возврат НайтиМаксимальную(
		МассивВерсий,
		МинимальнаяВерсия,
		Истина
	);

КонецФункции

Функция МаксимальнаяПатчВерсия(МассивВерсий, МинимальнаяВерсия)

	Возврат НайтиМаксимальную(
		МассивВерсий,
		МинимальнаяВерсия,
		Ложь,
		Истина
	);

КонецФункции

Функция НайтиМаксимальную(МассивВерсий, МинимальнаяВерсия, ТолькоОсновная = Ложь, ТолькоВторостепенная = Ложь)

	Максимальная = Неопределено;
	ЧетырехкомпонентнаяМинимальнаяВерсия = ПроверкаВерсийПакетов.ЭтоЧетырехкомпонентная(МинимальнаяВерсия.ВСтроку());

	Для Каждого Версия Из МассивВерсий Цикл
		Если Версия.Сравнить(МинимальнаяВерсия) < 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ТолькоОсновная
			И (Версия.Основная() <> МинимальнаяВерсия.Основная()
			Или ЧетырехкомпонентнаяМинимальнаяВерсия И Версия.Второстепенная() <> МинимальнаяВерсия.Второстепенная()) Тогда
			Продолжить;
		КонецЕсли;

		Если ТолькоВторостепенная
			И (Версия.Основная() <> МинимальнаяВерсия.Основная()
			Или Версия.Второстепенная() <> МинимальнаяВерсия.Второстепенная()) Тогда
			Продолжить;
		КонецЕсли;

		Если ТолькоВторостепенная
			И ЧетырехкомпонентнаяМинимальнаяВерсия
			И Версия.Патч() <> МинимальнаяВерсия.Патч() Тогда
			Продолжить;
		КонецЕсли;

		Если Максимальная = Неопределено Или Версия.Сравнить(Максимальная) > 0 Тогда
			Максимальная = Версия;
		КонецЕсли;
	КонецЦикла;

	Возврат Максимальная;

КонецФункции

#КонецОбласти
