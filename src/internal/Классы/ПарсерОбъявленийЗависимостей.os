
#Область ОписаниеПеременных

Перем _ВыражениеДляОбновления; // РегулярноеВыражение
Перем _ВыражениеНачалаВызова; // РегулярноеВыражение
Перем _ВыражениеПометкиПослеВызова; // РегулярноеВыражение
Перем _ВыражениеНачалаОписания; // РегулярноеВыражение
Перем _ВыражениеЭлементовЦепочки; // РегулярноеВыражение

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_ВыражениеДляОбновления = Новый РегулярноеВыражение(
		"""(?:[^""]|"""")*""|//[^\r\n]*|" +
		"\.[ \t]*(ЗависитОт|РазработкаЗависитОт)\s*\(\s*""([^""]+)""" +
		"\s*(?:,\s*""([^""]+)""\s*(?:,\s*""([^""]+)""\s*)?)?\)"
	);
	_ВыражениеДляОбновления.ИгнорироватьРегистр = Истина;

	_ВыражениеНачалаВызова = Новый РегулярноеВыражение(
		"""(?:[^""]|"""")*""|//[^\r\n]*|" +
		"\.[ \t]*(ЗависитОт|РазработкаЗависитОт)\s*\("
	);
	_ВыражениеНачалаВызова.ИгнорироватьРегистр = Истина;

	_ВыражениеПометкиПослеВызова = Новый РегулярноеВыражение(
		"^[ \t]*;?[ \t]*//[ \t]+((?i:неявная|implicit|транзитивная|transitive))" +
		"(?:[ \t]+-[ \t]+[^ \t\r\n][^\r\n]*)?[ \t]*\r?$"
	);
	_ВыражениеНачалаОписания = Новый РегулярноеВыражение("^[ \t]*Описание(?:[ \t]*\.|[ \t]*\r?$)");
	_ВыражениеНачалаОписания.Многострочный = Истина;
	_ВыражениеНачалаОписания.ИгнорироватьРегистр = Истина;
	_ВыражениеЭлементовЦепочки = Новый РегулярноеВыражение(
		"""(?:[^""]|"""")*""|//[^\r\n]*|'(?:[^']|'')*'|[();=+*/,-]"
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит вызовы зависимостей для замены минимальной версии в исходном тексте.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * ИмяПакета          - Строка - Имя пакета.
//     * ДляРазработки      - Булево - Признак зависимости для разработки.
//     * МинимальнаяВерсия  - Строка - Минимальная версия.
//     * МаксимальнаяВерсия - Строка - Максимальная версия.
//     * ИндексВерсии       - Число  - Позиция минимальной версии в тексте.
//     * ДлинаВерсии        - Число  - Длина минимальной версии в тексте.
Функция НайтиДляОбновления(ТекстМанифеста) Экспорт

	Объявления = Новый Массив();
	Для Каждого Совпадение Из НайтиСовпаденияОбъявлений(ТекстМанифеста) Цикл
		ГруппаВерсии = Совпадение.Группы[3];
		Объявление = Новый Структура();
		Объявление.Вставить("ИмяПакета", Совпадение.Группы[2].Значение);
		Объявление.Вставить("ДляРазработки", НРег(Совпадение.Группы[1].Значение) = НРег("РазработкаЗависитОт"));
		Объявление.Вставить("МинимальнаяВерсия", ГруппаВерсии.Значение);
		Объявление.Вставить("МаксимальнаяВерсия", Совпадение.Группы[4].Значение);
		Объявление.Вставить("ИндексВерсии", ГруппаВерсии.Индекс);
		Объявление.Вставить("ДлинаВерсии", ГруппаВерсии.Длина);
		Объявления.Добавить(Объявление);
	КонецЦикла;

	Возврат Объявления;

КонецФункции

// Находит зависимости с пометкой неявности или транзитивности после объявления и необязательным пояснением.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * ИмяПакета     - Строка - Имя отмеченного пакета.
//     * ДляРазработки - Булево - Признак зависимости для разработки.
//     * Транзитивная  - Булево - Пометка требует подтверждения транзитивной цепочкой.
Функция НайтиПометкиЗависимостей(ТекстМанифеста) Экспорт

	Пометки = Новый Массив();
	Для Каждого Совпадение Из НайтиСовпаденияОбъявлений(ТекстМанифеста) Цикл
		ОстатокТекста = Сред(ТекстМанифеста, Совпадение.Индекс + Совпадение.Длина + 1);
		КонецСтроки = СтрНайти(ОстатокТекста, Символ(10));
		ОстатокСтроки = ?(КонецСтроки = 0, ОстатокТекста, Лев(ОстатокТекста, КонецСтроки - 1));
		СовпаденияПометки = _ВыражениеПометкиПослеВызова.НайтиСовпадения(ОстатокСтроки);

		Если СовпаденияПометки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ИмяПакета = Совпадение.Группы[2].Значение;
		ДляРазработки = НРег(Совпадение.Группы[1].Значение) = НРег("РазработкаЗависитОт");
		ТекстПометки = НРег(СовпаденияПометки[0].Группы[1].Значение);
		Транзитивная = ТекстПометки = "транзитивная" Или ТекстПометки = "transitive";

		Пометки.Добавить(Новый Структура(
			"ИмяПакета, ДляРазработки, Транзитивная",
			ИмяПакета, ДляРазработки, Транзитивная
		));
	КонецЦикла;

	Возврат Пометки;

КонецФункции

// Проверяет, есть ли вызовы зависимости с неразобранными аргументами.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//   ДляРазработки - Булево - Режим проверяемых зависимостей.
//
// Возвращаемое значение:
//   Булево - Истина, если в выбранном режиме есть вызов с неразобранными аргументами.
Функция ЕстьНеразобранныеВызовы(ТекстМанифеста, ДляРазработки) Экспорт

	Объявления = НайтиСовпаденияОбъявлений(ТекстМанифеста);
	Для Каждого Вызов Из _ВыражениеНачалаВызова.НайтиСовпадения(ТекстМанифеста) Цикл
		Если Вызов.Группы[1].Значение = ""
			Или Не ЭтоВызовОписания(ТекстМанифеста, Вызов.Индекс)
			Или (НРег(Вызов.Группы[1].Значение) = НРег("РазработкаЗависитОт")) <> ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		НайденоОбъявление = Ложь;
		Для Каждого Объявление Из Объявления Цикл
			Если Объявление.Индекс = Вызов.Индекс Тогда
				НайденоОбъявление = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не НайденоОбъявление Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиСовпаденияОбъявлений(ТекстМанифеста)

	Объявления = Новый Массив();
	Для Каждого Совпадение Из _ВыражениеДляОбновления.НайтиСовпадения(ТекстМанифеста) Цикл
		Если Совпадение.Группы[1].Значение <> ""
			И ЭтоВызовОписания(ТекстМанифеста, Совпадение.Индекс) Тогда
			Объявления.Добавить(Совпадение);
		КонецЕсли;
	КонецЦикла;

	Возврат Объявления;

КонецФункции

Функция ЭтоВызовОписания(ТекстМанифеста, ИндексВызова)

	НачалоЦепочки = -1;
	Для Каждого Начало Из _ВыражениеНачалаОписания.НайтиСовпадения(Лев(ТекстМанифеста, ИндексВызова)) Цикл
		НачалоЦепочки = Начало.Индекс;
	КонецЦикла;

	Если НачалоЦепочки < 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПрефиксЦепочки = Сред(ТекстМанифеста, НачалоЦепочки + 1, ИндексВызова - НачалоЦепочки);

	ГлубинаСкобок = 0;
	Для Каждого Элемент Из _ВыражениеЭлементовЦепочки.НайтиСовпадения(ПрефиксЦепочки) Цикл
		Если Лев(Элемент.Значение, 2) = "//" Тогда
			Продолжить;
		КонецЕсли;
	
		Если Элемент.Значение = "(" Тогда
			ГлубинаСкобок = ГлубинаСкобок + 1;
		ИначеЕсли Элемент.Значение = ")" Тогда
			ГлубинаСкобок = ГлубинаСкобок - 1;
		ИначеЕсли ГлубинаСкобок = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат ГлубинаСкобок = 0;

КонецФункции

#КонецОбласти
