#Использовать osparser

#Область ОписаниеПеременных

Перем _ВыражениеПометкиПослеВызова; // РегулярноеВыражение
Перем _ТекстРазобранногоМанифеста; // Строка
Перем _ВызовыЗависимостей; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_ВыражениеПометкиПослеВызова = Новый РегулярноеВыражение(
		"^[ \t]*;?[ \t]*//[ \t]+((?i:неявная|implicit|транзитивная|transitive))" +
		"(?:[ \t]+-[ \t]+[^ \t\r\n][^\r\n]*)?[ \t]*\r?$"
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит статические объявления зависимостей и позиции их минимальных версий.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура - Объявления зависимостей с позициями версий в тексте.
Функция НайтиДляОбновления(ТекстМанифеста) Экспорт

	Результат = Новый Массив();
	Для Каждого Вызов Из НайтиВызовыЗависимостей(ТекстМанифеста) Цикл
		Поле = Вызов.Поле;
		Если Поле.Аргументы.Количество() < 1 Или Поле.Аргументы.Количество() > 3 Тогда
			Продолжить;
		КонецЕсли;

		Имя = СтроковыйАргумент(Поле.Аргументы[0]);
		Если Имя = Неопределено Или Имя = "" Тогда
			Продолжить;
		КонецЕсли;

		Версия = ?(Поле.Аргументы.Количество() > 1, СтроковыйАргумент(Поле.Аргументы[1]), "");
		МаксимальнаяВерсия = ?(Поле.Аргументы.Количество() > 2, СтроковыйАргумент(Поле.Аргументы[2]), "");
		Если Версия = Неопределено Или МаксимальнаяВерсия = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИндексВерсии = 0;
		ДлинаВерсии = 0;
		Если Поле.Аргументы.Количество() > 1 Тогда
			ЛитералВерсии = Поле.Аргументы[1].Начало;
			ИндексВерсии = ЛитералВерсии.Позиция;
			ДлинаВерсии = ЛитералВерсии.Длина - 2;
		КонецЕсли;

		Результат.Добавить(Новый Структура(
			"ИмяПакета, ДляРазработки, МинимальнаяВерсия, МаксимальнаяВерсия, ИндексВерсии, ДлинаВерсии",
			Имя, Вызов.ДляРазработки, Версия, МаксимальнаяВерсия, ИндексВерсии, ДлинаВерсии
		));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Находит пометки после объявлений зависимостей.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура - Пометки пакетов с признаком транзитивности.
Функция НайтиПометкиЗависимостей(ТекстМанифеста) Экспорт

	Пометки = Новый Массив();
	Для Каждого Вызов Из НайтиВызовыЗависимостей(ТекстМанифеста) Цикл
		Поле = Вызов.Поле;
		Если Поле.Аргументы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Имя = СтроковыйАргумент(Поле.Аргументы[0]);
		Если Имя = Неопределено Или Имя = "" Тогда
			Продолжить;
		КонецЕсли;

		ОстатокТекста = Сред(ТекстМанифеста, Поле.Конец.Позиция + Поле.Конец.Длина);
		КонецСтроки = СтрНайти(ОстатокТекста, Символ(10));
		Если КонецСтроки > 0 Тогда
			ОстатокТекста = Лев(ОстатокТекста, КонецСтроки - 1);
		КонецЕсли;

		Совпадения = _ВыражениеПометкиПослеВызова.НайтиСовпадения(ОстатокТекста);
		Если Совпадения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ТекстПометки = НРег(Совпадения[0].Группы[1].Значение);
		Транзитивная = ТекстПометки = "транзитивная" Или ТекстПометки = "transitive";
		Пометки.Добавить(Новый Структура(
			"ИмяПакета, ДляРазработки, Транзитивная", Имя, Вызов.ДляРазработки, Транзитивная
		));
	КонецЦикла;

	Возврат Пометки;

КонецФункции

// Находит имена в объявлениях, включая вызовы с вычисляемым именем.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//
// Возвращаемое значение:
//   Массив из Структура - ИмяПакета и ДляРазработки; имя может быть Неопределено.
Функция НайтиИменаОбъявлений(ТекстМанифеста) Экспорт

	Результат = Новый Массив();
	Для Каждого Вызов Из НайтиВызовыЗависимостей(ТекстМанифеста) Цикл
		Аргументы = Вызов.Поле.Аргументы;
		Имя = ?(Аргументы.Количество() > 0, СтроковыйАргумент(Аргументы[0]), Неопределено);
		Результат.Добавить(Новый Структура("ИмяПакета, ДляРазработки", Имя, Вызов.ДляРазработки));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет значения минимальных версий, сохраняя остальной текст манифеста.
//
// Параметры:
//   ТекстМанифеста - Строка - Исходный текст packagedef.
//   ЗаменыВерсий - Массив из Структура - Позиция, длина и новый текст версии.
//
// Возвращаемое значение:
//   Строка - Текст с замененными версиями.
Функция ЗаменитьВерсии(ТекстМанифеста, ЗаменыВерсий) Экспорт

	Если ЗаменыВерсий.Количество() = 0 Тогда
		Возврат ТекстМанифеста;
	КонецЕсли;

	Парсер = Новый ПарсерВстроенногоЯзыка();
	Парсер.Разобрать(ТекстМанифеста);

	Для Каждого ЗаменаВерсии Из ЗаменыВерсий Цикл
		Замена = Парсер.ТаблицаЗамен().Добавить();
		Замена.Источник = "depos";
		Замена.Позиция = ЗаменаВерсии.Позиция;
		Замена.Длина = ЗаменаВерсии.Длина;
		Замена.Текст = ЗаменаВерсии.Текст;
	КонецЦикла;

	Возврат Парсер.ВыполнитьЗамены();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиВызовыЗависимостей(ТекстМанифеста)

	Если _ВызовыЗависимостей <> Неопределено И _ТекстРазобранногоМанифеста = ТекстМанифеста Тогда
		Возврат _ВызовыЗависимостей;
	КонецЕсли;

	Парсер = Новый ПарсерВстроенногоЯзыка();
	Парсер.Разобрать(ТекстМанифеста);
	Вызовы = Новый Массив();

	Для Каждого Оператор Из Парсер.Узлы().ОператорВызоваПроцедуры Цикл
		Идентификатор = Оператор.Идентификатор;
		Если НРег(Идентификатор.Голова.Имя) <> "описание" Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Поле Из Идентификатор.Хвост Цикл
			Если Поле.Тип <> "ВыражениеПоле" Или Поле.Аргументы = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ИмяМетода = НРег(Поле.Имя);
			Если ИмяМетода = "зависитот" Или ИмяМетода = "разработказависитот" Тогда
				Вызовы.Добавить(Новый Структура(
					"Поле, ДляРазработки", Поле, ИмяМетода = "разработказависитот"
				));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	_ТекстРазобранногоМанифеста = ТекстМанифеста;
	_ВызовыЗависимостей = Вызовы;

	Возврат Вызовы;

КонецФункции

Функция СтроковыйАргумент(Аргумент)

	Если Аргумент.Тип <> "ВыражениеСтроковое" Или Аргумент.Элементы.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Аргумент.Элементы[0].Значение;

КонецФункции

#КонецОбласти
