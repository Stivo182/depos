#Использовать xml-parser
#Использовать errors
#Использовать semver

#Область ОписаниеПеременных

Перем _РезультатЧтения; // Соответствие, Структура
Перем _ПутьКФайлу; // Строка

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Разбирает файл opm-metadata.xml.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к файлу opm-metadata.xml.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура:
//     * ИмяПакета   - Строка - Имя пакета или пустая строка.
//     * Версия      - Строка - Версия пакета или пустая строка.
//     * Зависимости - ФиксированныйМассив из ФиксированнаяСтруктура - Зависимости пакета.
//
// Исключения:
//   - manifest.parse_failed - Если файл не удалось разобрать как XML.
//   - manifest.structure_invalid - Если структура манифеста некорректна.
//   - package.version_invalid - Если версия пакета некорректна.
//   - dependency.version_invalid - Если версия зависимости некорректна.
Функция Разобрать(ПутьКФайлу) Экспорт

	_РезультатЧтения = ПрочитатьXMLИзФайла(ПутьКФайлу);
	_ПутьКФайлу = ПутьКФайлу;

	Результат = Новый Структура();
	Результат.Вставить("ИмяПакета", ПолучитьИмяПакета());
	Результат.Вставить("Версия", ПолучитьВерсиюПакета());
	Результат.Вставить("Зависимости", Новый ФиксированныйМассив(ПолучитьЗависимости()));

	_РезультатЧтения = Неопределено;
	_ПутьКФайлу = Неопределено;

	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьXMLИзФайла(ПутьКФайлу)

	ПроцессорXML = Новый СериализацияДанныхXML(Ложь);
	Чтение = Новый ЧтениеXML;

	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу);
		РезультатЧтения = ПроцессорXML.ПрочитатьXML(Чтение, , Ложь);
	Исключение
		Причина = ИнформацияОбОшибке();
		ЗакрытьЧтениеXML(Чтение);
		ВызватьИсключение ОшибкаРазбораМанифеста(ПутьКФайлу, Причина);
	КонецПопытки;

	ЗакрытьЧтениеXML(Чтение);

	Возврат РезультатЧтения;

КонецФункции

Процедура ЗакрытьЧтениеXML(Чтение)

	Попытка
		Чтение.Закрыть();
	Исключение
	КонецПопытки;

КонецПроцедуры

// Возвращает имя пакета из XML.
//
// Возвращаемое значение:
//   Строка - Имя пакета или пустая строка, если корректное имя отсутствует.
Функция ПолучитьИмяПакета()

	Метаданные = ПолучитьУзелМетаданных();
	Если Не ЭтоКоллекцияКлючЗначение(Метаданные) Тогда
		Возврат "";
	КонецЕсли;

	УзелИмени = ПолучитьУзелИзЭлементов(
		ПолучитьЗначениеКоллекции(Метаданные, "_Элементы"),
		"name"
	);
	Если Не ЭтоПростойТекстовыйУзел(УзелИмени) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьТекстУзла(УзелИмени);

КонецФункции

// Возвращает версию пакета из XML.
//
// Возвращаемое значение:
//   Строка - Версия пакета или пустая строка, если версия отсутствует.
Функция ПолучитьВерсиюПакета()

	Метаданные = ПолучитьУзелМетаданных();
	Если Не ЭтоКоллекцияКлючЗначение(Метаданные) Тогда
		Возврат "";
	КонецЕсли;

	УзелВерсии = ПолучитьУзелИзЭлементов(
		ПолучитьЗначениеКоллекции(Метаданные, "_Элементы"),
		"version"
	);
	Если УзелВерсии = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Не ЭтоПростойТекстовыйУзел(УзелВерсии) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыЭлемента("version");
	КонецЕсли;

	ВерсияСтрокой = ПолучитьТекстУзла(УзелВерсии);
	Если Не ЗначениеЗаполнено(ВерсияСтрокой) Тогда
		Возврат "";
	КонецЕсли;

	ВерсияОбъект = Новый Версия(ВерсияСтрокой);
	Если ВерсияОбъект.Ошибка() Тогда
		ВызватьИсключение ОшибкаНекорректнойВерсииПакета();
	КонецЕсли;

	Возврат ВерсияСтрокой;

КонецФункции

// Возвращает зависимости пакета из XML.
//
// Возвращаемое значение:
//   Массив из ФиксированнаяСтруктура - Зависимости с полями ИмяПакета, МинимальнаяВерсия,
//                                      МаксимальнаяВерсия и ДляРазработки.
//
// Исключения:
//   - manifest.structure_invalid - Если структура зависимостей некорректна.
//   - dependency.version_invalid - Если версия зависимости некорректна.
Функция ПолучитьЗависимости()

	КорневыеЭлементы = ПолучитьЗначениеКоллекции(_РезультатЧтения, "_Элементы");
	Если Не ЭтоКоллекцияКлючЗначение(КорневыеЭлементы) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			"Некорректная структура манифеста: не найден корневой элемент 'opm-metadata'"
		);
	КонецЕсли;

	Метаданные = ПолучитьЗначениеКоллекции(КорневыеЭлементы, "opm-metadata");
	Если Не ЭтоКоллекцияКлючЗначение(Метаданные) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыЭлемента("opm-metadata");
	КонецЕсли;

	Если СодержитНепустойТекстИлиCDATA(Метаданные) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыЭлемента("opm-metadata");
	КонецЕсли;

	Элементы = ПолучитьЗначениеКоллекции(Метаданные, "_Элементы");
	Если Не ЭтоКоллекцияЭлементов(Элементы) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыЭлемента("opm-metadata");
	КонецЕсли;

	Если Элементы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат ПолучитьЗависимостиИзЭлементов(Элементы);

КонецФункции

Функция ПолучитьТекстУзла(Узел)

	Текст = ПолучитьЗначениеКоллекции(Узел, "_Значение");
	CDATA = ПолучитьЗначениеКоллекции(Узел, "_CDATA");
	Результат = ?(ЗначениеЗаполнено(Текст), Текст, CDATA);

	Возврат ?(ТипЗнч(Результат) = Тип("Строка"), СокрЛП(Результат), "");

КонецФункции

Функция ПолучитьУзелМетаданных()
	КорневыеЭлементы = ПолучитьЗначениеКоллекции(_РезультатЧтения, "_Элементы");
	Возврат ПолучитьЗначениеКоллекции(КорневыеЭлементы, "opm-metadata");
КонецФункции

Функция ПолучитьУзелИзЭлементов(Элементы, ИмяУзла)

	Если ЭтоКоллекцияКлючЗначение(Элементы) Тогда
		Возврат ПолучитьЗначениеКоллекции(Элементы, ИмяУзла);
	КонецЕсли;

	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Элементы Цикл
			Узел = ПолучитьЗначениеКоллекции(Элемент, ИмяУзла);
			Если Узел <> Неопределено Тогда
				Возврат Узел;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьЗависимостиИзЭлементов(Элементы)

	Результат = Новый Массив();
	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Элементы Цикл
			ДобавитьЗависимостьИзЭлемента(Результат, Элемент);
		КонецЦикла;
	Иначе
		ДобавитьЗависимостьИзЭлемента(Результат, Элементы);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьЗависимостьИзЭлемента(ЗависимостиПакета, Элемент)

	Если Не ЭтоКоллекцияКлючЗначение(Элемент) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыЭлемента("opm-metadata");
	КонецЕсли;

	ЗависимостьXML = ПолучитьЗначениеКоллекции(Элемент, "depends-on");
	Если ЗависимостьXML = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЭтоКорректныйУзелЗависимости(ЗависимостьXML) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыЭлемента("depends-on");
	КонецЕсли;

	Атрибуты = ПолучитьЗначениеКоллекции(ЗависимостьXML, "_Атрибуты");
	ЗависимостиПакета.Добавить(ПолучитьЗависимостьИзАтрибутов(Атрибуты));

КонецПроцедуры

Функция ПолучитьЗависимостьИзАтрибутов(Атрибуты)

	ИмяЗависимости = ПолучитьЗначениеКоллекции(Атрибуты, "name");
	Если Не ЗначениеЗаполнено(ИмяЗависимости) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			"Не указан атрибут 'name' элемента 'depends-on'"
		);
	КонецЕсли;

	МинимальнаяВерсия = ПолучитьМинимальнуюВерсию(Атрибуты, ИмяЗависимости);
	МаксимальнаяВерсия = ПолучитьМаксимальнуюВерсию(Атрибуты, ИмяЗависимости);

	Возврат СоздатьЗависимость(
		ИмяЗависимости,
		МинимальнаяВерсия,
		МаксимальнаяВерсия,
		ПолучитьЗначениеКоллекции(Атрибуты, "dev") = "true"
	);

КонецФункции

Функция ПолучитьМинимальнуюВерсию(Атрибуты, ИмяЗависимости)

	ВерсияСтрокой = ПолучитьЗначениеКоллекции(Атрибуты, "version");
	Если ВерсияСтрокой = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПроверитьВерсиюЗависимости(ВерсияСтрокой, ИмяЗависимости);

КонецФункции

Функция ПолучитьМаксимальнуюВерсию(Атрибуты, ИмяЗависимости)

	ВерсияСтрокой = ПолучитьЗначениеКоллекции(Атрибуты, "version-max");
	Если ВерсияСтрокой = Неопределено Или Не ЗначениеЗаполнено(Строка(ВерсияСтрокой)) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПроверитьВерсиюЗависимости(ВерсияСтрокой, ИмяЗависимости);

КонецФункции

Функция ПроверитьВерсиюЗависимости(ВерсияСтрокой, ИмяЗависимости)

	ВерсияСтрокой = Строка(ВерсияСтрокой);
	Если Не ЗначениеЗаполнено(ВерсияСтрокой) Тогда
		ВызватьИсключение ОшибкаНекорректнойВерсииЗависимости(ИмяЗависимости);
	КонецЕсли;

	ВерсияОбъект = Новый Версия(ВерсияСтрокой);
	Если ВерсияОбъект.Ошибка() Тогда
		ВызватьИсключение ОшибкаНекорректнойВерсииЗависимости(ИмяЗависимости);
	КонецЕсли;

	Возврат ВерсияСтрокой;

КонецФункции

Функция СоздатьЗависимость(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, ДляРазработки)

	Результат = Новый Структура();
	Результат.Вставить("ИмяПакета", ИмяПакета);
	Результат.Вставить("МинимальнаяВерсия", МинимальнаяВерсия);
	Результат.Вставить("МаксимальнаяВерсия", МаксимальнаяВерсия);
	Результат.Вставить("ДляРазработки", ДляРазработки);

	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

Функция ОшибкаНекорректнойСтруктурыМанифеста(Сообщение)

	Возврат ФабрикаОшибок.Создать(
		КодыОшибокDepos.СтруктураМанифестаНекорректна(),
		Сообщение,
		Новый Структура("ПутьКФайлу", _ПутьКФайлу)
	);

КонецФункции

Функция ОшибкаРазбораМанифеста(ПутьКФайлу, Причина)

	Возврат ФабрикаОшибок.Обернуть(
		Причина,
		КодыОшибокDepos.РазборМанифестаНеУдался(),
		СтрШаблон("Возникла ошибка при разборе файла манифеста '%1'", ПутьКФайлу),
		Новый Структура("ПутьКФайлу", ПутьКФайлу)
	);

КонецФункции

Функция ОшибкаНекорректнойСтруктурыЭлемента(ИмяЭлемента)

	Возврат ОшибкаНекорректнойСтруктурыМанифеста(
		СтрШаблон("Некорректная структура элемента '%1'", ИмяЭлемента)
	);

КонецФункции

Функция ОшибкаНекорректнойВерсииЗависимости(ИмяЗависимости)

	Возврат ФабрикаОшибок.Создать(
		КодыОшибокDepos.ВерсияЗависимостиНекорректна(),
		СтрШаблон("Некорректная версия зависимости '%1'", ИмяЗависимости),
		Новый Структура("ПутьКФайлу,ИмяПакета", _ПутьКФайлу, ИмяЗависимости)
	);

КонецФункции

Функция ОшибкаНекорректнойВерсииПакета()

	Возврат ФабрикаОшибок.Создать(
		КодыОшибокDepos.ВерсияПакетаНекорректна(),
		"Некорректная версия пакета",
		Новый Структура("ПутьКФайлу", _ПутьКФайлу)
	);

КонецФункции

Функция ЭтоКоллекцияКлючЗначение(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("Структура");
КонецФункции

Функция ЭтоКоллекцияЭлементов(Значение)
	Возврат ЭтоКоллекцияКлючЗначение(Значение) Или ТипЗнч(Значение) = Тип("Массив");
КонецФункции

Функция ЭтоПростойТекстовыйУзел(Узел)

	Если Не ЭтоКоллекцияКлючЗначение(Узел) Тогда
		Возврат Ложь;
	КонецЕсли;

	Атрибуты = ПолучитьЗначениеКоллекции(Узел, "_Атрибуты");
	ДочерниеЭлементы = ПолучитьЗначениеКоллекции(Узел, "_Элементы");
	Если Не ЭтоПустаяКоллекцияКлючЗначение(Атрибуты)
		Или Не ЭтоПустаяКоллекцияКлючЗначение(ДочерниеЭлементы) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = ПолучитьЗначениеКоллекции(Узел, "_Значение");
	CDATA = ПолучитьЗначениеКоллекции(Узел, "_CDATA");

	Возврат Не (ЗначениеЗаполнено(Текст) И ЗначениеЗаполнено(CDATA));

КонецФункции

Функция ЭтоПустаяКоллекцияКлючЗначение(Значение)
	Возврат ЭтоКоллекцияКлючЗначение(Значение) И Значение.Количество() = 0;
КонецФункции

Функция ЭтоКорректныйУзелЗависимости(Узел)

	Если Не ЭтоКоллекцияКлючЗначение(Узел) Тогда
		Возврат Ложь;
	КонецЕсли;

	Атрибуты = ПолучитьЗначениеКоллекции(Узел, "_Атрибуты");
	ДочерниеЭлементы = ПолучитьЗначениеКоллекции(Узел, "_Элементы");

	Возврат ЭтоКоллекцияКлючЗначение(Атрибуты)
		И ЭтоПустаяКоллекцияКлючЗначение(ДочерниеЭлементы)
		И Не СодержитНепустойТекстИлиCDATA(Узел);

КонецФункции

Функция ПолучитьЗначениеКоллекции(Коллекция, Ключ)

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция[Ключ];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СодержитНепустойТекстИлиCDATA(Узел)

	Текст = ПолучитьЗначениеКоллекции(Узел, "_Значение");
	CDATA = ПолучитьЗначениеКоллекции(Узел, "_CDATA");

	Возврат ЗначениеЗаполнено(СокрЛП(Строка(Текст)))
		Или ЗначениеЗаполнено(СокрЛП(Строка(CDATA)));

КонецФункции

#КонецОбласти
