#Область ОписаниеПеременных

Перем _Транспорт; // ТранспортРеестраПакетов
Перем _АдаптерСтарогоХаба; // АдаптерСтарогоХаба
Перем _АдаптерOpenHub; // АдаптерOpenHub
Перем _АдаптерыПоРеестрам; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

// Создает определитель адаптера реестра пакетов.
//
// Параметры:
//   Транспорт           - ТранспортРеестраПакетов - HTTP-транспорт.
//   АдаптерСтарогоХаба  - АдаптерСтарогоХаба - Адаптер прежнего API хаба.
//   АдаптерOpenHub      - АдаптерOpenHub - Адаптер API OpenHub.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("ТранспортРеестраПакетов") Транспорт,
	&Пластилин("АдаптерСтарогоХаба") АдаптерСтарогоХаба,
	&Пластилин("АдаптерOpenHub") АдаптерOpenHub
)

	_Транспорт = Транспорт;
	_АдаптерСтарогоХаба = АдаптерСтарогоХаба;
	_АдаптерOpenHub = АдаптерOpenHub;
	_АдаптерыПоРеестрам = Новый Соответствие;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Определяет адаптер API для реестра пакетов.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета для сообщения об ошибке.
//   Реестр    - URL - Адрес реестра.
//   Прокси    - URL, Структура, Неопределено - Настройки proxy.
//   Заголовки - Соответствие, Неопределено - Заголовки запроса discovery.
//
// Возвращаемое значение:
//   АдаптерСтарогоХаба, АдаптерOpenHub - Адаптер API реестра.
//
// Исключения:
//   - registry.unavailable - Если не удалось определить API реестра.
Функция Получить(ИмяПакета, Реестр, Прокси, Заголовки = Неопределено) Экспорт

	КлючРеестра = Реестр.ВСтроку();
	Адаптер = _АдаптерыПоРеестрам.Получить(КлючРеестра);
	Если Адаптер <> Неопределено Тогда
		Возврат Адаптер;
	КонецЕсли;

	Адаптер = Определить(ИмяПакета, Реестр, Прокси, Заголовки);
	_АдаптерыПоРеестрам.Вставить(КлючРеестра, Адаптер);

	Возврат Адаптер;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Определить(ИмяПакета, Реестр, Прокси, Заголовки)

	ПредставлениеРеестра = Реестр.ВСтрокуБезДанныхПользователя();
	Попытка
		Ответ = _Транспорт.Получить(АдресОписанияAPI(Реестр), Прокси, Заголовки);
	Исключение
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "ошибка транспорта");
	КонецПопытки;

	Если Ответ.КодСостояния = 404 Тогда
		Возврат _АдаптерСтарогоХаба;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета,
			ПредставлениеРеестра,
			СтрШаблон("HTTP %1 при определении API", Ответ.КодСостояния)
		);
	ИначеЕсли ЭтоOpenHub(Ответ.Тело) Тогда
		Возврат _АдаптерOpenHub;
	КонецЕсли;

	Возврат _АдаптерСтарогоХаба;

КонецФункции

Функция ЭтоOpenHub(Тело)

	Чтение = Новый ЧтениеJSON;
	Данные = Неопределено;

	Попытка
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		Возврат Ложь;
	КонецПопытки;

	Чтение.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Информация = Данные.Получить("info");
	Если ТипЗнч(Информация) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Информация.Получить("title") = "OpenHub API v1";

КонецФункции

Функция АдресОписанияAPI(Реестр)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментыПути(СтрРазделить("api/v1/openapi.json", "/", Ложь));

	Возврат Адрес;

КонецФункции

#КонецОбласти
