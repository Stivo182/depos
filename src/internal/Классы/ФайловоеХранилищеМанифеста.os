#Использовать errors

#Область ОписаниеПеременных

Перем _Лог; // Лог

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()

	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает содержимое файла манифеста в кодировке UTF-8.
//
// Параметры:
//   ПутьКФайлу - Строка - Полный путь к файлу манифеста
//
// Возвращаемое значение:
//   Строка - Содержимое файла манифеста
//
// Исключения:
//   - manifest.read_failed - Ошибка открытия, чтения или закрытия файла
Функция Прочитать(ПутьКФайлу) Экспорт

	ЧтениеТекста = Неопределено;
	Попытка
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		СодержимоеФайла = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		Возврат СодержимоеФайла;
	Исключение
		ИнформацияОбОшибкеЧтения = ИнформацияОбОшибке();
		ЗакрытьЧтениеТекста(ЧтениеТекста);
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			ИнформацияОбОшибкеЧтения,
			КодыОшибокDepos.ЧтениеМанифестаНеУдалось(),
			СтрШаблон("Возникла ошибка при чтении файла манифеста '%1'", ПутьКФайлу),
			Новый Структура("ПутьКФайлу", ПутьКФайлу)
		);
	КонецПопытки;

КонецФункции

// Записывает содержимое файла манифеста в кодировке UTF-8.
//
// Параметры:
//   ПутьКФайлу      - Строка - Полный путь к файлу манифеста
//   СодержимоеФайла - Строка - Текст, который нужно записать в файл
//
// Исключения:
//   - manifest.write_failed - Ошибка открытия, записи или закрытия файла
Процедура Записать(ПутьКФайлу, СодержимоеФайла) Экспорт

	ЗаписьТекста = Неопределено;
	Попытка
		ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8");
		ЗаписьТекста.Записать(СодержимоеФайла);
		ЗаписьТекста.Закрыть();
	Исключение
		ИнформацияОбОшибкеЗаписи = ИнформацияОбОшибке();
		ЗакрытьЗаписьТекста(ЗаписьТекста);
		
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			ИнформацияОбОшибкеЗаписи,
			КодыОшибокDepos.ЗаписьМанифестаНеУдалась(),
			СтрШаблон("Возникла ошибка при записи файла манифеста '%1'", ПутьКФайлу),
			Новый Структура("ПутьКФайлу", ПутьКФайлу)
		);
	КонецПопытки;

КонецПроцедуры

// Копирует файл манифеста.
//
// Параметры:
//   Источник - Строка - Путь к исходному файлу.
//   Приемник  - Строка - Путь к создаваемой копии.
Процедура Скопировать(Источник, Приемник) Экспорт

	КопироватьФайл(Источник, Приемник);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗакрытьЧтениеТекста(ЧтениеТекста)

	Если ЧтениеТекста = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЧтениеТекста.Закрыть();
	Исключение
		_Лог.Отладка("Не удалось закрыть файл: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗакрытьЗаписьТекста(ЗаписьТекста)

	Если ЗаписьТекста = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписьТекста.Закрыть();
	Исключение
		_Лог.Отладка("Не удалось закрыть файл после записи: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
