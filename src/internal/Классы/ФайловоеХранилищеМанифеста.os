#Использовать errors

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает файл манифеста в кодировке UTF-8 и возвращает содержимое без BOM.
//
// Параметры:
//   ПутьКФайлу - Строка - Полный путь к файлу манифеста
//
// Возвращаемое значение:
//   Строка - Содержимое файла манифеста
//
// Исключения:
//   - manifest.read_failed - Ошибка чтения файла
Функция Прочитать(ПутьКФайлу) Экспорт

	Попытка
		ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
		СодержимоеФайла = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
		Возврат УдалитьBOMИзНачала(СодержимоеФайла);
	Исключение
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			ИнформацияОбОшибке(),
			КодыОшибокDepos.ЧтениеМанифестаНеУдалось(),
			СтрШаблон("Возникла ошибка при чтении файла манифеста '%1'", ПутьКФайлу)
		);
	КонецПопытки;

КонецФункции

// Записывает содержимое файла манифеста в кодировке UTF-8 без преобразований.
// При перезаписи сохраняет наличие BOM. Новый файл создаёт без BOM.
//
// Параметры:
//   ПутьКФайлу      - Строка - Полный путь к файлу манифеста
//   СодержимоеФайла - Строка - Текст, который нужно записать в файл
//
// Исключения:
//   - manifest.write_failed - Ошибка записи файла
Процедура Записать(ПутьКФайлу, СодержимоеФайла) Экспорт

	Попытка
		ДобавлятьBOM = Ложь;
		Если Новый Файл(ПутьКФайлу).Существует() Тогда
			БуферФайла = ПолучитьБуферФайла(ПутьКФайлу);
			ДобавлятьBOM = БуферСодержитBOM(БуферФайла);
		КонецЕсли;

		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(
			СодержимоеФайла,
			КодировкаТекста.UTF8,
			ДобавлятьBOM
		);
		ДвоичныеДанные.Записать(ПутьКФайлу);
	Исключение
		ВызватьИсключение ФабрикаОшибок.Обернуть(
			ИнформацияОбОшибке(),
			КодыОшибокDepos.ЗаписьМанифестаНеУдалась(),
			СтрШаблон("Возникла ошибка при записи файла манифеста '%1'", ПутьКФайлу)
		);
	КонецПопытки;

КонецПроцедуры

// Копирует файл манифеста.
//
// Параметры:
//   Источник - Строка - Путь к исходному файлу.
//   Приемник  - Строка - Путь к создаваемой копии.
Процедура Скопировать(Источник, Приемник) Экспорт

	КопироватьФайл(Источник, Приемник);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьБуферФайла(ПутьКФайлу)

	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);

КонецФункции

Функция БуферСодержитBOM(Буфер)

	Возврат Буфер.Размер >= 3
		И Буфер.Получить(0) = 239
		И Буфер.Получить(1) = 187
		И Буфер.Получить(2) = 191;

КонецФункции

Функция УдалитьBOMИзНачала(Содержимое)

	Если Лев(Содержимое, 1) = Символ(65279) Тогда
		Возврат Сред(Содержимое, 2);
	КонецЕсли;

	Возврат Содержимое;

КонецФункции

#КонецОбласти
