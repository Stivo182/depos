#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует текстовый отчет о проверенных версиях зависимостей.
//
// Параметры:
//   ИзмененияЗависимостей - ТаблицаЗначений - Результат сравнения исходных и целевых зависимостей.
//
// Возвращаемое значение:
//   Строка
Функция Сформировать(ИзмененияЗависимостей) Экспорт

	Тексты = Новый Массив();
	Для Каждого СтрокаОтчета Из ПодготовитьСтроки(ИзмененияЗависимостей, Ложь) Цикл
		Тексты.Добавить(СтрокаОтчета.Текст + СтрокаОтчета.ВерсияПосле);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Формирует строки для консоли с цветовой разметкой и символами состояния.
//
// Параметры:
//   ИзмененияЗависимостей - ТаблицаЗначений - Результат сравнения зависимостей.
//   Обновлено - Булево - Истина для подтверждения выполненного обновления.
//   Настройки - НастройкиФорматирования - Цвета и подписи для вывода.
//   Профиль - Структура - Символы, доступные терминалу.
//
// Возвращаемое значение:
//   Массив из Структура - Части строки: Префикс, Текст, ВерсияПосле.
Функция ПодготовитьСтрокиДляКонсоли(ИзмененияЗависимостей, Обновлено, Настройки, Профиль) Экспорт
	Возврат ПодготовитьСтроки(ИзмененияЗависимостей, Истина, Обновлено, Настройки, Профиль);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьСтроки(
	ИзмененияЗависимостей,
	ДляКонсоли,
	Обновлено = Ложь,
	Настройки = Неопределено,
	Профиль = Неопределено
)

	Если ДляКонсоли Тогда
		ИзмененияЗависимостей.Сортировать("ДляРазработки, ИмяПакета");
	КонецЕсли;

	ТекстДляРазработки = "dev";
	Стрелка = "→";

	Если ДляКонсоли Тогда
		ТекстДляРазработки = Настройки.ТекстДляРазработки;
		Стрелка = Профиль.Стрелка;
	КонецЕсли;

	ШиринаИмен = 0;
	ШиринаВерсий = 0;
	ШиринаРазработки = ?(ДляКонсоли, 0, СтрДлина(ТекстДляРазработки));

	Для Каждого Изменение Из ИзмененияЗависимостей Цикл
		ШиринаИмен = Макс(ШиринаИмен, СтрДлина(Изменение.ИмяПакета));
		ВерсияДо = ?(ЗначениеЗаполнено(Изменение.МинимальнаяВерсияДо), Изменение.МинимальнаяВерсияДо, "*");
		ШиринаВерсий = Макс(ШиринаВерсий, СтрДлина(ВерсияДо));

		Если Изменение.ДляРазработки Тогда
			ШиринаРазработки = СтрДлина(ТекстДляРазработки);
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив();
	Для Каждого Изменение Из ИзмененияЗависимостей Цикл

		ИмяПакета = ПомощникКонсольногоВывода.ФиксированнаяСтрока(Изменение.ИмяПакета, ШиринаИмен);

		ДляРазработки = ?(Изменение.ДляРазработки, ТекстДляРазработки, "");
		ДляРазработки = ПомощникКонсольногоВывода.ФиксированнаяСтрока(ДляРазработки, ШиринаРазработки);

		ВерсияДо = ?(ЗначениеЗаполнено(Изменение.МинимальнаяВерсияДо), Изменение.МинимальнаяВерсияДо, "*");
		ВерсияДо = ПомощникКонсольногоВывода.ФиксированнаяСтрока(ВерсияДо, ШиринаВерсий);

		ВерсияПосле = ?(ЗначениеЗаполнено(Изменение.МинимальнаяВерсияПосле), Изменение.МинимальнаяВерсияПосле, "*");
		Префикс = "";	
		Если ДляКонсоли Тогда
			ВерсияПосле = ЦелеваяВерсияДляВывода(
				Изменение.МинимальнаяВерсияПосле,
				Изменение.МинимальнаяВерсияДо,
				Настройки
			);
			Префикс = ПрефиксОбновления(Изменение, Обновлено, Настройки, Профиль);
		КонецЕсли;

		Текст = СтрШаблон("%1  %2  %3 %4 ", ИмяПакета, ДляРазработки, ВерсияДо, Стрелка);
		Строки.Добавить(Новый Структура("Префикс, Текст, ВерсияПосле", Префикс, Текст, ВерсияПосле));

	КонецЦикла;

	Возврат Строки;

КонецФункции

Функция ПрефиксОбновления(Изменение, Обновлено, Настройки, Профиль)

	ТребуетсяОбновление = ТребуетсяОбновлениеДляВерсии(
		Изменение.МинимальнаяВерсияДо,
		Изменение.МинимальнаяВерсияПосле
	);
	СимволОбновления = ?(Обновлено, Профиль.Успех, Профиль.СтрелкаВверх);
	Цвет = ?(Обновлено,
		Настройки.ЦветСимволаВыполненногоОбновления,
		Настройки.ЦветСимволаНаличияОбновления
	);

	Возврат " " + ПомощникКонсольногоВывода.ПокраситьТекст(?(ТребуетсяОбновление, СимволОбновления, " "), Цвет) + " ";

КонецФункции

Функция ЦелеваяВерсияДляВывода(ЦелеваяВерсия, ИсходнаяВерсия, Настройки)

	ИсходнаяВерсияОбъект = Новый ВерсияПакета(ИсходнаяВерсия);
	ЦелеваяВерсияОбъект = Новый ВерсияПакета(ЦелеваяВерсия);
	ОбычнаяЧасть = "";
	ЦветнаяЧасть = "";
	Цвет = "Серый";
	ЧетырехкомпонентнаяЦелеваяВерсия = ПроверкаВерсийПакетов.ЭтоЧетырехкомпонентная(ЦелеваяВерсия);
	КоличествоМажорныхКомпонент = ?(ЧетырехкомпонентнаяЦелеваяВерсия, 2, 1);
	КоличествоМинорныхКомпонент = ?(ЧетырехкомпонентнаяЦелеваяВерсия, 3, 2);
	КоличествоПатчКомпонент = ?(ЧетырехкомпонентнаяЦелеваяВерсия, 4, 3);

	Если Не ЗначениеЗаполнено(ЦелеваяВерсия) Тогда
		ЦветнаяЧасть = Настройки.ПустаяВерсия;
	ИначеЕсли Не ЗначениеЗаполнено(ИсходнаяВерсия) Тогда
		ЦветнаяЧасть = ЦелеваяВерсия;
	Иначе
		КоличествоОбщихКомпонент = КоличествоОбщихКомпонентВерсии(
			ИсходнаяВерсияОбъект,
			ЦелеваяВерсияОбъект
		);

		Если КоличествоОбщихКомпонент < КоличествоМажорныхКомпонент Тогда
			Цвет = Настройки.ЦветМажорнойЧасти;
			ЦветнаяЧасть = ЦелеваяВерсия;
		ИначеЕсли КоличествоОбщихКомпонент < КоличествоМинорныхКомпонент Тогда
			Цвет = Настройки.ЦветМинорнойЧасти;
			ОбычнаяЧасть = ЧастьВерсииДоКомпоненты(ЦелеваяВерсия, КоличествоМажорныхКомпонент);
			ЦветнаяЧасть = ЧастьВерсииПослеКомпоненты(ЦелеваяВерсия, КоличествоМажорныхКомпонент);
		ИначеЕсли КоличествоОбщихКомпонент < КоличествоПатчКомпонент Тогда
			Цвет = Настройки.ЦветПатчЧасти;
			ОбычнаяЧасть = ЧастьВерсииДоКомпоненты(ЦелеваяВерсия, КоличествоМинорныхКомпонент);
			ЦветнаяЧасть = ЧастьВерсииПослеКомпоненты(ЦелеваяВерсия, КоличествоМинорныхКомпонент);
		Иначе
			ОбычнаяЧасть = ЦелеваяВерсия;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЦветнаяЧасть) Тогда
		Возврат ОбычнаяЧасть + ПомощникКонсольногоВывода.ПокраситьТекст(ЦветнаяЧасть, Цвет);
	КонецЕсли;

	Возврат ОбычнаяЧасть;

КонецФункции

Функция КоличествоОбщихКомпонентВерсии(ПерваяВерсия, ВтораяВерсия)
	Если ПерваяВерсия.Основная() <> ВтораяВерсия.Основная() Тогда
		Возврат 0;
	ИначеЕсли ПерваяВерсия.Второстепенная() <> ВтораяВерсия.Второстепенная() Тогда
		Возврат 1;
	ИначеЕсли ПерваяВерсия.Патч() <> ВтораяВерсия.Патч() Тогда
		Возврат 2;
	ИначеЕсли ПерваяВерсия.ДополнительныйПатч() <> ВтораяВерсия.ДополнительныйПатч() Тогда
		Возврат 3;
	КонецЕсли;

	Возврат 4;
КонецФункции

Функция ЧастьВерсииДоКомпоненты(ВерсияСтрокой, КоличествоКомпонент)

	Компоненты = СтрРазделить(ВерсияСтрокой, ".");
	Остаток = Новый Массив();

	Для Индекс = 0 По КоличествоКомпонент - 1 Цикл
		Остаток.Добавить(Компоненты[Индекс]);
	КонецЦикла;

	Возврат СтрСоединить(Остаток, ".") + ".";

КонецФункции

Функция ЧастьВерсииПослеКомпоненты(ВерсияСтрокой, КоличествоКомпонент)

	Компоненты = СтрРазделить(ВерсияСтрокой, ".");

	Остаток = Новый Массив();
	Для Индекс = КоличествоКомпонент По Компоненты.ВГраница() Цикл
		Остаток.Добавить(Компоненты[Индекс]);
	КонецЦикла;

	Возврат СтрСоединить(Остаток, ".");

КонецФункции

Функция ТребуетсяОбновлениеДляВерсии(ИсходнаяВерсия, ЦелеваяВерсия)
	Возврат ЗначениеЗаполнено(ЦелеваяВерсия)
		И ЗначениеЗаполнено(ИсходнаяВерсия)
		И Новый ВерсияПакета(ЦелеваяВерсия).Сравнить(ИсходнаяВерсия) > 0;
КонецФункции

#КонецОбласти
