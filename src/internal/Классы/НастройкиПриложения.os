// BSLLS:ExportVariables-off

&Деталька(Значение = "depos.debug", ЗначениеПоУмолчанию = Ложь)
Перем РежимОтладки Экспорт; // Булево

&Деталька(Значение = "depos.registry.primary", ЗначениеПоУмолчанию = "https://hub.oscript.io")
Перем ОсновнойРеестрПоУмолчанию Экспорт; // Строка

&Деталька(Значение = "depos.registry.fallback", ЗначениеПоУмолчанию = "http://hub.oscript.ru")
Перем РезервныйРеестрПоУмолчанию Экспорт; // Строка

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Возвращает признак включенного режима отладки.
//
// Возвращаемое значение:
//   Булево - Истина, если режим отладки включен.
Функция РежимОтладкиВключен() Экспорт

	Если ТипЗнч(РежимОтладки) = Тип("Булево") Тогда
		Возврат РежимОтладки;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(РежимОтладки))) = "true";

КонецФункции

// Возвращает адреса реестров по умолчанию в порядке обращения.
//
// Возвращаемое значение:
//   Массив из Строка - Непустые адреса основного и резервного реестров.
Функция РеестрыПоУмолчанию() Экспорт

	Результат = Новый Массив;

	Если ЗначениеЗаполнено(ОсновнойРеестрПоУмолчанию) Тогда
		Результат.Добавить(СокрЛП(Строка(ОсновнойРеестрПоУмолчанию)));
	КонецЕсли;

	Если ЗначениеЗаполнено(РезервныйРеестрПоУмолчанию) Тогда
		Результат.Добавить(СокрЛП(Строка(РезервныйРеестрПоУмолчанию)));
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
