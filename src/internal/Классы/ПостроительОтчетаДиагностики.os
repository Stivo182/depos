#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Строит упорядоченное представление результата анализа зависимостей.
//
// Параметры:
//   РезультатыАнализа - РезультатыАнализаЗависимостей - Результат анализа.
//   ПутьКМанифесту - Строка - Путь анализируемого манифеста.
//
// Возвращаемое значение:
//   ОтчетДиагностики
Функция Построить(РезультатыАнализа, ПутьКМанифесту) Экспорт

	Отчет = Новый ОтчетДиагностики();
	Отчет.ПутьКМанифесту = ПутьКМанифесту;
	Отчет.КоличествоПроблем = РезультатыАнализа.КоличествоПроблем();
	Отчет.КоличествоРекомендаций = КоличествоРекомендаций(РезультатыАнализа.Элементы());

	НомерСекции = 0;
	Для Каждого ОписаниеСекции Из ОписанияСекций() Цикл
		Элементы = ЭлементыТипа(РезультатыАнализа.Элементы(), ОписаниеСекции.Тип);
		Если Элементы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		НомерСекции = НомерСекции + 1;
		Секция = Новый Структура(
			"Номер, Тип, Заголовок, Описание, РазделятьЭлементы, РазделятьЭлементыПодробно, Элементы",
			НомерВФормате(НомерСекции),
			ОписаниеСекции.Тип,
			ОписаниеСекции.Заголовок,
			ОписаниеСекции.Описание,
			ОписаниеСекции.РазделятьЭлементы,
			ОписаниеСекции.РазделятьЭлементыПодробно,
			Элементы
		);
		Отчет.Секции.Добавить(Секция);
	КонецЦикла;

	Возврат Отчет;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписанияСекций()

	Результат = Новый Массив();

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(),
		"Отсутствуют в манифесте",
		"",
		Истина,
		Истина
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(),
		"Не обнаружено прямого использования"
	);

	ДобавитьОписаниеСекции(Результат, ТипыДиагностикиЗависимостей.НеУстановлен(), "Не установлены");
	ДобавитьОписаниеСекции(Результат, ТипыДиагностикиЗависимостей.Поврежден(), "Повреждены установленные пакеты");

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
		"Несоответствие версий",
		"",
		Истина,
		Истина
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		"Конфликты транзитивных зависимостей",
		"",
		Истина
	);

	ДобавитьОписаниеСекции(
		Результат,
		ТипыДиагностикиЗависимостей.РекомендацияВерсии(),
		"Рекомендации по версиям",
		"Прямые ограничения версий уже обеспечены транзитивными зависимостями",
		Истина
	);

	Возврат Результат;

КонецФункции

Процедура ДобавитьОписаниеСекции(
	Секции,
	Тип,
	Заголовок,
	Описание = "",
	РазделятьЭлементы = Ложь,
	РазделятьЭлементыПодробно = Ложь
)

	Секции.Добавить(Новый Структура(
		"Тип, Заголовок, Описание, РазделятьЭлементы, РазделятьЭлементыПодробно",
		Тип,
		Заголовок,
		Описание,
		РазделятьЭлементы,
		РазделятьЭлементыПодробно
	));

КонецПроцедуры

Функция ЭлементыТипа(ВсеЭлементы, Тип)

	Результат = Новый Массив();
	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("ИмяПакета");
	ТаблицаСортировки.Колонки.Добавить("ДляРазработки");
	ТаблицаСортировки.Колонки.Добавить("ТипКонфликта");
	ТаблицаСортировки.Колонки.Добавить("Источники");
	ТаблицаСортировки.Колонки.Добавить("Элемент");

	Для Каждого Элемент Из ВсеЭлементы Цикл
		Если Элемент.Тип = Тип Тогда
			КопияЭлемента = Элемент.Копия();
			ОтсортироватьТребования(КопияЭлемента.Требования);

			СтрокаТаблицы = ТаблицаСортировки.Добавить();
			СтрокаТаблицы.ИмяПакета = НРег(КопияЭлемента.ИмяПакета);
			СтрокаТаблицы.ДляРазработки = КопияЭлемента.ДляРазработки;
			СтрокаТаблицы.ТипКонфликта = КопияЭлемента.ТипКонфликта;
			СтрокаТаблицы.Источники = КлючТребований(КопияЭлемента.Требования);
			СтрокаТаблицы.Элемент = КопияЭлемента;
		КонецЕсли;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("ИмяПакета, ДляРазработки, ТипКонфликта, Источники");

	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		ОтсортироватьФайлы(СтрокаТаблицы.Элемент.Файлы);
		Результат.Добавить(СтрокаТаблицы.Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОтсортироватьТребования(Требования)

	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("Ключ");
	ТаблицаСортировки.Колонки.Добавить("Требование");

	Для Каждого Требование Из Требования Цикл
		СтрокаТаблицы = ТаблицаСортировки.Добавить();
		СтрокаТаблицы.Ключ = КлючТребования(Требование);
		СтрокаТаблицы.Требование = Требование;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("Ключ");
	Требования.Очистить();

	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Требования.Добавить(СтрокаТаблицы.Требование);
	КонецЦикла;

КонецПроцедуры

Функция КлючТребований(Требования)

	Ключи = Новый Массив();
	Для Каждого Требование Из Требования Цикл
		Ключи.Добавить(КлючТребования(Требование));
	КонецЦикла;

	Возврат СтрСоединить(Ключи, Символы.ПС);

КонецФункции

Функция КлючТребования(Требование)

	Возврат НРег(Требование.КорневаяПрямаяЗависимость) + Символы.Таб
		+ НРег(Требование.ИсточникТребования) + Символы.Таб
		+ Требование.ТребуемаяВерсия + Символы.Таб
		+ ?(Требование.ДляРазработки, "1", "0") + Символы.Таб
		+ СтрСоединить(Требование.ЦепочкаЗависимостей, Символы.Таб);

КонецФункции

Процедура ОтсортироватьФайлы(Файлы)

	ТаблицаСортировки = Новый ТаблицаЗначений();
	ТаблицаСортировки.Колонки.Добавить("Путь");

	Для Каждого Путь Из Файлы Цикл
		СтрокаТаблицы = ТаблицаСортировки.Добавить();
		СтрокаТаблицы.Путь = Путь;
	КонецЦикла;

	ТаблицаСортировки.Сортировать("Путь");

	Файлы.Очистить();
	Для Каждого СтрокаТаблицы Из ТаблицаСортировки Цикл
		Файлы.Добавить(СтрокаТаблицы.Путь);
	КонецЦикла;

КонецПроцедуры

Функция НомерВФормате(Номер)

	Возврат ?(Номер < 10, "0", "") + Номер;

КонецФункции

Функция КоличествоРекомендаций(Элементы)

	Результат = 0;
	Для Каждого Элемент Из Элементы Цикл
		Если Не Элемент.ЭтоПроблема Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
