#Использовать 1connector

#Область ОписаниеПеременных

Перем _РегулярноеВыражениеПеременнойСреды; // РегулярноеВыражение

#КонецОбласти

#Область ОбработчикиСобытий

// HTTP-транспорт реестра пакетов.
&Желудь
Процедура ПриСозданииОбъекта()

	_РегулярноеВыражениеПеременнойСреды = Новый РегулярноеВыражение("\$\{([^}]+)\}");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет GET-запрос к реестру пакетов.
//
// Параметры:
//   Адрес     - URL - Адрес ресурса.
//   Прокси    - URL - Адрес proxy.
//             - Структура - Настройки proxy из opm.cfg:
//               * ИспользоватьСистемный         - Булево - Использовать системные настройки proxy.
//               * Сервер                        - Строка - Адрес сервера proxy.
//               * Порт                          - Число - Порт сервера proxy.
//               * Пользователь                  - Строка - Имя пользователя.
//               * Пароль                        - Строка - Пароль пользователя.
//               * ИспользоватьАутентификациюОС  - Булево - Использовать аутентификацию операционной системы.
//             - Неопределено - Выполнить запрос без proxy.
//   Заголовки - Соответствие, Неопределено - Заголовки запроса.
//
// Возвращаемое значение:
//   Структура:
//     * КодСостояния - Число - Код состояния HTTP.
//     * Тело         - Строка - Тело HTTP-ответа.
//
// Исключения:
//   Исключение транспорта 1connector при невозможности выполнить запрос.
Функция Получить(Адрес, Прокси, Заголовки = Неопределено) Экспорт

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Таймаут", 30);

	Если Прокси <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("Прокси", СоздатьИнтернетПрокси(Прокси));
	КонецЕсли;

	ПодготовленныеЗаголовки = ПодготовитьЗаголовки(Заголовки);
	Если ПодготовленныеЗаголовки <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("Заголовки", ПодготовленныеЗаголовки);
	КонецЕсли;

	Ответ = КоннекторHTTP.Get(Адрес.КодированноеПредставление(), Неопределено, ДополнительныеПараметры);

	Возврат Новый Структура("КодСостояния,Тело", Ответ.КодСостояния, Ответ.Текст());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьЗаголовки(Заголовки)

	Если Заголовки = Неопределено Или Заголовки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого Заголовок Из Заголовки Цикл
		Результат.Вставить(Заголовок.Ключ, РазвернутьПеременныеСреды(Заголовок.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазвернутьПеременныеСреды(Значение)

	Результат = Строка(Значение);
	Для Каждого Совпадение Из _РегулярноеВыражениеПеременнойСреды.НайтиСовпадения(Результат) Цикл
		ИмяПеременной = Совпадение.Группы[1].Значение;
		Результат = СтрЗаменить(
			Результат,
			Совпадение.Значение,
			ПолучитьПеременнуюСреды(ИмяПеременной)
		);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьИнтернетПрокси(Настройки)

	Если ТипЗнч(Настройки) = Тип("URL") Тогда
		Возврат СоздатьИнтернетПроксиИзURL(Настройки);
	КонецЕсли;

	Возврат СоздатьИнтернетПроксиИзНастроекOpm(Настройки);

КонецФункции

Функция СоздатьИнтернетПроксиИзURL(Адрес)

	Прокси = Новый ИнтернетПрокси;

	УстановитьПроксиДляHTTP(
		Прокси,
		Адрес.Хост(),
		Адрес.ЭффективныйПорт(),
		Адрес.ИмяПользователя(),
		Адрес.Пароль()
	);

	Возврат Прокси;

КонецФункции

Функция СоздатьИнтернетПроксиИзНастроекOpm(Настройки)

	Если Настройки.ИспользоватьСистемный Тогда
		Прокси = Новый ИнтернетПрокси(Истина);
		Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
		Возврат Прокси;
	КонецЕсли;

	Прокси = Новый ИнтернетПрокси;

	УстановитьПроксиДляHTTP(
		Прокси,
		Настройки.Сервер,
		Настройки.Порт,
		Настройки.Пользователь,
		Настройки.Пароль,
		Настройки.ИспользоватьАутентификациюОС
	);

	Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;

	Возврат Прокси;

КонецФункции

Процедура УстановитьПроксиДляHTTP(
	Прокси,
	Сервер,
	Порт,
	Пользователь = Неопределено,
	Пароль = Неопределено,
	ИспользоватьАутентификациюОС = Ложь
)

	Для Каждого Протокол Из СтрРазделить("http,https", ",") Цикл
		Если Пользователь = Неопределено Тогда
			Прокси.Установить(Протокол, Сервер, Порт);
		Иначе
			Прокси.Установить(
				Протокол,
				Сервер,
				Порт,
				Пользователь,
				Пароль,
				ИспользоватьАутентификациюОС
			);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
