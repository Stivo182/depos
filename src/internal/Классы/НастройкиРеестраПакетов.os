#Использовать errors
#Использовать url

#Область ОписаниеПеременных

Перем _НастройкиПриложения; // НастройкиПриложения
Перем _ПровайдерНастроекOpm; // ПровайдерНастроекOpm
Перем _Прокси; // URL, Структура, Неопределено
Перем _Серверы; // Массив из Структура
Перем _НастройкиПрименены; // Булево

#КонецОбласти

#Область ОбработчикиСобытий

// Создает настройки реестра пакетов.
//
// Параметры:
//   НастройкиПриложения   - НастройкиПриложения - Настройки приложения.
//   ПровайдерНастроекOpm - ПровайдерНастроекOpm - Источник настроек OPM.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиПриложения") НастройкиПриложения,
	&Пластилин("ПровайдерНастроекOpm") ПровайдерНастроекOpm
)

	_НастройкиПриложения = НастройкиПриложения;
	_ПровайдерНастроекOpm = ПровайдерНастроекOpm;

	_НастройкиПрименены = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Разрешает настройки реестра с учётом значений CLI и opm.cfg.
//
// Параметры:
//   ОсновнойРеестр - Строка, Неопределено - Адрес или имя сервера из опции --registry.
//   Прокси         - Строка, Неопределено - Значение опции --registry-proxy.
//
// Возвращаемое значение:
//   НастройкиРеестраПакетов - Этот объект.
//
// Исключения:
//   - registry.settings_invalid - Если адрес некорректен или сервер с указанным именем не найден.
Функция Применить(ОсновнойРеестр = Неопределено, Прокси = Неопределено) Экспорт

	_НастройкиПрименены = Ложь;
	_Серверы = Новый Массив;

	РеестрУказанЯвно = ЗначениеЗаполнено(ОсновнойРеестр);
	НастройкиOpm = _ПровайдерНастроекOpm.ПолучитьНастройки(Не РеестрУказанЯвно);

	_Прокси = РазрешитьПрокси(Прокси, НастройкиOpm.Прокси);
	_Серверы = РазрешитьСерверы(ОсновнойРеестр, НастройкиOpm.Серверы);

	_НастройкиПрименены = Истина;

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает независимые настройки серверов пакетов в порядке обращения.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Реестр    - URL - Адрес реестра пакетов.
//     * Пул       - Строка - Имя пула пакетов или пустая строка.
//     * Заголовки - Соответствие - HTTP-заголовки запросов к серверу.
Функция Серверы() Экспорт

	ПрименитьНастройкиПриНеобходимости();

	Результат = Новый Массив;

	Для Каждого Сервер Из _Серверы Цикл
		Результат.Добавить(КопияНастройкиСервера(Сервер));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает имя пула OpenHub по умолчанию.
//
// Возвращаемое значение:
//   Строка - Имя пула.
Функция ПулПоУмолчанию() Экспорт

	Пул = СокрЛП(Строка(_НастройкиПриложения.ПулПоУмолчанию));

	Возврат ?(ЗначениеЗаполнено(Пул), Пул, "default");

КонецФункции

// Возвращает независимый адрес реестра пакетов.
//
// Возвращаемое значение:
//   URL, Неопределено - Адрес реестра или Неопределено.
Функция Реестр() Экспорт

	ПрименитьНастройкиПриНеобходимости();

	Если _Серверы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _Серверы[0].Реестр.Скопировать();

КонецФункции

// Возвращает независимый адрес proxy.
//
// Возвращаемое значение:
//   URL - Адрес proxy из командной строки.
//   Структура - Настройки proxy из opm.cfg:
//     * ИспользоватьСистемный        - Булево - Использовать системные настройки proxy.
//     * Сервер                       - Строка - Адрес сервера proxy.
//     * Порт                         - Число - Порт сервера proxy.
//     * Пользователь                 - Строка - Имя пользователя.
//     * Пароль                       - Строка - Пароль пользователя.
//     * ИспользоватьАутентификациюОС - Булево - Использовать аутентификацию операционной системы.
//   Неопределено - Настройки proxy отсутствуют.
Функция Прокси() Экспорт

	ПрименитьНастройкиПриНеобходимости();

	Если _Прокси = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(_Прокси) = Тип("URL") Тогда
		Возврат _Прокси.Скопировать();
	КонецЕсли;

	Возврат КопияНастроекПрокси(_Прокси);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьНастройкиПриНеобходимости()

	Если Не _НастройкиПрименены Тогда
		Применить();
	КонецЕсли;

КонецПроцедуры

Функция РазрешитьСерверы(УказанныйРеестр, СерверыOpm)

	Результат = Новый Массив;

	Если ЗначениеЗаполнено(УказанныйРеестр) Тогда
		Результат.Добавить(НастройкаУказанногоСервера(УказанныйРеестр, СерверыOpm));
		Возврат Результат;
	КонецЕсли;

	Для Каждого СерверOpm Из СерверыOpm Цикл
		Результат.Добавить(НастройкаСервераИзOpm(СерверOpm));
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Для Каждого АдресРеестра Из _НастройкиПриложения.РеестрыПоУмолчанию() Цикл
			Реестр = ПодготовитьРеестр(АдресРеестра);
			Если Реестр <> Неопределено Тогда
				Результат.Добавить(НоваяНастройкаСервера(Реестр, "", Новый Соответствие));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция НастройкаУказанногоСервера(Значение, СерверыOpm)

	Значение = СокрЛП(Строка(Значение));
	Если СтрНайти(Значение, "://") > 0 Тогда
		Возврат НастройкаСервераПоАдресу(Значение, СерверыOpm);
	КонецЕсли;

	СерверOpm = НайтиИменованныйСервер(Значение, СерверыOpm);
	Если СерверOpm <> Неопределено Тогда
		Возврат НастройкаСервераИзOpm(СерверOpm);
	КонецЕсли;

	Если ЭтоАдресБезСхемы(Значение) Тогда
		Возврат НастройкаСервераПоАдресу(Значение, СерверыOpm);
	КонецЕсли;

	ВызватьИсключение ОшибкаИменованногоСервера(Значение);

КонецФункции

Функция НайтиИменованныйСервер(ИмяСервера, СерверыOpm)

	Для Каждого СерверOpm Из СерверыOpm Цикл
		Если СерверOpm.Имя = ИмяСервера Тогда
			Возврат СерверOpm;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ЭтоАдресБезСхемы(Значение)

	Возврат СтрНайти(Значение, ".") > 0
		Или СтрНайти(Значение, "/") > 0
		Или СтрНайти(Значение, ":") > 0
		Или НРег(Значение) = "localhost";

КонецФункции

Функция НастройкаСервераПоАдресу(АдресСтрокой, СерверыOpm)

	Реестр = ПодготовитьРеестр(АдресСтрокой);
	Попытка
		Пул = ПулИзАдреса(Реестр);
	Исключение
		ВызватьИсключение ОшибкаНастройки("registry", ИнформацияОбОшибке());
	КонецПопытки;

	Заголовки = ЗаголовкиДляУказанногоСервера(Реестр, Пул, СерверыOpm);

	Возврат НоваяНастройкаСервера(Реестр, Пул, Заголовки);

КонецФункции

Функция ПодготовитьРеестр(Адрес)

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНастройки = "registry";
	Причина = Неопределено;
	АдресURL = АдресаСерверовПакетов.Разобрать(Адрес, 0, Причина);
	Если АдресURL = Неопределено Тогда
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки, Причина);
	КонецЕсли;

	Возврат АдресURL;

КонецФункции

Функция ПулИзАдреса(Адрес)

	КодированныеСегменты = Адрес.КодированныеСегментыПути();
	ИндексПула = -1;

	Для Индекс = 0 По КодированныеСегменты.ВГраница() Цикл
		Если ПустаяСтрока(КодированныеСегменты[Индекс]) Тогда
			Продолжить;
		КонецЕсли;

		Если ИндексПула >= 0 Тогда
			Возврат "";
		КонецЕсли;

		ИндексПула = Индекс;
	КонецЦикла;

	Если ИндексПула < 0
		Или СтрНайти(НРег(КодированныеСегменты[ИндексПула]), "%2f") > 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Адрес.СегментыПути()[ИндексПула];

КонецФункции

Функция ЗаголовкиДляУказанногоСервера(Реестр, Пул, СерверыOpm)

	ТочныйСервер = Неопределено;
	ЗапаснаяАвторизация = "";

	Для Каждого СерверOpm Из СерверыOpm Цикл
		Если Не ОдинаковоеПроисхождение(СерверOpm.Адрес, Реестр) Тогда
			Продолжить;
		КонецЕсли;

		ТочныйПул = НРег(СерверOpm.Пул) = НРег(Пул);
		Авторизация = СерверOpm.Заголовки.Получить("Authorization");

		Если ТочныйПул И (ТочныйСервер = Неопределено Или ЗначениеЗаполнено(Авторизация)) Тогда
			ТочныйСервер = СерверOpm;
		КонецЕсли;

		Если Не ТочныйПул И ПустаяСтрока(ЗапаснаяАвторизация) И ЗначениеЗаполнено(Авторизация) Тогда
			ЗапаснаяАвторизация = Авторизация;
		КонецЕсли;
	КонецЦикла;

	Заголовки = ?(ТочныйСервер = Неопределено, Новый Соответствие, КопияЗаголовков(ТочныйСервер.Заголовки));
	Если Не ЗначениеЗаполнено(Заголовки.Получить("Authorization"))
		И ЗначениеЗаполнено(ЗапаснаяАвторизация) Тогда
		Заголовки.Вставить("Authorization", ЗапаснаяАвторизация);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

Функция ОдинаковоеПроисхождение(ПервыйАдрес, ВторойАдрес)

	Возврат ПервыйАдрес.Корневой().ЭквивалентенДляСхемы(ВторойАдрес.Корневой());

КонецФункции

Функция НастройкаСервераИзOpm(СерверOpm)

	Возврат НоваяНастройкаСервера(СерверOpm.Адрес.Скопировать(), СерверOpm.Пул, СерверOpm.Заголовки);

КонецФункции

Функция НоваяНастройкаСервера(Реестр, Пул, Заголовки)

	Возврат Новый Структура("Реестр,Пул,Заголовки", Реестр, Пул, Заголовки);

КонецФункции

Функция КопияНастройкиСервера(Сервер)

	Возврат НоваяНастройкаСервера(Сервер.Реестр.Скопировать(), Сервер.Пул, КопияЗаголовков(Сервер.Заголовки));

КонецФункции

Функция КопияЗаголовков(ИсходныеЗаголовки)

	Заголовки = Новый Соответствие;
	Для Каждого Заголовок Из ИсходныеЗаголовки Цикл
		Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;

	Возврат Заголовки;

КонецФункции

Функция РазрешитьПрокси(УказанныйПрокси, ПроксиOpm)

	Если ЗначениеЗаполнено(УказанныйПрокси) Тогда
		Возврат ПодготовитьПрокси(УказанныйПрокси);
	КонецЕсли;

	Возврат ПроксиOpm;

КонецФункции

Функция КопияНастроекПрокси(Прокси)

	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьСистемный", Прокси.ИспользоватьСистемный);
	Результат.Вставить("Сервер", Прокси.Сервер);
	Результат.Вставить("Порт", Прокси.Порт);
	Результат.Вставить("Пользователь", Прокси.Пользователь);
	Результат.Вставить("Пароль", Прокси.Пароль);
	Результат.Вставить("ИспользоватьАутентификациюОС", Прокси.ИспользоватьАутентификациюОС);

	Возврат Результат;

КонецФункции

Функция ПодготовитьПрокси(Адрес)

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНастройки = "registry-proxy";
	Адрес = СокрЛП(Строка(Адрес));

	Причина = Неопределено;
	АдресURL = РазборURL.ПопытатьсяРазобрать(Адрес, Причина);
	Если АдресURL = Неопределено Тогда
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки, Причина);
	КонецЕсли;

	Если Не АдресURL.СоответствуетСхеме() Или НРег(АдресURL.Схема()) <> "http" Тогда
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки);
	КонецЕсли;

	Возврат АдресURL;

КонецФункции

Функция ОшибкаНастройки(ИмяНастройки, Причина = Неопределено)

	КодОшибки = КодыОшибокDepos.НастройкаРеестраНекорректна();
	СообщениеОшибки = СтрШаблон("Некорректное значение настройки '%1'", ИмяНастройки);

	Возврат ФабрикаОшибок.Создать(КодОшибки, СообщениеОшибки, Неопределено, Причина);

КонецФункции

Функция ОшибкаИменованногоСервера(ИмяСервера)

	КодОшибки = КодыОшибокDepos.НастройкаРеестраНекорректна();
	СообщениеОшибки = СтрШаблон("Сервер пакетов '%1' не найден в opm.cfg", ИмяСервера);

	Возврат ФабрикаОшибок.Создать(КодОшибки, СообщениеОшибки);

КонецФункции

#КонецОбласти
