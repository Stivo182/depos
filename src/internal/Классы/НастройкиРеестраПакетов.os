#Использовать errors
#Использовать url

#Область ОписаниеПеременных

Перем _НастройкиПриложения; // НастройкиПриложения
Перем _Реестр; // URL, Неопределено
Перем _Прокси; // URL, Неопределено
Перем _НастройкиПрименены; // Булево

#КонецОбласти

#Область ОбработчикиСобытий

// Создает настройки реестра из настроек приложения.
//
// Параметры:
//   НастройкиПриложения - НастройкиПриложения - Настройки приложения.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиПриложения") НастройкиПриложения
)

	_НастройкиПриложения = НастройкиПриложения;
	_НастройкиПрименены = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Разрешает настройки реестра с учётом значений CLI и деталек Autumn.
//
// Параметры:
//   ОсновнойРеестр - Строка, Неопределено - Значение опции --registry.
//   Прокси         - Строка, Неопределено - Значение опции --registry-proxy.
//
// Возвращаемое значение:
//   НастройкиРеестраПакетов - Этот объект.
//
// Исключения:
//   - registry.settings_invalid - Если адрес некорректен.
Функция Применить(
	ОсновнойРеестр = Неопределено,
	Прокси = Неопределено
) Экспорт

	_НастройкиПрименены = Ложь;

	ОсновнойРеестр = ЗначениеНастройки(
		ОсновнойРеестр,
		_НастройкиПриложения.ОсновнойРеестр
	);
	Прокси = ЗначениеНастройки(
		Прокси,
		_НастройкиПриложения.ПроксиРеестра
	);

	_Реестр = ПодготовитьРеестр(ОсновнойРеестр);
	_Прокси = ПодготовитьПрокси(Прокси);

	_НастройкиПрименены = Истина;

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает независимый адрес реестра пакетов.
//
// Возвращаемое значение:
//   URL, Неопределено - Адрес реестра или Неопределено.
Функция Реестр() Экспорт

	ПрименитьНастройкиПриНеобходимости();

	Если _Реестр = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _Реестр.Скопировать();

КонецФункции

// Возвращает независимый адрес proxy.
//
// Возвращаемое значение:
//   URL, Неопределено - Нормализованный адрес proxy или Неопределено.
Функция Прокси() Экспорт

	ПрименитьНастройкиПриНеобходимости();

	Если _Прокси = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат _Прокси.Скопировать();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьНастройкиПриНеобходимости()

	Если Не _НастройкиПрименены Тогда
		Применить();
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеНастройки(ЗначениеКоманднойСтроки, ЗначениеДетальки)

	Если ЗначениеКоманднойСтроки <> Неопределено
		И (ТипЗнч(ЗначениеКоманднойСтроки) <> Тип("Строка") Или ЗначениеЗаполнено(ЗначениеКоманднойСтроки)) Тогда
		Возврат ЗначениеКоманднойСтроки;
	КонецЕсли;

	Возврат ЗначениеДетальки;

КонецФункции

Функция ПодготовитьРеестр(Адрес)

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНастройки = "registry";
	Адрес = СокрЛП(Строка(Адрес));

	Попытка
		АдресURL = Новый URL(Адрес);
	Исключение
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки, ИнформацияОбОшибке());
	КонецПопытки;

	Если Не АдресURL.СоответствуетСхеме()
		Или (НРег(АдресURL.Схема()) <> "http" И НРег(АдресURL.Схема()) <> "https") Тогда
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки);
	КонецЕсли;

	Возврат АдресURL;

КонецФункции

Функция ПодготовитьПрокси(Адрес)

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНастройки = "registry-proxy";
	Адрес = СокрЛП(Строка(Адрес));

	Попытка
		АдресURL = Новый URL(Адрес);
	Исключение
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки, ИнформацияОбОшибке());
	КонецПопытки;

	Если Не АдресURL.СоответствуетСхеме() Или НРег(АдресURL.Схема()) <> "http" Тогда
		ВызватьИсключение ОшибкаНастройки(ИмяНастройки);
	КонецЕсли;

	Возврат АдресURL;

КонецФункции

Функция ОшибкаНастройки(ИмяНастройки, Причина = Неопределено)

	КодОшибки = КодыОшибокDepos.НастройкаРеестраНекорректна();
	СообщениеОшибки = СтрШаблон("Некорректное значение настройки '%1'", ИмяНастройки);

	Если Причина <> Неопределено Тогда
		Возврат ФабрикаОшибок.Обернуть(Причина, КодОшибки, СообщениеОшибки);
	КонецЕсли;

	Возврат ФабрикаОшибок.Создать(КодОшибки, СообщениеОшибки);

КонецФункции

#КонецОбласти
