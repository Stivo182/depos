#Область ОписаниеПеременных

Перем _ШиринаОтступа; // Число
Перем _ОтступЭлемента; // Строка
Перем _ОтступДеталей; // Строка
Перем _ОтступТребования; // Строка
Перем _ШиринаПодписиПоля; // Число

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()

	_ШиринаОтступа = 1;
	_ОтступЭлемента = ЛевыйОтступ(2);
	_ОтступДеталей = ЛевыйОтступ(7);
	_ОтступТребования = ЛевыйОтступ(9);
	_ШиринаПодписиПоля = СтрДлина("Рекомендация:");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует текстовый отчет диагностики с разметкой цветового вывода.
//
// Параметры:
//   Отчет - ОтчетДиагностики - Подготовленный отчет.
//   Подробно - Булево - Выводить все доступные детали.
//   Профиль - Структура, Неопределено - Профиль символов. По умолчанию используется Unicode.
//
// Возвращаемое значение:
//   Строка
Функция Сформировать(Отчет, Подробно = Ложь, Профиль = Неопределено) Экспорт

	Строки = Новый Массив();
	Строки.Добавить("");
	Профиль = ПолучитьПрофиль(Профиль);

	ДобавитьСводку(Строки, Отчет, Профиль);
	ДобавитьСекции(Строки, Отчет, Подробно, Профиль);
	ДобавитьЗавершениеОтчета(Строки, Отчет, Подробно);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПрофиль(Профиль)

	Если Профиль = Неопределено Тогда
		Возврат Новый ОпределительВозможностейТерминала().ОпределитьДляКодировки(КодировкаТекста.UTF8);
	КонецЕсли;

	Возврат Профиль;

КонецФункции

Процедура ДобавитьСводку(Строки, Отчет, Профиль)

	Если Отчет.ЕстьПроблемы() Тогда
		Строки.Добавить(СтрШаблон("%1 %2 %3     %4 %5 %6",
			ОформитьЦветом(Профиль.Ошибка, "Красный"),
			ОформитьЦветом(Отчет.КоличествоПроблем, "Красный"),
			ОформитьЦветом(ФормаСлова(Отчет.КоличествоПроблем, "проблема", "проблемы", "проблем"), "Красный"),
			ОформитьЦветом(Профиль.Рекомендация, "Синий"),
			ОформитьЦветом(Отчет.КоличествоРекомендаций, "Синий"),
			ОформитьЦветом(
				ФормаСлова(Отчет.КоличествоРекомендаций, "рекомендация", "рекомендации", "рекомендаций"),
				"Синий"
			)));
		Возврат;
	КонецЕсли;

	Строки.Добавить(ОформитьЦветом(Профиль.Успех, "Зеленый") + " Проблем не найдено.");
	Если Отчет.КоличествоРекомендаций > 0 Тогда
		Строки.Добавить(СтрШаблон("%1 %2 %3",
			ОформитьЦветом(Профиль.Рекомендация, "Синий"),
			ОформитьЦветом(Отчет.КоличествоРекомендаций, "Синий"),
			ОформитьЦветом(
				ФормаСлова(Отчет.КоличествоРекомендаций, "рекомендация", "рекомендации", "рекомендаций"),
				"Синий"
			)));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСекции(Строки, Отчет, Подробно, Профиль)

	Для Каждого Секция Из Отчет.Секции Цикл
		Строки.Добавить("");
		Строки.Добавить(РазделительСекции(Профиль));
		Строки.Добавить(СтрШаблон("%1  %2", Секция.Номер, Секция.Заголовок));
		
		Если ЗначениеЗаполнено(Секция.Описание) Тогда
			Строки.Добавить(ЛевыйОтступ(4) + ОформитьЦветом(Секция.Описание, "ТемноСерый"));
		КонецЕсли;

		Строки.Добавить("");
		ДобавитьЭлементыСекции(Строки, Секция, Подробно, Профиль);
	КонецЦикла;

	Если Отчет.Секции.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить(РазделительСекции(Профиль));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЭлементыСекции(Строки, Секция, Подробно, Профиль)

	КоличествоЭлементов = Секция.Элементы.Количество();
	РазделятьЭлементы = Секция.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()
		Или Секция.Тип = ТипыДиагностикиЗависимостей.НесоответствиеВерсий()
		Или Секция.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт()
		Или Секция.Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии();

	Для Индекс = 0 По КоличествоЭлементов - 1 Цикл
		ДобавитьЭлемент(Строки, Секция.Элементы[Индекс], Подробно, Профиль);
		Если РазделятьЭлементы И Индекс < КоличествоЭлементов - 1 Тогда
			Строки.Добавить("");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗавершениеОтчета(Строки, Отчет, Подробно)

	Если Отчет.ЕстьПроблемы() Тогда
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон("Найдено проблем: %1", ОформитьЦветом(Отчет.КоличествоПроблем, "Красный")));
	КонецЕсли;

	Если НЕ Подробно И (Отчет.ЕстьПроблемы() Или Отчет.КоличествоРекомендаций > 0) Тогда
		Строки.Добавить("Подробнее: добавьте " + ОформитьЦветом("--verbose", "Желтый") + " к текущей команде");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЭлемент(Строки, Элемент, Подробно, Профиль)

	КонтекстРазработки = ?(Элемент.ДляРазработки, " " + ОформитьЦветом("(dev)", "Желтый"), "");
	Строки.Добавить(СтрШаблон(
		"%1%2 %3%4",
		_ОтступЭлемента, Маркер(Элемент, Профиль),
		ОформитьЦветом(Элемент.ИмяПакета, "Белый"),
		КонтекстРазработки
	));

	Если (Подробно Или Элемент.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт())
		И ЗначениеЗаполнено(Элемент.КраткоеОписание) Тогда
		Строки.Добавить(_ОтступДеталей + ОформитьЦветом(Элемент.КраткоеОписание, "ТемноСерый"));
	КонецЕсли;

	Если Подробно И ЗначениеЗаполнено(Элемент.ПодробнаяПричина) Тогда
		Строки.Добавить(_ОтступДеталей + Элемент.ПодробнаяПричина);
	КонецЕсли;

	ДобавитьВерсииЭлемента(Строки, Элемент, Подробно, Профиль);

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии() Тогда
		ДобавитьРекомендацию(Строки, Элемент, Подробно, Профиль);
		Возврат;
	КонецЕсли;

	ДобавитьФайлыИКаталог(Строки, Элемент, Подробно, Профиль);

	Если Подробно Или Элемент.Тип = ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт() Тогда
		ДобавитьТребования(Строки, Элемент.Требования, Профиль, ?(Подробно, "Требования:", ""));
	Иначе
		ДобавитьКраткиеИсточники(Строки, Элемент.Требования);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьФайлыИКаталог(Строки, Элемент, Подробно, Профиль)

	Если Элемент.Файлы.Количество() > 0 Тогда
		ДобавитьФайлы(Строки,
			Элемент.Файлы,
			Подробно,
			Профиль,
			Элемент.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()
		);
	КонецЕсли;

	Если ЗначениеЗаполнено(Элемент.Каталог) Тогда
		Если Подробно Тогда
			ДобавитьПоле(Строки, "Каталог:", ОформитьЦветом(Элемент.Каталог, "Серый"));
		Иначе
			Строки.Добавить(_ОтступДеталей + ОформитьЦветом(Элемент.Каталог, "Серый"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьВерсииЭлемента(Строки, Элемент, Подробно, Профиль)

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте()
		Или НЕ (ЗначениеЗаполнено(Элемент.УстановленнаяВерсия)
			Или ЗначениеЗаполнено(Элемент.ТребуемаяВерсия)) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Подробно Тогда
		Если НЕ ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
			УстановленнаяВерсия = "Не установлена";
		ИначеЕсли НЕ ЗначениеЗаполнено(Элемент.ТребуемаяВерсия) Тогда
			Строки.Добавить(_ОтступДеталей + "Установлена: " + ОформитьЦветом(Элемент.УстановленнаяВерсия, "Красный"));
			Возврат;
		Иначе
			УстановленнаяВерсия = Элемент.УстановленнаяВерсия;
		КонецЕсли;

		Строки.Добавить(СтрШаблон(
			"%1%2 %3 %4",
			_ОтступДеталей,
			ОформитьЦветом(УстановленнаяВерсия, "Красный"),
			Профиль.Стрелка,
			ОформитьЦветом(Элемент.ТребуемаяВерсия, "Зеленый")
		));
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Элемент.УстановленнаяВерсия) Тогда
		ДобавитьПоле(Строки, "Установлена:", ОформитьЦветом(Элемент.УстановленнаяВерсия, "Красный"));
	КонецЕсли;

	Если ЗначениеЗаполнено(Элемент.ТребуемаяВерсия) Тогда
		ДобавитьПоле(Строки, "Требуется:", ОформитьЦветом(Элемент.ТребуемаяВерсия, "Зеленый"));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьФайлы(Строки, Файлы, Подробно, Профиль, ВыводитьВетви)

	Если Подробно Тогда
		КоличествоФайлов = Файлы.Количество();
		Для Индекс = 0 По КоличествоФайлов - 1 Цикл
			Ветвь = "";
			Если ВыводитьВетви Тогда
				Ветвь = ?(Индекс = КоличествоФайлов - 1, Профиль.ПоследняяВетка, Профиль.Ветка) + " ";
			КонецЕсли;
			Строки.Добавить(_ОтступДеталей + Ветвь + ОформитьЦветом(Файлы[Индекс], "Серый"));
		КонецЦикла;
		Возврат;
	КонецЕсли;

	КоличествоСкрытых = Файлы.Количество() - 1;
	Дополнение = ?(КоличествоСкрытых > 0,
		ОформитьЦветом(
			СтрШаблон(
				" (+%1 %2)",
				КоличествоСкрытых,
				ФормаСлова(КоличествоСкрытых, "файл", "файла", "файлов")
			),
			"ТемноСерый"
		),
		""
	);

	Строки.Добавить(_ОтступДеталей + ОформитьЦветом(Файлы[0], "Серый") + Дополнение);

КонецПроцедуры

Процедура ДобавитьКраткиеИсточники(Строки, Требования)

	Источники = Новый Массив();
	Для Каждого Требование Из Требования Цикл
		Источник = ?(ЗначениеЗаполнено(Требование.ИсточникТребования),
			Требование.ИсточникТребования,
			Требование.КорневаяПрямаяЗависимость
		);

		Если ЗначениеЗаполнено(Источник) И Источники.Найти(Источник) = Неопределено Тогда
			Источники.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;

	Если Источники.Количество() > 0 Тогда
		Строки.Добавить(_ОтступДеталей + СтрСоединить(Источники, ", "));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьТребования(Строки, Требования, Профиль, Заголовок = "Требования:")

	Если Требования.Количество() > 0 И ЗначениеЗаполнено(Заголовок) Тогда
		Строки.Добавить(_ОтступДеталей + Заголовок);
	КонецЕсли;

	Для Индекс = 0 По Требования.ВГраница() Цикл
		Требование = Требования[Индекс];
		Последнее = Индекс = Требования.ВГраница();
		Ветка = ?(Последнее, Профиль.ПоследняяВетка, Профиль.Ветка);
	
		Если Требование.ЦепочкаЗависимостей.Количество() > 0 Тогда
			Цепочка = СтрСоединить(Требование.ЦепочкаЗависимостей, " -> ");
		Иначе
			Цепочка = ?(ЗначениеЗаполнено(Требование.ИсточникТребования),
				Требование.ИсточникТребования,
				Требование.КорневаяПрямаяЗависимость
			);
		КонецЕсли;

		СтрокаТребования = _ОтступТребования + Ветка + " " + ОформитьЦветом(Цепочка, "Серый");
		Если ЗначениеЗаполнено(Требование.ТребуемаяВерсия) Тогда
			СтрокаТребования = СтрокаТребования + ОформитьЦветом(" (" + Требование.ТребуемаяВерсия + ")", "Бирюза");
		КонецЕсли;

		Строки.Добавить(СтрокаТребования);
	КонецЦикла;

КонецПроцедуры

Функция ОтобратьТребованияСВерсией(Требования)

	Результат = Новый Массив();
	Для Каждого Требование Из Требования Цикл
		Если ЗначениеЗаполнено(Требование.ТребуемаяВерсия) Тогда
			Результат.Добавить(Требование);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьРекомендацию(Строки, Элемент, Подробно, Профиль)

	Если Подробно Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущаяМинимальнаяВерсия) Тогда
			ДобавитьПоле(Строки, "Объявлено:", ОформитьЦветом(">=" + Элемент.ТекущаяМинимальнаяВерсия, "Бирюза"));
			ДобавитьПоле(Строки, "Рекомендация:", ОформитьЦветом("не указывать", "Зеленый"));
		КонецЕсли;

		Если ЗначениеЗаполнено(Элемент.ТранзитивнаяМинимальнаяВерсия) Тогда
			ДобавитьПоле(Строки, "Транзитивно:",
				ОформитьЦветом(">=" + Элемент.ТранзитивнаяМинимальнаяВерсия, "Бирюза"));
		КонецЕсли;
	Иначе
		Строки.Добавить(СтрШаблон(
			"%1%2 %3 %4",
			_ОтступДеталей,
			ОформитьЦветом(">=" + Элемент.ТекущаяМинимальнаяВерсия, "Бирюза"),
			Профиль.Стрелка,
			ОформитьЦветом("не указывать", "Бирюза")
		));
	КонецЕсли;

	ДобавитьФайлыИКаталог(Строки, Элемент, Подробно, Профиль);
	ДобавитьТребования(Строки,
		ОтобратьТребованияСВерсией(Элемент.Требования),
		Профиль,
		?(Подробно, "Цепочки:", "")
	);

КонецПроцедуры

Функция Маркер(Элемент, Профиль)

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии() Тогда
		Возврат ОформитьЦветом(Профиль.Рекомендация, "Синий");
	КонецЕсли;

	Если Элемент.Тип = ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую() Тогда
		Возврат ОформитьЦветом(Профиль.Предупреждение, "Желтый");
	КонецЕсли;

	Возврат ОформитьЦветом(Профиль.Ошибка, "Красный");

КонецФункции

Функция ОформитьЦветом(Текст, Цвет)

	Возврат ПомощникКонсольногоВывода.ПокраситьТекст(Текст, Цвет);

КонецФункции

Процедура ДобавитьПоле(Строки, Подпись, Значение)

	Заполнитель = ПомощникКонсольногоВывода.ФиксированнаяСтрока(
		"",
		_ШиринаПодписиПоля - СтрДлина(Подпись)
	);
	Строки.Добавить(_ОтступДеталей + Подпись + Заполнитель + " " + Значение);

КонецПроцедуры

Функция ЛевыйОтступ(Уровень)

	Возврат ПомощникКонсольногоВывода.ФиксированнаяСтрока("", Уровень * _ШиринаОтступа);

КонецФункции

Функция РазделительСекции(Профиль)

	Возврат СтрЗаменить("                                                            ", " ", Профиль.Горизонталь);

КонецФункции

Функция ФормаСлова(Количество, Форма1, Форма2, Форма5)

	ПоследниеДвеЦифры = Количество % 100;
	Если ПоследниеДвеЦифры >= 11 И ПоследниеДвеЦифры <= 14 Тогда
		Возврат Форма5;
	КонецЕсли;

	ПоследняяЦифра = Количество % 10;
	Если ПоследняяЦифра = 1 Тогда
		Возврат Форма1;
	ИначеЕсли ПоследняяЦифра >= 2 И ПоследняяЦифра <= 4 Тогда
		Возврат Форма2;
	КонецЕсли;

	Возврат Форма5;

КонецФункции

#КонецОбласти
