#Использовать errors

#Область ОписаниеПеременных

Перем _НастройкиРеестраПакетов; // НастройкиРеестраПакетов
Перем _ОпределительАдаптера; // ОпределительАдаптераРеестра
Перем _Лог; // Лог

#КонецОбласти

#Область ОбработчикиСобытий

// Создает клиент реестра пакетов.
//
// Параметры:
//   НастройкиРеестраПакетов - НастройкиРеестраПакетов - Настройки адресов и подключения к реестру.
//   ОпределительАдаптера    - ОпределительАдаптераРеестра - Определитель API реестра.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиРеестраПакетов") НастройкиРеестраПакетов,
	&Пластилин("ОпределительАдаптераРеестра") ОпределительАдаптера
)

	_НастройкиРеестраПакетов = НастройкиРеестраПакетов;
	_ОпределительАдаптера = ОпределительАдаптера;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает версии пакета из реестра.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Массив из Строка - Корректные semver-версии или пустой массив, если пакет не найден.
//
// Исключения:
//   - registry.hosts_not_configured - Если не настроен реестр.
//   - registry.unavailable - Если реестр не вернул корректные версии.
Функция ПолучитьВерсии(ИмяПакета) Экспорт

	Серверы = _НастройкиРеестраПакетов.Серверы();
	Прокси = _НастройкиРеестраПакетов.Прокси();

	ПроверитьНаличиеСерверов(Серверы);

	ПоследняяОшибка = Неопределено;
	АдресаРеестров = Новый Массив;

	Для Каждого Сервер Из Серверы Цикл
		ПредставлениеРеестра = АдресаСерверовПакетов.ПредставлениеДляДиагностики(Сервер.Реестр);
		АдресаРеестров.Добавить(ПредставлениеРеестра);

		_Лог.Отладка("Получение версий пакета '%1' из реестра: %2", ИмяПакета, ПредставлениеРеестра);

		Попытка
			ДоступныеВерсии = ПолучитьВерсииССервера(ИмяПакета, Сервер, Прокси);
		Исключение
			ПоследняяОшибка = ИнформацияОбОшибке();
			Если Не ДиагностикаОшибок.СодержитГруппу(ПоследняяОшибка, "registry") Тогда
				ВызватьИсключение;
			КонецЕсли;
			Продолжить;
		КонецПопытки;

		Если ДоступныеВерсии.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		_Лог.Отладка(
			"Успешно получено %1 версий пакета '%2' из реестра: %3",
			ДоступныеВерсии.Количество(),
			ИмяПакета,
			ПредставлениеРеестра
		);

		Возврат ДоступныеВерсии;
	КонецЦикла;

	Если ПоследняяОшибка <> Неопределено Тогда
		ВызватьИсключение ПоследняяОшибка;
	КонецЕсли;

	_Лог.Предупреждение(
		"Пакет '%1' не найден в реестрах %2, пакет пропущен",
		ИмяПакета,
		СтрСоединить(АдресаРеестров, ", ")
	);

	Возврат Новый Массив;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьВерсииССервера(ИмяПакета, Сервер, Прокси)

	Если ПулПолученИзАдреса(Сервер) Тогда
		Возврат ПолучитьВерсииПриНеоднозначномПути(ИмяПакета, Сервер, Прокси);
	КонецЕсли;

	РеестрДляОпределения = РеестрДляОпределенияАдаптера(Сервер);
	Адаптер = _ОпределительАдаптера.Получить(
		ИмяПакета,
		РеестрДляОпределения,
		Прокси,
		Сервер.Заголовки
	);

	Возврат ПолучитьВерсииАдаптером(Адаптер, ИмяПакета, Сервер, Прокси, Сервер.Пул);

КонецФункции

Функция ПолучитьВерсииПриНеоднозначномПути(ИмяПакета, Сервер, Прокси)

	ИсходноеОпределение = ПопытатьсяОпределитьАдаптер(
		ИмяПакета,
		Сервер.Реестр,
		Прокси,
		Сервер.Заголовки
	);

	Если ЭтоАдаптерOpenHub(ИсходноеОпределение.Адаптер) Тогда
		Возврат ПолучитьВерсииАдаптером(ИсходноеОпределение.Адаптер, ИмяПакета, Сервер, Прокси, "");
	КонецЕсли;

	КорневойРеестр = РеестрДляОпределенияАдаптера(Сервер);
	КорневоеОпределение = ПопытатьсяОпределитьАдаптер(
		ИмяПакета,
		КорневойРеестр,
		Прокси,
		Сервер.Заголовки
	);

	Если ЭтоАдаптерOpenHub(КорневоеОпределение.Адаптер) Тогда
		Возврат ПолучитьВерсииАдаптером(КорневоеОпределение.Адаптер, ИмяПакета, Сервер, Прокси, Сервер.Пул);
	КонецЕсли;

	Если ИсходноеОпределение.Адаптер = Неопределено Тогда
		ВызватьИсключение ИсходноеОпределение.Ошибка;
	КонецЕсли;

	Возврат ПолучитьВерсииАдаптером(ИсходноеОпределение.Адаптер, ИмяПакета, Сервер, Прокси, "");

КонецФункции

Функция ПопытатьсяОпределитьАдаптер(ИмяПакета, Реестр, Прокси, Заголовки)

	Результат = Новый Структура("Адаптер,Ошибка");

	Попытка
		Результат.Адаптер = _ОпределительАдаптера.Получить(ИмяПакета, Реестр, Прокси, Заголовки);
	Исключение
		Результат.Ошибка = ИнформацияОбОшибке();
		Если Не ДиагностикаОшибок.СодержитГруппу(Результат.Ошибка, "registry") Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ПолучитьВерсииАдаптером(Адаптер, ИмяПакета, Сервер, Прокси, Пул)

	Возврат Адаптер.ПолучитьВерсии(
		ИмяПакета,
		Сервер.Реестр,
		Прокси,
		Пул,
		Сервер.Заголовки
	);

КонецФункции

Функция ПулПолученИзАдреса(Сервер)

	Если Не ЗначениеЗаполнено(Сервер.Пул) Тогда
		Возврат Ложь;
	КонецЕсли;

	КоличествоСегментов = 0;
	СегментПути = "";
	Для Каждого Сегмент Из Сервер.Реестр.СегментыПути() Цикл
		Если ПустаяСтрока(Сегмент) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоСегментов = КоличествоСегментов + 1;
		СегментПути = Сегмент;
	КонецЦикла;

	Возврат КоличествоСегментов = 1 И НРег(СегментПути) = НРег(Сервер.Пул);

КонецФункции

Функция ЭтоАдаптерOpenHub(Адаптер)

	Возврат Адаптер <> Неопределено И ТипЗнч(Адаптер) = Тип("АдаптерOpenHub");

КонецФункции

Функция РеестрДляОпределенияАдаптера(Сервер)

	Если ЗначениеЗаполнено(Сервер.Пул) Тогда
		Возврат АдресаСерверовПакетов.КорневойСДаннымиПользователя(Сервер.Реестр);
	КонецЕсли;

	Возврат Сервер.Реестр.Скопировать();

КонецФункции

Процедура ПроверитьНаличиеСерверов(Серверы)

	Если Серверы.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Ошибка = Новый ПостроительОшибки(
		КодыОшибокDepos.ХостыРеестраНеНастроены(),
		"Не настроен адрес реестра пакетов"
	)
		.Подсказка("Укажите адрес реестра через --registry или настройте серверы пакетов в opm.cfg.")
		.Построить();

	ВызватьИсключение Ошибка;

КонецПроцедуры

#КонецОбласти
