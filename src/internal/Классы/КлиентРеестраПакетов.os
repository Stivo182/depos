#Использовать errors

#Область ОписаниеПеременных

Перем _НастройкиРеестраПакетов; // НастройкиРеестраПакетов
Перем _ПарсерСтраницыПакета; // ПарсерСтраницыПакета
Перем _Транспорт; // ТранспортРеестраПакетов
Перем _Лог; // Лог

#КонецОбласти

#Область ОбработчикиСобытий

// Создает клиент реестра пакетов.
//
// Параметры:
//   НастройкиРеестраПакетов - НастройкиРеестраПакетов - Настройки адресов и подключения к реестру.
//   ПарсерСтраницыПакета    - ПарсерСтраницыПакета - Парсер версий со страницы пакета.
//   Транспорт               - ТранспортРеестраПакетов - HTTP-транспорт.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиРеестраПакетов") НастройкиРеестраПакетов,
	&Пластилин("ПарсерСтраницыПакета") ПарсерСтраницыПакета,
	&Пластилин("ТранспортРеестраПакетов") Транспорт
)

	_НастройкиРеестраПакетов = НастройкиРеестраПакетов;
	_ПарсерСтраницыПакета = ПарсерСтраницыПакета;
	_Транспорт = Транспорт;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает версии пакета из реестра.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Массив из Строка - Непустой массив корректных semver-версий пакета.
//
// Исключения:
//   - registry.hosts_not_configured - Если не настроен реестр.
//   - registry.unavailable - Если реестр не вернул корректные версии.
Функция ПолучитьВерсии(ИмяПакета) Экспорт

	Реестр = _НастройкиРеестраПакетов.Реестр();
	Прокси = _НастройкиРеестраПакетов.Прокси();

	ПроверитьНаличиеРеестра(Реестр);

	ПредставлениеРеестра = Реестр.ВСтроку();
	Адрес = АдресСтраницыПакета(ИмяПакета, Реестр);
	_Лог.Отладка("Получение версий пакета '%1' из реестра: %2", ИмяПакета, ПредставлениеРеестра);

	Попытка
		Ответ = _Транспорт.Получить(Адрес, Прокси);
	Исключение
		ВызватьИсключение ОшибкаНедоступностиРеестра(ИмяПакета, ПредставлениеРеестра, "ошибка транспорта");
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		Причина = СтрШаблон("HTTP %1", Ответ.КодСостояния);
		ВызватьИсключение ОшибкаНедоступностиРеестра(ИмяПакета, ПредставлениеРеестра, Причина);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ответ.Тело) Тогда
		ВызватьИсключение ОшибкаНедоступностиРеестра(ИмяПакета, ПредставлениеРеестра, "пустой ответ");
	КонецЕсли;

	ВерсииПакета = _ПарсерСтраницыПакета.ИзвлечьВерсии(Ответ.Тело);
	Если ВерсииПакета.Количество() = 0 Тогда
		Причина = "ответ не содержит корректных версий";
		ВызватьИсключение ОшибкаНедоступностиРеестра(ИмяПакета, ПредставлениеРеестра, Причина);
	КонецЕсли;

	_Лог.Отладка(
		"Успешно получено %1 версий пакета '%2' из реестра: %3",
		ВерсииПакета.Количество(),
		ИмяПакета,
		ПредставлениеРеестра
	);

	Возврат ВерсииПакета;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНаличиеРеестра(Реестр)

	Если Реестр <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ошибка = Новый ПостроительОшибки(
		КодыОшибокDepos.ХостыРеестраНеНастроены(),
		"Не настроен адрес реестра пакетов"
	)
		.Подсказка("Задайте ОсновнойРеестр в настройках depos.")
		.Построить();

	ВызватьИсключение Ошибка;

КонецПроцедуры

Функция АдресСтраницыПакета(ИмяПакета, Хост)

	Адрес = Хост.Скопировать();
	Адрес.ДобавитьСегментПути("package");
	Адрес.ДобавитьСегментПути(ИмяПакета);

	Возврат Адрес;

КонецФункции

Функция ОшибкаНедоступностиРеестра(ИмяПакета, Реестр, Причина)

	Сообщение = СтрШаблон(
		"Не удалось получить версии пакета '%1' из реестра %2: %3",
		ИмяПакета,
		Реестр,
		Причина
	);

	Возврат Новый ПостроительОшибки(КодыОшибокDepos.РеестрНедоступен(), Сообщение)
		.Подсказка("Проверьте подключение к интернету и доступность реестра пакетов.")
		.Построить();

КонецФункции

#КонецОбласти
