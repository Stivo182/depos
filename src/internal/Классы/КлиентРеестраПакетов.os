#Использовать 1connector
#Использовать errors

#Область ОписаниеПеременных

Перем _НастройкиПриложения; // НастройкиПриложения
Перем _ПарсерСтраницыПакета; // ПарсерСтраницыПакета
Перем _Лог; // Лог

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиПриложения") НастройкиПриложения,
	&Пластилин("ПарсерСтраницыПакета") ПарсерСтраницыПакета
)

	_НастройкиПриложения = НастройкиПриложения;
	_ПарсерСтраницыПакета = ПарсерСтраницыПакета;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает версии пакета с автоматическим переключением на резервный хост при недоступности основного
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета
//
// Возвращаемое значение:
//   Массив из Строка - Массив версий пакета
//
// Вызывает исключение:
//   Если не удалось получить версии ни с основного, ни с резервного хоста
Функция ПолучитьВерсии(ИмяПакета) Экспорт
	
	МассивХостов = _НастройкиПриложения.ХостыРепозитория();

	Если МассивХостов.Количество() = 0 Тогда
		Ошибка = Новый ПостроительОшибки(
			КодыОшибокDepos.ХостыРеестраНеНастроены(),
			"Не настроены хосты реестра пакетов"
		)
			.Подсказка("Задайте ХостРепозитория в настройках depos.")
			.Построить();
		ВызватьИсключение Ошибка;
	КонецЕсли;

	Для Каждого Хост Из МассивХостов Цикл
		_Лог.Отладка(
			"Попытка получения версий пакета '%1' с хоста: %2", 
			ИмяПакета,
			Хост
		);

		Попытка
			Ответ = КоннекторHTTP.Get(АдресСтраницыПакета(ИмяПакета, Хост));
		Исключение
			_Лог.Предупреждение(
				"Возникла ошибка при получении версий пакета '%1' с хоста: %2", 
				ИмяПакета,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			Продолжить;
		КонецПопытки;

		Если Ответ.КодСостояния = КодыСостоянияHTTP.ОК_200 Тогда
			ВерсииПакета = _ПарсерСтраницыПакета.ИзвлечьВерсии(Ответ.Текст());
			_Лог.Отладка(
				"Успешно получено %1 версий пакета '%2' с хоста: %3", 
				ВерсииПакета.Количество(),
				ИмяПакета,
				Хост
			);
			Возврат ВерсииПакета;
		Иначе
			_Лог.Отладка(
				"Получен HTTP код %1 при запросе версий пакета '%2' с хоста: %3", 
				Ответ.КодСостояния,
				ИмяПакета,
				Хост
			);
		КонецЕсли;
	КонецЦикла;

	Сообщение = СтрШаблон(
		"Не удалось получить версии пакета '%1' с хостов: %2",
		ИмяПакета, 
		СтрСоединить(МассивХостов, ", ")
	);

	Ошибка = Новый ПостроительОшибки(КодыОшибокDepos.РеестрНедоступен(), Сообщение)
		.Подсказка("Проверьте подключение к интернету и доступность реестра пакетов.")
		.Построить();

	ВызватьИсключение Ошибка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресСтраницыПакета(ИмяПакета, Хост)
	Возврат СтрШаблон("https://%1/package/%2", Хост, ИмяПакета);
КонецФункции

#КонецОбласти
