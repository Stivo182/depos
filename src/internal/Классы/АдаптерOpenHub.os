#Использовать errors
#Использовать native-errors

#Область ОписаниеПеременных

Перем _Транспорт; // ТранспортРеестраПакетов
Перем _КлассификаторОшибок; // КлассификаторОшибок

#КонецОбласти

#Область ОбработчикиСобытий

// Создает адаптер API OpenHub.
//
// Параметры:
//   Транспорт                   - ТранспортРеестраПакетов - HTTP-транспорт.
//   КлассификаторНативныхОшибок - КлассификаторОшибок - Классификатор нативных ошибок.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("ТранспортРеестраПакетов") Транспорт,
	&Пластилин("КлассификаторНативныхОшибок") КлассификаторНативныхОшибок
)

	_Транспорт = Транспорт;
	_КлассификаторОшибок = КлассификаторНативныхОшибок;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает доступные версии пакета из OpenHub.
//
// Параметры:
//   ИмяПакета  - Строка - Имя пакета.
//   Реестр     - URL - Адрес реестра.
//   Прокси     - URL, Структура, Неопределено - Настройки proxy.
//   Пул        - Строка - Явно выбранный пул; пустая строка выбирает пул default.
//   Заголовки  - Соответствие, Неопределено - Заголовки запросов.
//
// Возвращаемое значение:
//   Массив из Строка - Корректные незаблокированные версии или пустой массив, если пакет не найден.
//
// Исключения:
//   - registry.unavailable - Если OpenHub недоступен или не вернул доступные версии.
Функция ПолучитьВерсии(ИмяПакета, Реестр, Прокси, Пул = "", Заголовки = Неопределено) Экспорт

	ПредставлениеРеестра = АдресаСерверовПакетов.ПредставлениеДляДиагностики(Реестр);
	ИмяПула = ?(ЗначениеЗаполнено(Пул), Пул, "default");

	Данные = ПолучитьДанныеJSON(
		АдресВерсийПакета(Реестр, ИмяПула, ИмяПакета),
		Прокси,
		ИмяПакета,
		ПредставлениеРеестра,
		Истина,
		Заголовки
	);

	Если Данные = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Соответствие")
		И ТипЗнч(Данные.Получить("versions")) = Тип("Массив")
		И Данные.Получить("versions").Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Результат = ИзвлечьДоступныеВерсии(Данные, ИмяПакета, ПредставлениеРеестра);
	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкаНедоступногоРеестра(
			ИмяПакета,
			ПредставлениеРеестра,
			"ответ не содержит корректных доступных версий"
		);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзвлечьДоступныеВерсии(Данные, ИмяПакета, ПредставлениеРеестра)

	Элементы = ПолучитьМассивJSON(Данные, "versions", ИмяПакета, ПредставлениеРеестра, Истина);
	Результат = Новый Массив;

	Для Каждого Элемент Из Элементы Цикл
		ПроверитьЭлементJSON(Элемент, ИмяПакета, ПредставлениеРеестра, "versions");
		ПроверитьПоляВерсии(Элемент, ИмяПакета, ПредставлениеРеестра);

		ВерсияПакета = Элемент.Получить("version");
		Если Элемент.Получить("yanked") = Ложь И ПроверкаВерсийПакетов.ЭтоКорректная(ВерсияПакета) Тогда
			Результат.Добавить(ВерсияПакета);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьДанныеJSON(
	Адрес,
	Прокси,
	ИмяПакета,
	ПредставлениеРеестра,
	ОтсутствиеДопустимо = Ложь,
	Заголовки = Неопределено
)

	Попытка
		Ответ = _Транспорт.Получить(Адрес, Прокси, Заголовки);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		Если ДиагностикаОшибок.СодержитГруппу(ИсходнаяОшибка, "registry") Тогда
			ВызватьИсключение;
		КонецЕсли;

		ОшибкаТранспорта = ОписаниеОшибкиТранспорта(ИсходнаяОшибка);
		ВызватьИсключение ОшибкаНедоступногоРеестра(
			ИмяПакета,
			ПредставлениеРеестра,
			ОшибкаТранспорта.Причина,
			ОшибкаТранспорта.Подсказка,
			ОшибкаТранспорта.Ошибка
		);
	КонецПопытки;

	Если Ответ.КодСостояния = 404 И ОтсутствиеДопустимо Тогда
		Возврат Неопределено;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкаНедоступногоРеестра(
			ИмяПакета,
			ПредставлениеРеестра,
			СтрШаблон("HTTP %1", Ответ.КодСостояния)
		);
	КонецЕсли;

	Возврат ПрочитатьТелоJSON(Ответ.Тело, ИмяПакета, ПредставлениеРеестра);

КонецФункции

Функция ОшибкаНедоступногоРеестра(ИмяПакета, Реестр, Причина, Подсказка = "", ПричинаОшибки = Неопределено)

	Сообщение = СтрШаблон(
		"Не удалось получить версии пакета '%1' из реестра %2: %3",
		ИмяПакета,
		Реестр,
		Причина
	);

	Если ПустаяСтрока(Подсказка) Тогда
		Подсказка = "Проверьте доступность реестра.";
	КонецЕсли;

	Построитель = Новый ПостроительОшибки(КодыОшибокDepos.РеестрНедоступен(), Сообщение);
	Построитель.Подсказка(Подсказка);

	Если ПричинаОшибки <> Неопределено Тогда
		Построитель.Причина(ПричинаОшибки);
	КонецЕсли;

	Возврат Построитель.Построить();

КонецФункции

Функция ОписаниеОшибкиТранспорта(Ошибка)

	НормализованнаяОшибка = _КлассификаторОшибок.Классифицировать(Ошибка);
	Если НормализованнаяОшибка = Неопределено Тогда
		Возврат Новый Структура(
			"Причина,Подсказка,Ошибка",
			"Транспортная ошибка",
			"Проверьте доступность реестра и настройки сети.",
			Неопределено
		);
	КонецЕсли;

	КодОшибки = ДиагностикаОшибок.КодОшибки(НормализованнаяОшибка);
	КадрОшибки = ДиагностикаОшибок.НайтиПервую(НормализованнаяОшибка, КодОшибки);

	Возврат Новый Структура(
		"Причина,Подсказка,Ошибка",
		КадрОшибки.Сообщение(),
		ПодсказкаДляОшибкиТранспорта(КодОшибки),
		НормализованнаяОшибка
	);

КонецФункции

Функция ПодсказкаДляОшибкиТранспорта(КодОшибки)

	Если КодОшибки = КодыНативныхОшибок.HTTPТаймаутОперации() Тогда
		Возврат "Увеличьте DEPOS_REGISTRY_TIMEOUT или проверьте доступность реестра.";
	ИначеЕсли КодОшибки = КодыНативныхОшибок.СетьОшибкаРазрешенияИмениУзла() Тогда
		Возврат "Проверьте адрес реестра и настройки DNS.";
	ИначеЕсли КодОшибки = КодыНативныхОшибок.СетьСоединениеОтклонено()
		Или КодОшибки = КодыНативныхОшибок.СетьСоединениеСброшено() Тогда
		Возврат "Проверьте адрес, порт и доступность реестра.";
	ИначеЕсли КодОшибки = КодыНативныхОшибок.ПроксиТребуетАутентификации()
		Или КодОшибки = КодыНативныхОшибок.ПроксиНеУстановилТуннель() Тогда
		Возврат "Проверьте адрес и аутентификацию прокси.";
	ИначеЕсли КодОшибки = КодыНативныхОшибок.СетьОшибкаСогласованияTLS()
		Или КодОшибки = КодыНативныхОшибок.HTTPПользовательскийСертификатНеПоддерживается() Тогда
		Возврат "Проверьте TLS-соединение и сертификат реестра.";
	КонецЕсли;

	Возврат "Проверьте доступность реестра и настройки сети.";

КонецФункции

Функция ПрочитатьТелоJSON(Тело, ИмяПакета, ПредставлениеРеестра)

	ЧтениеJSON = Новый ЧтениеJSON;
	ОшибкаЧтения = Неопределено;
	Данные = Неопределено;

	Попытка
		ЧтениеJSON.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ОшибкаЧтения = ИнформацияОбОшибке();
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Если ОшибкаЧтения <> Неопределено Тогда
		ВызватьИсключение ОшибкаНедоступногоРеестра(
			ИмяПакета,
			ПредставлениеРеестра,
			"поврежденный JSON OpenHub"
		);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ПолучитьМассивJSON(
	Данные,
	ИмяПоля,
	ИмяПакета,
	ПредставлениеРеестра,
	ОтсутствиеДопустимо = Ложь
)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);
	КонецЕсли;

	Значение = Данные.Получить(ИмяПоля);
	Если Значение = Неопределено И ОтсутствиеДопустимо Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьЭлементJSON(Элемент, ИмяПакета, ПредставлениеРеестра, ИмяПоля)

	Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ВызватьОшибкуСтруктурыJSON(
		ИмяПакета,
		ПредставлениеРеестра,
		СтрШаблон("некорректный элемент массива '%1' OpenHub", ИмяПоля)
	);

КонецПроцедуры

Процедура ПроверитьПоляВерсии(Элемент, ИмяПакета, ПредставлениеРеестра)

	ПроверитьТипПоля(Элемент, "version", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Элемент, "yanked", Тип("Булево"), ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ПроверитьТипПоля(Элемент, ИмяПоля, ОжидаемыйТип, ИмяПакета, ПредставлениеРеестра)

	Если ТипЗнч(Элемент.Получить(ИмяПоля)) = ОжидаемыйТип Тогда
		Возврат;
	КонецЕсли;

	ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ВызватьОшибкуСтруктурыJSON(
	ИмяПакета,
	ПредставлениеРеестра,
	Описание = "некорректная структура JSON OpenHub"
)

	ВызватьИсключение ОшибкаНедоступногоРеестра(ИмяПакета, ПредставлениеРеестра, Описание);

КонецПроцедуры

Функция АдресВерсийПакета(Реестр, ИмяПула, ИмяПакета)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментыПути(СтрРазделить("api/v1/pools", "/", Ложь));
	Адрес.ДобавитьСегментПути(ИмяПула);
	Адрес.ДобавитьСегментПути("packages");
	Адрес.ДобавитьСегментПути(ИмяПакета);
	Адрес.ДобавитьСегментПути("versions");

	Возврат Адрес;

КонецФункции

#КонецОбласти
