#Область ОписаниеПеременных

Перем _Транспорт; // ТранспортРеестраПакетов
Перем _ОсновныеПулы; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

// Создает адаптер API OpenHub.
//
// Параметры:
//   Транспорт - ТранспортРеестраПакетов - HTTP-транспорт.
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("ТранспортРеестраПакетов") Транспорт)

	_Транспорт = Транспорт;
	_ОсновныеПулы = Новый Соответствие;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает доступные версии пакета из OpenHub.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   Реестр     - URL - Адрес реестра.
//   Прокси     - URL, Структура, Неопределено - Настройки proxy.
//   Пул        - Строка - Явно выбранный пул; пустая строка выбирает основной публичный.
//   Заголовки  - Соответствие, Неопределено - Заголовки запросов.
//
// Возвращаемое значение:
//   Массив из Строка - Корректные незаблокированные версии или пустой массив, если пакет не найден.
//
// Исключения:
//   - registry.unavailable - Если OpenHub недоступен или не вернул доступные версии.
Функция ПолучитьВерсии(ИмяПакета, Реестр, Прокси, Пул = "", Заголовки = Неопределено) Экспорт

	ПредставлениеРеестра = Реестр.ВСтроку();
	БазовыйАдрес = АдресХаба(Реестр, Пул);

	ИмяПула = Пул;
	Если Не ЗначениеЗаполнено(ИмяПула) Тогда
		ИмяПула = ПолучитьОсновнойПубличныйПул(ИмяПакета, БазовыйАдрес, Прокси, Заголовки);
	КонецЕсли;

	Данные = ПолучитьДанныеJSON(
		АдресВерсийПакета(БазовыйАдрес, ИмяПула, ИмяПакета),
		Прокси,
		ИмяПакета,
		ПредставлениеРеестра,
		Истина,
		Заголовки
	);

	Если Данные = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Результат = ИзвлечьДоступныеВерсии(Данные, ИмяПакета, ПредставлениеРеестра);
	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета,
			ПредставлениеРеестра,
			"ответ не содержит корректных доступных версий"
		);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьЕщеСтраницыПулов(Данные, НомерСтраницы, ИмяПакета, ПредставлениеРеестра)

	ВсегоЭлементов = Данные.Получить("total");
	СтраницаОтвета = Данные.Получить("page");
	РазмерСтраницы = Данные.Получить("pageSize");

	Если ТипЗнч(СтраницаОтвета) <> Тип("Число")
		Или ТипЗнч(РазмерСтраницы) <> Тип("Число")
		Или ТипЗнч(ВсегоЭлементов) <> Тип("Число")
		Или СтраницаОтвета <= 0
		Или СтраницаОтвета <> НомерСтраницы
		Или РазмерСтраницы <= 0
		Или ВсегоЭлементов < 0 Тогда
		ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);
	КонецЕсли;

	Возврат СтраницаОтвета * РазмерСтраницы < ВсегоЭлементов;

КонецФункции

Функция ПолучитьОсновнойПубличныйПул(ИмяПакета, Реестр, Прокси, Заголовки)

	ПредставлениеРеестра = Реестр.ВСтроку();
	ИмяПула = _ОсновныеПулы.Получить(ПредставлениеРеестра);

	Если ЗначениеЗаполнено(ИмяПула) Тогда
		Возврат ИмяПула;
	КонецЕсли;

	НомерСтраницы = 1;
	Пока Истина Цикл
		Данные = ПолучитьДанныеJSON(
			АдресПулов(Реестр, НомерСтраницы),
			Прокси,
			ИмяПакета,
			ПредставлениеРеестра,
			Ложь,
			Заголовки
		);

		Пулы = ПолучитьМассивJSON(
			Данные,
			"items",
			ИмяПакета,
			ПредставлениеРеестра
		);

		ИмяПула = НайтиОсновнойПубличныйПул(Пулы, ИмяПакета, ПредставлениеРеестра);
		Если ЗначениеЗаполнено(ИмяПула) Тогда
			_ОсновныеПулы.Вставить(ПредставлениеРеестра, ИмяПула);
			Возврат ИмяПула;
		КонецЕсли;

		Если Не ЕстьЕщеСтраницыПулов(
			Данные,
			НомерСтраницы,
			ИмяПакета,
			ПредставлениеРеестра
		) Тогда
			Прервать;
		КонецЕсли;

		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;

	ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
		ИмяПакета, ПредставлениеРеестра, "основной публичный пул не найден");

КонецФункции

Функция ИзвлечьДоступныеВерсии(Данные, ИмяПакета, ПредставлениеРеестра)

	Элементы = ПолучитьМассивJSON(Данные, "versions", ИмяПакета, ПредставлениеРеестра, Истина);
	Результат = Новый Массив;

	Для Каждого Элемент Из Элементы Цикл
		ПроверитьЭлементJSON(Элемент, ИмяПакета, ПредставлениеРеестра, "versions");
		ПроверитьПоляВерсии(Элемент, ИмяПакета, ПредставлениеРеестра);

		ВерсияПакета = Элемент.Получить("version");
		Если Элемент.Получить("yanked") = Ложь И ПроверкаВерсийПакетов.ЭтоКорректная(ВерсияПакета) Тогда
			Результат.Добавить(ВерсияПакета);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиОсновнойПубличныйПул(Пулы, ИмяПакета, ПредставлениеРеестра)

	Для Каждого Пул Из Пулы Цикл
		ПроверитьЭлементJSON(Пул, ИмяПакета, ПредставлениеРеестра, "items");
		ПроверитьПоляПула(Пул, ИмяПакета, ПредставлениеРеестра);

		Если Пул.Получить("default") = Истина И НРег(Пул.Получить("visibility")) = "public" Тогда
			Возврат Пул.Получить("name");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПолучитьДанныеJSON(
	Адрес,
	Прокси,
	ИмяПакета,
	ПредставлениеРеестра,
	ОтсутствиеДопустимо = Ложь,
	Заголовки = Неопределено
)

	Попытка
		Ответ = _Транспорт.Получить(Адрес, Прокси, Заголовки);
	Исключение
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "ошибка транспорта");
	КонецПопытки;

	Если Ответ.КодСостояния = 404 И ОтсутствиеДопустимо Тогда
		Возврат Неопределено;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета,
			ПредставлениеРеестра,
			СтрШаблон("HTTP %1", Ответ.КодСостояния)
		);
	КонецЕсли;

	Возврат ПрочитатьТелоJSON(Ответ.Тело, ИмяПакета, ПредставлениеРеестра);

КонецФункции

Функция ПрочитатьТелоJSON(Тело, ИмяПакета, ПредставлениеРеестра)

	ЧтениеJSON = Новый ЧтениеJSON;
	ОшибкаЧтения = Неопределено;
	Данные = Неопределено;

	Попытка
		ЧтениеJSON.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ОшибкаЧтения = ИнформацияОбОшибке();
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Если ОшибкаЧтения <> Неопределено Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета,
			ПредставлениеРеестра,
			"поврежденный JSON OpenHub"
		);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ПолучитьМассивJSON(
	Данные,
	ИмяПоля,
	ИмяПакета,
	ПредставлениеРеестра,
	ОтсутствиеДопустимо = Ложь
)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);
	КонецЕсли;

	Значение = Данные.Получить(ИмяПоля);
	Если Значение = Неопределено И ОтсутствиеДопустимо Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьЭлементJSON(Элемент, ИмяПакета, ПредставлениеРеестра, ИмяПоля)

	Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ВызватьОшибкуСтруктурыJSON(
		ИмяПакета,
		ПредставлениеРеестра,
		СтрШаблон("некорректный элемент массива '%1' OpenHub", ИмяПоля)
	);

КонецПроцедуры

Процедура ПроверитьПоляВерсии(Элемент, ИмяПакета, ПредставлениеРеестра)

	ПроверитьТипПоля(Элемент, "version", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Элемент, "yanked", Тип("Булево"), ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ПроверитьПоляПула(Пул, ИмяПакета, ПредставлениеРеестра)

	ПроверитьТипПоля(Пул, "name", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Пул, "visibility", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Пул, "default", Тип("Булево"), ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ПроверитьТипПоля(Элемент, ИмяПоля, ОжидаемыйТип, ИмяПакета, ПредставлениеРеестра)

	Если ТипЗнч(Элемент.Получить(ИмяПоля)) = ОжидаемыйТип Тогда
		Возврат;
	КонецЕсли;

	ВызватьОшибкуСтруктурыJSON(ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ВызватьОшибкуСтруктурыJSON(
	ИмяПакета,
	ПредставлениеРеестра,
	Описание = "некорректная структура JSON OpenHub"
)

	ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(ИмяПакета, ПредставлениеРеестра, Описание);

КонецПроцедуры

Функция АдресПулов(Реестр, НомерСтраницы)

	ПараметрыЗапроса = Новый ПараметрыЗапросаURL;
	ПараметрыЗапроса.Добавить("page", Формат(НомерСтраницы, "ЧГ="));
	ПараметрыЗапроса.Добавить("pageSize", "100");

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	Адрес.УстановитьПараметрыЗапроса(ПараметрыЗапроса);

	Возврат Адрес;

КонецФункции

Функция АдресВерсийПакета(Реестр, ИмяПула, ИмяПакета)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	Адрес.ДобавитьСегментПути(ИмяПула);
	Адрес.ДобавитьСегментПути("packages");
	Адрес.ДобавитьСегментПути(ИмяПакета);
	Адрес.ДобавитьСегментПути("versions");

	Возврат Адрес;

КонецФункции

Функция АдресХаба(Реестр, Пул)

	Результат = Реестр.Скопировать();
	Если ЗначениеЗаполнено(Пул) Тогда
		Результат.ОчиститьПуть();
		Результат.ОчиститьЗапрос();
		Результат.ОчиститьФрагмент();
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
