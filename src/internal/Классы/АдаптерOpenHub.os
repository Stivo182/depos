#Область ОписаниеПеременных

Перем _Транспорт; // ТранспортРеестраПакетов
Перем _ОсновныеПулы; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

// Создает адаптер API OpenHub.
//
// Параметры:
//   Транспорт - ТранспортРеестраПакетов - HTTP-транспорт.
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("ТранспортРеестраПакетов") Транспорт)

	_Транспорт = Транспорт;
	_ОсновныеПулы = Новый Соответствие;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает доступные версии пакета из OpenHub.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   Реестр     - URL - Адрес реестра.
//   Прокси     - URL, Неопределено - Адрес proxy.
//
// Возвращаемое значение:
//   Массив из Строка - Корректные незаблокированные версии или пустой массив, если пакет не найден.
//
// Исключения:
//   - registry.unavailable - Если OpenHub недоступен или не вернул доступные версии.
Функция ПолучитьВерсии(ИмяПакета, Реестр, Прокси) Экспорт

	ПредставлениеРеестра = Реестр.ВСтроку();
	ИмяПула = ПолучитьОсновнойПубличныйПул(ИмяПакета, Реестр, Прокси);
	АдресВерсий = АдресВерсийПакета(Реестр, ИмяПула, ИмяПакета);

	Данные = ПолучитьДанныеJSON(АдресВерсий, Прокси, ИмяПакета, ПредставлениеРеестра, Истина);
	Если Данные = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ЭлементыВерсий = ПолучитьМассивJSON(
		Данные, "versions", ИмяПакета, ПредставлениеРеестра, Истина);
	Результат = Новый Массив;

	Для Каждого Элемент Из ЭлементыВерсий Цикл
		ПроверитьЭлементJSON(Элемент, ИмяПакета, ПредставлениеРеестра, "versions");
		ПроверитьПоляВерсии(Элемент, ИмяПакета, ПредставлениеРеестра);

		Если Элемент.Получить("yanked") = Истина Тогда
			Продолжить;
		КонецЕсли;

		ВерсияСтрокой = Элемент.Получить("version");
		Если ПроверкаВерсийПакетов.ЭтоКорректная(ВерсияСтрокой) Тогда
			Результат.Добавить(ВерсияСтрокой);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "ответ не содержит корректных доступных версий");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОсновнойПубличныйПул(ИмяПакета, Реестр, Прокси)

	ПредставлениеРеестра = Реестр.ВСтроку();
	ИмяПула = _ОсновныеПулы.Получить(ПредставлениеРеестра);

	Если ЗначениеЗаполнено(ИмяПула) Тогда
		Возврат ИмяПула;
	КонецЕсли;

	НомерСтраницы = 1;
	ПродолжатьПоиск = Истина;
	Пока ПродолжатьПоиск Цикл
		Данные = ПолучитьДанныеJSON(
			АдресПулов(Реестр, НомерСтраницы),
			Прокси,
			ИмяПакета,
			ПредставлениеРеестра
		);
		Пулы = ПолучитьМассивJSON(
			Данные, "items", ИмяПакета, ПредставлениеРеестра);

		Для Каждого Пул Из Пулы Цикл
			ПроверитьЭлементJSON(Пул, ИмяПакета, ПредставлениеРеестра, "items");
			ПроверитьПоляПула(Пул, ИмяПакета, ПредставлениеРеестра);

			Если Пул.Получить("default") = Истина
				И НРег(Пул.Получить("visibility")) = "public" Тогда
				ИмяПула = Пул.Получить("name");
				Если ЗначениеЗаполнено(ИмяПула) Тогда
					_ОсновныеПулы.Вставить(ПредставлениеРеестра, ИмяПула);
					Возврат ИмяПула;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		ВсегоПулов = Данные.Получить("total");
		Если ТипЗнч(ВсегоПулов) <> Тип("Число") Тогда
			ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
				ИмяПакета, ПредставлениеРеестра, "некорректная структура JSON OpenHub");
		КонецЕсли;

		ПродолжатьПоиск = НомерСтраницы * 100 < ВсегоПулов;
		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;

	ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
		ИмяПакета, ПредставлениеРеестра, "основной публичный пул не найден");

КонецФункции

Функция ПолучитьДанныеJSON(
	Адрес,
	Прокси,
	ИмяПакета,
	ПредставлениеРеестра,
	ОтсутствиеДопустимо = Ложь
)

	Попытка
		Ответ = _Транспорт.Получить(Адрес, Прокси);
	Исключение
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "ошибка транспорта");
	КонецПопытки;

	Если Ответ.КодСостояния = 404 И ОтсутствиеДопустимо Тогда
		Возврат Неопределено;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, СтрШаблон("HTTP %1", Ответ.КодСостояния));
	КонецЕсли;

	Возврат ПрочитатьТелоJSON(Ответ.Тело, ИмяПакета, ПредставлениеРеестра);

КонецФункции

Функция ПрочитатьТелоJSON(Тело, ИмяПакета, ПредставлениеРеестра)

	ЧтениеJSON = Новый ЧтениеJSON;
	ОшибкаЧтения = Неопределено;
	Данные = Неопределено;

	Попытка
		ЧтениеJSON.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ОшибкаЧтения = ИнформацияОбОшибке();
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Если ОшибкаЧтения <> Неопределено Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "поврежденный JSON OpenHub");
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ПолучитьМассивJSON(
	Данные,
	ИмяПоля,
	ИмяПакета,
	ПредставлениеРеестра,
	ОтсутствиеДопустимо = Ложь
)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "некорректная структура JSON OpenHub");
	КонецЕсли;

	Значение = Данные.Получить(ИмяПоля);
	Если Значение = Неопределено И ОтсутствиеДопустимо Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "некорректная структура JSON OpenHub");
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьЭлементJSON(Элемент, ИмяПакета, ПредставлениеРеестра, ИмяПоля)

	Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
		ИмяПакета, ПредставлениеРеестра,
		СтрШаблон("некорректный элемент массива '%1' OpenHub", ИмяПоля));

КонецПроцедуры

Процедура ПроверитьПоляВерсии(Элемент, ИмяПакета, ПредставлениеРеестра)

	ПроверитьТипПоля(Элемент, "version", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Элемент, "yanked", Тип("Булево"), ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ПроверитьПоляПула(Пул, ИмяПакета, ПредставлениеРеестра)

	ПроверитьТипПоля(Пул, "name", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Пул, "visibility", Тип("Строка"), ИмяПакета, ПредставлениеРеестра);
	ПроверитьТипПоля(Пул, "default", Тип("Булево"), ИмяПакета, ПредставлениеРеестра);

КонецПроцедуры

Процедура ПроверитьТипПоля(Элемент, ИмяПоля, ОжидаемыйТип, ИмяПакета, ПредставлениеРеестра)

	Если ТипЗнч(Элемент.Получить(ИмяПоля)) = ОжидаемыйТип Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
		ИмяПакета, ПредставлениеРеестра, "некорректная структура JSON OpenHub");

КонецПроцедуры

Функция АдресПулов(Реестр, НомерСтраницы)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	Адрес.УстановитьЗапрос(СтрШаблон("page=%1&pageSize=100", НомерСтраницы));

	Возврат Адрес;

КонецФункции

Функция АдресВерсийПакета(Реестр, ИмяПула, ИмяПакета)

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("api");
	Адрес.ДобавитьСегментПути("v1");
	Адрес.ДобавитьСегментПути("pools");
	Адрес.ДобавитьСегментПути(ИмяПула);
	Адрес.ДобавитьСегментПути("packages");
	Адрес.ДобавитьСегментПути(ИмяПакета);
	Адрес.ДобавитьСегментПути("versions");

	Возврат Адрес;

КонецФункции

#КонецОбласти
