#Использовать xml-parser
#Использовать errors
#Использовать semver

#Область ПрограммныйИнтерфейс

// Разбирает зависимости из файла opm-metadata.xml.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к файлу opm-metadata.xml.
//
// Возвращаемое значение:
//   Массив из Структура - Зависимости с полями ИмяПакета, МинимальнаяВерсия,
//                          МаксимальнаяВерсия и ДляРазработки.
Функция Разобрать(ПутьКФайлу) Экспорт

	РезультатЧтения = ПрочитатьXMLИзФайла(ПутьКФайлу);

	Возврат ПолучитьЗависимостиИзOpmMetadata(РезультатЧтения, ПутьКФайлу);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьXMLИзФайла(ПутьКФайлу)

	ПроцессорXML = Новый СериализацияДанныхXML(Ложь);
	Чтение = Новый ЧтениеXML;

	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу);
		РезультатЧтения = ПроцессорXML.ПрочитатьXML(Чтение, , Ложь);
	Исключение
		Причина = ИнформацияОбОшибке();
		ЗакрытьЧтениеXML(Чтение);
		ВызватьИсключение ОшибкаРазбораМанифеста(ПутьКФайлу, Причина);
	КонецПопытки;

	ЗакрытьЧтениеXML(Чтение);

	Возврат РезультатЧтения;

КонецФункции

Процедура ЗакрытьЧтениеXML(Чтение)

	Попытка
		Чтение.Закрыть();
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьЗависимостиИзOpmMetadata(РезультатЧтения, ПутьКФайлу)

	КорневыеЭлементы = ПолучитьЗначениеКоллекции(РезультатЧтения, "_Элементы");
	Если Не ЭтоКоллекцияКлючЗначение(КорневыеЭлементы) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Некорректная структура манифеста: не найден корневой элемент 'opm-metadata'"
		);
	КонецЕсли;

	Метаданные = ПолучитьЗначениеКоллекции(КорневыеЭлементы, "opm-metadata");
	Если Не ЭтоКоллекцияКлючЗначение(Метаданные) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Некорректная структура элемента 'opm-metadata'"
		);
	КонецЕсли;

	Если СодержитНепустойТекстИлиCDATA(Метаданные) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Некорректная структура элемента 'opm-metadata'"
		);
	КонецЕсли;

	Элементы = ПолучитьЗначениеКоллекции(Метаданные, "_Элементы");
	Если Не ЭтоКоллекцияКлючЗначение(Элементы)
		И Не ТипЗнч(Элементы) = Тип("Массив") Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Некорректная структура элемента 'opm-metadata'"
		);
	КонецЕсли;

	Если Элементы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат ПолучитьЗависимостиИзЭлементовOpmMetadata(Элементы, ПутьКФайлу);

КонецФункции

Функция ПолучитьЗависимостиИзЭлементовOpmMetadata(Элементы, ПутьКФайлу)

	Зависимости = Новый Массив();
	Если ТипЗнч(Элементы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Элементы Цикл
			ДобавитьЗависимостиИзЭлементаOpmMetadata(Зависимости, Элемент, ПутьКФайлу);
		КонецЦикла;
	Иначе
		ДобавитьЗависимостиИзЭлементаOpmMetadata(Зависимости, Элементы, ПутьКФайлу);
	КонецЕсли;

	Возврат Зависимости;

КонецФункции

Процедура ДобавитьЗависимостиИзЭлементаOpmMetadata(Зависимости, Элемент, ПутьКФайлу)

	Если Не ЭтоКоллекцияКлючЗначение(Элемент) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Некорректная структура элемента 'opm-metadata'"
		);
	КонецЕсли;

	ЗависимостьXML = ПолучитьЗначениеКоллекции(Элемент, "depends-on");
	Если ЗависимостьXML = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Атрибуты = ПолучитьЗначениеКоллекции(ЗависимостьXML, "_Атрибуты");
	ЭлементыЗависимости = ПолучитьЗначениеКоллекции(ЗависимостьXML, "_Элементы");
	Если Не ЭтоКоллекцияКлючЗначение(ЗависимостьXML)
		Или Не ЭтоКоллекцияКлючЗначение(Атрибуты)
		Или Не ЭтоКоллекцияКлючЗначение(ЭлементыЗависимости)
		Или ЭлементыЗависимости.Количество() <> 0
		Или СодержитНепустойТекстИлиCDATA(ЗависимостьXML) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Некорректная структура элемента 'depends-on'"
		);
	КонецЕсли;

	Зависимости.Добавить(ПолучитьЗависимостьИзАтрибутовDependsOn(Атрибуты, ПутьКФайлу));

КонецПроцедуры

Функция ПолучитьЗависимостьИзАтрибутовDependsOn(Атрибуты, ПутьКФайлу)

	Имя = ПолучитьЗначениеКоллекции(Атрибуты, "name");
	Если Не ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение ОшибкаНекорректнойСтруктурыМанифеста(
			ПутьКФайлу,
			"Не указан атрибут 'name' элемента 'depends-on'"
		);
	КонецЕсли;

	МинимальнаяВерсия = ПолучитьВерсиюИзАтрибутовDependsOn(Атрибуты, "version", Имя, ПутьКФайлу);
	МаксимальнаяВерсия = ПолучитьВерсиюИзАтрибутовDependsOn(Атрибуты, "version-max", Имя, ПутьКФайлу);

	Возврат Новый Структура(
		"ИмяПакета,МинимальнаяВерсия,МаксимальнаяВерсия,ДляРазработки",
		Имя,
		МинимальнаяВерсия,
		МаксимальнаяВерсия,
		ПолучитьЗначениеКоллекции(Атрибуты, "dev") = "true"
	);

КонецФункции

Функция ПолучитьВерсиюИзАтрибутовDependsOn(Атрибуты, ИмяАтрибута, ИмяПакета, ПутьКФайлу)

	ВерсияСтрокой = ПолучитьЗначениеКоллекции(Атрибуты, ИмяАтрибута);
	Если ВерсияСтрокой = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ВерсияСтрокой = Строка(ВерсияСтрокой);
	Если ИмяАтрибута = "version-max" И Не ЗначениеЗаполнено(ВерсияСтрокой) Тогда
		Возврат "";
	КонецЕсли;

	Версия = Новый Версия(ВерсияСтрокой);
	Если Не ЗначениеЗаполнено(ВерсияСтрокой) Или Версия.Ошибка() Тогда
		ВызватьИсключение ОшибкаНекорректнойВерсииЗависимости(ИмяПакета, ПутьКФайлу);
	КонецЕсли;

	Возврат ВерсияСтрокой;

КонецФункции

Функция ОшибкаРазбораМанифеста(ПутьКФайлу, Причина)

	Возврат ФабрикаОшибок.Обернуть(
		Причина,
		КодыОшибокDepos.РазборМанифестаНеУдался(),
		СтрШаблон("Возникла ошибка при получении зависимостей из файла манифеста '%1'", ПутьКФайлу),
		Новый Структура("ПутьКФайлу", ПутьКФайлу)
	);

КонецФункции

Функция ОшибкаНекорректнойСтруктурыМанифеста(ПутьКФайлу, Сообщение)

	Возврат ФабрикаОшибок.Создать(
		КодыОшибокDepos.СтруктураМанифестаНекорректна(),
		Сообщение,
		Новый Структура("ПутьКФайлу", ПутьКФайлу)
	);

КонецФункции

Функция ОшибкаНекорректнойВерсииЗависимости(ИмяПакета, ПутьКФайлу)

	Возврат ФабрикаОшибок.Создать(
		КодыОшибокDepos.ВерсияЗависимостиНекорректна(),
		СтрШаблон("Некорректная версия зависимости '%1'", ИмяПакета),
		Новый Структура("ПутьКФайлу,ИмяПакета", ПутьКФайлу, ИмяПакета)
	);

КонецФункции

Функция ЭтоКоллекцияКлючЗначение(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("Структура");

КонецФункции

Функция ПолучитьЗначениеКоллекции(Коллекция, Ключ)

	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Ключ, Значение);
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция[Ключ];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СодержитНепустойТекстИлиCDATA(Узел)

	Текст = ПолучитьЗначениеКоллекции(Узел, "_Значение");
	CDATA = ПолучитьЗначениеКоллекции(Узел, "_CDATA");

	Возврат ЗначениеЗаполнено(СокрЛП(Строка(Текст)))
		Или ЗначениеЗаполнено(СокрЛП(Строка(CDATA)));

КонецФункции

#КонецОбласти
