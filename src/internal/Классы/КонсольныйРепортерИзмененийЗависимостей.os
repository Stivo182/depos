#Использовать coloratos

#Область ОписаниеПеременных

Перем _НастройкиФорматирования; // НастройкиФорматирования
Перем _ОпределительВозможностей; // ОпределительВозможностейТерминала
Перем _ТекстовыйРепортер; // ТекстовыйРепортерИзмененийЗависимостей

#КонецОбласти
#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиФорматирования") НастройкиФорматирования,
	&Пластилин("ОпределительВозможностейТерминала") ОпределительВозможностей,
	&Пластилин("ТекстовыйРепортерИзмененийЗависимостей") ТекстовыйРепортер
)
	_НастройкиФорматирования = НастройкиФорматирования;
	_ОпределительВозможностей = ОпределительВозможностей;
	_ТекстовыйРепортер = ТекстовыйРепортер;
КонецПроцедуры

#КонецОбласти
#Область ПрограммныйИнтерфейс

// Выводит таблицу изменений зависимостей в режиме проверки доступных обновлений.
//
// Параметры:
//   ИзмененияЗависимостей - ТаблицаЗначений - см. ЗависимостиПакета.ПолучитьИзмененияОтносительно
Процедура ВывестиКакПроверенные(ИзмененияЗависимостей) Экспорт
	Вывести(ИзмененияЗависимостей, Ложь);
КонецПроцедуры

// Выводит таблицу изменений зависимостей после выполненного обновления.
//
// Параметры:
//   ИзмененияЗависимостей - ТаблицаЗначений - см. ЗависимостиПакета.ПолучитьИзмененияОтносительно
Процедура ВывестиКакОбновленные(ИзмененияЗависимостей) Экспорт
	Вывести(ИзмененияЗависимостей, Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Вывести(ИзмененияЗависимостей, Обновлено)

	Если ИзмененияЗависимостей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Профиль = _ОпределительВозможностей.Определить();
	Строки = _ТекстовыйРепортер.ПодготовитьСтрокиДляКонсоли(
		ИзмененияЗависимостей,
		Обновлено,
		_НастройкиФорматирования,
		Профиль
	);

	Для Каждого СтрокаОтчета Из Строки Цикл
		ЦветнойВывод.Вывести(СтрокаОтчета.Префикс);
		Консоль.Вывести(СтрокаОтчета.Текст);
		ЦветнойВывод.ВывестиСтроку(СтрокаОтчета.ВерсияПосле);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
