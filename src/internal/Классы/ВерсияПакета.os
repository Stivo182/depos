#Использовать semver

#Область ОписаниеПеременных

Перем _ИсходноеПредставление; // Строка
Перем _ВерсияSemVer; // Версия, Неопределено
Перем _ЕстьОшибка; // Булево
Перем _Основная; // Число
Перем _Второстепенная; // Число
Перем _Патч; // Число
Перем _ДополнительныйПатч; // Число

#КонецОбласти

#Область ОбработчикиСобытий

// Создает версию пакета из строки.
//
// Параметры:
//   ВерсияСтрокой - Строка - Версия в формате SemVer или A.B.C.D.
Процедура ПриСозданииОбъекта(ВерсияСтрокой)

	_ИсходноеПредставление = ВерсияСтрокой;
	_ЕстьОшибка = Ложь;

	Если ПроверкаВерсийПакетов.ЭтоЧетырехкомпонентная(ВерсияСтрокой) Тогда
		ЗаполнитьЧетырехкомпонентнуюВерсию(ВерсияСтрокой);
	Иначе
		ЗаполнитьSemVer(ВерсияСтрокой);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает признак ошибки разбора версии.
//
// Возвращаемое значение:
//   Булево - Истина, если версия некорректна.
Функция Ошибка() Экспорт
	Возврат _ЕстьОшибка;
КонецФункции

// Сравнивает версию с другой версией.
//
// Параметры:
//   ДругаяВерсия - ВерсияПакета, Строка - Версия для сравнения.
//
// Возвращаемое значение:
//   Число - -1, если версия меньше, 0, если равна, 1, если больше.
Функция Сравнить(ДругаяВерсия) Экспорт

	ВерсияДляСравнения = ДругаяВерсия;
	Если ТипЗнч(ДругаяВерсия) = Тип("Строка") Тогда
		ВерсияДляСравнения = Новый ВерсияПакета(ДругаяВерсия);
	КонецЕсли;

	Результат = СравнитьЧисло(_Основная, ВерсияДляСравнения.Основная());
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьЧисло(_Второстепенная, ВерсияДляСравнения.Второстепенная());
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьЧисло(_Патч, ВерсияДляСравнения.Патч());
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьЧисло(_ДополнительныйПатч, ВерсияДляСравнения.ДополнительныйПатч());
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ВерсияДляСравненияСтрокой = ВерсияДляСравнения.ВСтроку();
	Если _ВерсияSemVer <> Неопределено
		И Не ПроверкаВерсийПакетов.ЭтоЧетырехкомпонентная(ВерсияДляСравненияСтрокой) Тогда
		Возврат _ВерсияSemVer.Сравнить(Новый Версия(ВерсияДляСравненияСтрокой));
	КонецЕсли;

	Если ЭтоПререлиз() Тогда
		Возврат -1;
	КонецЕсли;

	Если ВерсияДляСравнения.ЭтоПререлиз() Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Возвращает основную часть версии.
//
// Возвращаемое значение:
//   Число - Основная часть версии.
Функция Основная() Экспорт
	Возврат _Основная;
КонецФункции

// Возвращает второстепенную часть версии.
//
// Возвращаемое значение:
//   Число - Второстепенная часть версии.
Функция Второстепенная() Экспорт
	Возврат _Второстепенная;
КонецФункции

// Возвращает первую патч-часть версии.
//
// Возвращаемое значение:
//   Число - Первая патч-часть версии.
Функция Патч() Экспорт
	Возврат _Патч;
КонецФункции

// Возвращает дополнительную патч-часть версии.
//
// Возвращаемое значение:
//   Число - Дополнительная патч-часть или 0 для SemVer.
Функция ДополнительныйПатч() Экспорт
	Возврат _ДополнительныйПатч;
КонецФункции

// Возвращает строковое представление версии.
//
// Возвращаемое значение:
//   Строка - Исходная строка версии.
Функция ВСтроку() Экспорт
	Возврат _ИсходноеПредставление;
КонецФункции

// Возвращает признак prerelease-версии.
//
// Возвращаемое значение:
//   Булево - Истина, если версия содержит prerelease-суффикс.
Функция ЭтоПререлиз() Экспорт
	Возврат _ВерсияSemVer <> Неопределено И _ВерсияSemVer.ПреРелиз.Количество() > 0;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьЧетырехкомпонентнуюВерсию(ВерсияСтрокой)

	Части = СтрРазделить(ВерсияСтрокой, ".");

	_Основная = Число(Части[0]);
	_Второстепенная = Число(Части[1]);
	_Патч = Число(Части[2]);
	_ДополнительныйПатч = Число(Части[3]);

КонецПроцедуры

Процедура ЗаполнитьSemVer(ВерсияСтрокой)

	_ВерсияSemVer = Новый Версия(ВерсияСтрокой);
	_ЕстьОшибка = _ВерсияSemVer.Ошибка();

	_Основная = _ВерсияSemVer.Основная;
	_Второстепенная = _ВерсияSemVer.Второстепенная;
	_Патч = _ВерсияSemVer.Патч;
	_ДополнительныйПатч = 0;

КонецПроцедуры

Функция СравнитьЧисло(Первое, Второе)

	Если Первое = Второе Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ?(Первое > Второе, 1, -1);

КонецФункции

#КонецОбласти
