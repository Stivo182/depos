#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Определяет профиль символов для текущего консольного вывода.
//
// Возвращаемое значение:
//   Структура - Профиль символов и возможностей терминала.
Функция Определить() Экспорт

	Возврат СформироватьПрофиль(Консоль.КодировкаВыходногоПотока);

КонецФункции

// Строит профиль для указанной кодировки. Нужен для воспроизводимой проверки профилей.
//
// Параметры:
//   Кодировка - КодировкаТекста - Кодировка вывода.
//
// Возвращаемое значение:
//   Структура
Функция ОпределитьДляКодировки(Кодировка) Экспорт

	Возврат СформироватьПрофиль(Кодировка);

КонецФункции

// Заменяет Unicode-маркеры на безопасный профиль терминала.
//
// Параметры:
//   Текст - Строка - Сформированный текст отчёта.
//   Профиль - Структура - Результат Определить или ОпределитьДляКодировки.
//
// Возвращаемое значение:
//   Строка
Функция ПрименитьПрофиль(Текст, Профиль) Экспорт

	Если Профиль.ЭтоЮникод Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = СтрЗаменить(Текст, "×", Профиль.Ошибка);
	Результат = СтрЗаменить(Результат, "✓", Профиль.Успех);
	Результат = СтрЗаменить(Результат, "💡︎︎", Профиль.Рекомендация);
	Результат = СтрЗаменить(Результат, "→", Профиль.Стрелка);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПрофиль(Кодировка)

	Возврат ПрофильСимволов(РежимКодировки(Кодировка));

КонецФункции

Функция РежимКодировки(Кодировка)

	Если Кодировка = КодировкаТекста.UTF8
		Или Кодировка = КодировкаТекста.UTF8NoBOM
		Или Кодировка = КодировкаТекста.UTF16 Тогда
		Возврат "UTF8";
	ИначеЕсли Кодировка = КодировкаТекста.OEM Тогда
		Возврат "CP866";
	КонецЕсли;

	Возврат "ASCII";

КонецФункции

Функция ПрофильСимволов(Режим)

	Профиль = Новый Структура();
	Профиль.Вставить("Режим", Режим);
	Профиль.Вставить("ЭтоЮникод", Режим = "UTF8");

	Если Режим = "UTF8" Тогда
		Профиль.Вставить("Ошибка", "✕ ");
		Профиль.Вставить("Предупреждение", "⚠ ");
		Профиль.Вставить("Успех", "✓");
		Профиль.Вставить("Рекомендация", "💡︎︎");
		Профиль.Вставить("СтрелкаВверх", "↑");
		Профиль.Вставить("Стрелка", "→");
	Иначе
		Профиль.Вставить("Ошибка", "[x]");
		Профиль.Вставить("Предупреждение", "[!]");
		Профиль.Вставить("Успех", "[ok]");
		Профиль.Вставить("Рекомендация", "[i]");
		Профиль.Вставить("СтрелкаВверх", "^");
		Профиль.Вставить("Стрелка", "->");
	КонецЕсли;

	Если Режим = "ASCII" Тогда
		Профиль.Вставить("Ветка", "|-");
		Профиль.Вставить("ПоследняяВетка", "+-");
		Профиль.Вставить("Вертикаль", "| ");
		Профиль.Вставить("Горизонталь", "-");
	Иначе
		Профиль.Вставить("Ветка", "├─");
		Профиль.Вставить("ПоследняяВетка", "└─");
		Профиль.Вставить("Вертикаль", "│  ");
		Профиль.Вставить("Горизонталь", "─");
	КонецЕсли;

	Возврат Профиль;

КонецФункции

#КонецОбласти
