#Использовать coloratos

#Область ОписаниеПеременных

&Пластилин("ТекстовыйРепортерДиагностики")
Перем _ТекстовыйРепортер; // ТекстовыйРепортерДиагностики

&Пластилин("ОпределительВозможностейТерминала")
Перем _ОпределительВозможностей; // ОпределительВозможностейТерминала

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выводит подготовленный отчет с учетом возможностей терминала.
//
// Параметры:
//   Отчет - ОтчетДиагностики - Независимый снимок диагностики.
//   Подробно - Булево - Выводить все диагностические сведения.
Процедура Вывести(Отчет, Подробно = Ложь) Экспорт

	Профиль = _ОпределительВозможностей.Определить();
	ТекстОтчета = _ТекстовыйРепортер.Сформировать(Отчет, Подробно, Профиль);
	ЦветнойВывод.ВывестиСтроку(ТекстОтчета);

КонецПроцедуры

#КонецОбласти
