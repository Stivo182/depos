#Область ОписаниеПеременных

Перем _Транспорт; // ТранспортРеестраПакетов
Перем _РегулярноеВыражениеИзвлеченияВерсии; // РегулярноеВыражение
Перем _РегулярноеВыражениеЗаголовкаПакета; // РегулярноеВыражение

#КонецОбласти

#Область ОбработчикиСобытий

// Адаптирует старый HTML-реестр пакетов к интерфейсу получения версий.
//
// Параметры:
//   Транспорт - ТранспортРеестраПакетов - HTTP-транспорт.
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин("ТранспортРеестраПакетов") Транспорт)

	_Транспорт = Транспорт;
	_РегулярноеВыражениеИзвлеченияВерсии = Новый РегулярноеВыражение(
		"href=""\/download\/[a-zA-Z_0-9-]+\/[a-zA-Z_0-9-]+-([0-9A-Za-z+.-]+)\.ospx"""
	);
	_РегулярноеВыражениеЗаголовкаПакета = Новый РегулярноеВыражение("<h1[^>]*>([^<]*)<\/h1>");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает версии пакета из старого HTML-реестра.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   Реестр     - URL - Адрес реестра.
//   Прокси     - URL, Неопределено - Адрес proxy.
//
// Возвращаемое значение:
//   Массив из Строка - Корректные semver-версии или пустой массив, если пакет не найден.
//
// Исключения:
//   - registry.unavailable - Если реестр не вернул корректные версии.
Функция ПолучитьВерсии(ИмяПакета, Реестр, Прокси) Экспорт

	ПредставлениеРеестра = Реестр.ВСтроку();

	Адрес = Реестр.Скопировать();
	Адрес.ДобавитьСегментПути("package");
	Адрес.ДобавитьСегментПути(ИмяПакета);

	Попытка
		Ответ = _Транспорт.Получить(Адрес, Прокси);
	Исключение
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "ошибка транспорта");
	КонецПопытки;

	Если Ответ.КодСостояния = 404 Тогда
		Возврат Новый Массив;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, СтрШаблон("HTTP %1", Ответ.КодСостояния));
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ответ.Тело) Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "пустой ответ");
	КонецЕсли;

	Если ЭтоСтраницаНенайденногоПакета(Ответ.Тело) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ВерсииПакета = ИзвлечьВерсии(Ответ.Тело);
	Если ВерсииПакета.Количество() = 0 Тогда
		ВызватьИсключение ОшибкиРеестраПакетов.Недоступен(
			ИмяПакета, ПредставлениеРеестра, "ответ не содержит корректных версий");
	КонецЕсли;

	Возврат ВерсииПакета;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоСтраницаНенайденногоПакета(HTMLКонтент)

	Заголовки = _РегулярноеВыражениеЗаголовкаПакета.НайтиСовпадения(HTMLКонтент);
	Если Заголовки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПустаяСтрока(СокрЛП(Заголовки[0].Группы[1].Значение));

КонецФункции

Функция ИзвлечьВерсии(HTMLКонтент)

	ВерсииПакета = Новый Массив;
	Совпадения = _РегулярноеВыражениеИзвлеченияВерсии.НайтиСовпадения(HTMLКонтент);

	Для Каждого Совпадение Из Совпадения Цикл
		ВерсияСтрокой = Совпадение.Группы[1].Значение;
		Если ПроверкаВерсийПакетов.ЭтоКорректная(ВерсияСтрокой) Тогда
			ВерсииПакета.Добавить(ВерсияСтрокой);
		КонецЕсли;
	КонецЦикла;

	Возврат ВерсииПакета;

КонецФункции

#КонецОбласти
