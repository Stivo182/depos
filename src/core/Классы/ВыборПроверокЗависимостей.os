#Использовать errors

#Область ОписаниеПеременных

Перем _ВыбранныеПроверки; // Соответствие
Перем _ДопустимыеПроверки; // Массив из Строка

#КонецОбласти

#Область ОбработчикиСобытий

// Создает выбор проверок зависимостей.
//
// Параметры:
//   ЗначениеОпции - Строка, Неопределено - Значение опции --checks. Пустое значение выбирает все
//                                          проверки. Допустимы usage, installed и transitive.
//
// Исключения:
//   - checks.invalid - Задана неизвестная проверка.
Процедура ПриСозданииОбъекта(ЗначениеОпции = Неопределено)

	_ВыбранныеПроверки = Новый Соответствие();
	_ДопустимыеПроверки = ТипыПроверокЗависимостей.Все();

	Если ЗначениеОпции = Неопределено Или Не ЗначениеЗаполнено(СокрЛП(ЗначениеОпции)) Тогда
		ДобавитьВсеПроверки();
		Возврат;
	КонецЕсли;

	Для Каждого ИмяПроверки Из СтрРазделить(ЗначениеОпции, ",", Истина) Цикл
		ИмяПроверки = НРег(СокрЛП(ИмяПроверки));
		ПроверитьИмяПроверки(ИмяПроверки, ЗначениеОпции);
		_ВыбранныеПроверки.Вставить(ИмяПроверки, Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает признак выбора проверок использования.
//
// Возвращаемое значение:
//   Булево - Истина, если нужно анализировать использование пакетов.
Функция ПроверятьИспользование() Экспорт
	Возврат ВыбранаПроверка(ТипыПроверокЗависимостей.Использование);
КонецФункции

// Возвращает признак выбора проверок прямых установленных пакетов.
//
// Возвращаемое значение:
//   Булево - Истина, если нужно проверить прямые зависимости.
Функция ПроверятьУстановленныеПакеты() Экспорт
	Возврат ВыбранаПроверка(ТипыПроверокЗависимостей.УстановленныеПакеты);
КонецФункции

// Возвращает признак выбора проверок транзитивных зависимостей.
//
// Возвращаемое значение:
//   Булево - Истина, если нужно проверить транзитивные зависимости.
Функция ПроверятьТранзитивныеЗависимости() Экспорт
	Возврат ВыбранаПроверка(ТипыПроверокЗависимостей.ТранзитивныеЗависимости);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВсеПроверки()
	Для Каждого ИмяПроверки Из _ДопустимыеПроверки Цикл
		_ВыбранныеПроверки.Вставить(ИмяПроверки, Истина);
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьИмяПроверки(ИмяПроверки, ЗначениеОпции)

	Если _ДопустимыеПроверки.Найти(ИмяПроверки) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение Новый ПостроительОшибки(
		КодыОшибокDepos.ВыборПроверокНекорректен(),
		СтрШаблон("Неизвестная проверка зависимостей '%1'", ИмяПроверки)
	)
		.Данные("ЗначениеОпции", ЗначениеОпции)
		.Подсказка(СтрШаблон(
			"Укажите %1 или их комбинацию через запятую.",
			СтрСоединить(_ДопустимыеПроверки, ", ")
		))
		.Построить();

КонецПроцедуры

Функция ВыбранаПроверка(ИмяПроверки)
	Возврат _ВыбранныеПроверки[ИмяПроверки] <> Неопределено;
КонецФункции

#КонецОбласти
