#Использовать errors
#Использовать "../../internal"

#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_Зависимости = ПустаяТаблицаЗависимостей();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Загружает зависимости из файла манифеста пакета.
//
// Параметры:
//   ПутьКФайлу - Строка - Полный путь к файлу манифеста
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ЗаполнитьИзМанифеста(ПутьКФайлу) Экспорт

	Расширение = НРег(Новый Файл(ПутьКФайлу).Расширение);

	Если Расширение = ".xml" Тогда
		ПрочитатьИзOpmMetadata(ПутьКФайлу);
	Иначе
		ПрочитатьИзPackagedef(ПутьКФайлу);
	КонецЕсли;

	Возврат ЭтотОбъект;

КонецФункции

// Загружает зависимости из готовой таблицы значений.
//
// Параметры:
//   Зависимости - ТаблицаЗначений, Массив, ФиксированныйМассив - Коллекция зависимостей:
//     * ИмяПакета          - Строка - Имя пакета
//     * ДляРазработки      - Булево - Признак зависимости для разработки
//     * Транзитивная       - Булево, необязательно - Зависимость с транзитивной пометкой
//     * Неявная            - Булево, необязательно - Зависимость с пометкой неявного использования
//     * МинимальнаяВерсия  - Строка - Минимально допустимая версия
//     * МаксимальнаяВерсия - Строка - Максимально допустимая версия
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ЗаполнитьИзТаблицы(Зависимости) Экспорт

	_Зависимости.Очистить();

	ЕстьПометкаТранзитивной = Ложь;
	ЕстьПометкаНеявной = Ложь;
	Если ТипЗнч(Зависимости) = Тип("ТаблицаЗначений") Тогда
		ЕстьПометкаТранзитивной = Зависимости.Колонки.Найти("Транзитивная") <> Неопределено;
		ЕстьПометкаНеявной = Зависимости.Колонки.Найти("Неявная") <> Неопределено;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Зависимости Цикл
		Транзитивная = Ложь;
		Неявная = Ложь;

		Если ТипЗнч(СтрокаТаблицы) = Тип("Структура")
			Или ТипЗнч(СтрокаТаблицы) = Тип("ФиксированнаяСтруктура") Тогда
			СтрокаТаблицы.Свойство("Транзитивная", Транзитивная);
			СтрокаТаблицы.Свойство("Неявная", Неявная);
		Иначе
			Если ЕстьПометкаТранзитивной Тогда
				Транзитивная = СтрокаТаблицы.Транзитивная;
			КонецЕсли;

			Если ЕстьПометкаНеявной Тогда
				Неявная = СтрокаТаблицы.Неявная;
			КонецЕсли;
		КонецЕсли;

		ДобавитьЗависимостьВТаблицу(
			СтрокаТаблицы.ИмяПакета,
			СтрокаТаблицы.МинимальнаяВерсия,
			СтрокаТаблицы.МаксимальнаяВерсия,
			СтрокаТаблицы.ДляРазработки,
			Транзитивная,
			Неявная
		);
	КонецЦикла;

	Возврат ЭтотОбъект;

КонецФункции

// Оставляет зависимости по имени пакета с поддержкой масок и регулярных выражений.
//
// Параметры:
//   Фильтр - Строка - Имена пакетов через запятую или пробел,
//                     маска с символами * (любые символы) и ? (один символ)
//                     или регулярное выражение (например, /^autumn-.*$/).
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ОставитьПоИмени(Фильтр) Экспорт

	Если Не ЗначениеЗаполнено(Фильтр) Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ПрименитьФильтрПоИмени(Фильтр, Ложь);

	Возврат ЭтотОбъект;

КонецФункции

// Исключает зависимости по имени пакета.
//
// Параметры:
//   Фильтр - Строка - Имена пакетов через запятую или пробел,
//                     маска с символами * (любые символы) и ? (один символ)
//                     или регулярное выражение (например, /^autumn-.*$/).
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция УдалитьПоИмени(Фильтр) Экспорт

	Если Не ЗначениеЗаполнено(Фильтр) Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ПрименитьФильтрПоИмени(Фильтр, Истина);

	Возврат ЭтотОбъект;

КонецФункции

// Добавляет новую зависимость в коллекцию.
//
// Параметры:
//   ИмяПакета          - Строка - Имя пакета
//   МинимальнаяВерсия  - Строка - Минимально допустимая версия
//   МаксимальнаяВерсия - Строка - Максимально допустимая версия
//   ДляРазработки      - Булево - Признак зависимости для разработки
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция Добавить(ИмяПакета, МинимальнаяВерсия = "", МаксимальнаяВерсия = "", ДляРазработки = Ложь) Экспорт
	ДобавитьЗависимостьВТаблицу(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, ДляРазработки);
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет новую зависимость для разработки.
//
// Параметры:
//   ИмяПакета          - Строка - Имя пакета
//   МинимальнаяВерсия  - Строка - Минимально допустимая версия
//   МаксимальнаяВерсия - Строка - Максимально допустимая версия
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ДобавитьДляРазработки(ИмяПакета, МинимальнаяВерсия = "", МаксимальнаяВерсия = "") Экспорт
	ДобавитьЗависимостьВТаблицу(ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает копию внутренней таблицы зависимостей.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * ИмяПакета          - Строка - Имя пакета
//     * ДляРазработки      - Булево - Признак зависимости для разработки
//     * Транзитивная       - Булево - Зависимость с транзитивной пометкой
//     * Неявная            - Булево - Зависимость с пометкой неявного использования
//     * МинимальнаяВерсия  - Строка - Минимально допустимая версия
//     * МаксимальнаяВерсия - Строка - Максимально допустимая версия
Функция СкопироватьВТаблицу() Экспорт
	Возврат _Зависимости.Скопировать();
КонецФункции

// Проверяет, что коллекция зависимостей пустая.
//
// Возвращаемое значение:
//   Булево - Истина, если в коллекции нет ни одной зависимости;
//            Ложь, если есть хотя бы одна зависимость.
Функция ЭтоПустой() Экспорт
	Возврат _Зависимости.Количество() = 0;
КонецФункции

// Вычисляет изменения в зависимостях по сравнению с другой коллекцией
// и формирует таблицу с результатами.
//
// Параметры:
//   Зависимости - ЗависимостиПакета - Коллекция исходных зависимостей для сравнения.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * ИмяПакета              - Строка - Имя пакета
//     * ДляРазработки          - Булево - Признак зависимости для разработки
//     * МинимальнаяВерсияДо    - Строка - Версия в исходной коллекции
//     * МинимальнаяВерсияПосле - Строка - Версия в текущей коллекции
//     * МаксимальнаяВерсия     - Строка - Максимальная версия
Функция ПолучитьИзмененияОтносительно(Зависимости) Экспорт
	
	ТаблицаИсходная = Зависимости.СкопироватьВТаблицу();
	ТипСтрока = Новый ОписаниеТипов("Строка");

	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("ИмяПакета", ТипСтрока);
	Результат.Колонки.Добавить("ДляРазработки", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("МинимальнаяВерсияДо", ТипСтрока);
	Результат.Колонки.Добавить("МинимальнаяВерсияПосле", ТипСтрока);
	Результат.Колонки.Добавить("МаксимальнаяВерсия", ТипСтрока);

	Для Каждого СтрокаТекущая Из _Зависимости Цикл

		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.ИмяПакета = СтрокаТекущая.ИмяПакета;
		СтрокаРезультата.ДляРазработки = СтрокаТекущая.ДляРазработки;
		СтрокаРезультата.МинимальнаяВерсияПосле = СтрокаТекущая.МинимальнаяВерсия;
		СтрокаРезультата.МаксимальнаяВерсия = СтрокаТекущая.МаксимальнаяВерсия;

		СтрокаСопоставляемая = ТаблицаИсходная.Найти(СтрокаТекущая.ИмяПакета, "ИмяПакета");
		Если Не СтрокаСопоставляемая = Неопределено Тогда
			СтрокаРезультата.МинимальнаяВерсияДо = СтрокаСопоставляемая.МинимальнаяВерсия;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрочитатьИзPackagedef(ПутьКФайлу)

	Попытка		
		ИнформацияОПакете = Новый ИнформацияОПакете(ПутьКФайлу);
	Исключение
		ВызватьИсключение ОшибкаРазбораМанифеста(ПутьКФайлу, ИнформацияОбОшибке());
	КонецПопытки;

	ЗаполнитьИзТаблицы(ИнформацияОПакете.Зависимости());
	ОтметитьПометкиЗависимостей(ПутьКФайлу);

КонецПроцедуры

Процедура ОтметитьПометкиЗависимостей(ПутьКФайлу)

	ТекстМанифеста = Новый ФайловоеХранилищеМанифеста().Прочитать(ПутьКФайлу);
	Парсер = Новый ПарсерОбъявленийЗависимостей();
	Пометки = Парсер.НайтиПометкиЗависимостей(ТекстМанифеста);

	Если Пометки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ИменаОбъявлений = Парсер.НайтиИменаОбъявлений(ТекстМанифеста);

	Для Каждого Пометка Из Пометки Цикл
		Если Не ПометкаСвязанаСОбъявлением(Пометка, ИменаОбъявлений) Тогда
			Продолжить;
		КонецЕсли;

		Отбор = Новый Структура("ИмяПакета, ДляРазработки", НРег(Пометка.ИмяПакета), Пометка.ДляРазработки);
		Зависимости = _Зависимости.НайтиСтроки(Отбор);
		Если Зависимости.Количество() = 1 Тогда
			Если Пометка.Транзитивная Тогда
				Зависимости[0].Транзитивная = Истина;
			Иначе
				Зависимости[0].Неявная = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПометкаСвязанаСОбъявлением(Пометка, ИменаОбъявлений)

	КоличествоВычисляемыхИмен = 0;
	КоличествоОбъявленийПакета = 0;

	Для Каждого Объявление Из ИменаОбъявлений Цикл
		Если Объявление.ДляРазработки <> Пометка.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Если Объявление.ИмяПакета = Неопределено Тогда
			КоличествоВычисляемыхИмен = КоличествоВычисляемыхИмен + 1;
		ИначеЕсли НРег(Объявление.ИмяПакета) = НРег(Пометка.ИмяПакета) Тогда
			КоличествоОбъявленийПакета = КоличествоОбъявленийПакета + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОбъявленийПакета <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Если каждому вычисляемому имени соответствует отдельный пакет, оно не могло создать помеченный пакет.
	НеописанныеЗависимости = НайтиЗависимостиБезЛитеральногоИмени(ИменаОбъявлений, Пометка.ДляРазработки);
	Возврат КоличествоВычисляемыхИмен = НеописанныеЗависимости.Количество();

КонецФункции

Функция НайтиЗависимостиБезЛитеральногоИмени(ИменаОбъявлений, ДляРазработки)

	Результат = Новый Массив();
	Для Каждого Зависимость Из _Зависимости Цикл
		Если Зависимость.ДляРазработки <> ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		ИмяЕстьВОбъявлениях = Ложь;
		Для Каждого Объявление Из ИменаОбъявлений Цикл
			Если Объявление.ДляРазработки = ДляРазработки
				И НРег(Объявление.ИмяПакета) = Зависимость.ИмяПакета Тогда
				ИмяЕстьВОбъявлениях = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не ИмяЕстьВОбъявлениях Тогда
			Результат.Добавить(Зависимость);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОшибкаРазбораМанифеста(ПутьКФайлу, Причина)

	Возврат ФабрикаОшибок.Обернуть(
		Причина,
		КодыОшибокDepos.РазборМанифестаНеУдался(),
		СтрШаблон("Возникла ошибка при получении зависимостей из файла манифеста '%1'", ПутьКФайлу),
		Новый Структура("ПутьКФайлу", ПутьКФайлу)
	);

КонецФункции

Процедура ПрочитатьИзOpmMetadata(ПутьКФайлу)

	ЗависимостиИзМанифеста = Новый ПарсерOpmMetadata().Разобрать(ПутьКФайлу).Зависимости;
	_Зависимости.Очистить();

	Для Каждого Зависимость Из ЗависимостиИзМанифеста Цикл
		ДобавитьЗависимостьВТаблицу(
			Зависимость.ИмяПакета,
			Зависимость.МинимальнаяВерсия,
			Зависимость.МаксимальнаяВерсия,
			Зависимость.ДляРазработки
		);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗависимостьВТаблицу(
	Знач ИмяПакета, МинимальнаяВерсия, МаксимальнаяВерсия, ДляРазработки, Транзитивная = Ложь, Неявная = Ложь
)

	ИмяПакета = НРег(ИмяПакета);
	СтрокаТаблицы = _Зависимости.Найти(ИмяПакета, "ИмяПакета");
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = _Зависимости.Добавить();
	КонецЕсли;

	СтрокаТаблицы.ИмяПакета = ИмяПакета;
	СтрокаТаблицы.МинимальнаяВерсия = МинимальнаяВерсия;
	СтрокаТаблицы.МаксимальнаяВерсия = МаксимальнаяВерсия;
	СтрокаТаблицы.ДляРазработки = ДляРазработки;
	СтрокаТаблицы.Транзитивная = Транзитивная;
	СтрокаТаблицы.Неявная = Неявная;

КонецПроцедуры

Процедура ПрименитьФильтрПоИмени(Фильтр, ИсключатьСовпадения)

	ФильтрИмен = Новый ФильтрИменПакетов(Фильтр);

	Количество = _Зависимости.Количество();
	Для Инд = 1 По Количество Цикл
		СтрокаТаблицы = _Зависимости[Количество - Инд];
		СовпадаетСФильтром = ФильтрИмен.Совпадает(СтрокаТаблицы.ИмяПакета);
		Если СовпадаетСФильтром = ИсключатьСовпадения Тогда
			_Зависимости.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПустаяТаблицаЗависимостей()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Зависимости = Новый ТаблицаЗначений();
	Зависимости.Колонки.Добавить("ИмяПакета", ТипСтрока);
	Зависимости.Колонки.Добавить("ДляРазработки", Новый ОписаниеТипов("Булево"));
	Зависимости.Колонки.Добавить("Транзитивная", Новый ОписаниеТипов("Булево"));
	Зависимости.Колонки.Добавить("Неявная", Новый ОписаниеТипов("Булево"));
	Зависимости.Колонки.Добавить("МинимальнаяВерсия", ТипСтрока);
	Зависимости.Колонки.Добавить("МаксимальнаяВерсия", ТипСтрока);

	Возврат Зависимости;

КонецФункции

#КонецОбласти
