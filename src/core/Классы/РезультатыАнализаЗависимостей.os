#Использовать "../../internal"

#Область ОписаниеПеременных

Перем _Элементы; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

// Создает пустой результат анализа зависимостей.
Процедура ПриСозданииОбъекта()
	
	_Элементы = Новый Массив();
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает диагностические элементы в порядке добавления в отдельном массиве.
//
// Параметры:
//   Тип - Строка, Неопределено - Тип диагностики или все типы.
//
// Возвращаемое значение:
//   Массив из ДиагностическийЭлементЗависимости
Функция Элементы(Тип = Неопределено) Экспорт

	Результат = Новый Массив();
	Для Каждого Элемент Из _Элементы Цикл
		Если Тип = Неопределено Или Элемент.Тип = Тип Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Добавляет проблему зависимости.
//
// Параметры:
//   Тип - Строка - Тип диагностики.
//   ИмяПакета - Строка - Имя проблемного пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   ДиагностическийЭлементЗависимости
Функция ДобавитьПроблему(Тип, ИмяПакета, ДляРазработки) Экспорт

	Возврат ДобавитьЭлемент(Тип, ИмяПакета, ДляРазработки, Истина);

КонецФункции

// Добавляет информационную рекомендацию по зависимости.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   ДиагностическийЭлементЗависимости
Функция ДобавитьРекомендацию(ИмяПакета, ДляРазработки) Экспорт

	Возврат ДобавитьЭлемент(
		ТипыДиагностикиЗависимостей.РекомендацияВерсии(),
		ИмяПакета,
		ДляРазработки,
		Ложь
	);

КонецФункции

// Удаляет элементы заданного типа для пакета в указанном контексте.
//
// Параметры:
//   Тип - Строка - Тип диагностического элемента.
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
Процедура УдалитьЭлементы(Тип, ИмяПакета, ДляРазработки) Экспорт

	Количество = _Элементы.Количество();
	Для Инд = 1 По Количество Цикл
		Индекс = Количество - Инд;
		Элемент = _Элементы[Индекс];
		Если Элемент.Тип = Тип
			И Элемент.ИмяПакета = ИмяПакета
			И Элемент.ДляРазработки = ДляРазработки Тогда
			_Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Удаляет все рекомендации по версиям из результата анализа.
Процедура ОчиститьРекомендации() Экспорт

	Количество = _Элементы.Количество();
	Для Инд = 1 По Количество Цикл
		Индекс = Количество - Инд;
		Если _Элементы[Индекс].Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии() Тогда
			_Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет наличие проблем в результате анализа.
//
// Возвращаемое значение:
//   Булево
Функция ЕстьПроблемы() Экспорт
	Возврат КоличествоПроблем() > 0;
КонецФункции

// Возвращает общее количество найденных проблем.
//
// Возвращаемое значение:
//   Число
Функция КоличествоПроблем() Экспорт

	Результат = 0;
	Для Каждого Элемент Из _Элементы Цикл
		Если Элемент.ЭтоПроблема Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Удаляет из результата анализа проблемы по имени пакета.
//
// Параметры:
//   Фильтр - Строка - Имена пакетов через запятую или пробел,
//                     маска с символами * (любые символы) и ? (один символ)
//                     или регулярное выражение (например, /^autumn-.*$/).
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ИсключитьПоИмени(Фильтр) Экспорт

	Если Не ЗначениеЗаполнено(Фильтр) Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ФильтрИмен = Новый ФильтрИменПакетов(Фильтр);
	ПрименитьИсключениеКЭлементам(ФильтрИмен);

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьЭлемент(Тип, ИмяПакета, ДляРазработки, ЭтоПроблема)

	Элемент = Новый ДиагностическийЭлементЗависимости(
		Тип,
		ИмяПакета,
		ДляРазработки,
		ЭтоПроблема
	);
	_Элементы.Добавить(Элемент);

	Возврат Элемент;

КонецФункции

Процедура ПрименитьИсключениеКЭлементам(ФильтрИмен)

	Количество = _Элементы.Количество();
	Для Инд = 1 По Количество Цикл
		Индекс = Количество - Инд;
		Если ФильтрИмен.Совпадает(_Элементы[Индекс].ИмяПакета) Тогда
			_Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
