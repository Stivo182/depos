// BSLLS:ExportVariables-off

#Область ОписаниеПеременных

Перем Тип Экспорт; // Строка
Перем ИмяПакета Экспорт; // Строка
Перем ДляРазработки Экспорт; // Булево
Перем ЭтоПроблема Экспорт; // Булево
Перем КраткоеОписание Экспорт; // Строка
Перем ПодробнаяПричина Экспорт; // Строка
Перем УстановленнаяВерсия Экспорт; // Строка
Перем ТребуемаяВерсия Экспорт; // Строка
Перем ТекущаяМинимальнаяВерсия Экспорт; // Строка
Перем ТранзитивнаяМинимальнаяВерсия Экспорт; // Строка
Перем Файлы Экспорт; // Массив
Перем Каталог Экспорт; // Строка
Перем Требования Экспорт; // Массив
Перем ТипКонфликта Экспорт; // Строка

#КонецОбласти

#Область ОбработчикиСобытий

// Создаёт диагностический элемент зависимости.
//
// Параметры:
//   Тип - Строка - Тип диагностического элемента.
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//   ЭтоПроблема - Булево - Признак влияния элемента на строгий режим.
Процедура ПриСозданииОбъекта(Тип, ИмяПакета, ДляРазработки, ЭтоПроблема)

	ЭтотОбъект.Тип = Тип;
	ЭтотОбъект.ИмяПакета = ИмяПакета;
	ЭтотОбъект.ДляРазработки = ДляРазработки;
	ЭтотОбъект.ЭтоПроблема = ЭтоПроблема;

	КраткоеОписание = "";
	ПодробнаяПричина = "";
	УстановленнаяВерсия = "";
	ТребуемаяВерсия = "";
	ТекущаяМинимальнаяВерсия = "";
	ТранзитивнаяМинимальнаяВерсия = "";
	Файлы = Новый Массив();
	Каталог = "";
	Требования = Новый Массив();
	ТипКонфликта = "";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создает независимую копию диагностического элемента и вложенных коллекций.
//
// Возвращаемое значение:
//   ДиагностическийЭлементЗависимости
Функция Копия() Экспорт

	Результат = Новый ДиагностическийЭлементЗависимости(Тип, ИмяПакета, ДляРазработки, ЭтоПроблема);
	Результат.КраткоеОписание = КраткоеОписание;
	Результат.ПодробнаяПричина = ПодробнаяПричина;
	Результат.УстановленнаяВерсия = УстановленнаяВерсия;
	Результат.ТребуемаяВерсия = ТребуемаяВерсия;
	Результат.ТекущаяМинимальнаяВерсия = ТекущаяМинимальнаяВерсия;
	Результат.ТранзитивнаяМинимальнаяВерсия = ТранзитивнаяМинимальнаяВерсия;
	Результат.Каталог = Каталог;
	Результат.ТипКонфликта = ТипКонфликта;

	Для Каждого Путь Из Файлы Цикл
		Результат.Файлы.Добавить(Путь);
	КонецЦикла;

	Для Каждого Требование Из Требования Цикл
		Результат.Требования.Добавить(Требование.Копия());
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
