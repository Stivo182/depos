#Область ПрограммныйИнтерфейс

// Возвращает тип проверки использования зависимостей.
//
// Возвращаемое значение:
//   Строка - Тип проверки.
Функция Использование() Экспорт

	Возврат "usage";

КонецФункции

// Возвращает тип проверки установленных пакетов.
//
// Возвращаемое значение:
//   Строка - Тип проверки.
Функция УстановленныеПакеты() Экспорт

	Возврат "installed";

КонецФункции

// Возвращает тип проверки транзитивных зависимостей.
//
// Возвращаемое значение:
//   Строка - Тип проверки.
Функция ТранзитивныеЗависимости() Экспорт

	Возврат "transitive";

КонецФункции

// Возвращает все допустимые типы проверок зависимостей.
//
// Возвращаемое значение:
//   Массив из Строка - Имена проверок для параметра --checks.
Функция Все() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Использование());
	Результат.Добавить(УстановленныеПакеты());
	Результат.Добавить(ТранзитивныеЗависимости());

	Возврат Результат;

КонецФункции

#КонецОбласти
