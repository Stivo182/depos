#Область ПрограммныйИнтерфейс

// Возвращает код ошибки отсутствующего файла манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция МанифестНеНайден() Экспорт
	Возврат "manifest.not_found";
КонецФункции

// Возвращает код ошибки отсутствующего каталога манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция КаталогМанифестаНеНайден() Экспорт
	Возврат "manifest.directory_not_found";
КонецФункции

// Возвращает код ошибки неустановленного пакета.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ПакетНеУстановлен() Экспорт
	Возврат "package.not_installed";
КонецФункции

// Возвращает код ошибки неподдерживаемого формата вывода.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ФорматВыводаНеПоддерживается() Экспорт
	Возврат "output.format_not_supported";
КонецФункции

// Возвращает код ошибки ненастроенных хостов реестра.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ХостыРеестраНеНастроены() Экспорт
	Возврат "registry.hosts_not_configured";
КонецФункции

// Возвращает код ошибки недоступного реестра.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция РеестрНедоступен() Экспорт
	Возврат "registry.unavailable";
КонецФункции

// Возвращает код ошибки недоступных версий пакета.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ВерсииПакетаНедоступны() Экспорт
	Возврат "package.versions_unavailable";
КонецФункции

// Возвращает код ошибки чтения манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ЧтениеМанифестаНеУдалось() Экспорт
	Возврат "manifest.read_failed";
КонецФункции

// Возвращает код ошибки записи манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ЗаписьМанифестаНеУдалась() Экспорт
	Возврат "manifest.write_failed";
КонецФункции

// Возвращает код ошибки разбора манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция РазборМанифестаНеУдался() Экспорт
	Возврат "manifest.parse_failed";
КонецФункции

// Возвращает код ошибки некорректной структуры манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция СтруктураМанифестаНекорректна() Экспорт
	Возврат "manifest.structure_invalid";
КонецФункции

// Возвращает код ошибки некорректной версии зависимости.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ВерсияЗависимостиНекорректна() Экспорт
	Возврат "dependency.version_invalid";
КонецФункции

// Возвращает код ошибки неподдерживаемого формата манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ФорматМанифестаНеПоддерживается() Экспорт
	Возврат "manifest.format_not_supported";
КонецФункции

// Возвращает код ошибки конфликта источников манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция КонфликтИсточниковМанифеста() Экспорт
	Возврат "manifest.source_conflict";
КонецФункции

// Возвращает код ошибки проверки манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ПроверкаМанифестаНеУдалась() Экспорт
	Возврат "manifest.verification_failed";
КонецФункции

// Возвращает код ошибки обновления манифеста.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ОбновлениеМанифестаНеУдалось() Экспорт
	Возврат "manifest.update_failed";
КонецФункции

// Возвращает код ошибки восстановления манифеста из резервной копии.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ВосстановлениеМанифестаНеУдалось() Экспорт
	Возврат "manifest.restore_failed";
КонецФункции

// Возвращает код ошибки отсутствующей зависимости.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ЗависимостьНеНайдена() Экспорт
	Возврат "dependency.not_found";
КонецФункции

// Возвращает код ошибки некорректного типа целевой версии.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ТипЦелевойВерсииНекорректен() Экспорт
	Возврат "target.invalid";
КонецФункции

// Возвращает код ошибки некорректного регулярного выражения фильтра.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция РегулярноеВыражениеФильтраНекорректно() Экспорт
	Возврат "filter.regex_invalid";
КонецФункции

// Возвращает код ошибки отсутствующего каталога исходников.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция КаталогИсходниковНеНайден() Экспорт
	Возврат "source.directory_not_found";
КонецФункции

#КонецОбласти
