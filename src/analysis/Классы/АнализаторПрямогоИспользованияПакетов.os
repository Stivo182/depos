#Использовать fs
#Использовать "../../packages"
#Использовать "../../common"

#Область ОписаниеПеременных

Перем _СканерИсходников; // СканерИсходников

#КонецОбласти

#Область ОбработчикиСобытий

// Создает анализатор прямого использования пакетов в исходных файлах.
//
// Параметры:
//   СканерИсходников - СканерИсходников - Сканер импортов OneScript.
Процедура ПриСозданииОбъекта(СканерИсходников)

	_СканерИсходников = СканерИсходников;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит использования пакетов в производственных и вспомогательных исходниках.
//
// Параметры:
//   РабочийКаталог - Строка - Рабочий каталог проекта.
//   КаталогиИсходников - Массив из Строка - Каталоги производственных исходников.
//   КаталогиДляРазработки - Массив из Строка - Каталоги вспомогательных исходников.
//   ВыражениеИсключенияИменПакетов - Строка - Регулярное выражение исключаемых имен.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Используемые пакеты и файлы их использования.
Функция Проанализировать(
	РабочийКаталог,
	КаталогиИсходников,
	КаталогиДляРазработки,
	ВыражениеИсключенияИменПакетов
) Экспорт

	Результат = ПустойРезультат();
	ФильтрИмен = Новый ФильтрИменПакетов(ВыражениеИсключенияИменПакетов);

	ДобавитьПакеты(
		Результат,
		_СканерИсходников.НайтиПакеты(РазрешитьПутиКаталогов(КаталогиИсходников, РабочийКаталог)),
		Ложь,
		ФильтрИмен,
		ВыражениеИсключенияИменПакетов
	);
	ДобавитьПакеты(
		Результат,
		_СканерИсходников.НайтиПакеты(РазрешитьПутиКаталогов(КаталогиДляРазработки, РабочийКаталог)),
		Истина,
		ФильтрИмен,
		ВыражениеИсключенияИменПакетов
	);

	Возврат Результат;

КонецФункции

// Создает пустой результат анализа прямого использования пакетов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Таблица с колонками результата анализа.
Функция ПустойРезультат() Экспорт

	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("ИмяПакета", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДляРазработки", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Файлы");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПакеты(
	Результат,
	Пакеты,
	ДляРазработки,
	ФильтрИмен,
	ВыражениеИсключенияИменПакетов
)

	Для Каждого Пакет Из Пакеты Цикл
		ПакетИсключенПоИмени = ЗначениеЗаполнено(ВыражениеИсключенияИменПакетов)
			И ФильтрИмен.Совпадает(Пакет.ИмяПакета);

		Если ПакетИсключенПоИмени Тогда
			Продолжить;
		КонецЕсли;

		Отбор = Новый Структура("ИмяПакета, ДляРазработки", Пакет.ИмяПакета, ДляРазработки);
		НайденныеСтроки = Результат.НайтиСтроки(Отбор);

		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаТаблицы = Результат.Добавить();
			СтрокаТаблицы.ИмяПакета = Пакет.ИмяПакета;
			СтрокаТаблицы.ДляРазработки = ДляРазработки;
			СтрокаТаблицы.Файлы = Новый Массив();
		Иначе
			СтрокаТаблицы = НайденныеСтроки[0];
		КонецЕсли;

		СтрокаТаблицы.Файлы.Добавить(Пакет.Файл);
	КонецЦикла;

КонецПроцедуры

Функция РазрешитьПутиКаталогов(Каталоги, РабочийКаталог)

	Результат = Новый Массив();
	Для Каждого Каталог Из Каталоги Цикл
		Каталог = СокрЛП(Каталог);

		Если РаботаСПутямиФайловойСистемы.ЭтоАбсолютныйПуть(Каталог) Тогда
			Результат.Добавить(Каталог);
		ИначеЕсли ЗначениеЗаполнено(РабочийКаталог) Тогда
			Каталог = СтрЗаменить(Каталог, "\", "/");
			Результат.Добавить(ФС.ПолныйПуть(ОбъединитьПути(РабочийКаталог, Каталог)));
		Иначе
			Результат.Добавить(СтрЗаменить(Каталог, "\", "/"));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
