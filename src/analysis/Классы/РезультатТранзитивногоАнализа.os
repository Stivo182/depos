// BSLLS:ExportVariables-off

#Область ОписаниеПеременных

Перем Конфликты Экспорт; // Массив из ДиагностическийЭлементЗависимости
Перем Требования Экспорт; // Массив из ТребованиеЗависимости

#КонецОбласти

#Область ОбработчикиСобытий

// Создает результат одного анализа транзитивного графа.
//
// Параметры:
//   Конфликты - Массив из ДиагностическийЭлементЗависимости - Найденные конфликты.
//   Требования - Массив из ТребованиеЗависимости - Собранные требования версий.
Процедура ПриСозданииОбъекта(Конфликты, Требования)

	ЭтотОбъект.Конфликты = Конфликты;
	ЭтотОбъект.Требования = Требования;

КонецПроцедуры

#КонецОбласти
