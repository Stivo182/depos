#Область ОписаниеПеременных

Перем _РезультатыАнализа; // РезультатыАнализаЗависимостей
Перем _ПовторныеОбъявления; // Массив из Строка

#КонецОбласти

#Область ОбработчикиСобытий

// Создает объект правил приоритета диагностик зависимостей.
//
// Параметры:
//   РезультатыАнализа - РезультатыАнализаЗависимостей - Текущие результаты анализа.
//   ПовторныеОбъявления - Массив из Строка - Ключи неоднозначных объявлений.
Процедура ПриСозданииОбъекта(РезультатыАнализа, ПовторныеОбъявления)

	_РезультатыАнализа = РезультатыАнализа;
	_ПовторныеОбъявления = ПовторныеОбъявления;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие структурной диагностики объявления.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если структурная диагностика уже сформирована.
Функция ЕстьСтруктурнаяДиагностика(ИмяПакета, ДляРазработки) Экспорт

	Если ЕстьПовторноеОбъявление(ИмяПакета, ДляРазработки) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Элемент Из _РезультатыАнализа.Элементы() Цикл
		СовпадаетИмяПакета = Элемент.ИмяПакета = НРег(ИмяПакета);
		СовпадаетКонтекст = Элемент.ДляРазработки = ДляРазработки;
		ЭтоСтруктурнаяДиагностика = ТипыДиагностикиЗависимостей.ЭтоСтруктурнаяДиагностика(Элемент.Тип);
		ПодходящаяДиагностика = СовпадаетИмяПакета И СовпадаетКонтекст И ЭтоСтруктурнаяДиагностика;

		Если ПодходящаяДиагностика Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие ошибки пакета в указанном контексте.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибка уже сформирована.
Функция ЕстьОшибкаПакета(ИмяПакета, ДляРазработки) Экспорт

	Для Каждого Элемент Из _РезультатыАнализа.Элементы() Цикл
		СовпадаетИмяПакета = Элемент.ИмяПакета = НРег(ИмяПакета);
		СовпадаетКонтекст = Элемент.ДляРазработки = ДляРазработки;
		ЭтоОшибка = Элемент.Уровень = УровниДиагностикиЗависимостей.Ошибка();

		Если СовпадаетИмяПакета И СовпадаетКонтекст И ЭтоОшибка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие более приоритетной диагностики объявления.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если судьба объявления уже определена другой диагностикой.
Функция ЕстьДиагностикаОбъявленияБолееВысокогоУровня(ИмяПакета, ДляРазработки) Экспорт

	Для Каждого Элемент Из _РезультатыАнализа.Элементы() Цикл
		СовпадаетИмяПакета = Элемент.ИмяПакета = НРег(ИмяПакета);
		СовпадаетКонтекст = Элемент.ДляРазработки = ДляРазработки;
		ДиагностикаОпределяетСудьбуОбъявления = Элемент.Тип = ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую()
			Или Элемент.Тип = ТипыДиагностикиЗависимостей.ПометкаТранзитивностиНеПодтверждена();

		Если СовпадаетИмяПакета И СовпадаетКонтекст И ДиагностикаОпределяетСудьбуОбъявления Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие повторного объявления в указанном контексте.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если объявление неоднозначно.
Функция ЕстьПовторноеОбъявление(ИмяПакета, ДляРазработки) Экспорт

	Возврат _ПовторныеОбъявления.Найти(КлючОбъявления(ИмяПакета, ДляРазработки)) <> Неопределено;

КонецФункции

// Проверяет наличие диагностики указанного типа для пакета.
//
// Параметры:
//   Тип - Строка - Тип диагностики.
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Булево - Истина, если диагностика найдена.
Функция ЕстьДиагностика(Тип, ИмяПакета) Экспорт

	Возврат НайтиДиагностическийЭлемент(Тип, ИмяПакета) <> Неопределено;

КонецФункции

// Находит диагностику указанного типа для пакета.
//
// Параметры:
//   Тип - Строка - Тип диагностики.
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Структура, Неопределено - Найденный элемент диагностики.
Функция НайтиДиагностическийЭлемент(Тип, ИмяПакета) Экспорт

	Для Каждого Элемент Из _РезультатыАнализа.Элементы(Тип) Цикл
		Если Элемент.ИмяПакета = НРег(ИмяПакета) Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Проверяет, что структурная диагностика уже удаляет или переносит объявление.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если другое исправление уже меняет объявление.
Функция СтруктурнаяДиагностикаУдаляетИлиПереносит(ИмяПакета, ДляРазработки) Экспорт

	Если ЕстьПовторноеОбъявление(ИмяПакета, ДляРазработки) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Элемент Из _РезультатыАнализа.Элементы() Цикл
		ИзменяетОбъявление = ТипыДиагностикиЗависимостей.ИзменяетОбъявлениеЗависимости(Элемент.Тип);
		СовпадаетИмяПакета = Элемент.ИмяПакета = НРег(ИмяПакета);
		СовпадаетКонтекст = Элемент.ДляРазработки = ДляРазработки;
		ПодходящаяДиагностика = ИзменяетОбъявление И СовпадаетИмяПакета И СовпадаетКонтекст;

		Если ПодходящаяДиагностика Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие диагностики графа с учетом контекста.
//
// Параметры:
//   Тип - Строка - Тип диагностики.
//   ТолькоПроизводственные - Булево - Исключить диагностики для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если диагностика найдена.
Функция ЕстьДиагностикаГрафа(Тип, ТолькоПроизводственные) Экспорт

	Для Каждого Элемент Из _РезультатыАнализа.Элементы(Тип) Цикл
		Если Не ТолькоПроизводственные Или Не Элемент.ДляРазработки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Формирует ключ объявления пакета и контекста.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Строка - Ключ объявления.
Функция КлючОбъявления(ИмяПакета, ДляРазработки) Экспорт

	Возврат НРег(ИмяПакета) + Символы.Таб + ?(ДляРазработки, "1", "0");

КонецФункции

#КонецОбласти
