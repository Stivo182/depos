#Использовать fs
#Использовать "../../manifest"
#Использовать "../../packages"
#Использовать "../../common"

#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений, Неопределено
Перем _РабочийКаталог; // Строка, Неопределено
Перем _КаталогиИсходников; // Массив из Строка
Перем _КаталогиВспомогательныхИсходников; // Массив из Строка
Перем _ИсключитьЗависимостиДляРазработки; // Булево
Перем _ВыражениеИсключенияИменПакетов; // Строка
Перем _ИспользуемыеПакеты; // ТаблицаЗначений
Перем _УстановленныеПакеты; // Соответствие
Перем _КэшМетаданныхПакетов; // Соответствие
Перем _ПоврежденныеПакеты; // ТаблицаЗначений
Перем _РезультатыАнализа; // РезультатыАнализа
Перем _СканерИсходников; // СканерИсходников
Перем _СканерУстановленныхПакетов; // СканерУстановленныхПакетов
Перем _АнализаторТранзитивныхЗависимостей; // АнализаторТранзитивныхЗависимостей

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Пластилин("СканерИсходников") СканерИсходников,
	&Пластилин("СканерУстановленныхПакетов") СканерУстановленныхПакетов,
	&Пластилин("АнализаторТранзитивныхЗависимостей") АнализаторТранзитивныхЗависимостей
)

	_СканерИсходников = СканерИсходников;
	_СканерУстановленныхПакетов = СканерУстановленныхПакетов;
	_АнализаторТранзитивныхЗависимостей = АнализаторТранзитивныхЗависимостей;
	_РезультатыАнализа = Новый РезультатыАнализаЗависимостей();
	_КаталогиИсходников = Новый Массив();
	_КаталогиВспомогательныхИсходников = Новый Массив();
	_ВыражениеИсключенияИменПакетов = "";

	_ИспользуемыеПакеты = Новый ТаблицаЗначений();
	_ИспользуемыеПакеты.Колонки.Добавить("ИмяПакета", Новый ОписаниеТипов("Строка"));
	_ИспользуемыеПакеты.Колонки.Добавить("ДляРазработки", Новый ОписаниеТипов("Булево"));
	_ИспользуемыеПакеты.Колонки.Добавить("Файлы");

	ИсключатьДляРазработки(Ложь);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет анализ зависимостей и выявляет проблемы.
//
// Сканирует исходный код в указанных каталогах, ищет использования пакетов
// и сопоставляет их с декларированными зависимостями для выявления:
//   - Отсутствующих зависимостей (используется в коде, но не объявлено в манифесте)
//   - Неиспользуемых зависимостей (объявлено в манифесте, но не используется в коде)
//
// Параметры:
//   Зависимости - ЗависимостиПакета - Объект с зависимостями из манифеста пакета
//   ВыборПроверок - ВыборПроверокЗависимостей, Неопределено - Выбранные проверки.
//                                                               Неопределено означает все проверки.
//
// Возвращаемое значение:
//   РезультатыАнализаЗависимостей - Результат анализа, содержащий найденные ошибки
Функция ПроверитьЗависимости(Зависимости, ВыборПроверок = Неопределено) Экспорт
	
	_Зависимости = Новый ЗависимостиПакета()
		.ЗаполнитьИзТаблицы(Зависимости.СкопироватьВТаблицу())
		.УдалитьПоИмени(_ВыражениеИсключенияИменПакетов)
		.СкопироватьВТаблицу();

	_РезультатыАнализа = Новый РезультатыАнализаЗависимостей();
	_КэшМетаданныхПакетов = Новый Соответствие();
	_УстановленныеПакеты = Неопределено;
	_ПоврежденныеПакеты = Неопределено;

	Если ВыборПроверок = Неопределено Тогда
		ВыборПроверок = Новый ВыборПроверокЗависимостей();
	КонецЕсли;

	Если ВыборПроверок.ПроверятьИспользование() Тогда
		НайтиИспользуемыеПакеты();
	КонецЕсли;

	Если ВыборПроверок.ПроверятьУстановленныеПакеты()
		Или ВыборПроверок.ПроверятьТранзитивныеЗависимости() Тогда
		НайтиУстановленныеПакеты();
	КонецЕсли;

	Если ВыборПроверок.ПроверятьИспользование() Тогда
		ПроверитьОтсутствующиеВМанифестеПакеты();
	КонецЕсли;

	Если ВыборПроверок.ПроверятьУстановленныеПакеты() Тогда
		ПроверитьУстановленныеПакеты();
	ИначеЕсли ВыборПроверок.ПроверятьТранзитивныеЗависимости() Тогда
		ПроверитьПоврежденныеПрямыеПакеты();
	КонецЕсли;

	ВсеТребования = Новый Массив();
	Если ВыборПроверок.ПроверятьТранзитивныеЗависимости() Тогда
		ВсеТребования = ПроверитьТранзитивныеЗависимости();
		ПроверитьПометкиТранзитивныхЗависимостей(ВсеТребования, Зависимости);
	КонецЕсли;

	Если ВыборПроверок.ПроверятьИспользование() Тогда
		ПроверитьНеиспользуемыеПакеты();
	КонецЕсли;

	Если ВыборПроверок.ПроверятьТранзитивныеЗависимости() Тогда
		СформироватьРекомендацииПоВерсиям(ВсеТребования);
	КонецЕсли;
	
	Возврат _РезультатыАнализа;
	
КонецФункции

// Устанавливает рабочий каталог для разрешения относительных путей.
//
// Рабочий каталог используется как базовый путь для преобразования
// относительных путей каталогов исходников в абсолютные.
//
// Параметры:
//   Каталог - Строка - Полный путь к рабочему каталогу (обычно каталог манифеста).
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция РабочийКаталог(Каталог) Экспорт
	_РабочийКаталог = Каталог;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает признак исключения зависимостей для разработки из анализа.
//
// Позволяет игнорировать зависимости, помеченные как предназначенные только для разработки,
// при проверке отсутствующих и неиспользуемых пакетов.
//
// Параметры:
//   Исключить - Булево - Признак исключения зависимостей для разработки.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ИсключатьДляРазработки(Исключить = Истина) Экспорт
	_ИсключитьЗависимостиДляРазработки = Исключить;
	Возврат ЭтотОбъект;
КонецФункции

// Исключает пакеты из анализа до создания проблем и чтения их метаданных.
//
// Параметры:
//   Фильтр - Строка - Имена пакетов, маска или регулярное выражение.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция ИсключитьПоИмени(Фильтр) Экспорт
	_ВыражениеИсключенияИменПакетов = Фильтр;
	Возврат ЭтотОбъект;
КонецФункции

// Задает каталоги с основными исходниками для анализа использования пакетов.
//
// Параметры:
//   Каталоги - Массив из Строка, Строка - Массив путей к каталогам с исходниками
//                                         или строка с путями, разделенными запятыми.
//                                         Поддерживаются абсолютные и относительные пути.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция КаталогиИсходников(Каталоги) Экспорт

	_КаталогиИсходников.Очистить();
	ПрименитьКаталоги(Каталоги, _КаталогиИсходников);

	Возврат ЭтотОбъект;

КонецФункции

// Задает каталоги со вспомогательными исходниками для анализа использования пакетов.
//
// Определяет каталоги со вспомогательным кодом (тесты, примеры, инструменты сборки),
// в которых будет выполняться поиск использования пакетов. Пакеты, найденные
// в этих каталогах, помечаются как используемые для разработки.
//
// Параметры:
//   Каталоги - Массив из Строка, Строка - Массив путей к каталогам со вспомогательными исходниками
//                                         или строка с путями, разделенными запятыми.
//                                         Поддерживаются абсолютные и относительные пути.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция КаталогиДляРазработки(Каталоги) Экспорт

	_КаталогиВспомогательныхИсходников.Очистить();
	ПрименитьКаталоги(Каталоги, _КаталогиВспомогательныхИсходников);

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьКаталоги(Источник, Приемник)
		
	Приемник.Очистить();

	ИсточникМассив = Источник;
	Если ТипЗнч(ИсточникМассив) = Тип("Строка") Тогда
		ИсточникМассив = СтрРазделить(ИсточникМассив, ",", Ложь);
	КонецЕсли;

	Для Каждого Каталог Из ИсточникМассив Цикл
		Приемник.Добавить(Каталог);
	КонецЦикла;

КонецПроцедуры

Процедура НайтиИспользуемыеПакеты()
	
	_ИспользуемыеПакеты.Очистить();
	ФильтрИмен = Новый ФильтрИменПакетов(_ВыражениеИсключенияИменПакетов);

	ДобавитьИспользуемыеПакеты(
		_СканерИсходников.НайтиПакеты(ПолучитьАбсолютныеПутиКаталогов(_КаталогиИсходников)),
		Ложь,
		ФильтрИмен
	);
	ДобавитьИспользуемыеПакеты(
		_СканерИсходников.НайтиПакеты(ПолучитьАбсолютныеПутиКаталогов(_КаталогиВспомогательныхИсходников)),
		Истина,
		ФильтрИмен
	);

КонецПроцедуры

Процедура НайтиУстановленныеПакеты()
	
	КаталогБиблиотек = ОбъединитьПути(_РабочийКаталог, "oscript_modules");
	Если Не ФС.КаталогСуществует(КаталогБиблиотек) Тогда
		КаталогБиблиотек = "";
	КонецЕсли;

	_УстановленныеПакеты = _СканерУстановленныхПакетов
		.УстановитьКаталогБиблиотек(КаталогБиблиотек)
		.УстановитьКонфигурационныйФайл(ОбъединитьПути(_РабочийКаталог, "oscript.cfg"))
		.ИсключитьПоИмени(_ВыражениеИсключенияИменПакетов)
		.НайтиВсеПакеты();

	_ПоврежденныеПакеты = _СканерУстановленныхПакетов.ПоврежденныеПакеты();
	_КэшМетаданныхПакетов = _СканерУстановленныхПакетов.КэшМетаданныхПакетов();

КонецПроцедуры

Процедура ДобавитьИспользуемыеПакеты(Пакеты, ДляРазработки, ФильтрИмен)
	
	Для Каждого Пакет Из Пакеты Цикл

		Если ЗначениеЗаполнено(_ВыражениеИсключенияИменПакетов)
			И ФильтрИмен.Совпадает(Пакет.ИмяПакета) Тогда
			Продолжить;
		КонецЕсли;

		Отбор = Новый Структура("ИмяПакета, ДляРазработки", Пакет.ИмяПакета, ДляРазработки);
		НайденныеСтроки = _ИспользуемыеПакеты.НайтиСтроки(Отбор);

		Если НайденныеСтроки.Количество() = 0 Тогда
			СтрокаТаблицы = _ИспользуемыеПакеты.Добавить();
			СтрокаТаблицы.ИмяПакета = Пакет.ИмяПакета;
			СтрокаТаблицы.ДляРазработки = ДляРазработки;
			СтрокаТаблицы.Файлы = Новый Массив();
		Иначе
			СтрокаТаблицы = НайденныеСтроки[0];
		КонецЕсли;

		СтрокаТаблицы.Файлы.Добавить(Пакет.Файл);

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтсутствующиеВМанифестеПакеты()
	
	Для Каждого ИспользуемыйПакет Из _ИспользуемыеПакеты Цикл

		Если _ИсключитьЗависимостиДляРазработки И ИспользуемыйПакет.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Отбор = Новый Структура();
		Отбор.Вставить("ИмяПакета", ИспользуемыйПакет.ИмяПакета); 
		
		Если Не ИспользуемыйПакет.ДляРазработки Тогда
			Отбор.Вставить("ДляРазработки", ИспользуемыйПакет.ДляРазработки); 
		КонецЕсли;
			
		Если _Зависимости.НайтиСтроки(Отбор).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		Файлы = Новый СписокЗначений();
		Файлы.ЗагрузитьЗначения(ИспользуемыйПакет.Файлы);
		Файлы.СортироватьПоЗначению();

		Элемент = _РезультатыАнализа.ДобавитьПроблему(
			ТипыДиагностикиЗависимостей.ОтсутствуетВМанифесте(),
			ИспользуемыйПакет.ИмяПакета,
			ИспользуемыйПакет.ДляРазработки
		);
		Элемент.Файлы = Файлы.ВыгрузитьЗначения();
		Элемент.УстановленнаяВерсия = ВерсияУстановленногоПакета(ИспользуемыйПакет.ИмяПакета);
		
	КонецЦикла;

КонецПроцедуры

Функция ВерсияУстановленногоПакета(ИмяПакета)

	Если _УстановленныеПакеты = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	КаталогПакета = _УстановленныеПакеты[ИмяПакета];
	Если КаталогПакета = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьВерсиюПакета(КаталогПакета);

КонецФункции

Процедура ПроверитьНеиспользуемыеПакеты()
	
	Для Каждого Зависимость Из _Зависимости Цикл

		Если _ИсключитьЗависимостиДляРазработки И Зависимость.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Отбор = Новый Структура("ИмяПакета, ДляРазработки", Зависимость.ИмяПакета, Зависимость.ДляРазработки);
		
		Если _ИспользуемыеПакеты.НайтиСтроки(Отбор).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Зависимость.Неявная Или Зависимость.Транзитивная Тогда
			Продолжить;
		КонецЕсли;

		_РезультатыАнализа.ДобавитьПроблему(
			ТипыДиагностикиЗависимостей.НеИспользуетсяНапрямую(),
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьУстановленныеПакеты()
	
	Для Каждого Зависимость Из _Зависимости Цикл

		Если _ИсключитьЗависимостиДляРазработки И Зависимость.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		ОтборПоврежденногоПакета = Новый Структура("ИмяПакета", Зависимость.ИмяПакета);
		ПоврежденныеПакеты = _ПоврежденныеПакеты.НайтиСтроки(ОтборПоврежденногоПакета);
		Если ПоврежденныеПакеты.Количество() > 0 Тогда
			ДобавитьПоврежденныйПакет(Зависимость, ПоврежденныеПакеты[0]);
			Продолжить;
		КонецЕсли;

		КаталогПакета = _УстановленныеПакеты[Зависимость.ИмяПакета];
		Если КаталогПакета = Неопределено Тогда
			_РезультатыАнализа.ДобавитьПроблему(
				ТипыДиагностикиЗависимостей.НеУстановлен(),
				Зависимость.ИмяПакета,
				Зависимость.ДляРазработки
			);
			Продолжить;
		КонецЕсли;

		Если Не (ЗначениеЗаполнено(Зависимость.МинимальнаяВерсия) 
			Или ЗначениеЗаполнено(Зависимость.МаксимальнаяВерсия)) Тогда
			Продолжить;
		КонецЕсли;

		УстановленнаяВерсия = ПолучитьВерсиюПакета(КаталогПакета);
		Если Не ЗначениеЗаполнено(УстановленнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		ТребуемаяВерсия = ПолучитьПредставлениеТребуемойВерсии(Зависимость, УстановленнаяВерсия);
		Если ЗначениеЗаполнено(ТребуемаяВерсия) Тогда
			Элемент = _РезультатыАнализа.ДобавитьПроблему(
				ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
				Зависимость.ИмяПакета,
				Зависимость.ДляРазработки
			);
			Элемент.ТребуемаяВерсия = ТребуемаяВерсия;
			Элемент.УстановленнаяВерсия = УстановленнаяВерсия;
			Элемент.Каталог = КаталогПакета;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоврежденныеПрямыеПакеты()

	Для Каждого Зависимость Из _Зависимости Цикл

		Если _ИсключитьЗависимостиДляРазработки И Зависимость.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Отбор = Новый Структура("ИмяПакета", Зависимость.ИмяПакета);
		ПоврежденныеПакеты = _ПоврежденныеПакеты.НайтиСтроки(Отбор);
		Если ПоврежденныеПакеты.Количество() > 0 Тогда
			ДобавитьПоврежденныйПакет(Зависимость, ПоврежденныеПакеты[0]);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоврежденныйПакет(Зависимость, ПоврежденныйПакет)

	Элемент = _РезультатыАнализа.ДобавитьПроблему(
		ТипыДиагностикиЗависимостей.Поврежден(),
		Зависимость.ИмяПакета,
		Зависимость.ДляРазработки
	);
	Элемент.Каталог = ПоврежденныйПакет.Каталог;
	Элемент.ПодробнаяПричина = ПоврежденныйПакет.Причина;

КонецПроцедуры

Функция ПроверитьТранзитивныеЗависимости()

	Конфликты = _АнализаторТранзитивныхЗависимостей
		.ИсключатьДляРазработки(_ИсключитьЗависимостиДляРазработки)
		.ИсключитьПоИмени(_ВыражениеИсключенияИменПакетов)
		.Проверить(
			Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(_Зависимости),
			_УстановленныеПакеты,
			_КэшМетаданныхПакетов
		);

	Для Каждого Конфликт Из Конфликты Цикл
		Элемент = _РезультатыАнализа.ДобавитьПроблему(
			ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
			Конфликт.ИмяПакета,
			Конфликт.ДляРазработки
		);
		Элемент.ТипКонфликта = Конфликт.ТипКонфликта;
		Элемент.КраткоеОписание = Конфликт.КраткоеОписание;
		Элемент.ТребуемаяВерсия = Конфликт.ТребуемаяВерсия;
		Элемент.УстановленнаяВерсия = Конфликт.УстановленнаяВерсия;

		Для Каждого Требование Из Конфликт.Требования Цикл
			Элемент.Требования.Добавить(Требование.Копия());
		КонецЦикла;
	КонецЦикла;

	ВсеТребования = _АнализаторТранзитивныхЗависимостей.ПолучитьТребования();
	Возврат ВсеТребования;

КонецФункции

Функция ПодтвержденаТранзитивность(Зависимость, ВсеТребования)

	Для Каждого Требование Из ВсеТребования Цикл
		Если Требование.ИмяПакета <> Зависимость.ИмяПакета
			Или Требование.КорневаяПрямаяЗависимость = Зависимость.ИмяПакета
			Или Не Зависимость.ДляРазработки И Требование.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Возврат Истина;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПроверитьПометкиТранзитивныхЗависимостей(ВсеТребования, ИсходныеЗависимости)

	ТребованияБезИсключений = Неопределено;

	Для Каждого Зависимость Из _Зависимости Цикл
		Если Не Зависимость.Транзитивная
			Или _ИсключитьЗависимостиДляРазработки И Зависимость.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Если ПодтвержденаТранзитивность(Зависимость, ВсеТребования) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(_ВыражениеИсключенияИменПакетов) Тогда
			Если ТребованияБезИсключений = Неопределено Тогда
				ТребованияБезИсключений = ПолучитьТребованияБезИсключений(ИсходныеЗависимости);
			КонецЕсли;

			Если ПодтвержденаТранзитивность(Зависимость, ТребованияБезИсключений) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		_РезультатыАнализа.ДобавитьПроблему(
			ТипыДиагностикиЗависимостей.ПометкаТранзитивностиНеПодтверждена(),
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТребованияБезИсключений(ИсходныеЗависимости)

	УстановленныеПакеты = _СканерУстановленныхПакетов
		.ИсключитьПоИмени("")
		.НайтиВсеПакеты();

	Анализатор = Новый АнализаторТранзитивныхЗависимостей();
	Анализатор.ИсключатьДляРазработки(_ИсключитьЗависимостиДляРазработки);
	Анализатор.Проверить(
		ИсходныеЗависимости,
		УстановленныеПакеты,
		_СканерУстановленныхПакетов.КэшМетаданныхПакетов()
	);

	Возврат Анализатор.ПолучитьТребования();

КонецФункции

Процедура СформироватьРекомендацииПоВерсиям(ВсеТребования)

	Для Каждого Кандидат Из _Зависимости Цикл

		Если Не ЗначениеЗаполнено(Кандидат.МинимальнаяВерсия)
			Или ЗначениеЗаполнено(Кандидат.МаксимальнаяВерсия)
			Или _ИсключитьЗависимостиДляРазработки И Кандидат.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Требования = НезависимыеТребованияКандидата(Кандидат, ВсеТребования);
		МинимальнаяВерсия = НаиболееСтрогийМинимум(Требования);

		Если ЕстьПрямойКонфликтПакета(Кандидат.ИмяПакета)
			Или ЕстьКонфликтИсточника(Кандидат, Требования, ВсеТребования)
			Или ТребованияНесовместимы(Требования)
			Или Не ЗначениеЗаполнено(МинимальнаяВерсия)
			Или СравнитьВерсии(МинимальнаяВерсия, Кандидат.МинимальнаяВерсия) < 0 Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьРекомендациюПоВерсии(Кандидат, МинимальнаяВерсия, Требования);

	КонецЦикла;

КонецПроцедуры

Функция НезависимыеТребованияКандидата(Кандидат, ВсеТребования)

	Результат = Новый Массив();

	Для Каждого Требование Из ВсеТребования Цикл

		Если Требование.ИмяПакета <> Кандидат.ИмяПакета
			Или Требование.КорневаяПрямаяЗависимость = Кандидат.ИмяПакета
			Или Не Кандидат.ДляРазработки И Требование.ДляРазработки
			Или Требование.ЦепочкаЗависимостей.Количество() <> 2
			Или ЦепочкаПовторяетПакет(Требование.ЦепочкаЗависимостей, Кандидат.ИмяПакета) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Требование);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьКонфликтИсточника(Кандидат, Требования, ВсеТребования)

	Для Каждого Требование Из Требования Цикл
		Если ЕстьПрямойКонфликтПакета(Требование.КорневаяПрямаяЗависимость)
			Или ЕстьПрямойКонфликтПакета(Требование.ИсточникТребования)
			Или Не ВерсияПрямогоИсточникаСоответствует(Требование.КорневаяПрямаяЗависимость)
			Или ЕстьНеполныеДанныеВетки(Требование.КорневаяПрямаяЗависимость) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьТранзитивныйКонфликтИсточника(Требования)
		Или ЕстьНесовместимыеТребованияВеток(Кандидат, Требования, ВсеТребования);

КонецФункции

Функция ЕстьНеполныеДанныеВетки(КорневаяПрямаяЗависимость)

	Для Каждого Конфликт Из _РезультатыАнализа.Элементы(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт()) Цикл
		Если Конфликт.ТипКонфликта <> ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьНеУстановлена() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Требование Из Конфликт.Требования Цикл
			Если Требование.КорневаяПрямаяЗависимость = КорневаяПрямаяЗависимость Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьТранзитивныйКонфликтИсточника(Требования)

	Для Каждого Конфликт Из _РезультатыАнализа.Элементы(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт()) Цикл
		Если Конфликт.ТипКонфликта = ТипыКонфликтовЗависимостей.НесовместимыеТребования() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТребованиеКонфликта Из Конфликт.Требования Цикл
			Для Каждого Требование Из Требования Цикл
				Если ЦепочкаНачинаетсяС(
					Требование.ЦепочкаЗависимостей,
					ТребованиеКонфликта.ЦепочкаЗависимостей
				) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЦепочкаНачинаетсяС(Цепочка, Начало)

	Если Цепочка.Количество() < Начало.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По Начало.Количество() - 1 Цикл
		Если Цепочка[Индекс] <> Начало[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЕстьНесовместимыеТребованияВеток(Кандидат, ТребованияКандидата, ВсеТребования)

	ТребованияПоПакетам = Новый Соответствие();

	Для Каждого Требование Из ВсеТребования Цикл
		Если Не КореньЕстьВТребованиях(Требование.КорневаяПрямаяЗависимость, ТребованияКандидата)
			Или Не Кандидат.ДляРазработки И Требование.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		ТребованияПакета = ТребованияПоПакетам[Требование.ИмяПакета];
		Если ТребованияПакета = Неопределено Тогда
			ТребованияПакета = Новый Массив();
			ТребованияПоПакетам.Вставить(Требование.ИмяПакета, ТребованияПакета);
		КонецЕсли;

		ТребованияПакета.Добавить(Требование);
	КонецЦикла;

	Для Каждого ТребованияПакета Из ТребованияПоПакетам Цикл
		Если ТребованияНесовместимы(ТребованияПакета.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция КореньЕстьВТребованиях(КорневаяПрямаяЗависимость, Требования)

	Для Каждого Требование Из Требования Цикл
		Если Требование.КорневаяПрямаяЗависимость = КорневаяПрямаяЗависимость Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьПрямойКонфликтПакета(ИмяПакета)

	Для Каждого Элемент Из _РезультатыАнализа.Элементы() Цикл
		Если Элемент.ИмяПакета = ИмяПакета
			И (Элемент.Тип = ТипыДиагностикиЗависимостей.НеУстановлен()
			Или Элемент.Тип = ТипыДиагностикиЗависимостей.Поврежден()
			Или Элемент.Тип = ТипыДиагностикиЗависимостей.НесоответствиеВерсий()) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВерсияПрямогоИсточникаСоответствует(ИмяПакета)

	Отбор = Новый Структура("ИмяПакета", ИмяПакета);
	ПрямыеЗависимости = _Зависимости.НайтиСтроки(Отбор);
	КаталогПакета = _УстановленныеПакеты[ИмяПакета];

	Если ПрямыеЗависимости.Количество() = 0 Или КаталогПакета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановленнаяВерсия = ПолучитьВерсиюПакета(КаталогПакета);
	Если Не ЗначениеЗаполнено(УстановленнаяВерсия) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТребуемаяВерсия = ПолучитьПредставлениеТребуемойВерсии(ПрямыеЗависимости[0], УстановленнаяВерсия);
	Возврат Не ЗначениеЗаполнено(ТребуемаяВерсия);

КонецФункции

Функция ТребованияНесовместимы(Требования)

	МинимальнаяВерсия = НаиболееСтрогийМинимум(Требования);
	МаксимальнаяВерсия = НаиболееСтрогийМаксимум(Требования);

	Возврат ЗначениеЗаполнено(МинимальнаяВерсия)
		И ЗначениеЗаполнено(МаксимальнаяВерсия)
		И СравнитьВерсии(МинимальнаяВерсия, МаксимальнаяВерсия) > 0;

КонецФункции

Функция НаиболееСтрогийМинимум(Требования)

	Результат = "";

	Для Каждого Требование Из Требования Цикл
		Если Не ЗначениеЗаполнено(Требование.МинимальнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Результат)
			Или СравнитьВерсии(Требование.МинимальнаяВерсия, Результат) > 0 Тогда
			Результат = Требование.МинимальнаяВерсия;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЦепочкаПовторяетПакет(ЦепочкаЗависимостей, ИмяПакета)

	КоличествоВхождений = 0;
	Для Каждого ПакетЦепочки Из ЦепочкаЗависимостей Цикл
		Если ПакетЦепочки = ИмяПакета Тогда
			КоличествоВхождений = КоличествоВхождений + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоВхождений > 1;

КонецФункции

Функция НаиболееСтрогийМаксимум(Требования)

	Результат = "";

	Для Каждого Требование Из Требования Цикл
		Если Не ЗначениеЗаполнено(Требование.МаксимальнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Результат)
			Или СравнитьВерсии(Требование.МаксимальнаяВерсия, Результат) < 0 Тогда
			Результат = Требование.МаксимальнаяВерсия;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьРекомендациюПоВерсии(Кандидат, МинимальнаяВерсия, Требования)

	Элемент = _РезультатыАнализа.ДобавитьРекомендацию(Кандидат.ИмяПакета, Кандидат.ДляРазработки);
	Элемент.ТекущаяМинимальнаяВерсия = Кандидат.МинимальнаяВерсия;
	Элемент.ТранзитивнаяМинимальнаяВерсия = МинимальнаяВерсия;

	Для Каждого Требование Из Требования Цикл
		Если Не ЗначениеЗаполнено(Требование.МинимальнаяВерсия)
			Или СравнитьВерсии(Требование.МинимальнаяВерсия, МинимальнаяВерсия) <> 0 Тогда
			Продолжить;
		КонецЕсли;

		Элемент.Требования.Добавить(Требование.Копия());
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПредставлениеТребуемойВерсии(Зависимость, УстановленнаяВерсия)

	МеньшеМинимальной = ЗначениеЗаполнено(Зависимость.МинимальнаяВерсия) 
		И СравнитьВерсии(УстановленнаяВерсия, Зависимость.МинимальнаяВерсия) < 0;

	БольшеМаксимальной = ЗначениеЗаполнено(Зависимость.МаксимальнаяВерсия) 
		И СравнитьВерсии(УстановленнаяВерсия, Зависимость.МаксимальнаяВерсия) > 0;

	Если Не (МеньшеМинимальной Или БольшеМаксимальной) Тогда
		Возврат "";
	КонецЕсли;

	ТребуемаяВерсия = Новый Массив();

	Если ЗначениеЗаполнено(Зависимость.МинимальнаяВерсия) Тогда
		ТребуемаяВерсия.Добавить(">=" + Зависимость.МинимальнаяВерсия);
	КонецЕсли;

	Если ЗначениеЗаполнено(Зависимость.МаксимальнаяВерсия) Тогда
		ТребуемаяВерсия.Добавить("<=" + Зависимость.МаксимальнаяВерсия);
	КонецЕсли;

	ТребуемаяВерсия = СтрСоединить(ТребуемаяВерсия, ",");

	Возврат ТребуемаяВерсия;

КонецФункции

Функция СравнитьВерсии(ПерваяВерсия, ВтораяВерсия)
	Возврат Новый ВерсияПакета(ПерваяВерсия).Сравнить(ВтораяВерсия);
КонецФункции

Функция ПолучитьАбсолютныеПутиКаталогов(Каталоги)

	Результат = Новый Массив();
	Для Каждого Каталог Из Каталоги Цикл

		Каталог = СокрЛП(Каталог);

		Если РаботаСПутямиФайловойСистемы.ЭтоАбсолютныйПуть(Каталог) Тогда
			Результат.Добавить(Каталог);
		ИначеЕсли ЗначениеЗаполнено(_РабочийКаталог) Тогда
			Каталог = СтрЗаменить(Каталог, "\", "/");
			Результат.Добавить(ФС.ПолныйПуть(ОбъединитьПути(_РабочийКаталог, Каталог)));
		Иначе
			Результат.Добавить(СтрЗаменить(Каталог, "\", "/"));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьВерсиюПакета(КаталогПакета)

	ПутьКФайлу = ОбъединитьПути(КаталогПакета, "opm-metadata.xml");
	МетаданныеПакета = _КэшМетаданныхПакетов[ПутьКФайлу];

	Если МетаданныеПакета = Неопределено Тогда
		Если Не ФС.ФайлСуществует(ПутьКФайлу) Тогда
			Возврат "";
		КонецЕсли;

		МетаданныеПакета = Новый ПарсерOpmMetadata().Разобрать(ПутьКФайлу);
		_КэшМетаданныхПакетов.Вставить(ПутьКФайлу, МетаданныеПакета);
	КонецЕсли;

	Возврат МетаданныеПакета.Версия;

КонецФункции

#КонецОбласти
