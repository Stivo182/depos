#Использовать "../../packages"

#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений
Перем _ИсключитьЗависимостиДляРазработки; // Булево
Перем _РезультатСканирования; // РезультатСканированияУстановленныхПакетов
Перем _РезультатыАнализа; // РезультатыАнализаЗависимостей
Перем _ПравилаПриоритетаДиагностик; // ПравилаПриоритетаДиагностикЗависимостей
Перем _РеестрОбъявлений; // РеестрОбъявленийЗависимостей

#КонецОбласти

#Область ОбработчикиСобытий

// Создает анализатор состояния прямых зависимостей.
//
// Параметры:
//   Контекст - КонтекстАнализаЗависимостей - Данные одного запуска анализа.
Процедура ПриСозданииОбъекта(Контекст)

	_Зависимости = Контекст.Зависимости();
	_ИсключитьЗависимостиДляРазработки = Контекст.ИсключатьДляРазработки();
	_РезультатСканирования = Контекст.РезультатСканирования();
	_РезультатыАнализа = Контекст.РезультатыАнализа();
	_ПравилаПриоритетаДиагностик = Контекст.ПравилаПриоритетаДиагностик();
	_РеестрОбъявлений = Контекст.РеестрОбъявлений();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет установку, версии пакетов и совместимость версий OneScript.
//
// Параметры:
//   ВерсияСредыПакета - Строка - Минимальная версия OneScript проекта.
Процедура Проверить(ВерсияСредыПакета) Экспорт

	Для Каждого Зависимость Из _Зависимости Цикл
		Если _ИсключитьЗависимостиДляРазработки И Зависимость.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		ПоврежденныйПакет = НайтиПоврежденныйПакет(Зависимость.ИмяПакета);
		Если ПоврежденныйПакет <> Неопределено Тогда
			ДобавитьИлиОбновитьДиагностикуПоврежденногоПакета(Зависимость, ПоврежденныйПакет);
			Продолжить;
		КонецЕсли;

		КаталогПакета = _РезультатСканирования.Пакеты[Зависимость.ИмяПакета];
		Если КаталогПакета = Неопределено Тогда
			ДобавитьНеустановленныйПакет(Зависимость);
			Продолжить;
		КонецЕсли;

		МетаданныеПакета = _РезультатСканирования.МетаданныеПакетаПоКаталогу(КаталогПакета);
		УстановленнаяВерсия = ?(МетаданныеПакета = Неопределено, "", МетаданныеПакета.Версия);
		Если Не ЗначениеЗаполнено(УстановленнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		Если ДобавитьНесоответствиеВерсииЕслиОбнаружено(Зависимость, УстановленнаяВерсия, КаталогПакета) Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьНесовместимостьВерсииСреды(
			Зависимость,
			МетаданныеПакета,
			УстановленнаяВерсия,
			ВерсияСредыПакета,
			КаталогПакета
		);
	КонецЦикла;

КонецПроцедуры

// Добавляет диагностики поврежденных прямых зависимостей без остальных проверок установки.
Процедура ПроверитьПоврежденныеПакеты() Экспорт

	Для Каждого Зависимость Из _Зависимости Цикл
		Если _ИсключитьЗависимостиДляРазработки И Зависимость.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		ПоврежденныйПакет = НайтиПоврежденныйПакет(Зависимость.ИмяПакета);
		Если ПоврежденныйПакет <> Неопределено Тогда
			ДобавитьИлиОбновитьДиагностикуПоврежденногоПакета(Зависимость, ПоврежденныйПакет);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПоврежденныйПакет(ИмяПакета)

	Отбор = Новый Структура("ИмяПакета", ИмяПакета);
	ПоврежденныеПакеты = _РезультатСканирования.ПоврежденныеПакеты.НайтиСтроки(Отбор);
	Возврат ?(ПоврежденныеПакеты.Количество() = 0, Неопределено, ПоврежденныеПакеты[0]);

КонецФункции

Процедура ДобавитьНеустановленныйПакет(Зависимость)

	Элемент = _РезультатыАнализа.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.НеУстановлен(),
		Зависимость.ИмяПакета,
		Зависимость.ДляРазработки
	);
	Элемент.ТребуемаяВерсия = ОграниченияВерсийПакетов.Представление(Зависимость);
	Элемент.КраткоеОписание = _РеестрОбъявлений.Представление(Зависимость);

КонецПроцедуры

Функция ДобавитьНесоответствиеВерсииЕслиОбнаружено(Зависимость, УстановленнаяВерсия, КаталогПакета)

	ЕстьОграничениеВерсии = ЗначениеЗаполнено(Зависимость.МинимальнаяВерсия)
		Или ЗначениеЗаполнено(Зависимость.МаксимальнаяВерсия);
	ТребуемаяВерсия = ?(
		ЕстьОграничениеВерсии,
		ОграниченияВерсийПакетов.Нарушенное(Зависимость, УстановленнаяВерсия),
		""
	);

	Если Не ЗначениеЗаполнено(ТребуемаяВерсия) Тогда
		Возврат Ложь;
	КонецЕсли;

	Элемент = _РезультатыАнализа.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.НесоответствиеВерсий(),
		Зависимость.ИмяПакета,
		Зависимость.ДляРазработки
	);
	Элемент.ТребуемаяВерсия = ТребуемаяВерсия;
	Элемент.УстановленнаяВерсия = УстановленнаяВерсия;
	Элемент.Каталог = КаталогПакета;

	Возврат Истина;

КонецФункции

Процедура ДобавитьНесовместимостьВерсииСреды(
	Зависимость,
	МетаданныеПакета,
	УстановленнаяВерсия,
	ВерсияСредыПакета,
	КаталогПакета
)

	НеНужноПроверятьВерсиюСреды = Зависимость.ДляРазработки
		Или Не ПроверкаВерсийПакетов.ЭтоКорректная(ВерсияСредыПакета)
		Или Не ПроверкаВерсийПакетов.ЭтоКорректная(МетаданныеПакета.ВерсияСреды);
	Если НеНужноПроверятьВерсиюСреды Тогда
		Возврат;
	КонецЕсли;

	Если ОграниченияВерсийПакетов.Сравнить(МетаданныеПакета.ВерсияСреды, ВерсияСредыПакета) <= 0 Тогда
		Возврат;
	КонецЕсли;

	Элемент = _РезультатыАнализа.ДобавитьОшибку(
		ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка(),
		Зависимость.ИмяПакета,
		Ложь
	);
	Элемент.УстановленнаяВерсия = УстановленнаяВерсия;
	Элемент.ВерсияСредыПроверяемогоПакета = ВерсияСредыПакета;
	Элемент.ВерсияСредыЗависимости = МетаданныеПакета.ВерсияСреды;
	Элемент.Каталог = КаталогПакета;

КонецПроцедуры

Процедура ДобавитьИлиОбновитьДиагностикуПоврежденногоПакета(Зависимость, ПоврежденныйПакет)

	Элемент = _ПравилаПриоритетаДиагностик.НайтиДиагностическийЭлемент(
		ТипыДиагностикиЗависимостей.Поврежден(),
		Зависимость.ИмяПакета
	);

	Если Элемент = Неопределено Тогда
		Элемент = _РезультатыАнализа.ДобавитьОшибку(
			ТипыДиагностикиЗависимостей.Поврежден(),
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
	Иначе
		Элемент.ДляРазработки = Элемент.ДляРазработки И Зависимость.ДляРазработки;
	КонецЕсли;

	Элемент.Каталог = ПоврежденныйПакет.Каталог;
	Элемент.ПодробнаяПричина = ПоврежденныйПакет.Причина;

КонецПроцедуры

#КонецОбласти
