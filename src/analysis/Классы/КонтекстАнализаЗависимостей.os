#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений
Перем _ИсключитьЗависимостиДляРазработки; // Булево
Перем _РезультатСканирования; // РезультатСканированияУстановленныхПакетов
Перем _РезультатыАнализа; // РезультатыАнализаЗависимостей
Перем _ПравилаПриоритетаДиагностик; // ПравилаПриоритетаДиагностикЗависимостей
Перем _РеестрОбъявлений; // РеестрОбъявленийЗависимостей

#КонецОбласти

#Область ОбработчикиСобытий

// Создает контекст одного запуска анализа зависимостей.
//
// Параметры:
//   Зависимости - ТаблицаЗначений - Прямые зависимости проекта.
//   ИсключитьЗависимостиДляРазработки - Булево - Исключать контекст разработки.
//   РезультатСканирования - РезультатСканированияУстановленныхПакетов - Установленные пакеты.
//   РезультатыАнализа - РезультатыАнализаЗависимостей - Текущие результаты анализа.
//   ПравилаПриоритетаДиагностик - ПравилаПриоритетаДиагностикЗависимостей - Правила объединения диагностик.
//   РеестрОбъявлений - РеестрОбъявленийЗависимостей - Исходные объявления зависимостей.
Процедура ПриСозданииОбъекта(
	Зависимости,
	ИсключитьЗависимостиДляРазработки,
	РезультатСканирования,
	РезультатыАнализа,
	ПравилаПриоритетаДиагностик,
	РеестрОбъявлений
)

	_Зависимости = Зависимости;
	_ИсключитьЗависимостиДляРазработки = ИсключитьЗависимостиДляРазработки;
	_РезультатСканирования = РезультатСканирования;
	_РезультатыАнализа = РезультатыАнализа;
	_ПравилаПриоритетаДиагностик = ПравилаПриоритетаДиагностик;
	_РеестрОбъявлений = РеестрОбъявлений;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает прямые зависимости проекта.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Прямые зависимости проекта.
Функция Зависимости() Экспорт
	Возврат _Зависимости;
КонецФункции

// Возвращает признак исключения зависимостей для разработки.
//
// Возвращаемое значение:
//   Булево - Истина, если контекст разработки исключен.
Функция ИсключатьДляРазработки() Экспорт
	Возврат _ИсключитьЗависимостиДляРазработки;
КонецФункции

// Возвращает результат сканирования установленных пакетов.
//
// Возвращаемое значение:
//   РезультатСканированияУстановленныхПакетов - Результат одного сканирования.
Функция РезультатСканирования() Экспорт
	Возврат _РезультатСканирования;
КонецФункции

// Возвращает накапливаемые результаты анализа.
//
// Возвращаемое значение:
//   РезультатыАнализаЗависимостей - Диагностики текущего запуска.
Функция РезультатыАнализа() Экспорт
	Возврат _РезультатыАнализа;
КонецФункции

// Возвращает правила приоритета диагностик.
//
// Возвращаемое значение:
//   ПравилаПриоритетаДиагностикЗависимостей - Правила объединения диагностик.
Функция ПравилаПриоритетаДиагностик() Экспорт
	Возврат _ПравилаПриоритетаДиагностик;
КонецФункции

// Возвращает индекс исходных объявлений зависимостей.
//
// Возвращаемое значение:
//   РеестрОбъявленийЗависимостей - Реестр объявлений.
Функция РеестрОбъявлений() Экспорт
	Возврат _РеестрОбъявлений;
КонецФункции

#КонецОбласти
