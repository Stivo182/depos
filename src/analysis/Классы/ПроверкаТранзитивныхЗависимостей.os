#Использовать "../../manifest"
#Использовать "../../packages"

#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений
Перем _ИсключитьЗависимостиДляРазработки; // Булево
Перем _РезультатСканированияПакетов; // РезультатСканированияУстановленныхПакетов
Перем _РезультатыАнализа; // РезультатыАнализаЗависимостей
Перем _ПравилаПриоритетаДиагностик; // ПравилаПриоритетаДиагностикЗависимостей
Перем _РеестрОбъявлений; // РеестрОбъявленийЗависимостей
Перем _АнализаторТранзитивныхЗависимостей; // АнализаторТранзитивныхЗависимостей
Перем _СканерУстановленныхПакетов; // СканерУстановленныхПакетов
Перем _ИспользуемыеПакеты; // ТаблицаЗначений
Перем _ВыражениеИсключенияИменПакетов; // Строка

#КонецОбласти

#Область ОбработчикиСобытий

// Создает проверку транзитивных зависимостей.
//
// Параметры:
//   Контекст - КонтекстАнализаЗависимостей - Данные одного запуска анализа.
//   АнализаторТранзитивныхЗависимостей - АнализаторТранзитивныхЗависимостей - Анализатор графа.
//   СканерУстановленныхПакетов - СканерУстановленныхПакетов - Сканер локальных пакетов.
//   ИспользуемыеПакеты - ТаблицаЗначений - Найденные прямые использования пакетов.
//   ВыражениеИсключенияИменПакетов - Строка - Фильтр исключаемых пакетов.
Процедура ПриСозданииОбъекта(
	Контекст,
	АнализаторТранзитивныхЗависимостей,
	СканерУстановленныхПакетов,
	ИспользуемыеПакеты,
	ВыражениеИсключенияИменПакетов
)

	_Зависимости = Контекст.Зависимости();
	_ИсключитьЗависимостиДляРазработки = Контекст.ИсключатьДляРазработки();
	_РезультатСканированияПакетов = Контекст.РезультатСканирования();
	_РезультатыАнализа = Контекст.РезультатыАнализа();
	_ПравилаПриоритетаДиагностик = Контекст.ПравилаПриоритетаДиагностик();
	_РеестрОбъявлений = Контекст.РеестрОбъявлений();
	_АнализаторТранзитивныхЗависимостей = АнализаторТранзитивныхЗависимостей;
	_СканерУстановленныхПакетов = СканерУстановленныхПакетов;
	_ИспользуемыеПакеты = ИспользуемыеПакеты;
	_ВыражениеИсключенияИменПакетов = ВыражениеИсключенияИменПакетов;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет транзитивный анализ и добавляет связанные диагностики.
//
// Параметры:
//   ИсходныеЗависимости - ЗависимостиПакета - Зависимости до применения фильтра.
//   ВерсияСредыПакета - Строка - Минимальная версия OneScript проекта.
//
// Возвращаемое значение:
//   Массив из ТребованиеЗависимости - Требования транзитивного графа.
Функция Проверить(ИсходныеЗависимости, ВерсияСредыПакета) Экспорт

	ВсеТребования = ПроверитьТранзитивныеЗависимости();
	ПроверитьВерсииСредыТранзитивныхЗависимостей(ВсеТребования, ВерсияСредыПакета);
	ПроверитьПометкиТранзитивныхЗависимостей(ВсеТребования, ИсходныеЗависимости);

	Возврат ВсеТребования;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьТранзитивныеЗависимости()

	РезультатТранзитивногоАнализа = _АнализаторТранзитивныхЗависимостей
		.ИсключатьДляРазработки(_ИсключитьЗависимостиДляРазработки)
		.ИсключитьПоИмени(_ВыражениеИсключенияИменПакетов)
		.Проанализировать(
			Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(_Зависимости),
			_РезультатСканированияПакетов
		);

	Для Каждого Конфликт Из РезультатТранзитивногоАнализа.Конфликты Цикл
		Если Конфликт.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьПовреждена() Тогда
			ЭлементПовреждения = _ПравилаПриоритетаДиагностик.НайтиДиагностическийЭлемент(
				ТипыДиагностикиЗависимостей.Поврежден(),
				Конфликт.ИмяПакета
			);

			Если ЭлементПовреждения <> Неопределено Тогда
				ЭлементПовреждения.ДляРазработки = ЭлементПовреждения.ДляРазработки
					И Конфликт.ДляРазработки;

				Для Каждого Требование Из Конфликт.Требования Цикл
					ЭлементПовреждения.Требования.Добавить(Требование.Копия());
				КонецЦикла;

				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Элемент = _РезультатыАнализа.ДобавитьОшибку(
			ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
			Конфликт.ИмяПакета,
			Конфликт.ДляРазработки
		);
		Элемент.ТипКонфликта = Конфликт.ТипКонфликта;
		Элемент.КраткоеОписание = Конфликт.КраткоеОписание;
		Элемент.ТребуемаяВерсия = Конфликт.ТребуемаяВерсия;
		Элемент.УстановленнаяВерсия = Конфликт.УстановленнаяВерсия;
		Элемент.Каталог = Конфликт.Каталог;
		Элемент.ПодробнаяПричина = Конфликт.ПодробнаяПричина;

		Для Каждого Требование Из Конфликт.Требования Цикл
			Элемент.Требования.Добавить(Требование.Копия());
		КонецЦикла;
	КонецЦикла;

	Возврат РезультатТранзитивногоАнализа.Требования;

КонецФункции

Процедура ПроверитьВерсииСредыТранзитивныхЗависимостей(ВсеТребования, ВерсияСредыПакета)

	Если Не ПроверкаВерсийПакетов.ЭтоКорректная(ВерсияСредыПакета) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Требование Из ВсеТребования Цикл
		Если Требование.ДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		Элемент = _ПравилаПриоритетаДиагностик.НайтиДиагностическийЭлемент(
			ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка(),
			Требование.ИмяПакета
		);

		Если Элемент <> Неопределено Тогда
			Если Элемент.Требования.Количество() = 0 Тогда
				ДобавитьТребованияПакета(Элемент, ВсеТребования, Требование.ИмяПакета);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		КаталогПакета = _РезультатСканированияПакетов.Пакеты[Требование.ИмяПакета];
		Если КаталогПакета = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		МетаданныеПакета = _РезультатСканированияПакетов.МетаданныеПакетаПоКаталогу(КаталогПакета);
		НесовместимаяВерсияСреды = МетаданныеПакета = Неопределено
			Или Не ПроверкаВерсийПакетов.ЭтоКорректная(МетаданныеПакета.ВерсияСреды)
			Или ОграниченияВерсийПакетов.Сравнить(
				МетаданныеПакета.ВерсияСреды,
				ВерсияСредыПакета
			) <= 0;

		Если НесовместимаяВерсияСреды Тогда
			Продолжить;
		КонецЕсли;

		Элемент = _РезультатыАнализа.ДобавитьОшибку(
			ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка(),
			Требование.ИмяПакета,
			Ложь
		);
		Элемент.УстановленнаяВерсия = МетаданныеПакета.Версия;
		Элемент.ВерсияСредыПроверяемогоПакета = ВерсияСредыПакета;
		Элемент.ВерсияСредыЗависимости = МетаданныеПакета.ВерсияСреды;
		Элемент.Каталог = КаталогПакета;

		ДобавитьТребованияПакета(Элемент, ВсеТребования, Требование.ИмяПакета);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьТребованияПакета(Элемент, ВсеТребования, ИмяПакета)

	Для Каждого Требование Из ВсеТребования Цикл
		Если Требование.ИмяПакета = ИмяПакета И Не Требование.ДляРазработки Тогда
			Элемент.Требования.Добавить(Требование.Копия());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПометкиТранзитивныхЗависимостей(ВсеТребования, ИсходныеЗависимости)

	ТребованияБезИсключений = Неопределено;

	Для Каждого Зависимость Из _Зависимости Цикл
		ИсключенаЗависимостьДляРазработки = _ИсключитьЗависимостиДляРазработки
			И Зависимость.ДляРазработки;
		НеНужноПроверятьПометку = Не Зависимость.Транзитивная Или ИсключенаЗависимостьДляРазработки;

		Если НеНужноПроверятьПометку Тогда
			Продолжить;
		КонецЕсли;

		Если _ПравилаПриоритетаДиагностик.СтруктурнаяДиагностикаУдаляетИлиПереносит(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		) Тогда
			Продолжить;
		КонецЕсли;

		Если ИспользуетсяНапрямую(Зависимость.ИмяПакета, Зависимость.ДляРазработки) Тогда
			Продолжить;
		КонецЕсли;

		Если ТребованияТранзитивныхЗависимостей.ПодтвержденаТранзитивность(
			Зависимость,
			ВсеТребования
		) Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(_ВыражениеИсключенияИменПакетов) Тогда
			Если ТребованияБезИсключений = Неопределено Тогда
				ТребованияБезИсключений = СформироватьТребованияБезИсключенияПакетов(ИсходныеЗависимости);
			КонецЕсли;

			Если ТребованияТранзитивныхЗависимостей.ПодтвержденаТранзитивность(
				Зависимость,
				ТребованияБезИсключений
			) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Элемент = _РезультатыАнализа.ДобавитьПредупреждение(
			ТипыДиагностикиЗависимостей.ПометкаТранзитивностиНеПодтверждена(),
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
		Элемент.КраткоеОписание = _РеестрОбъявлений.Представление(Зависимость, Истина);
	КонецЦикла;

КонецПроцедуры

Функция СформироватьТребованияБезИсключенияПакетов(ИсходныеЗависимости)

	РезультатСканирования = _СканерУстановленныхПакетов
		.ИсключитьПоИмени("")
		.Просканировать();

	Анализатор = Новый АнализаторТранзитивныхЗависимостей();
	Анализатор.ИсключатьДляРазработки(_ИсключитьЗависимостиДляРазработки);
	РезультатТранзитивногоАнализа = Анализатор.Проанализировать(
		ИсходныеЗависимости,
		РезультатСканирования
	);

	Возврат РезультатТранзитивногоАнализа.Требования;

КонецФункции

Функция ИспользуетсяНапрямую(ИмяПакета, ДляРазработки)
	Отбор = Новый Структура("ИмяПакета, ДляРазработки", НРег(ИмяПакета), ДляРазработки);
	Использования = _ИспользуемыеПакеты.НайтиСтроки(Отбор);
	Возврат Использования.Количество() > 0;
КонецФункции

#КонецОбласти
