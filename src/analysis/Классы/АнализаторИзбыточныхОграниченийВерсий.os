#Использовать "../../packages"

#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений
Перем _ИсключитьЗависимостиДляРазработки; // Булево
Перем _ПравилаПриоритетаДиагностик; // ПравилаПриоритетаДиагностикЗависимостей
Перем _РезультатыАнализа; // РезультатыАнализаЗависимостей
Перем _РезультатСканированияПакетов; // РезультатСканированияУстановленныхПакетов
Перем _РеестрОбъявлений; // РеестрОбъявленийЗависимостей

#КонецОбласти

#Область ОбработчикиСобытий

// Создает анализатор избыточных ограничений версий.
//
// Параметры:
//   Контекст - КонтекстАнализаЗависимостей - Данные одного запуска анализа.
Процедура ПриСозданииОбъекта(Контекст)

	_Зависимости = Контекст.Зависимости();
	_ИсключитьЗависимостиДляРазработки = Контекст.ИсключатьДляРазработки();
	_ПравилаПриоритетаДиагностик = Контекст.ПравилаПриоритетаДиагностик();
	_РезультатыАнализа = Контекст.РезультатыАнализа();
	_РезультатСканированияПакетов = Контекст.РезультатСканирования();
	_РеестрОбъявлений = Контекст.РеестрОбъявлений();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует рекомендации по ограничениям версий прямых зависимостей.
//
// Параметры:
//   ВсеТребования - Массив из Структура - Требования транзитивного графа.
Процедура СформироватьРекомендации(ВсеТребования) Экспорт

	Для Каждого Кандидат Из _Зависимости Цикл
		НеПодходитДляРекомендации = Не ЗначениеЗаполнено(Кандидат.МинимальнаяВерсия)
			Или ЗначениеЗаполнено(Кандидат.МаксимальнаяВерсия)
			Или _ИсключитьЗависимостиДляРазработки И Кандидат.ДляРазработки;

		Если НеПодходитДляРекомендации Тогда
			Продолжить;
		КонецЕсли;

		Если ЕстьБолееПриоритетнаяДиагностика(Кандидат) Тогда
			Продолжить;
		КонецЕсли;

		Требования = НезависимыеТребованияКандидата(Кандидат, ВсеТребования);
		МинимальнаяВерсия = ОграниченияВерсийПакетов.НаиболееСтрогийМинимум(Требования);

		НельзяРекомендоватьВерсию = ЕстьПрямойКонфликтПакета(Кандидат.ИмяПакета)
			Или ЕстьКонфликтИсточника(Кандидат, Требования, ВсеТребования)
			Или ТребованияНесовместимы(Требования)
			Или Не ЗначениеЗаполнено(МинимальнаяВерсия)
			Или СравнитьВерсии(МинимальнаяВерсия, Кандидат.МинимальнаяВерсия) < 0;

		Если Не НельзяРекомендоватьВерсию Тогда
			ДобавитьРекомендацию(Кандидат, МинимальнаяВерсия, Требования);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьБолееПриоритетнаяДиагностика(Кандидат)

	Возврат _ПравилаПриоритетаДиагностик.ЕстьСтруктурнаяДиагностика(
		Кандидат.ИмяПакета,
		Кандидат.ДляРазработки
	) Или _ПравилаПриоритетаДиагностик.ЕстьДиагностикаОбъявленияБолееВысокогоУровня(
		Кандидат.ИмяПакета,
		Кандидат.ДляРазработки
	);

КонецФункции

Функция НезависимыеТребованияКандидата(Кандидат, ВсеТребования)

	Результат = Новый Массив();
	Для Каждого Требование Из ВсеТребования Цикл
		НеПодходитКандидату = Требование.ИмяПакета <> Кандидат.ИмяПакета
			Или Требование.КорневаяПрямаяЗависимость = Кандидат.ИмяПакета
			Или Не Кандидат.ДляРазработки И Требование.ДляРазработки
			Или Требование.ЦепочкаЗависимостей.Количество() <> 2
			Или ЦепочкаПовторяетПакет(Требование.ЦепочкаЗависимостей, Кандидат.ИмяПакета);

		Если Не НеПодходитКандидату Тогда
			Результат.Добавить(Требование);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьКонфликтИсточника(Кандидат, Требования, ВсеТребования)

	Для Каждого Требование Из Требования Цикл
		ЕстьКонфликтВетки = ЕстьПрямойКонфликтПакета(Требование.КорневаяПрямаяЗависимость)
			Или ЕстьПрямойКонфликтПакета(Требование.ИсточникТребования)
			Или Не ВерсияПрямогоИсточникаСоответствует(Требование.КорневаяПрямаяЗависимость)
			Или ЕстьНеполныеДанныеВетки(Требование.КорневаяПрямаяЗависимость);

		Если ЕстьКонфликтВетки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьТранзитивныйКонфликтИсточника(Требования)
		Или ЕстьНесовместимыеТребованияВеток(Кандидат, Требования, ВсеТребования);

КонецФункции

Функция ЕстьНеполныеДанныеВетки(КорневаяПрямаяЗависимость)

	Конфликты = _РезультатыАнализа.Элементы(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт());
	Для Каждого Конфликт Из Конфликты Цикл
		Если Не КонфликтВызванНедоступнымТранзитивнымПакетом(Конфликт) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Требование Из Конфликт.Требования Цикл
			Если Требование.КорневаяПрямаяЗависимость = КорневаяПрямаяЗависимость Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция КонфликтВызванНедоступнымТранзитивнымПакетом(Конфликт)

	ПакетНеУстановлен = Конфликт.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьНеУстановлена();
	ПакетПоврежден = Конфликт.ТипКонфликта = ТипыКонфликтовЗависимостей.ТранзитивнаяЗависимостьПовреждена();

	Возврат ПакетНеУстановлен Или ПакетПоврежден;

КонецФункции

Функция ЕстьТранзитивныйКонфликтИсточника(Требования)

	Конфликты = _РезультатыАнализа.Элементы(ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт());
	Для Каждого Конфликт Из Конфликты Цикл
		Если Конфликт.ТипКонфликта = ТипыКонфликтовЗависимостей.НесовместимыеТребования() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТребованиеКонфликта Из Конфликт.Требования Цикл
			Для Каждого Требование Из Требования Цикл
				Если ЦепочкаНачинаетсяС(
					Требование.ЦепочкаЗависимостей,
					ТребованиеКонфликта.ЦепочкаЗависимостей
				) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЦепочкаНачинаетсяС(Цепочка, Начало)

	Если Цепочка.Количество() < Начало.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 0 По Начало.Количество() - 1 Цикл
		Если Цепочка[Индекс] <> Начало[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЕстьНесовместимыеТребованияВеток(Кандидат, ТребованияКандидата, ВсеТребования)

	ТребованияПоПакетам = Новый Соответствие();
	Для Каждого Требование Из ВсеТребования Цикл
		НеОтноситсяКВеткамКандидата = Не КореньЕстьВТребованиях(
			Требование.КорневаяПрямаяЗависимость,
			ТребованияКандидата
		);
		НеподходящийКонтекст = Не Кандидат.ДляРазработки И Требование.ДляРазработки;

		Если НеОтноситсяКВеткамКандидата Или НеподходящийКонтекст Тогда
			Продолжить;
		КонецЕсли;

		ТребованияПакета = ТребованияПоПакетам[Требование.ИмяПакета];
		Если ТребованияПакета = Неопределено Тогда
			ТребованияПакета = Новый Массив();
			ТребованияПоПакетам.Вставить(Требование.ИмяПакета, ТребованияПакета);
		КонецЕсли;

		ТребованияПакета.Добавить(Требование);
	КонецЦикла;

	Для Каждого ТребованияПакета Из ТребованияПоПакетам Цикл
		Если ТребованияНесовместимы(ТребованияПакета.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция КореньЕстьВТребованиях(КорневаяПрямаяЗависимость, Требования)

	Для Каждого Требование Из Требования Цикл
		Если Требование.КорневаяПрямаяЗависимость = КорневаяПрямаяЗависимость Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьПрямойКонфликтПакета(ИмяПакета)

	Для Каждого Элемент Из _РезультатыАнализа.Элементы() Цикл
		СовпадаетИмяПакета = Элемент.ИмяПакета = ИмяПакета;
		ЭтоКонфликтУстановки = Элемент.Тип = ТипыДиагностикиЗависимостей.НеУстановлен()
			Или Элемент.Тип = ТипыДиагностикиЗависимостей.Поврежден()
			Или Элемент.Тип = ТипыДиагностикиЗависимостей.НесоответствиеВерсий()
			Или Элемент.Тип = ТипыДиагностикиЗависимостей.НесовместимостьВерсийДвижка();

		Если СовпадаетИмяПакета И ЭтоКонфликтУстановки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВерсияПрямогоИсточникаСоответствует(ИмяПакета)

	ПрямыеЗависимости = _Зависимости.НайтиСтроки(Новый Структура("ИмяПакета", ИмяПакета));
	УстановленнаяВерсия = _РезультатСканированияПакетов.ВерсияПакета(ИмяПакета);
	НетДанныхПрямогоИсточника = ПрямыеЗависимости.Количество() = 0
		Или Не ЗначениеЗаполнено(УстановленнаяВерсия);

	Если НетДанныхПрямогоИсточника Тогда
		Возврат Ложь;
	КонецЕсли;

	ТребуемаяВерсия = ОграниченияВерсийПакетов.Нарушенное(ПрямыеЗависимости[0], УстановленнаяВерсия);
	Возврат Не ЗначениеЗаполнено(ТребуемаяВерсия);

КонецФункции

Функция ТребованияНесовместимы(Требования)

	МинимальнаяВерсия = ОграниченияВерсийПакетов.НаиболееСтрогийМинимум(Требования);
	МаксимальнаяВерсия = ОграниченияВерсийПакетов.НаиболееСтрогийМаксимум(Требования);

	Возврат ЗначениеЗаполнено(МинимальнаяВерсия)
		И ЗначениеЗаполнено(МаксимальнаяВерсия)
		И СравнитьВерсии(МинимальнаяВерсия, МаксимальнаяВерсия) > 0;

КонецФункции

Функция ЦепочкаПовторяетПакет(ЦепочкаЗависимостей, ИмяПакета)

	КоличествоВхождений = 0;
	Для Каждого ПакетЦепочки Из ЦепочкаЗависимостей Цикл
		Если ПакетЦепочки = ИмяПакета Тогда
			КоличествоВхождений = КоличествоВхождений + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КоличествоВхождений > 1;

КонецФункции

Процедура ДобавитьРекомендацию(Кандидат, МинимальнаяВерсия, Требования)

	Элемент = _РезультатыАнализа.ДобавитьРекомендацию(Кандидат.ИмяПакета, Кандидат.ДляРазработки);
	Элемент.КраткоеОписание = _РеестрОбъявлений.Представление(Кандидат, Ложь, Ложь);
	Элемент.ТекущаяМинимальнаяВерсия = Кандидат.МинимальнаяВерсия;
	Элемент.ТранзитивнаяМинимальнаяВерсия = МинимальнаяВерсия;

	Для Каждого Требование Из Требования Цикл
		НеОпределяетМинимальнуюВерсию = Не ЗначениеЗаполнено(Требование.МинимальнаяВерсия)
			Или СравнитьВерсии(Требование.МинимальнаяВерсия, МинимальнаяВерсия) <> 0;

		Если Не НеОпределяетМинимальнуюВерсию Тогда
			Элемент.Требования.Добавить(Требование.Копия());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СравнитьВерсии(ПерваяВерсия, ВтораяВерсия)

	Возврат ОграниченияВерсийПакетов.Сравнить(ПерваяВерсия, ВтораяВерсия);

КонецФункции

#КонецОбласти
