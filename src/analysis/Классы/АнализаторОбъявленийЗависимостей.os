#Использовать "../../manifest"
#Использовать "../../packages"
#Использовать "../../common"

#Область ОписаниеПеременных

Перем _Зависимости; // ТаблицаЗначений
Перем _ИсключитьЗависимостиДляРазработки; // Булево
Перем _РезультатСканированияПакетов; // РезультатСканированияУстановленныхПакетов, Неопределено
Перем _РезультатыАнализа; // РезультатыАнализаЗависимостей
Перем _ПравилаПриоритетаДиагностик; // ПравилаПриоритетаДиагностикЗависимостей
Перем _РеестрОбъявлений; // РеестрОбъявленийЗависимостей
Перем _ОбъявленияЗависимостей; // Массив из Структура
Перем _ИспользуемыеПакеты; // ТаблицаЗначений
Перем _ВыражениеИсключенияИменПакетов; // Строка
Перем _ПовторныеОбъявления; // Массив из Строка

#КонецОбласти

#Область ОбработчикиСобытий

// Создает анализатор объявлений зависимостей.
//
// Параметры:
//   Контекст - КонтекстАнализаЗависимостей - Данные одного запуска анализа.
//   ОбъявленияЗависимостей - Массив из Структура - Исходные объявления зависимостей.
//   ИспользуемыеПакеты - ТаблицаЗначений - Найденные прямые использования пакетов.
//   ВыражениеИсключенияИменПакетов - Строка - Фильтр исключаемых пакетов.
//   ПовторныеОбъявления - Массив из Строка - Ключи неоднозначных объявлений.
Процедура ПриСозданииОбъекта(
	Контекст,
	ОбъявленияЗависимостей,
	ИспользуемыеПакеты,
	ВыражениеИсключенияИменПакетов,
	ПовторныеОбъявления
)

	_Зависимости = Контекст.Зависимости();
	_ИсключитьЗависимостиДляРазработки = Контекст.ИсключатьДляРазработки();
	_РезультатСканированияПакетов = Контекст.РезультатСканирования();
	_РезультатыАнализа = Контекст.РезультатыАнализа();
	_ПравилаПриоритетаДиагностик = Контекст.ПравилаПриоритетаДиагностик();
	_РеестрОбъявлений = Контекст.РеестрОбъявлений();
	_ОбъявленияЗависимостей = ОбъявленияЗависимостей;
	_ИспользуемыеПакеты = ИспользуемыеПакеты;
	_ВыражениеИсключенияИменПакетов = ВыражениеИсключенияИменПакетов;
	_ПовторныеОбъявления = ПовторныеОбъявления;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет повторные и избыточные объявления зависимостей.
Процедура ПроверитьОбъявления() Экспорт
	ПроверитьПовторныеОбъявления();
	ПроверитьИзбыточныеЗависимостиДляРазработки();
КонецПроцедуры

// Проверяет соответствие объявлений прямому использованию пакетов.
Процедура ПроверитьИспользование() Экспорт
	ПроверитьЗависимостиДляРазработкиВПроизводственномКоде();
	ПроверитьНеактуальныеПометки();
КонецПроцедуры

// Формирует структурные рекомендации по данным транзитивного графа.
//
// Параметры:
//   ВсеТребования - Массив из ТребованиеЗависимости - Требования транзитивного графа.
Процедура ПроверитьТранзитивныеРекомендации(ВсеТребования) Экспорт
	ПроверитьПереносВЗависимостиДляРазработки(ВсеТребования);
	ПроверитьОтсутствующиеТранзитивныеПометки(ВсеТребования);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПовторныеОбъявления()

	_ПовторныеОбъявления.Очистить();

	Группы = Новый Соответствие();
	Для Каждого Объявление Из _ОбъявленияЗависимостей Цикл
		ИсключеноОбъявлениеДляРазработки = _ИсключитьЗависимостиДляРазработки
			И Объявление.ДляРазработки;
		ПропуститьОбъявление = ОбъявлениеИсключено(Объявление)
			Или ИсключеноОбъявлениеДляРазработки;

		Если ПропуститьОбъявление Тогда
			Продолжить;
		КонецЕсли;

		Ключ = _ПравилаПриоритетаДиагностик.КлючОбъявления(Объявление.ИмяПакета, Объявление.ДляРазработки);
		Объявления = Группы[Ключ];
		Если Объявления = Неопределено Тогда
			Объявления = Новый Массив();
			Группы.Вставить(Ключ, Объявления);
		КонецЕсли;

		Объявления.Добавить(Объявление);
	КонецЦикла;

	Для Каждого Группа Из Группы Цикл
		Объявления = Группа.Значение;
		Если Объявления.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		_ПовторныеОбъявления.Добавить(Группа.Ключ);
		ОграниченияВерсийСовпадают = _РеестрОбъявлений.ОграниченияВерсийОбъявленийСовпадают(Объявления);

		Если ОграниченияВерсийСовпадают Тогда
			Элемент = _РезультатыАнализа.ДобавитьПредупреждение(
				ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
				НРег(Объявления[0].ИмяПакета),
				Объявления[0].ДляРазработки
			);
		Иначе
			Элемент = _РезультатыАнализа.ДобавитьОшибку(
				ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
				НРег(Объявления[0].ИмяПакета),
				Объявления[0].ДляРазработки
			);
		КонецЕсли;

		Элемент.ПодробнаяПричина = _РеестрОбъявлений.ОписаниеПовторных(Объявления);

		МожноУдалитьПовтор = ОграниченияВерсийСовпадают И _РеестрОбъявлений.ВсеЛитеральные(Объявления);
		Если МожноУдалитьПовтор Тогда
			ОбъявлениеДляУдаления = Объявления[Объявления.ВГраница()];
			Элемент.КраткоеОписание = "Строка " + ОбъявлениеДляУдаления.НомерСтроки + ": "
				+ ОбъявлениеДляУдаления.ТекстОбъявления + " →"
				+ " удалить повторное объявление";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИзбыточныеЗависимостиДляРазработки()

	Если _ИсключитьЗависимостиДляРазработки Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЗависимостьДляРазработки Из _Зависимости Цикл
		ЭтоЗависимостьДляРазработки = ЗависимостьДляРазработки.ДляРазработки;
		ЕстьПовторДляРазработки = _ПравилаПриоритетаДиагностик.ЕстьПовторноеОбъявление(
			ЗависимостьДляРазработки.ИмяПакета,
			Истина
		);
		ПропуститьЗависимость = Не ЭтоЗависимостьДляРазработки Или ЕстьПовторДляРазработки;

		Если ПропуститьЗависимость Тогда
			Продолжить;
		КонецЕсли;

		ПроизводственнаяЗависимость = НайтиЗависимость(
			ЗависимостьДляРазработки.ИмяПакета, Ложь
		);
		НетПроизводственнойЗависимости = ПроизводственнаяЗависимость = Неопределено;
		ЕстьПроизводственныйПовтор = _ПравилаПриоритетаДиагностик.ЕстьПовторноеОбъявление(
			ЗависимостьДляРазработки.ИмяПакета,
			Ложь
		);
		НеоднозначнаяПроизводственнаяЗависимость = НетПроизводственнойЗависимости
			Или ЕстьПроизводственныйПовтор;
		Если НеоднозначнаяПроизводственнаяЗависимость Тогда
			Продолжить;
		КонецЕсли;

		Если Не ОграничениеПокрывает(
			ПроизводственнаяЗависимость,
			ЗависимостьДляРазработки
		) Тогда
			Объявления = _РеестрОбъявлений.ДляПакета(ЗависимостьДляРазработки.ИмяПакета);
			Элемент = _РезультатыАнализа.ДобавитьОшибку(
				ТипыДиагностикиЗависимостей.ПовторноеОбъявление(),
				ЗависимостьДляРазработки.ИмяПакета,
				Истина
			);
			Элемент.ПодробнаяПричина = _РеестрОбъявлений.ОписаниеПовторных(Объявления);

			_ПовторныеОбъявления.Добавить(
				_ПравилаПриоритетаДиагностик.КлючОбъявления(ЗависимостьДляРазработки.ИмяПакета, Ложь)
			);
			_ПовторныеОбъявления.Добавить(
				_ПравилаПриоритетаДиагностик.КлючОбъявления(ЗависимостьДляРазработки.ИмяПакета, Истина)
			);
			Продолжить;
		КонецЕсли;

		Если _РеестрОбъявлений.НайтиЛитеральноеОбъявление(ЗависимостьДляРазработки.ИмяПакета, Истина) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьСтруктурнуюРекомендацию(
			ТипыДиагностикиЗависимостей.РекомендацияУдаленияЗависимостиДляРазработки(),
			ЗависимостьДляРазработки,
			"удалить",
			""
		);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЗависимостиДляРазработкиВПроизводственномКоде()

	Если _ИсключитьЗависимостиДляРазработки Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИспользуемыйПакет Из _ИспользуемыеПакеты Цикл
		ЕстьПроизводственнаяЗависимость = НайтиЗависимость(
			ИспользуемыйПакет.ИмяПакета,
			Ложь
		) <> Неопределено;
		НеНужноПереноситьЗависимость = ИспользуемыйПакет.ДляРазработки
			Или ЕстьПроизводственнаяЗависимость;

		Если НеНужноПереноситьЗависимость Тогда
			Продолжить;
		КонецЕсли;

		Зависимость = НайтиЗависимость(ИспользуемыйПакет.ИмяПакета, Истина);
		НетЗависимостиДляРазработки = Зависимость = Неопределено;

		Если НетЗависимостиДляРазработки Тогда
			Продолжить;
		КонецЕсли;

		НетЛитеральногоОбъявления = _РеестрОбъявлений.НайтиЛитеральноеОбъявление(
			Зависимость.ИмяПакета,
			Истина
		) = Неопределено;
		НайденоПовторноеОбъявление = _ПравилаПриоритетаДиагностик.ЕстьПовторноеОбъявление(
			Зависимость.ИмяПакета,
			Истина
		);
		НеоднозначноеОбъявление = НетЛитеральногоОбъявления Или НайденоПовторноеОбъявление;

		Если НеоднозначноеОбъявление Тогда
			Продолжить;
		КонецЕсли;

		Элемент = _РезультатыАнализа.ДобавитьОшибку(
			ТипыДиагностикиЗависимостей.ЗависимостьДляРазработкиВПроизводственномКоде(),
			Зависимость.ИмяПакета,
			Истина
		);
		Элемент.КраткоеОписание = _РеестрОбъявлений.ПредставлениеЗамены(
			Зависимость,
			СтрЗаменить(_РеестрОбъявлений.Текст(Зависимость), ".РазработкаЗависитОт(", ".ЗависитОт(")
		);
		Элемент.Файлы = ИспользуемыйПакет.Файлы;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНеактуальныеПометки()

	Для Каждого Зависимость Из _Зависимости Цикл
		ЕстьЛитеральноеОбъявление = _РеестрОбъявлений.НайтиЛитеральноеОбъявление(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		) <> Неопределено;
		ЕстьПометкаНепрямойЗависимости = Зависимость.Транзитивная Или Зависимость.Неявная;
		ИсключенаЗависимостьДляРазработки = _ИсключитьЗависимостиДляРазработки
			И Зависимость.ДляРазработки;
		ПрямоеИспользование = НайтиПрямоеИспользование(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
		ЕстьПрямоеИспользование = ПрямоеИспользование <> Неопределено;
		ЕстьБолееПриоритетнаяДиагностика = _ПравилаПриоритетаДиагностик.СтруктурнаяДиагностикаУдаляетИлиПереносит(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);

		ПропуститьЗависимость = Не ЕстьЛитеральноеОбъявление
			Или Не ЕстьПометкаНепрямойЗависимости
			Или ИсключенаЗависимостьДляРазработки
			Или Не ЕстьПрямоеИспользование
			ИЛИ ЕстьБолееПриоритетнаяДиагностика;

		Если ПропуститьЗависимость Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьСтруктурнуюРекомендацию(
			ТипыДиагностикиЗависимостей.РекомендацияУдаленияПометки(),
			Зависимость,
			_РеестрОбъявлений.Текст(Зависимость),
			"",
			ПрямоеИспользование.Файлы
		);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПереносВЗависимостиДляРазработки(ВсеТребования)

	НельзяПроверитьПеренос = _ИсключитьЗависимостиДляРазработки
		ИЛИ НЕ ТранзитивныйГрафПолон(Истина);

	Если НельзяПроверитьПеренос Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Зависимость Из _Зависимости Цикл
		ЕстьЛитеральноеОбъявление = _РеестрОбъявлений.НайтиЛитеральноеОбъявление(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		) <> Неопределено;
		ЕстьПометкаНепрямойЗависимости = Зависимость.Транзитивная Или Зависимость.Неявная;
		ПрямоеИспользованиеПриРазработке = НайтиПрямоеИспользование(Зависимость.ИмяПакета, Истина);
		ИспользуетсяПриРазработке = ПрямоеИспользованиеПриРазработке <> Неопределено;
		ИспользуетсяВПроизводственномКоде = ИспользуетсяНапрямую(Зависимость.ИмяПакета, Ложь);
		ОбъявленаЗависимостьДляРазработки = НайтиЗависимость(Зависимость.ИмяПакета, Истина) <> Неопределено;
		ТребуетсяПроизводственномуГрафу = ТребованияТранзитивныхЗависимостей.ПодтвержденаТранзитивность(
			Зависимость,
			ВсеТребования
		);
		НайденоПовторноеОбъявление = _ПравилаПриоритетаДиагностик.ЕстьПовторноеОбъявление(
			Зависимость.ИмяПакета,
			Ложь
		);

		ПропуститьЗависимость = Не ЕстьЛитеральноеОбъявление
			Или Зависимость.ДляРазработки
			Или ЕстьПометкаНепрямойЗависимости
			Или Не ИспользуетсяПриРазработке
			Или ИспользуетсяВПроизводственномКоде
			Или ОбъявленаЗависимостьДляРазработки
			Или ТребуетсяПроизводственномуГрафу
			ИЛИ НайденоПовторноеОбъявление;

		Если ПропуститьЗависимость Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьСтруктурнуюРекомендацию(
			ТипыДиагностикиЗависимостей.ПроизводственнаяЗависимостьТолькоДляРазработки(),
			Зависимость,
			СтрЗаменить(_РеестрОбъявлений.Текст(Зависимость), ".ЗависитОт(", ".РазработкаЗависитОт("),
			"",
			ПрямоеИспользованиеПриРазработке.Файлы
		);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтсутствующиеТранзитивныеПометки(ВсеТребования)

	НельзяПроверитьПометки = _ИсключитьЗависимостиДляРазработки;

	Если НельзяПроверитьПометки Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Зависимость Из _Зависимости Цикл
		ЕстьЛитеральноеОбъявление = _РеестрОбъявлений.НайтиЛитеральноеОбъявление(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		) <> Неопределено;
		ЕстьПометкаНепрямойЗависимости = Зависимость.Транзитивная Или Зависимость.Неявная;
		ИсключенаЗависимостьДляРазработки = _ИсключитьЗависимостиДляРазработки
			И Зависимость.ДляРазработки;
		ЕстьПрямоеИспользование = ИспользуетсяНапрямую(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
		ТребованияТранзитивности = ТребованияТранзитивныхЗависимостей.ПодтверждающиеТребования(
			Зависимость,
			ВсеТребования
		);
		ТранзитивностьПодтверждена = ТребованияТранзитивности.Количество() > 0;
		ОбнаруженаОшибкаПакета = _ПравилаПриоритетаДиагностик.ЕстьОшибкаПакета(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);
		ЕстьДругаяСтруктурнаяДиагностика = _ПравилаПриоритетаДиагностик.ЕстьСтруктурнаяДиагностика(
			Зависимость.ИмяПакета,
			Зависимость.ДляРазработки
		);

		ПропуститьЗависимость = Не ЕстьЛитеральноеОбъявление
			Или ЕстьПометкаНепрямойЗависимости
			Или ИсключенаЗависимостьДляРазработки
			Или ЕстьПрямоеИспользование
			Или Не ТранзитивностьПодтверждена
			Или ОбнаруженаОшибкаПакета
			ИЛИ ЕстьДругаяСтруктурнаяДиагностика;

		Если ПропуститьЗависимость Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьСтруктурнуюРекомендацию(
			ТипыДиагностикиЗависимостей.РекомендацияТранзитивнойПометки(),
			Зависимость,
			_РеестрОбъявлений.Текст(Зависимость) + " // Транзитивная",
			"",
			Неопределено,
			ТребованияТранзитивности
		);
	КонецЦикла;

КонецПроцедуры

Функция НайтиЗависимость(ИмяПакета, ДляРазработки)

	Отбор = Новый Структура("ИмяПакета, ДляРазработки", НРег(ИмяПакета), ДляРазработки);
	Зависимости = _Зависимости.НайтиСтроки(Отбор);
	Возврат ?(Зависимости.Количество() = 0, Неопределено, Зависимости[0]);

КонецФункции

Функция ИспользуетсяНапрямую(ИмяПакета, ДляРазработки)

	Возврат НайтиПрямоеИспользование(ИмяПакета, ДляРазработки) <> Неопределено;

КонецФункции

Функция НайтиПрямоеИспользование(ИмяПакета, ДляРазработки)

	Отбор = Новый Структура("ИмяПакета, ДляРазработки", НРег(ИмяПакета), ДляРазработки);
	Использования = _ИспользуемыеПакеты.НайтиСтроки(Отбор);
	Возврат ?(Использования.Количество() = 0, Неопределено, Использования[0]);

КонецФункции

Функция ОграничениеПокрывает(Покрывающее, Покрываемое)

	Возврат ОграниченияВерсийПакетов.Покрывает(Покрывающее, Покрываемое);

КонецФункции

Функция ТранзитивныйГрафПолон(ТолькоПроизводственные = Ложь)

	ЕстьНеполныеДанные = Не ВсеПрямыеЗависимостиУстановлены(ТолькоПроизводственные)
		Или _ПравилаПриоритетаДиагностик.ЕстьДиагностикаГрафа(
			ТипыДиагностикиЗависимостей.НеУстановлен(),
			ТолькоПроизводственные
		)
		Или _ПравилаПриоритетаДиагностик.ЕстьДиагностикаГрафа(
			ТипыДиагностикиЗависимостей.Поврежден(),
			ТолькоПроизводственные
		);

	Если ЕстьНеполныеДанные Тогда
		Возврат Ложь;
	КонецЕсли;

	НужноПроверитьПроизводственныйГрафОтдельно = ТолькоПроизводственные
		И НЕ _ИсключитьЗависимостиДляРазработки;

	Если НужноПроверитьПроизводственныйГрафОтдельно Тогда
		Возврат НайтиПроизводственныеТранзитивныеКонфликты().Количество() = 0;
	КонецЕсли;

	Возврат Не _ПравилаПриоритетаДиагностик.ЕстьДиагностикаГрафа(
		ТипыДиагностикиЗависимостей.ТранзитивныйКонфликт(),
		ТолькоПроизводственные
	);

КонецФункции

Функция НайтиПроизводственныеТранзитивныеКонфликты()

	Анализатор = Новый АнализаторТранзитивныхЗависимостей();
	РезультатТранзитивногоАнализа = Анализатор
		.ИсключатьДляРазработки()
		.ИсключитьПоИмени(_ВыражениеИсключенияИменПакетов)
		.Проанализировать(
			Новый ЗависимостиПакета().ЗаполнитьИзТаблицы(_Зависимости),
			_РезультатСканированияПакетов
		);

	Возврат РезультатТранзитивногоАнализа.Конфликты;

КонецФункции

Функция ВсеПрямыеЗависимостиУстановлены(ТолькоПроизводственные)

	Если _РезультатСканированияПакетов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Зависимость Из _Зависимости Цикл
		ИсключитьКонтекстРазработки = ТолькоПроизводственные Или _ИсключитьЗависимостиДляРазработки;
		ПропуститьЗависимость = ИсключитьКонтекстРазработки И Зависимость.ДляРазработки;

		Если ПропуститьЗависимость Тогда
			Продолжить;
		КонецЕсли;

		Если _РезультатСканированияПакетов.Пакеты[Зависимость.ИмяПакета] = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДобавитьСтруктурнуюРекомендацию(
	Тип,
	Зависимость,
	Рекомендация,
	Причина,
	Файлы = Неопределено,
	Требования = Неопределено
)

	Элемент = _РезультатыАнализа.ДобавитьРекомендацию(
		Зависимость.ИмяПакета,
		Зависимость.ДляРазработки,
		Тип
	);
	Элемент.КраткоеОписание = _РеестрОбъявлений.ПредставлениеЗамены(Зависимость, Рекомендация);
	Элемент.ПодробнаяПричина = Причина;

	Если Файлы <> Неопределено Тогда
		Элемент.Файлы = Файлы;
	КонецЕсли;

	Если Требования <> Неопределено Тогда
		Для Каждого Требование Из Требования Цикл
			Элемент.Требования.Добавить(Требование.Копия());
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ОбъявлениеИсключено(Объявление)

	Если Не ЗначениеЗаполнено(_ВыражениеИсключенияИменПакетов) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Новый ФильтрИменПакетов(_ВыражениеИсключенияИменПакетов).Совпадает(Объявление.ИмяПакета);

КонецФункции

#КонецОбласти
