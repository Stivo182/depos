#Использовать "../../common"

#Область ОписаниеПеременных

Перем _Элементы; // Массив

#КонецОбласти

#Область ОбработчикиСобытий

// Создает пустой результат анализа зависимостей.
Процедура ПриСозданииОбъекта()
	
	_Элементы = Новый Массив();
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает диагностические элементы в порядке добавления в отдельном массиве.
//
// Параметры:
//   Тип - Строка, Неопределено - Тип диагностики или все типы.
//
// Возвращаемое значение:
//   Массив из ДиагностическийЭлементЗависимости
Функция Элементы(Тип = Неопределено) Экспорт

	Результат = Новый Массив();
	Для Каждого Элемент Из _Элементы Цикл
		Если Тип = Неопределено Или Элемент.Тип = Тип Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Добавляет ошибку зависимости.
//
// Параметры:
//   Тип - Строка - Тип диагностики.
//   ИмяПакета - Строка - Имя пакета с ошибкой.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   ДиагностическийЭлементЗависимости
Функция ДобавитьОшибку(Тип, ИмяПакета, ДляРазработки) Экспорт

	Возврат ДобавитьЭлемент(
		Тип,
		ИмяПакета,
		ДляРазработки,
		УровниДиагностикиЗависимостей.Ошибка()
	);

КонецФункции

// Добавляет предупреждение по зависимости.
//
// Параметры:
//   Тип - Строка - Тип диагностики.
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   ДиагностическийЭлементЗависимости
Функция ДобавитьПредупреждение(Тип, ИмяПакета, ДляРазработки) Экспорт

	Возврат ДобавитьЭлемент(
		Тип,
		ИмяПакета,
		ДляРазработки,
		УровниДиагностикиЗависимостей.Предупреждение()
	);

КонецФункции

// Добавляет информационную рекомендацию по зависимости.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//   Тип - Строка - Тип диагностики или пустая строка для рекомендации версии.
//
// Возвращаемое значение:
//   ДиагностическийЭлементЗависимости
Функция ДобавитьРекомендацию(ИмяПакета, ДляРазработки, Тип = "") Экспорт

	Если Не ЗначениеЗаполнено(Тип) Тогда
		Тип = ТипыДиагностикиЗависимостей.РекомендацияВерсии();
	КонецЕсли;

	Возврат ДобавитьЭлемент(
		Тип,
		ИмяПакета,
		ДляРазработки,
		УровниДиагностикиЗависимостей.Рекомендация()
	);

КонецФункции

// Удаляет элементы заданного типа для пакета в указанном контексте.
//
// Параметры:
//   Тип - Строка - Тип диагностического элемента.
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
Процедура УдалитьЭлементы(Тип, ИмяПакета, ДляРазработки) Экспорт

	Количество = _Элементы.Количество();
	Для Инд = 1 По Количество Цикл
		Индекс = Количество - Инд;
		Элемент = _Элементы[Индекс];
		Если Элемент.Тип = Тип
			И Элемент.ИмяПакета = ИмяПакета
			И Элемент.ДляРазработки = ДляРазработки Тогда
			_Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Удаляет все рекомендации из результата анализа.
Процедура ОчиститьРекомендации() Экспорт

	Количество = _Элементы.Количество();
	Для Инд = 1 По Количество Цикл
		Индекс = Количество - Инд;
		Если _Элементы[Индекс].Уровень = УровниДиагностикиЗависимостей.Рекомендация() Тогда
			_Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет наличие ошибок в результате анализа.
//
// Возвращаемое значение:
//   Булево
Функция ЕстьОшибки() Экспорт
	Возврат КоличествоОшибок() > 0;
КонецФункции

// Возвращает общее количество найденных ошибок.
//
// Возвращаемое значение:
//   Число
Функция КоличествоОшибок() Экспорт

	Результат = 0;
	Для Каждого Элемент Из _Элементы Цикл
		Если Элемент.Уровень = УровниДиагностикиЗависимостей.Ошибка() Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает общее количество найденных предупреждений.
//
// Возвращаемое значение:
//   Число
Функция КоличествоПредупреждений() Экспорт

	Возврат КоличествоПоУровню(УровниДиагностикиЗависимостей.Предупреждение());

КонецФункции

// Возвращает общее количество найденных рекомендаций.
//
// Возвращаемое значение:
//   Число
Функция КоличествоРекомендаций() Экспорт

	Возврат КоличествоПоУровню(УровниДиагностикиЗависимостей.Рекомендация());

КонецФункции

// Удаляет из результата анализа диагностические элементы по имени пакета.
//
// Параметры:
//   Фильтр - Строка - Имена пакетов через запятую или пробел,
//                     маска с символами * (любые символы) и ? (один символ)
//                     или регулярное выражение (например, /^autumn-.*$/).
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов
Функция ИсключитьПоИмени(Фильтр) Экспорт

	Если Не ЗначениеЗаполнено(Фильтр) Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	ФильтрИмен = Новый ФильтрИменПакетов(Фильтр);
	ПрименитьИсключениеКЭлементам(ФильтрИмен);

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьЭлемент(Тип, ИмяПакета, ДляРазработки, Уровень)

	Элемент = Новый ДиагностическийЭлементЗависимости(
		Тип,
		ИмяПакета,
		ДляРазработки,
		Уровень
	);
	_Элементы.Добавить(Элемент);

	Возврат Элемент;

КонецФункции

Функция КоличествоПоУровню(Уровень)

	Результат = 0;
	Для Каждого Элемент Из _Элементы Цикл
		Если Элемент.Уровень = Уровень Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПрименитьИсключениеКЭлементам(ФильтрИмен)

	Количество = _Элементы.Количество();
	Для Инд = 1 По Количество Цикл
		Индекс = Количество - Инд;
		Если ФильтрИмен.Совпадает(_Элементы[Индекс].ИмяПакета) Тогда
			_Элементы.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
