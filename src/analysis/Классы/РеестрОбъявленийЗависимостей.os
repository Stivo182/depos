#Область ОписаниеПеременных

Перем _Объявления; // Массив из Структура

#КонецОбласти

#Область ОбработчикиСобытий

// Создает индекс исходных объявлений зависимостей.
//
// Параметры:
//   Объявления - Массив из Структура - Объявления, полученные при разборе манифеста.
Процедура ПриСозданииОбъекта(Объявления)

	_Объявления = Объявления;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Находит литеральное объявление пакета в указанном контексте.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//   ДляРазработки - Булево - Признак зависимости для разработки.
//
// Возвращаемое значение:
//   Структура, Неопределено - Найденное объявление.
Функция НайтиЛитеральноеОбъявление(ИмяПакета, ДляРазработки) Экспорт

	Для Каждого Объявление Из _Объявления Цикл
		СовпадаетИмяПакета = НРег(Объявление.ИмяПакета) = НРег(ИмяПакета);
		СовпадаетКонтекст = Объявление.ДляРазработки = ДляРазработки;
		ПодходящееОбъявление = Объявление.ЛитеральноеОбъявление
			И СовпадаетИмяПакета
			И СовпадаетКонтекст;

		Если ПодходящееОбъявление Тогда
			Возврат Объявление;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает текст литерального объявления зависимости.
//
// Параметры:
//   Зависимость - СтрокаТаблицыЗначений - Зависимость пакета.
//
// Возвращаемое значение:
//   Строка - Текст объявления или пустая строка, если объявление не найдено.
Функция Текст(Зависимость) Экспорт

	Объявление = НайтиЛитеральноеОбъявление(Зависимость.ИмяПакета, Зависимость.ДляРазработки);
	Возврат ?(Объявление = Неопределено, "", Объявление.ТекстОбъявления);

КонецФункции

// Возвращает текст литерального объявления вместе с пометкой.
//
// Параметры:
//   Зависимость - СтрокаТаблицыЗначений - Зависимость пакета.
//
// Возвращаемое значение:
//   Строка - Текст объявления или пустая строка, если объявление не найдено.
Функция ТекстСПометкой(Зависимость) Экспорт

	Объявление = НайтиЛитеральноеОбъявление(Зависимость.ИмяПакета, Зависимость.ДляРазработки);
	Если Объявление = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Объявление.ТекстОбъявления
		+ ?(ЗначениеЗаполнено(Объявление.ТекстПометки), " " + Объявление.ТекстПометки, "");

КонецФункции

// Формирует представление замены объявления.
//
// Параметры:
//   Зависимость - СтрокаТаблицыЗначений - Зависимость пакета.
//   Рекомендация - Строка - Предлагаемое объявление или действие.
//
// Возвращаемое значение:
//   Строка - Представление исходного и предлагаемого объявлений.
Функция ПредставлениеЗамены(Зависимость, Рекомендация) Экспорт

	Объявление = НайтиЛитеральноеОбъявление(Зависимость.ИмяПакета, Зависимость.ДляРазработки);
	Префикс = ?(Объявление = Неопределено, "", "Строка " + Объявление.НомерСтроки + ": ");
	Возврат Префикс + ТекстСПометкой(Зависимость) + " → " + Рекомендация;

КонецФункции

// Формирует представление исходного объявления с номером строки.
//
// Параметры:
//   Зависимость - СтрокаТаблицыЗначений - Зависимость пакета.
//   УчитыватьПометку - Булево - Добавлять текст пометки зависимости.
//   ДобавлятьПодпись - Булево - Добавлять подпись "Объявлено".
//
// Возвращаемое значение:
//   Строка - Представление объявления или пустая строка, если объявление не найдено.
Функция Представление(Зависимость, УчитыватьПометку = Ложь, ДобавлятьПодпись = Истина) Экспорт

	Объявление = НайтиЛитеральноеОбъявление(Зависимость.ИмяПакета, Зависимость.ДляРазработки);
	Если Объявление = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТекстОбъявления = ?(УчитыватьПометку, ТекстСПометкой(Зависимость), Объявление.ТекстОбъявления);
	Представление = ТекстОбъявления + "  (строка " + Объявление.НомерСтроки + ")";
	Возврат ?(ДобавлятьПодпись, "Объявлено: " + Представление, Представление);

КонецФункции

// Возвращает все объявления указанного пакета.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Массив из Структура - Объявления пакета.
Функция ДляПакета(ИмяПакета) Экспорт

	Результат = Новый Массив();
	Для Каждого Объявление Из _Объявления Цикл
		Если НРег(Объявление.ИмяПакета) = НРег(ИмяПакета) Тогда
			Результат.Добавить(Объявление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует многострочное описание повторных объявлений.
//
// Параметры:
//   Объявления - Массив из Структура - Повторные объявления пакета.
//
// Возвращаемое значение:
//   Строка - Строки и тексты объявлений.
Функция ОписаниеПовторных(Объявления) Экспорт

	Строки = Новый Массив();
	Для Каждого Объявление Из Объявления Цикл
		ТекстОбъявления = ?(
			Объявление.ЛитеральноеОбъявление,
			Объявление.ТекстОбъявления,
			"вычисляемое объявление"
		);
		Строки.Добавить(СтрШаблон("Строка %1: %2", Объявление.НомерСтроки, ТекстОбъявления));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Проверяет совпадение ограничений версии у объявлений.
//
// Параметры:
//   Объявления - Массив из Структура - Сравниваемые объявления.
//
// Возвращаемое значение:
//   Булево - Истина, если ограничения совпадают.
Функция ОграниченияВерсийОбъявленийСовпадают(Объявления) Экспорт

	Первое = Объявления[0];
	Для Индекс = 1 По Объявления.Количество() - 1 Цикл
		Текущее = Объявления[Индекс];
		РазличаютсяОграничения = Текущее.МинимальнаяВерсия <> Первое.МинимальнаяВерсия
			Или Текущее.МаксимальнаяВерсия <> Первое.МаксимальнаяВерсия;

		Если РазличаютсяОграничения Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет, что все объявления литеральные.
//
// Параметры:
//   Объявления - Массив из Структура - Проверяемые объявления.
//
// Возвращаемое значение:
//   Булево - Истина, если все объявления литеральные.
Функция ВсеЛитеральные(Объявления) Экспорт

	Для Каждого Объявление Из Объявления Цикл
		Если Не Объявление.ЛитеральноеОбъявление Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти
