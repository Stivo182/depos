// Возвращает уровень ошибки.
//
// Возвращаемое значение:
//   Строка - Уровень диагностики.
Функция Ошибка() Экспорт

	Возврат "error";

КонецФункции

// Возвращает уровень предупреждения.
//
// Возвращаемое значение:
//   Строка - Уровень диагностики.
Функция Предупреждение() Экспорт

	Возврат "warning";

КонецФункции

// Возвращает уровень рекомендации.
//
// Возвращаемое значение:
//   Строка - Уровень диагностики.
Функция Рекомендация() Экспорт

	Возврат "recommendation";

КонецФункции
