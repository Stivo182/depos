#Использовать coloratos
#Использовать "../../core"
#Использовать "../../internal"

#Область Опции

&Опция(Имя = "m manifest", Описание = "Путь к файлу манифеста или его каталогу (по умолчанию - текущая директория)")
&ТСтрока
Перем _ФайлМанифеста; // Строка

&Опция(Имя = "p package", Описание = "Имя установленного пакета")
&ТСтрока
Перем _ИмяУстановленногоПакета; // Строка, Неопределено

&Опция(Имя = "src-dirs", Описание = "Каталоги с исходным кодом для анализа")
&ТСтрока
&ПоУмолчанию("")
Перем _КаталогиИсходников; // Строка

&Опция(Имя = "dev-dirs", Описание = "Каталоги с вспомогательным кодом для анализа")
&ТСтрока
&ПоУмолчанию("")
Перем _КаталогиВспомогательныхИсходников; // Строка

&Опция(Имя = "ignore-dev", Описание = "Игнорировать зависимости для разработки при анализе")
&Флаг
&ПоУмолчанию(Ложь)
Перем _ИгнорироватьЗависимостиДляРазработки; // Булево

&Опция(Имя = "strict", Описание = "Завершать выполнение с ненулевым кодом при обнаружении проблем")
&Флаг
&ПоУмолчанию(Ложь)
Перем _СтрогийРежим; // Булево

&Опция(
	Имя = "checks",
	Описание = "Проверки: usage, installed, transitive или их комбинация через запятую"
)
&ТСтрока
&ПоУмолчанию("")
Перем _Проверки; // Строка

&Опция(
	Имя = "x exclude",
	Описание = "Исключает зависимости по выражению: список имен, маска или регулярное выражение (например, /^autumn-.*$/)"
)
&ТСтрока
Перем _ВыражениеИсключенияИменПакетов; // Строка

#КонецОбласти

#Область ОписаниеПеременных

&ЛогDepos
Перем _Лог; // Лог

&Пластилин("НастройкиПриложения")
Перем _НастройкиПриложения; // НастройкиПриложения

&Пластилин("ПомощникЗапускаКоманд")
Перем _ПомощникЗапускаКоманд; // ПомощникЗапускаКоманд

&Пластилин("КонсольныйРепортерАнализаЗависимостей")
Перем _КонсольныйРепортерАнализаЗависимостей; // КонсольныйРепортерАнализаЗависимостей

&Пластилин("АнализаторЗависимостей")
Перем _АнализаторЗависимостей; // АнализаторЗависимостей

#КонецОбласти

&КомандаПриложения(Имя = "doctor", Описание = "Диагностика зависимостей")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ЗапуститьБезопасно() Экспорт

	Попытка
		Запустить();
	Исключение
		_ПомощникЗапускаКоманд.ОбработатьОшибку(ИнформацияОбОшибке(), _Лог);
	КонецПопытки;

КонецПроцедуры

Процедура Запустить()

	ВыборПроверок = Новый ВыборПроверокЗависимостей(_Проверки);
	ФайлМанифеста = ПолучитьФайлМанифеста();

	Консоль.ВывестиСтроку(СтрШаблон("Диагностика зависимостей: %1" + Символы.ПС, ФайлМанифеста));

	РезультатыАнализа = ПолучитьРезультатыАнализаСИсключениями(ФайлМанифеста, ВыборПроверок);

	_КонсольныйРепортерАнализаЗависимостей.Вывести(РезультатыАнализа);

	Если Не _НастройкиПриложения.РежимОтладки Тогда
		ЗавершитьРаботу(ОпределитьКодВозврата(РезультатыАнализа));
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьКодВозврата(РезультатыАнализа)

	Если _СтрогийРежим И РезультатыАнализа.ЕстьПроблемы() Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ПолучитьФайлМанифеста()

	_ПомощникЗапускаКоманд
		.УстановитьФайлМанифеста(_ФайлМанифеста)
		.УстановитьИмяУстановленногоПакета(_ИмяУстановленногоПакета);
		
	Возврат _ПомощникЗапускаКоманд.ОпределитьФайлМанифеста();

КонецФункции

Функция ПолучитьРезультатыАнализаСИсключениями(ФайлМанифеста, ВыборПроверок)

	Зависимости = Новый ЗависимостиПакета()
		.ЗаполнитьИзМанифеста(ФайлМанифеста)
		.УдалитьПоИмени(_ВыражениеИсключенияИменПакетов);

	РезультатыАнализа = ПолучитьРезультатыАнализа(
		ФайлМанифеста,
		Зависимости,
		ВыборПроверок
	);

	Возврат РезультатыАнализа.ИсключитьПоИмени(_ВыражениеИсключенияИменПакетов);

КонецФункции

Функция ПолучитьРезультатыАнализа(ФайлМанифеста, Зависимости, ВыборПроверок)
		
	РабочийКаталог = Новый Файл(ФайлМанифеста).Путь;
	КаталогиИсходников = ПолучитьКаталогиДляАнализа(_КаталогиИсходников, РабочийКаталог, "src");
	КаталогиДляРазработки = ПолучитьКаталогиДляАнализа(
		_КаталогиВспомогательныхИсходников,
		РабочийКаталог,
		"tests,tasks"
	);

	_АнализаторЗависимостей
		.РабочийКаталог(РабочийКаталог)
		.КаталогиИсходников(КаталогиИсходников)
		.ИсключитьПоИмени(_ВыражениеИсключенияИменПакетов);

	Если _ИгнорироватьЗависимостиДляРазработки
		Или ЗначениеЗаполнено(_ИмяУстановленногоПакета) Тогда
		_АнализаторЗависимостей.ИсключатьДляРазработки();
	Иначе
		_АнализаторЗависимостей.КаталогиДляРазработки(КаталогиДляРазработки);
	КонецЕсли;

	Возврат _АнализаторЗависимостей.ПроверитьЗависимости(Зависимости, ВыборПроверок);

КонецФункции

Функция ПолучитьКаталогиДляАнализа(ЗаданныеКаталоги, РабочийКаталог, КаталогиПоУмолчанию)

	Если ЗначениеЗаполнено(ЗаданныеКаталоги) Тогда
		Возврат ЗаданныеКаталоги;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Каталог Из СтрРазделить(КаталогиПоУмолчанию, ",", Ложь) Цикл
		Если ФС.КаталогСуществует(ОбъединитьПути(РабочийКаталог, Каталог)) Тогда
			Результат.Добавить(Каталог);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции
