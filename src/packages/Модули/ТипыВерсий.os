#Использовать errors
#Использовать "../../common"

#Область ПрограммныйИнтерфейс

// Возвращает тип поиска последней версии.
//
// Возвращаемое значение:
//   Строка - Тип версии.
Функция Последняя() Экспорт

	Возврат "Последняя";

КонецФункции

// Возвращает тип поиска минорной версии.
//
// Возвращаемое значение:
//   Строка - Тип версии.
Функция Минорная() Экспорт

	Возврат "Минорная";

КонецФункции

// Возвращает тип поиска патч-версии.
//
// Возвращаемое значение:
//   Строка - Тип версии.
Функция Патч() Экспорт

	Возврат "Патч";

КонецФункции

// Преобразует аргумент CLI типа целевой версии в значение ТипыВерсий.
//
// Параметры:
//   Аргумент - Строка - Значение аргумента CLI: latest, minor или patch.
//
// Возвращаемое значение:
//   Строка - Значение ТипыВерсий.
//
// Исключения:
//   - Если аргумент не входит в latest, minor, patch.
Функция ИзАргументаКоманднойСтроки(Аргумент) Экспорт

	Если Аргумент = "latest" Тогда
		Возврат Последняя();
	ИначеЕсли Аргумент = "minor" Тогда
		Возврат Минорная();
	ИначеЕсли Аргумент = "patch" Тогда
		Возврат Патч();
	КонецЕсли;

	Сообщение = СтрШаблон("Некорректный тип целевой версии '%1'", Аргумент);
	ВызватьИсключение Новый ПостроительОшибки(КодыОшибокDepos.ТипЦелевойВерсииНекорректен(), Сообщение)
		.Подсказка("Допустимые значения: latest, minor, patch.")
		.Построить();

КонецФункции

#КонецОбласти
