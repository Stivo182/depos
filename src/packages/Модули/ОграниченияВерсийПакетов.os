#Область СлужебныйПрограммныйИнтерфейс

// Проверяет наличие минимальной или максимальной версии.
//
// Параметры:
//   Ограничение - Структура, СтрокаТаблицыЗначений, ТребованиеЗависимости - Объект с границами версии.
//
// Возвращаемое значение:
//   Булево - Истина, если указана хотя бы одна граница.
Функция Есть(Ограничение) Экспорт

	Возврат ЗначениеЗаполнено(Ограничение.МинимальнаяВерсия)
		Или ЗначениеЗаполнено(Ограничение.МаксимальнаяВерсия);

КонецФункции

// Возвращает строковое представление ограничения версии.
//
// Параметры:
//   Ограничение - Структура, СтрокаТаблицыЗначений, ТребованиеЗависимости - Объект с границами версии.
//
// Возвращаемое значение:
//   Строка - Ограничение в формате >=X,<=Y.
Функция Представление(Ограничение) Экспорт

	Части = Новый Массив();
	Если ЗначениеЗаполнено(Ограничение.МинимальнаяВерсия) Тогда
		Части.Добавить(">=" + Ограничение.МинимальнаяВерсия);
	КонецЕсли;

	Если ЗначениеЗаполнено(Ограничение.МаксимальнаяВерсия) Тогда
		Части.Добавить("<=" + Ограничение.МаксимальнаяВерсия);
	КонецЕсли;

	Возврат СтрСоединить(Части, ",");

КонецФункции

// Возвращает нарушенное установленной версией ограничение.
//
// Параметры:
//   Ограничение - Структура, СтрокаТаблицыЗначений, ТребованиеЗависимости - Объект с границами версии.
//   УстановленнаяВерсия - Строка - Проверяемая версия.
//
// Возвращаемое значение:
//   Строка - Представление нарушенного ограничения или пустая строка.
Функция Нарушенное(Ограничение, УстановленнаяВерсия) Экспорт

	МеньшеМинимальной = ЗначениеЗаполнено(Ограничение.МинимальнаяВерсия)
		И Сравнить(УстановленнаяВерсия, Ограничение.МинимальнаяВерсия) < 0;
	БольшеМаксимальной = ЗначениеЗаполнено(Ограничение.МаксимальнаяВерсия)
		И Сравнить(УстановленнаяВерсия, Ограничение.МаксимальнаяВерсия) > 0;

	Возврат ?(МеньшеМинимальной Или БольшеМаксимальной, Представление(Ограничение), "");

КонецФункции

// Проверяет, гарантирует ли первое ограничение требования второго.
//
// Параметры:
//   Покрывающее - Структура, СтрокаТаблицыЗначений - Более строгое ограничение.
//   Покрываемое - Структура, СтрокаТаблицыЗначений - Проверяемое ограничение.
//
// Возвращаемое значение:
//   Булево - Истина, если покрывающее ограничение гарантирует покрываемое.
Функция Покрывает(Покрывающее, Покрываемое) Экспорт

	ОграниченияСовпадают = Покрывающее.МинимальнаяВерсия = Покрываемое.МинимальнаяВерсия
		И Покрывающее.МаксимальнаяВерсия = Покрываемое.МаксимальнаяВерсия;
	Если ОграниченияСовпадают Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не Есть(Покрываемое) Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		МинимумПокрыт = Не ЗначениеЗаполнено(Покрываемое.МинимальнаяВерсия)
			Или ЗначениеЗаполнено(Покрывающее.МинимальнаяВерсия)
				И Сравнить(Покрывающее.МинимальнаяВерсия, Покрываемое.МинимальнаяВерсия) >= 0;
		МаксимумПокрыт = Не ЗначениеЗаполнено(Покрываемое.МаксимальнаяВерсия)
			Или ЗначениеЗаполнено(Покрывающее.МаксимальнаяВерсия)
				И Сравнить(Покрывающее.МаксимальнаяВерсия, Покрываемое.МаксимальнаяВерсия) <= 0;
		Возврат МинимумПокрыт И МаксимумПокрыт;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проверяет совместимость двух ограничений версий.
//
// Параметры:
//   Первое - Структура, ТребованиеЗависимости - Первое ограничение.
//   Второе - Структура, ТребованиеЗависимости - Второе ограничение.
//
// Возвращаемое значение:
//   Булево - Истина, если диапазоны имеют пересечение.
Функция Совместимы(Первое, Второе) Экспорт

	Если ЗначениеЗаполнено(Первое.МинимальнаяВерсия)
		И ЗначениеЗаполнено(Второе.МаксимальнаяВерсия)
		И Сравнить(Первое.МинимальнаяВерсия, Второе.МаксимальнаяВерсия) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(Второе.МинимальнаяВерсия)
		И ЗначениеЗаполнено(Первое.МаксимальнаяВерсия)
		И Сравнить(Второе.МинимальнаяВерсия, Первое.МаксимальнаяВерсия) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Возвращает наиболее строгую минимальную версию из требований.
//
// Параметры:
//   Требования - Массив из ТребованиеЗависимости - Требования версий.
//
// Возвращаемое значение:
//   Строка - Наиболее строгая минимальная версия.
Функция НаиболееСтрогийМинимум(Требования) Экспорт

	Результат = "";
	Для Каждого Требование Из Требования Цикл
		Если Не ЗначениеЗаполнено(Требование.МинимальнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Результат)
			Или Сравнить(Требование.МинимальнаяВерсия, Результат) > 0 Тогда
			Результат = Требование.МинимальнаяВерсия;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает наиболее строгую максимальную версию из требований.
//
// Параметры:
//   Требования - Массив из ТребованиеЗависимости - Требования версий.
//
// Возвращаемое значение:
//   Строка - Наиболее строгая максимальная версия.
Функция НаиболееСтрогийМаксимум(Требования) Экспорт

	Результат = "";
	Для Каждого Требование Из Требования Цикл
		Если Не ЗначениеЗаполнено(Требование.МаксимальнаяВерсия) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Результат)
			Или Сравнить(Требование.МаксимальнаяВерсия, Результат) < 0 Тогда
			Результат = Требование.МаксимальнаяВерсия;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сравнивает две версии пакета.
//
// Параметры:
//   ПерваяВерсия - Строка - Первая версия.
//   ВтораяВерсия - Строка - Вторая версия.
//
// Возвращаемое значение:
//   Число - Отрицательное, ноль или положительное значение.
Функция Сравнить(ПерваяВерсия, ВтораяВерсия) Экспорт

	Возврат Новый ВерсияПакета(ПерваяВерсия).Сравнить(ВтораяВерсия);

КонецФункции

#КонецОбласти
