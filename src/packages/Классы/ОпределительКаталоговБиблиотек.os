#Использовать engine-config

#Область ОписаниеПеременных

Перем _КонфигурационныйФайл; // Строка
Перем _КонтекстныйКаталог; // Строка

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	_КонфигурационныйФайл = "";
	_КонтекстныйКаталог = "";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает конфигурационный файл oscript.cfg.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к конфигурационному файлу.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьКонфигурационныйФайл(ПутьКФайлу) Экспорт

	_КонфигурационныйФайл = ПутьКФайлу;
	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает каталог, относительно которого разрешаются пути библиотек.
//
// Параметры:
//   Каталог - Строка - Базовый каталог. Пустая строка включает обычную конфигурацию запуска.
//
// Возвращаемое значение:
//   ЭтотОбъект - Для поддержки цепочки вызовов.
Функция УстановитьКонтекстныйКаталог(Каталог) Экспорт
	_КонтекстныйКаталог = Каталог;
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает упорядоченный список каталогов библиотек, видимых проекту.
//
// В контекстном режиме учитываются системная конфигурация движка и OSCRIPT_CONFIG, пути которого
// разрешаются относительно контекстного каталога. Явный конфигурационный файл имеет наивысший приоритет.
//
// Возвращаемое значение:
//   Массив из Строка - Абсолютные пути каталогов: дополнительные, затем системный.
Функция ПолучитьКаталогиБиблиотек() Экспорт

	Построитель = Новый ПостроительКонфигурацииИнтерпретатора();
	Если ЗначениеЗаполнено(_КонтекстныйКаталог) Тогда
		КаталогДвижка = Новый Файл(ОбъединитьПути(КаталогПрограммы(), "..")).ПолноеИмя;
		Построитель
			.ДобавитьНеобязательныйФайлКонфигурации(ОбъединитьПути(КаталогДвижка, "bin", "oscript.cfg"))
			.ДобавитьТекущееОкружение(_КонтекстныйКаталог);
	Иначе
		Построитель.ДобавитьСтандартныеИсточники();
	КонецЕсли;

	Если ЗначениеЗаполнено(_КонфигурационныйФайл) Тогда
		Построитель.ДобавитьНеобязательныйФайлКонфигурации(_КонфигурационныйФайл);
	КонецЕсли;

	Конфигурация = Построитель.Построить();
	Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

	Возврат Локатор.ПолучитьКаталогиПоиска();

КонецФункции

#КонецОбласти
