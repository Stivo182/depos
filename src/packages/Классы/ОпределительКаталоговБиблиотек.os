#Использовать engine-config

#Область ОписаниеПеременных

Перем _КонфигурационныйФайл; // Строка

#КонецОбласти

#Область ОбработчикиСобытий

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()

	_КонфигурационныйФайл = "";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает конфигурационный файл oscript.cfg.
//
// Параметры:
//   ПутьКФайлу - Строка - Путь к конфигурационному файлу.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьКонфигурационныйФайл(ПутьКФайлу) Экспорт

	_КонфигурационныйФайл = ПутьКФайлу;
	Возврат ЭтотОбъект;

КонецФункции

// Возвращает упорядоченный список каталогов библиотек, видимых проекту.
//
// Стандартные источники текущего запуска учитываются с обычным приоритетом OneScript. Явно установленный
// конфигурационный файл имеет наивысший приоритет.
//
// Возвращаемое значение:
//   Массив из Строка - Абсолютные пути каталогов: дополнительные, затем системный.
Функция ПолучитьКаталогиБиблиотек() Экспорт

	Построитель = Новый ПостроительКонфигурацииИнтерпретатора();
	Построитель.ДобавитьСтандартныеИсточники();

	Если ЗначениеЗаполнено(_КонфигурационныйФайл) Тогда
		Построитель.ДобавитьНеобязательныйФайлКонфигурации(_КонфигурационныйФайл);
	КонецЕсли;

	Конфигурация = Построитель.Построить();
	Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

	Возврат Локатор.ПолучитьКаталогиПоиска();

КонецФункции

#КонецОбласти
