#Использовать errors
#Использовать "../../common"

#Область ОписаниеПеременных

Перем _НастройкиРеестраПакетов; // НастройкиРеестраПакетов
Перем _АдаптерOpenHub; // АдаптерOpenHub
Перем _Лог; // Лог

#КонецОбласти

#Область ОбработчикиСобытий

// Создает клиент реестра пакетов.
//
// Параметры:
//   НастройкиРеестраПакетов - НастройкиРеестраПакетов - Настройки адресов и подключения к реестру.
//   АдаптерOpenHub          - АдаптерOpenHub - Адаптер API OpenHub.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиРеестраПакетов") НастройкиРеестраПакетов,
	&Пластилин("АдаптерOpenHub") АдаптерOpenHub
)

	_НастройкиРеестраПакетов = НастройкиРеестраПакетов;
	_АдаптерOpenHub = АдаптерOpenHub;
	_Лог = Логирование.ПолучитьЛог("oscript.lib.depos");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает версии пакета из реестра.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Массив из Строка - Корректные semver-версии или пустой массив, если пакет не найден.
//
// Исключения:
//   - registry.hosts_not_configured - Если не настроен реестр.
//   - registry.unavailable - Если реестр не вернул корректные версии.
Функция ПолучитьВерсии(ИмяПакета) Экспорт

	Возврат ПолучитьПодходящиеВерсии(ИмяПакета);

КонецФункции

// Выбирает версию пакета в настроенных реестрах с учетом OneScript.
//
// Параметры:
//   ИмяПакета     - Строка - Имя пакета.
//   Спецификация - Строка - Диапазон версий OpenHub.
//   ВерсияДвижка - Строка - Целевая версия OneScript.
//
// Возвращаемое значение:
//   Строка, Неопределено - Подходящая версия или отсутствие версии во всех реестрах.
Функция РазрешитьВерсию(ИмяПакета, Спецификация, ВерсияДвижка) Экспорт

	ДоступныеВерсии = ПолучитьПодходящиеВерсии(ИмяПакета, Спецификация, ВерсияДвижка);
	Возврат ?(ДоступныеВерсии.Количество() > 0, ДоступныеВерсии[0], Неопределено);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПодходящиеВерсии(ИмяПакета, Спецификация = "", ВерсияДвижка = "")

	Серверы = _НастройкиРеестраПакетов.Серверы();
	Прокси = _НастройкиРеестраПакетов.Прокси();
	ПулПоУмолчанию = _НастройкиРеестраПакетов.ПулПоУмолчанию();

	ПроверитьНаличиеСерверов(Серверы);

	ПоследняяОшибка = Неопределено;
	ПоследняяПопыткаУспешна = Ложь;
	БылОтветРезолва = Ложь;
	АдресаРеестров = Новый Массив;

	Для Каждого Сервер Из Серверы Цикл
		ПредставлениеРеестра = АдресаСерверовПакетов.ПредставлениеДляДиагностики(Сервер.Реестр);
		АдресаРеестров.Добавить(ПредставлениеРеестра);

		Попытка
			ДоступныеВерсии = ПолучитьВерсииССервера(
				ИмяПакета,
				Сервер,
				Прокси,
				Спецификация,
				ВерсияДвижка
			);
			ПоследняяПопыткаУспешна = Истина;
			БылОтветРезолва = Истина;
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Если НеподдерживаемыйРезолвПослеОтвета(Ошибка, БылОтветРезолва) Тогда
				Продолжить;
			КонецЕсли;

			ПоследняяОшибка = Ошибка;
			ПоследняяПопыткаУспешна = Ложь;

			Если ОшибкаЗапрещаетПереходКДругомуРеестру(ПоследняяОшибка) Тогда
				ВызватьИсключение;
			КонецЕсли;

			Продолжить;
		КонецПопытки;

		Если ДоступныеВерсии.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Возврат ДоступныеВерсии;
	КонецЦикла;

	ПоследнийСервер = Серверы[Серверы.ВГраница()];
	Если ЗначениеЗаполнено(ПоследнийСервер.Пул)
		И НРег(ПоследнийСервер.Пул) <> НРег(ПулПоУмолчанию)
		И Не ПулУжеУказанДляРеестра(Серверы, ПоследнийСервер.Реестр, ПулПоУмолчанию) Тогда

		Попытка
			ДоступныеВерсии = ПолучитьВерсииИзОсновногоПула(
				ИмяПакета,
				ПоследнийСервер,
				Прокси,
				Спецификация,
				ВерсияДвижка
			);
			ПоследняяПопыткаУспешна = Истина;
			БылОтветРезолва = Истина;
		Исключение
			Ошибка = ИнформацияОбОшибке();
			Если Не НеподдерживаемыйРезолвПослеОтвета(Ошибка, БылОтветРезолва) Тогда
				ПоследняяОшибка = Ошибка;
				ПоследняяПопыткаУспешна = Ложь;
				Если ОшибкаЗапрещаетПереходКДругомуРеестру(ПоследняяОшибка) Тогда
					ВызватьИсключение;
				КонецЕсли;
			КонецЕсли;
		КонецПопытки;

		Если ДоступныеВерсии <> Неопределено И ДоступныеВерсии.Количество() > 0 Тогда
			Возврат ДоступныеВерсии;
		КонецЕсли;
	КонецЕсли;

	Если ПоследняяОшибка <> Неопределено
		И (Не ЗначениеЗаполнено(ВерсияДвижка)
			Или Не НеподдерживаемыйРезолвПослеОтвета(ПоследняяОшибка, ПоследняяПопыткаУспешна)) Тогда
		ВызватьИсключение ПоследняяОшибка;
	КонецЕсли;

	Если ЗначениеЗаполнено(ВерсияДвижка) Тогда
		_Лог.Предупреждение("Для пакета '%1' не найдена версия для OneScript %2 в реестрах %3",
			ИмяПакета,
			ВерсияДвижка,
			СтрСоединить(АдресаРеестров, ", ")
		);
	Иначе
		_Лог.Предупреждение("Пакет '%1' не найден в реестрах %2, пакет пропущен",
			ИмяПакета,
			СтрСоединить(АдресаРеестров, ", ")
		);
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

Функция ОшибкаЗапрещаетПереходКДругомуРеестру(Ошибка)

	Если Не ДиагностикаОшибок.СодержитГруппу(Ошибка, "registry") Тогда
		Возврат Истина;
	КонецЕсли;

	Код = ДиагностикаОшибок.КодОшибки(Ошибка);
	Возврат Код = КодыОшибокDepos.ДоступКРееструЗапрещен()
		Или Код = КодыОшибокDepos.РазрешениеВерсииОтклонено();

КонецФункции

Функция НеподдерживаемыйРезолвПослеОтвета(Ошибка, БылОтветРезолва)

	Возврат БылОтветРезолва
		И ДиагностикаОшибок.КодОшибки(Ошибка) = КодыОшибокDepos.РазрешениеВерсииНеПоддерживается();

КонецФункции

Функция ПолучитьВерсииССервера(ИмяПакета, Сервер, Прокси, Спецификация, ВерсияДвижка)

	Пул = ?(ЗначениеЗаполнено(Сервер.Пул), Сервер.Пул, _НастройкиРеестраПакетов.ПулПоУмолчанию());

	Возврат ПолучитьВерсииАдаптером(
		ИмяПакета,
		АдресХаба(Сервер),
		Прокси,
		Пул,
		Сервер.Заголовки,
		Спецификация,
		ВерсияДвижка
	);

КонецФункции

Функция ПолучитьВерсииИзОсновногоПула(ИмяПакета, Сервер, Прокси, Спецификация, ВерсияДвижка)

	Возврат ПолучитьВерсииАдаптером(
		ИмяПакета,
		АдресХаба(Сервер),
		Прокси,
		_НастройкиРеестраПакетов.ПулПоУмолчанию(),
		Сервер.Заголовки,
		Спецификация,
		ВерсияДвижка
	);

КонецФункции

Функция ПулУжеУказанДляРеестра(Серверы, Реестр, Пул)

	Для Каждого Сервер Из Серверы Цикл
		Если НРег(Сервер.Пул) = НРег(Пул)
			И Сервер.Реестр.Корневой().ЭквивалентенДляСхемы(Реестр.Корневой()) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПолучитьВерсииАдаптером(ИмяПакета,
	Реестр,
	Прокси,
	Пул,
	Заголовки,
	Спецификация,
	ВерсияДвижка
)

	ПредставлениеРеестра = АдресаСерверовПакетов.ПредставлениеДляДиагностики(Реестр);
	ДополнениеОПуле = СтрШаблон(", пул: %1", Пул);

	_Лог.Отладка(
		"Получение версий пакета '%1' из реестра: %2%3",
		ИмяПакета,
		ПредставлениеРеестра,
		ДополнениеОПуле
	);

	Если ЗначениеЗаполнено(ВерсияДвижка) Тогда
		Версия = _АдаптерOpenHub.РазрешитьВерсию(
			ИмяПакета,
			Спецификация,
			ВерсияДвижка,
			Реестр,
			Прокси,
			Пул,
			Заголовки
		);

		ДоступныеВерсии = Новый Массив;
		Если ЗначениеЗаполнено(Версия) Тогда
			ДоступныеВерсии.Добавить(Версия);
		КонецЕсли;
	Иначе
		ДоступныеВерсии = _АдаптерOpenHub.ПолучитьВерсии(
			ИмяПакета,
			Реестр,
			Прокси,
			Пул,
			Заголовки
		);
	КонецЕсли;

	Если ДоступныеВерсии.Количество() > 0 Тогда
		_Лог.Отладка(
			"Успешно получено %1 версий пакета '%2' из реестра: %3%4",
			ДоступныеВерсии.Количество(),
			ИмяПакета,
			ПредставлениеРеестра,
			ДополнениеОПуле
		);
	КонецЕсли;

	Возврат ДоступныеВерсии;

КонецФункции

Функция ПулПолученИзАдреса(Сервер)

	Если Не ЗначениеЗаполнено(Сервер.Пул) Тогда
		Возврат Ложь;
	КонецЕсли;

	КоличествоСегментов = 0;
	СегментПути = "";
	Для Каждого Сегмент Из Сервер.Реестр.СегментыПути() Цикл
		Если ПустаяСтрока(Сегмент) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоСегментов = КоличествоСегментов + 1;
		СегментПути = Сегмент;
	КонецЦикла;

	Возврат КоличествоСегментов = 1 И НРег(СегментПути) = НРег(Сервер.Пул);

КонецФункции

Функция АдресХаба(Сервер)

	Если ПулПолученИзАдреса(Сервер) Тогда
		Возврат АдресаСерверовПакетов.КорневойСДаннымиПользователя(Сервер.Реестр);
	КонецЕсли;

	Возврат Сервер.Реестр.Скопировать();

КонецФункции

Процедура ПроверитьНаличиеСерверов(Серверы)

	Если Серверы.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Ошибка = Новый ПостроительОшибки(
		КодыОшибокDepos.ХостыРеестраНеНастроены(),
		"Не настроен адрес реестра пакетов"
	)
		.Подсказка("Укажите адрес реестра через --registry или настройте серверы пакетов в opm.cfg.")
		.Построить();

	ВызватьИсключение Ошибка;

КонецПроцедуры

#КонецОбласти
