#Область ОбработчикиСобытий

// Создает провайдер настроек серверов пакетов OPM.
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает серверы и proxy из первого существующего файла opm.cfg.
//
// Параметры:
//   УчитыватьЗеркало - Булево - Учитывать сервер из переменной среды OPM_HUB_MIRROR.
//
// Возвращаемое значение:
//   Структура:
//     * Серверы - Массив из Структура:
//       ** Имя             - Строка - Имя сервера пакетов.
//       ** Адрес           - URL - Адрес сервера пакетов.
//       ** Пул             - Строка - Имя пула пакетов или пустая строка.
//       ** Заголовки       - Соответствие - HTTP-заголовки запросов к серверу.
//     * Прокси - Структура - Настройки proxy:
//       ** ИспользоватьСистемный         - Булево - Использовать системные настройки proxy.
//       ** Сервер                        - Строка - Адрес сервера proxy.
//       ** Порт                          - Число - Порт сервера proxy.
//       ** Пользователь                  - Строка - Имя пользователя.
//       ** Пароль                        - Строка - Пароль пользователя.
//       ** ИспользоватьАутентификациюОС  - Булево - Использовать аутентификацию операционной системы.
//   Неопределено - Настройки proxy отсутствуют.
Функция ПолучитьНастройки(УчитыватьЗеркало = Истина) Экспорт

	ПутиФайлов = ПутиФайловНастроек();
	ИмяЗеркала = ?(УчитыватьЗеркало, ПолучитьПеременнуюСреды("OPM_HUB_MIRROR"), "");

	Для Каждого ПутьФайла Из ПутиФайлов Цикл
		Если Не Новый Файл(ПутьФайла).Существует() Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Настройки = ПрочитатьНастройки(ПутьФайла);
			Возврат НовыеНастройкиOpm(
				СерверыИзНастроек(Настройки, ИмяЗеркала),
				ПроксиИзНастроек(Настройки)
			);
		Исключение
			Возврат НовыеНастройкиOpm(Новый Массив, Неопределено);
		КонецПопытки;
	КонецЦикла;

	Возврат НовыеНастройкиOpm(Новый Массив, Неопределено);

КонецФункции

// Возвращает пути, в которых OPM ищет opm.cfg.
//
// Возвращаемое значение:
//   Массив из Строка - Пути в порядке приоритета.
Функция ПутиФайловНастроек() Экспорт

	ИмяФайла = "opm.cfg";
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПутьПрофиляПользователя = СистемнаяИнформация.ПолучитьПутьПапки(
		СпециальнаяПапка.ПрофильПользователя
	);

	Пути = Новый Массив;
	Пути.Добавить(ОбъединитьПути(ТекущийКаталог(), ИмяФайла));

	Если ЭтоWindows(СистемнаяИнформация) Тогда
		Пути.Добавить(ОбъединитьПути(ПутьПрофиляПользователя, ИмяФайла));
		ПутьОбщихДанных = СистемнаяИнформация.ПолучитьПутьПапки(
			СпециальнаяПапка.ОбщийКаталогДанныхПриложения
		);
		Пути.Добавить(ОбъединитьПути(ПутьОбщихДанных, ИмяФайла));
	Иначе
		Пути.Добавить(ОбъединитьПути(ПутьПрофиляПользователя, "." + ИмяФайла));
		Пути.Добавить(ОбъединитьПути("/etc", ИмяФайла));
	КонецЕсли;

	Пути.Добавить(ОбъединитьПути(СтартовыйСценарий().Каталог, ИмяФайла));

	Возврат Пути;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьНастройки(ПутьФайла)

	ЧтениеТекста = Новый ЧтениеТекста(ПутьФайла);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Настройки = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Корень opm.cfg должен быть объектом JSON";
	КонецЕсли;

	Возврат Настройки;

КонецФункции

Функция СерверыИзНастроек(Настройки, ИмяЗеркала)

	Результат = Новый Массив;
	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	СервераПакетов = Настройки.Получить("СервераПакетов");
	Если ТипЗнч(СервераПакетов) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Индекс = 0;
	Для Каждого НастройкаСервера Из СервераПакетов Цикл
		Индекс = Индекс + 1;

		Попытка
			Сервер = ПодготовитьСервер(НастройкаСервера, Индекс);
		Исключение
			Продолжить;
		КонецПопытки;

		Если Сервер = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ИмяЗеркала) И Сервер.Имя <> ИмяЗеркала Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Сервер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПодготовитьСервер(Настройка, Индекс)

	Если ТипЗнч(Настройка) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	АдресСтрокой = ЗначениеПоля(Настройка, "Сервер", "");
	Если Не ЗначениеЗаполнено(АдресСтрокой) Или СтрНачинаетсяС(НРег(АдресСтрокой), "file://") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Порт = Число(ЗначениеПоля(Настройка, "Порт", 0));
	Адрес = АдресаСерверовПакетов.Разобрать(АдресСтрокой, Порт);
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовки = ПодготовитьЗаголовки(ЗначениеПоля(Настройка, "Заголовки", Неопределено));
	Авторизация = ЗначениеПоля(Настройка, "Авторизация", "");
	Если ЗначениеЗаполнено(Авторизация) Тогда
		Заголовки.Вставить("Authorization", Строка(Авторизация));
	КонецЕсли;

	Имя = Строка(ЗначениеПоля(Настройка, "Имя", СтрШаблон("ДопСервер_%1", Индекс)));
	ПутьНаСервере = Строка(ЗначениеПоля(Настройка, "ПутьНаСервере", "/"));

	Возврат НовыйСерверOpm(Имя, Адрес, ОпределитьПул(ПутьНаСервере), Заголовки);

КонецФункции

Функция ОпределитьПул(ПутьНаСервере)

	Сегменты = СтрРазделить(Строка(ПутьНаСервере), "/", Ложь);
	Если Сегменты.Количество() >= 5
		И НРег(Сегменты[0]) = "api"
		И НРег(Сегменты[1]) = "v1"
		И НРег(Сегменты[2]) = "pools"
		И НРег(Сегменты[4]) = "download" Тогда
		Возврат Сегменты[3];
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПодготовитьЗаголовки(ИсходныеЗаголовки)

	Заголовки = Новый Соответствие;
	Если ТипЗнч(ИсходныеЗаголовки) <> Тип("Соответствие") Тогда
		Возврат Заголовки;
	КонецЕсли;

	Для Каждого Заголовок Из ИсходныеЗаголовки Цикл
		Заголовки.Вставить(Заголовок.Ключ, Строка(Заголовок.Значение));
	КонецЦикла;

	Возврат Заголовки;

КонецФункции

Функция ПроксиИзНастроек(Настройки)

	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Прокси = Настройки.Получить("Прокси");

	Если ТипЗнч(Прокси) <> Тип("Соответствие")
		Или ЗначениеПоля(Прокси, "ИспользоватьПрокси", Ложь) <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИспользоватьСистемный = ЗначениеПоля(Прокси, "ПроксиПоУмолчанию", Ложь) = Истина;
	Сервер = Строка(ЗначениеПоля(Прокси, "Сервер", ""));

	Если Не ИспользоватьСистемный И Не ЗначениеЗаполнено(Сервер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НовыеНастройкиПрокси(
		ИспользоватьСистемный,
		Сервер,
		Число(ЗначениеПоля(Прокси, "Порт", 80)),
		Строка(ЗначениеПоля(Прокси, "Пользователь", "")),
		Строка(ЗначениеПоля(Прокси, "Пароль", "")),
		ЗначениеПоля(Прокси, "ИспользоватьАутентификациюОС", Ложь) = Истина
	);

КонецФункции

Функция НовыеНастройкиOpm(Серверы, Прокси)

	Возврат Новый Структура("Серверы,Прокси", Серверы, Прокси);

КонецФункции

Функция НовыйСерверOpm(Имя, Адрес, Пул, Заголовки)

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Адрес", Адрес);
	Результат.Вставить("Пул", Пул);
	Результат.Вставить("Заголовки", Заголовки);

	Возврат Результат;

КонецФункции

Функция НовыеНастройкиПрокси(
	ИспользоватьСистемный,
	Сервер,
	Порт,
	Пользователь,
	Пароль,
	ИспользоватьАутентификациюОС
)

	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьСистемный", ИспользоватьСистемный);
	Результат.Вставить("Сервер", Сервер);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИспользоватьАутентификациюОС", ИспользоватьАутентификациюОС);

	Возврат Результат;

КонецФункции

Функция ЗначениеПоля(Настройки, ИмяПоля, ЗначениеПоУмолчанию)

	Значение = Настройки.Получить(ИмяПоля);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ЭтоWindows(СистемнаяИнформация)

	Платформа = СистемнаяИнформация.ТипПлатформы;

	Возврат Платформа = ТипПлатформы.Windows_x86 Или Платформа = ТипПлатформы.Windows_x86_64;

КонецФункции

#КонецОбласти
