// BSLLS:ExportVariables-off

#Использовать fs

#Область ОписаниеПеременных

Перем Пакеты Экспорт; // Соответствие
Перем ПоврежденныеПакеты Экспорт; // ТаблицаЗначений
Перем МетаданныеПакетов Экспорт; // Соответствие

#КонецОбласти

#Область ОбработчикиСобытий

// Создает результат одного сканирования установленных пакетов.
//
// Параметры:
//   Пакеты - Соответствие - Имена и каталоги корректно установленных пакетов.
//   ПоврежденныеПакеты - ТаблицаЗначений - Сведения о поврежденных пакетах.
//   МетаданныеПакетов - Соответствие - Метаданные пакетов по пути к файлу.
Процедура ПриСозданииОбъекта(Пакеты, ПоврежденныеПакеты, МетаданныеПакетов)

	ЭтотОбъект.Пакеты = Пакеты;
	ЭтотОбъект.ПоврежденныеПакеты = ПоврежденныеПакеты;
	ЭтотОбъект.МетаданныеПакетов = МетаданныеПакетов;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает версию установленного пакета.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
//
// Возвращаемое значение:
//   Строка - Версия пакета или пустая строка, если пакет или его метаданные не найдены.
Функция ВерсияПакета(ИмяПакета) Экспорт

	КаталогПакета = Пакеты[ИмяПакета];
	Возврат ?(КаталогПакета = Неопределено, "", ВерсияПакетаПоКаталогу(КаталогПакета));

КонецФункции

// Возвращает версию пакета по каталогу установки.
//
// Параметры:
//   КаталогПакета - Строка - Каталог установленного пакета.
//
// Возвращаемое значение:
//   Строка - Версия пакета или пустая строка, если метаданные не найдены.
Функция ВерсияПакетаПоКаталогу(КаталогПакета) Экспорт

	МетаданныеПакета = МетаданныеПакетаПоКаталогу(КаталогПакета);
	Возврат ?(МетаданныеПакета = Неопределено, "", МетаданныеПакета.Версия);

КонецФункции

// Возвращает метаданные установленного пакета по каталогу.
//
// Параметры:
//   КаталогПакета - Строка - Каталог установленного пакета.
//
// Возвращаемое значение:
//   Структура, Неопределено - Метаданные пакета.
Функция МетаданныеПакетаПоКаталогу(КаталогПакета) Экспорт

	ПутьКФайлу = ОбъединитьПути(КаталогПакета, "opm-metadata.xml");
	Возврат МетаданныеПакетов[ПутьКФайлу];

КонецФункции

#КонецОбласти
