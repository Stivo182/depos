#Использовать 1commands

#Область ПрограммныйИнтерфейс

// Применяет патч для установленной зависимости oscript-yaml.
Процедура ПрименитьДляOscriptYaml() Экспорт

    РабочийКаталог = ТекущийКаталог();
    ПутьПатча = ОбъединитьПути(РабочийКаталог, "patches/oscript-yaml-module-names.patch");

    Если Не Новый Файл(ПутьПатча).Существует() Тогда
        ВызватьИсключение СтрШаблон("Не найден патч зависимости oscript-yaml: %1", ПутьПатча);
    КонецЕсли;

    ПрямаяПроверка = ВыполнитьGitApply(РабочийКаталог, ПутьПатча, Ложь, Истина);
    Если ПрямаяПроверка.КодВозврата = 0 Тогда
        РезультатПрименения = ВыполнитьGitApply(РабочийКаталог, ПутьПатча);
        Если РезультатПрименения.КодВозврата <> 0 Тогда
            ВызватьИсключение СтрШаблон(
                "Не удалось применить патч oscript-yaml.%1%2",
                Символы.ПС,
                РезультатПрименения.Вывод
            );
        КонецЕсли;

        Возврат;
    КонецЕсли;

    ОбратнаяПроверка = ВыполнитьGitApply(РабочийКаталог, ПутьПатча, Истина, Истина);
    Если ОбратнаяПроверка.КодВозврата = 0 Тогда
        Возврат;
    КонецЕсли;

    ВызватьИсключение СтрШаблон(
        "Патч oscript-yaml несовместим с установленной версией.%1Прямая проверка:%1%2%1Обратная проверка:%1%3",
        Символы.ПС,
        ПрямаяПроверка.Вывод,
        ОбратнаяПроверка.Вывод
    );

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьGitApply(РабочийКаталог, ПутьПатча, Обратно = Ложь, ТолькоПроверка = Ложь)

    КомандаGit = Новый Команда;
    КомандаGit.УстановитьКоманду("git");
    КомандаGit.УстановитьРабочийКаталог(РабочийКаталог);
    КомандаGit.ДобавитьПараметр("apply");

    Если Обратно Тогда
        КомандаGit.ДобавитьПараметр("--reverse");
    КонецЕсли;

    Если ТолькоПроверка Тогда
        КомандаGit.ДобавитьПараметр("--check");
    КонецЕсли;

    КомандаGit.ДобавитьПараметр(КомандаGit.ОбернутьВКавычки(ПутьПатча));

    КодВозврата = КомандаGit.Исполнить();

    Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, КомандаGit.ПолучитьВывод());

КонецФункции

#КонецОбласти
